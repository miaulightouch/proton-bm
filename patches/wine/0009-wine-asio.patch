+/* Native PipeWire transport. LGPL-2.1-or-later. */
+#ifndef PROTONASIO_UNIXLIB_H
+#define PROTONASIO_UNIXLIB_H
+#include "windef.h"
+#include "wine/unixlib.h"
+
+#define ASIO_UNIX_ABI 0x50415334u
+
+enum { ASIO_WRITE_DROPPED = 1 };
+
+enum asio_unix_call { asio_open, asio_close, asio_create, asio_destroy, asio_start,
+                     asio_stop, asio_wait, asio_write, asio_timing, asio_reset,
+                     asio_calls_count };
+struct asio_open_params { UINT64 handle; LONG result; };
+struct asio_handle_params { UINT64 handle; LONG result; };
+struct asio_create_params { UINT64 handle; UINT rate, channels, frames; LONG result; };
+/* One immutable callback reservation, in the current run. */
+struct asio_ticket { UINT64 generation, id, position, nanoseconds, latency, clock_position; };
+struct asio_wait_params { UINT64 handle; LONG result; struct asio_ticket ticket; };
+struct asio_write_params
+{
+    UINT64 handle;
+    const BYTE *data;
+    UINT frames;
+    LONG result;
+    UINT64 generation, id;
+};
+struct asio_timing_params { UINT64 handle, latency; LONG result; };
+
+#endif

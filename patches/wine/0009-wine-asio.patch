+static void test_clock_publication(void)
+{
+    struct asio_deadline_queue queue;
+    struct asio_render_result rendered;
+    struct asio_clock clock = {0};
+    struct asio_clock_value value = {0}, read;
+    unsigned char output[1024];
+
+    ok(asio_queue_init(&queue, 256, 1, 8), "Queue initialization failed.\n");
+    asio_queue_reset(&queue, 1, 512);
+    ok(!asio_clock_reserve(&clock, 1, 256, &read), "Unpublished clock granted a ticket.\n");
+    ok(asio_queue_render(&queue, output, 256, &rendered), "First render failed.\n");
+    value.nanoseconds = 1000000000;
+    value.callback_end = queue.callback_end;
+    asio_clock_publish(&clock, &value);
+    ok(asio_clock_reserve(&clock, 1, 256, &read), "First published ticket not granted.\n");
+    ok(asio_queue_render(&queue, output, 1024, &rendered), "Changed quantum render failed.\n");
+    ok(asio_block_due(2, queue.callback_end, 256), "The new interval did not cover callback1.\n");
+    ok(!asio_clock_reserve(&clock, 2, 256, &read),
+       "A new callback escaped with the previous submission's timestamp.\n");
+    value.position = 256;
+    value.nanoseconds = 1021333333;
+    value.backend = 16;
+    value.callback_end = queue.callback_end;
+    asio_clock_publish(&clock, &value);
+    ok(asio_clock_reserve(&clock, 2, 256, &read), "Committed interval did not grant callback1.\n");
+    ok(read.position == 256 && read.nanoseconds == 1021333333 && read.backend == 16
+       && read.callback_end == value.callback_end, "Reservation mixed timing generations.\n");
+    asio_clock_reset(&clock);
+    ok(!asio_clock_reserve(&clock, 2, 256, &read), "Reset left an old ticket available.\n");
+    asio_queue_destroy(&queue);
+}
+
+static void test_ticket_lifecycle(void)
+{
+    struct asio_deadline_queue queue;
+    struct asio_render_result rendered;
+    struct asio_clock clock = {0};
+    struct asio_clock_value value = {0}, ticket;
+    unsigned char input[4] = {1}, output[4];
+    uint64_t period = 4 * 1000000000ULL / 48000;
+    uint64_t due = 1000000000ULL;
+    uint64_t prefill_ns, callback_ns;
+
+    /* Q1024/B256 uses Q+B software latency: the prefill ticket is one B early. */
+    ok(audio_presentation_time_at(1280, due, 1024, 48000, &prefill_ns)
+       && audio_presentation_time_at(1280, due, 1280, 48000, &callback_ns)
+       && prefill_ns < callback_ns && callback_ns == due
+       && prefill_ns + 256 * 1000000000ULL / 48000 == callback_ns,
+       "Startup prefill was not mapped one native block before callback0.\n");
+
+    ok(asio_queue_init(&queue, 4, 1, 4), "Queue initialization failed.\n");
+    asio_queue_reset(&queue, 7, 4);
+    ok(asio_queue_render(&queue, output, 4, &rendered), "Initial render failed.\n");
+    value.callback_end = queue.callback_end;
+    value.nanoseconds = due + period;
+    asio_clock_publish(&clock, &value);
+    ok(asio_queue_commit(&queue, 7, 0, input) == ASIO_COMMITTED,
+       "Prefill block was rejected at the startup deadline.\n");
+    ok(asio_clock_reserve(&clock, 1, 4, &ticket), "Future ticket was not reserved.\n");
+    ok(ticket.nanoseconds > due, "Future ticket lost its future timestamp.\n");
+    value.nanoseconds = due;
+    asio_clock_publish(&clock, &value);
+    ok(asio_clock_reserve(&clock, 1, 4, &ticket), "Current ticket was not reserved.\n");
+    ok(ticket.nanoseconds == due, "Current ticket lost the published clock timestamp.\n");
+    ok(asio_queue_commit(&queue, 7, 1, input) == ASIO_COMMITTED,
+       "Current ticket did not commit before consumption.\n");
+    ok(asio_queue_render(&queue, output, 4, &rendered), "First block render failed.\n");
+    ok(rendered.copied_frames == 4 && !rendered.silent_frames,
+       "Prefill block was not consumed at its startup position.\n");
+    ok(asio_queue_render(&queue, output, 4, &rendered), "Current block render failed.\n");
+    ok(rendered.copied_frames == 4 && !rendered.silent_frames,
+       "Current ticket did not supply its PCM block.\n");
+    ok(asio_queue_render(&queue, output, 4, &rendered), "Expired block render failed.\n");
+    ok(asio_queue_commit(&queue, 7, 2, input) == ASIO_LATE,
+       "Expired ticket was accepted after its PCM deadline.\n");
+    asio_clock_reset(&clock);
+    ok(!asio_clock_reserve(&clock, 2, 4, &ticket), "Cancelled clock left a ticket available.\n");
+    asio_queue_reset(&queue, 8, 4);
+    ok(asio_queue_commit(&queue, 7, 0, input) == ASIO_QUEUE_INVALID,
+       "Stale generation was accepted after cancellation.\n");
+    asio_queue_destroy(&queue);
+}

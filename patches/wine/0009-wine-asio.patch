+static void test_streaming_boundaries(IASIO *driver, LONG output_channels)
+{
+    static const double rates[] = {8000.0, 44100.0, 48000.0, 192000.0};
+    static const LONG sizes[] = {64, 256, 4096};
+    double original;
+    unsigned int i, j;
+    LONG error;
+
+    error = driver->lpVtbl->getSampleRate(driver, &original);
+    ok(error == ASE_OK, "GetSampleRate before boundary streaming failed: %ld.\n", error);
+    if (error != ASE_OK)
+        return;
+
+    for (i = 0; i < sizeof(rates) / sizeof(rates[0]); ++i)
+    {
+        error = driver->lpVtbl->canSampleRate(driver, rates[i]);
+        ok(error == ASE_OK, "CanSampleRate(%.0f) failed for boundary streaming: %ld.\n",
+                rates[i], error);
+        if (error != ASE_OK)
+            continue;
+        for (j = 0; j < sizeof(sizes) / sizeof(sizes[0]); ++j)
+            test_one_stream(driver, output_channels, rates[i], sizes[j]);
+    }
+
+    error = driver->lpVtbl->setSampleRate(driver, original);
+    ok(error == ASE_OK, "Could not restore %.0f Hz after boundary streaming: %ld.\n",
+            original, error);
+}

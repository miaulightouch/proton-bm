+/* Standard ASIO driver ABI. This library is licensed under LGPL-2.1-or-later. */
+#ifndef PROTONASIO_H
+#define PROTONASIO_H
+
+#include <stdarg.h>
+#include "windef.h"
+#include "unknwn.h"
+
+static const GUID CLSID_ProtonASIO =
+    {0xba274ea3,0x1dd1,0x4593,{0xa8,0x5a,0xae,0xce,0x49,0x18,0x1f,0x47}};
+
+enum { ASE_OK = 0, ASE_SUCCESS = 0x3f4847a0, ASE_NotPresent = -1000,
+       ASE_HWMalfunction, ASE_InvalidParameter, ASE_InvalidMode, ASE_SPNotAdvancing,
+       ASE_NoClock, ASE_NoMemory };
+enum { ASIOSTInt24LSB = 17 };
+
+#define ASIO_DEVICE_NAME_SIZE 32
+BOOL asio_get_device_name(char name[ASIO_DEVICE_NAME_SIZE]);
+
+#pragma pack(push, 4)
+typedef struct { DWORD hi, lo; } ASIOSamples;
+typedef struct { LONG channel, isInput, isActive, channelGroup, type; char name[32]; } ASIOChannelInfo;
+typedef struct { LONG isInput, channelNum; void *buffers[2]; } ASIOBufferInfo;
+typedef struct { LONG index, associatedChannel, associatedGroup, isCurrentSource; char name[32]; } ASIOClockSource;
+typedef struct
+{
+    double speed;
+    ASIOSamples systemTime, samplePosition;
+    double sampleRate;
+    DWORD flags;
+    char reserved[12];
+} ASIOTimeInfo;
+typedef struct
+{
+    double speed;
+    ASIOSamples timeCodeSamples;
+    DWORD flags;
+    char future[64];
+} ASIOTimeCode;
+typedef struct { LONG reserved[4]; ASIOTimeInfo timeInfo; ASIOTimeCode timeCode; } ASIOTime;
+typedef struct
+{
+    void (__cdecl *bufferSwitch)(LONG, LONG);
+    void (__cdecl *sampleRateDidChange)(double);
+    LONG (__cdecl *asioMessage)(LONG, LONG, void *, double *);
+    ASIOTime *(__cdecl *bufferSwitchTimeInfo)(ASIOTime *, LONG, LONG);
+} ASIOCallbacks;
+#pragma pack(pop)
+C_ASSERT(sizeof(ASIOTimeInfo) == 48);
+C_ASSERT(sizeof(ASIOTimeCode) == 84);
+C_ASSERT(sizeof(ASIOTime) == 148);
+
+typedef struct IASIO IASIO;
+typedef struct
+{
+    HRESULT (WINAPI *QueryInterface)(IASIO *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(IASIO *);
+    ULONG (WINAPI *Release)(IASIO *);
+    LONG (*init)(IASIO *, void *);
+    void (*getDriverName)(IASIO *, char *);
+    LONG (*getDriverVersion)(IASIO *);
+    void (*getErrorMessage)(IASIO *, char *);
+    LONG (*start)(IASIO *);
+    LONG (*stop)(IASIO *);
+    LONG (*getChannels)(IASIO *, LONG *, LONG *);
+    LONG (*getLatencies)(IASIO *, LONG *, LONG *);
+    LONG (*getBufferSize)(IASIO *, LONG *, LONG *, LONG *, LONG *);
+    LONG (*canSampleRate)(IASIO *, double);
+    LONG (*getSampleRate)(IASIO *, double *);
+    LONG (*setSampleRate)(IASIO *, double);
+    LONG (*getClockSources)(IASIO *, ASIOClockSource *, LONG *);
+    LONG (*setClockSource)(IASIO *, LONG);
+    LONG (*getSamplePosition)(IASIO *, ASIOSamples *, ASIOSamples *);
+    LONG (*getChannelInfo)(IASIO *, ASIOChannelInfo *);
+    LONG (*createBuffers)(IASIO *, ASIOBufferInfo *, LONG, LONG, ASIOCallbacks *);
+    LONG (*disposeBuffers)(IASIO *);
+    LONG (*controlPanel)(IASIO *);
+    LONG (*future)(IASIO *, LONG, void *);
+    LONG (*outputReady)(IASIO *);
+} IASIOVtbl;
+struct IASIO { const IASIOVtbl *lpVtbl; };
+
+#endif
diff --git a/dlls/protonasio/pipewire.c b/dlls/protonasio/pipewire.c
new file mode 100644
--- /dev/null
+++ b/dlls/protonasio/pipewire.c
@@ -0,0 +1,1299 @@
+/* Native PipeWire transport for the generic x64 ASIO driver.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/eventfd.h>
+#include <sys/resource.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <pipewire/pipewire.h>
+#include <spa/param/audio/format-utils.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winternl.h"
+
+#include "asio.h"
+#include "wine/audio_presentation.h"
+#include "wine/debug.h"
+#include "timeline.h"
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(asio);
+
+#define ASIO_MIN_RATE 8000
+#define ASIO_MAX_RATE 192000
+#define ASIO_MIN_FRAMES 64
+#define ASIO_MAX_FRAMES 4096
+#define ASIO_NEGOTIATION_NS 750000000LL
+#define ASIO_RT_TIME_FLOOR_USEC 20000
+
+struct asio_transport;
+
+struct asio_stream
+{
+    struct asio_transport *transport;
+    struct pw_stream *pw;
+    struct spa_hook listener;
+    bool listener_added;
+
+    int event_fd;
+    struct asio_deadline_queue queue;
+    UINT rate, channels, frames, frame_size;
+    UINT64 max_buffer_frames;
+    UINT64 generation, next_block;
+    struct asio_clock clock;
+    UINT64 nominal_buffered;
+    int64_t nominal_delay;
+    struct spa_fraction nominal_period;
+    bool nominal_latency_valid;
+
+    int started;
+    int stopped;
+    int ready;
+    int failed;
+    int error;
+    int callback_inflight;
+    int write_inflight;
+    int closing;
+    bool preflight_active;
+};
+
+struct asio_transport
+{
+    struct pw_thread_loop *loop;
+    struct pw_context *context;
+    struct pw_core *core;
+    struct spa_hook core_listener;
+    bool core_listener_added;
+    int core_sync_seq;
+    bool core_ready;
+    bool core_failed;
+    int core_error;
+    struct asio_stream *stream;
+};
+
+static pthread_mutex_t pipewire_init_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static int asio_error(int error)
+{
+    if (!error)
+        return -EIO;
+    return error < 0 ? error : -error;
+}
+
+static UINT64 add_u64(UINT64 a, UINT64 b)
+{
+    return a > UINT64_MAX - b ? UINT64_MAX : a + b;
+}
+
+static UINT64 mul_mul_div_u64(UINT64 value, UINT64 multiplier1, UINT64 multiplier2,
+                              UINT64 divisor)
+{
+    __uint128_t result;
+
+    if (!divisor)
+        return UINT64_MAX;
+    result = (__uint128_t)value * multiplier1 * multiplier2 / divisor;
+    return result > UINT64_MAX ? UINT64_MAX : (UINT64)result;
+}
+
+static bool clock_ns(clockid_t clock_id, UINT64 *value)
+{
+    struct timespec ts;
+
+    if (clock_gettime(clock_id, &ts) < 0)
+        return false;
+    *value = (UINT64)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+    return true;
+}
+
+static UINT64 monotonic_ns(void)
+{
+    UINT64 value;
+
+    return clock_ns(CLOCK_MONOTONIC, &value) ? value : 0;
+}
+
+static UINT64 raw_ns(void)
+{
+    UINT64 value;
+
+    return clock_ns(CLOCK_MONOTONIC_RAW, &value) ? value : 0;
+}
+
+static bool map_monotonic_to_system(UINT64 monotonic, UINT64 *system)
+{
+    UINT64 before, after, raw, midpoint;
+
+    /* Match Wine's QPC provider without calling Windows code from the RT loop. */
+    if (!clock_ns(CLOCK_MONOTONIC, &before)
+            || !clock_ns(CLOCK_MONOTONIC_RAW, &raw)
+            || !clock_ns(CLOCK_MONOTONIC, &after) || after < before)
+        return false;
+    midpoint = before + (after - before) / 2;
+    if (monotonic >= midpoint)
+    {
+        if (raw > UINT64_MAX - (monotonic - midpoint)) return false;
+        *system = raw + monotonic - midpoint;
+    }
+    else
+    {
+        if (raw < midpoint - monotonic) return false;
+        *system = raw - (midpoint - monotonic);
+    }
+    return true;
+}
+
+
+/* A container can load libpipewire from the host while its compiled-in SPA
+ * path points outside the container.  Keep a usable explicit path and derive
+ * the matching path from the loaded library otherwise. */
+static bool spa_plugin_dir_usable(const char *dir)
+{
+    char path[PATH_MAX + 64];
+    unsigned char ident[5];
+    int fd, count;
+
+    if (!dir || !dir[0])
+        return false;
+    snprintf(path, sizeof(path), "%s/support/libspa-support.so", dir);
+    fd = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0)
+        return false;
+    count = read(fd, ident, sizeof(ident));
+    close(fd);
+    return count == (int)sizeof(ident) && !memcmp(ident, "\x7f" "ELF", 4)
+            && ident[4] == (sizeof(void *) == 8 ? 2 : 1);
+}
+
+static bool set_pipewire_plugin_dirs(void)
+{
+    Dl_info info;
+    char libpath[PATH_MAX], spa_path[PATH_MAX + 64], module_path[PATH_MAX + 64], *slash;
+    const char *explicit_dir = getenv("SPA_PLUGIN_DIR");
+
+    if (explicit_dir && spa_plugin_dir_usable(explicit_dir))
+        return true;
+
+    if (!dladdr((void *)pw_init, &info) || !info.dli_fname
+            || !realpath(info.dli_fname, libpath))
+        goto failed;
+    if (!(slash = strrchr(libpath, '/')))
+        goto failed;
+    *slash = 0;
+
+    snprintf(spa_path, sizeof(spa_path), "%s/spa-0.2", libpath);
+    snprintf(module_path, sizeof(module_path), "%s/pipewire-0.3", libpath);
+    if (!spa_plugin_dir_usable(spa_path) || access(module_path, R_OK | X_OK))
+        goto failed;
+    /* SPA is the readiness marker also used by winepipewire.drv. */
+    if (setenv("PIPEWIRE_MODULE_DIR", module_path, 1) || setenv("SPA_PLUGIN_DIR", spa_path, 1))
+        goto failed;
+    return true;
+
+failed:
+    WARN("Cannot establish matching PipeWire plugin directories.\n");
+    return false;
+}
+
+static struct asio_transport *transport_from_handle(UINT64 handle)
+{
+    return handle ? (struct asio_transport *)(UINT_PTR)handle : NULL;
+}
+
+static void notify_stream(struct asio_stream *stream)
+{
+    UINT64 value = 1;
+
+    if (stream->event_fd >= 0)
+        while (write(stream->event_fd, &value, sizeof(value)) < 0 && errno == EINTR)
+            ;
+}
+
+/* The snapshot excludes this submission; current size belongs only to its P range. */
+static bool presentation_time(struct asio_stream *stream, const struct pw_time *time,
+                              UINT64 *first_ns, UINT64 *backend)
+{
+    uint64_t mono;
+    UINT64 delay = time->delay > 0 ? time->delay : 0;
+
+    if (!audio_presentation_first_ns(time->now, time->queued, time->buffered, time->delay,
+                                     time->rate.num, time->rate.denom, stream->rate, &mono))
+        return false;
+    /* Converter occupancy can dither by a frame while its nominal latency stays fixed. */
+    if (!stream->nominal_latency_valid || stream->nominal_delay != time->delay
+            || stream->nominal_period.num != time->rate.num
+            || stream->nominal_period.denom != time->rate.denom)
+    {
+        stream->nominal_buffered = time->buffered;
+        stream->nominal_delay = time->delay;
+        stream->nominal_period = time->rate;
+        stream->nominal_latency_valid = true;
+    }
+    /* Already queued buffers are represented by P, not a second latency term. */
+    *backend = add_u64(stream->nominal_buffered, mul_mul_div_u64(delay, time->rate.num,
+                                                      stream->rate, time->rate.denom));
+    return *backend != UINT64_MAX && map_monotonic_to_system(mono, first_ns);
+}
+
+static void wait_stream_callbacks(struct asio_stream *stream)
+{
+    /* RT_PROCESS callbacks do not take the thread-loop lock. */
+    while (__atomic_load_n(&stream->callback_inflight, __ATOMIC_ACQUIRE))
+        sched_yield();
+}
+
+static void wait_stream_writes(struct asio_stream *stream)
+{
+    while (__atomic_load_n(&stream->write_inflight, __ATOMIC_ACQUIRE))
+        sched_yield();
+}
+
+static void stream_fail(struct asio_stream *stream, int error)
+{
+    int expected = 0;
+
+    error = asio_error(error);
+    __atomic_compare_exchange_n(&stream->error, &expected, error, false,
+                                __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->failed, 1, __ATOMIC_RELEASE);
+    notify_stream(stream);
+}
+
+static void asio_stream_add_buffer(void *data, struct pw_buffer *buffer)
+{
+    struct asio_stream *stream = data;
+    UINT64 required = 0, slots;
+    uint32_t i;
+
+    if (!buffer || !buffer->buffer || !buffer->buffer->datas)
+    {
+        stream_fail(stream, -EFAULT);
+        return;
+    }
+    for (i = 0; i < buffer->buffer->n_datas; ++i)
+    {
+        UINT64 frames = buffer->buffer->datas[i].maxsize / stream->frame_size;
+        if (frames > required) required = frames;
+    }
+    if (!required) { stream_fail(stream, -EFAULT); return; }
+    if (required <= stream->max_buffer_frames) return;
+    /* Buffer geometry is negotiated before activation, never allocate on RT. */
+    if (__atomic_load_n(&stream->clock.valid, __ATOMIC_ACQUIRE)
+            || __atomic_load_n(&stream->callback_inflight, __ATOMIC_ACQUIRE))
+    {
+        stream_fail(stream, -EMSGSIZE);
+        return;
+    }
+    slots = (required + stream->frames - 1) / stream->frames + 4;
+    if (slots > UINT32_MAX) { stream_fail(stream, -EOVERFLOW); return; }
+    asio_queue_destroy(&stream->queue);
+    if (!asio_queue_init(&stream->queue, stream->frames, stream->frame_size, slots))
+        stream_fail(stream, -ENOMEM);
+    else stream->max_buffer_frames = required;
+}
+
+static void asio_stream_state_changed(void *data, enum pw_stream_state old_state,
+                                      enum pw_stream_state state, const char *error)
+{
+    struct asio_stream *stream = data;
+    int code;
+
+    (void)error;
+    if (state == PW_STREAM_STATE_PAUSED || state == PW_STREAM_STATE_STREAMING)
+    {
+        stream->ready = 1;
+        if (stream->transport->loop)
+            pw_thread_loop_signal(stream->transport->loop, false);
+        return;
+    }
+    if (state != PW_STREAM_STATE_ERROR
+            && (state != PW_STREAM_STATE_UNCONNECTED || !stream->ready))
+        return;
+    code = state == PW_STREAM_STATE_UNCONNECTED ? -ENODEV : (errno ? -errno : -EIO);
+    stream_fail(stream, code);
+    if (stream->transport->loop)
+        pw_thread_loop_signal(stream->transport->loop, false);
+}
+
+/* No Windows calls, waiting or allocation on the PipeWire process thread. */
+static void asio_stream_process(void *data)
+{
+    struct asio_stream *stream = data;
+    struct pw_buffer *buffer;
+    struct spa_data *out;
+    struct pw_time time;
+    struct asio_render_result rendered;
+    UINT64 requested, position = 0, first_ns = 0, backend = 0;
+    bool have_time = false, active;
+
+    __atomic_add_fetch(&stream->callback_inflight, 1, __ATOMIC_ACQ_REL);
+    if (__atomic_load_n(&stream->closing, __ATOMIC_ACQUIRE)) goto done;
+    if (!(buffer = pw_stream_dequeue_buffer(stream->pw))) goto done;
+    if (!buffer->buffer || !buffer->buffer->n_datas || !buffer->buffer->datas
+            || !(out = &buffer->buffer->datas[0])->data || !out->chunk)
+    {
+        stream_fail(stream, -EFAULT);
+        pw_stream_queue_buffer(stream->pw, buffer);
+        goto done;
+    }
+    requested = buffer->requested ? buffer->requested : out->maxsize / stream->frame_size;
+    if (requested > out->maxsize / stream->frame_size)
+        requested = out->maxsize / stream->frame_size;
+    if (!requested)
+    {
+        stream_fail(stream, -EMSGSIZE);
+        out->chunk->size = 0;
+        buffer->size = 0;
+        pw_stream_queue_buffer(stream->pw, buffer);
+        goto done;
+    }
+    active = __atomic_load_n(&stream->started, __ATOMIC_ACQUIRE)
+            && !__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE);
+    if (active)
+    {
+        memset(&time, 0, sizeof(time));
+        have_time = pw_stream_get_time_n(stream->pw, &time, sizeof(time)) >= 0
+                && presentation_time(stream, &time, &first_ns, &backend);
+        if (!have_time)
+        {
+            /* PipeWire may request initial buffers before its first streaming clock. */
+            if (__atomic_load_n(&stream->clock.valid, __ATOMIC_ACQUIRE)) stream_fail(stream, -EIO);
+            memset(out->data, 0, (size_t)requested * stream->frame_size);
+        }
+        else
+        {
+            if (!stream->queue.generation)
+                asio_queue_reset(&stream->queue,
+                        __atomic_load_n(&stream->generation, __ATOMIC_ACQUIRE), requested);
+            position = __atomic_load_n(&stream->queue.play_position, __ATOMIC_RELAXED);
+            if (!asio_queue_render(&stream->queue, out->data, requested, &rendered))
+            {
+                stream_fail(stream, -EIO);
+                memset(out->data, 0, (size_t)requested * stream->frame_size);
+                have_time = false;
+            }
+        }
+    }
+    else memset(out->data, 0, (size_t)requested * stream->frame_size);
+    out->chunk->offset = 0;
+    out->chunk->stride = stream->frame_size;
+    out->chunk->size = requested * stream->frame_size;
+    buffer->size = requested;
+    if (pw_stream_queue_buffer(stream->pw, buffer) < 0) stream_fail(stream, -EPIPE);
+    else if (have_time)
+    {
+        struct asio_clock_value value = {position, first_ns, backend,
+            __atomic_load_n(&stream->queue.callback_end, __ATOMIC_RELAXED)};
+        asio_clock_publish(&stream->clock, &value);
+    }
+    if (active) notify_stream(stream);
+
+done:
+    __atomic_sub_fetch(&stream->callback_inflight, 1, __ATOMIC_RELEASE);
+}
+
+static const struct pw_stream_events asio_stream_events = {
+    PW_VERSION_STREAM_EVENTS,
+    .state_changed = asio_stream_state_changed,
+    .add_buffer = asio_stream_add_buffer,
+    .process = asio_stream_process,
+};
+
+static void asio_core_done(void *data, uint32_t id, int seq)
+{
+    struct asio_transport *transport = data;
+
+    if (id == PW_ID_CORE && seq == transport->core_sync_seq)
+    {
+        transport->core_ready = true;
+        pw_thread_loop_signal(transport->loop, false);
+    }
+}
+
+static void asio_core_error(void *data, uint32_t id, int seq, int res,
+                            const char *message)
+{
+    struct asio_transport *transport = data;
+
+    (void)seq;
+    (void)message;
+    if (id != PW_ID_CORE)
+        return;
+    transport->core_error = asio_error(res);
+    transport->core_failed = true;
+    if (transport->stream)
+        stream_fail(transport->stream, transport->core_error);
+    if (transport->loop)
+        pw_thread_loop_signal(transport->loop, false);
+}
+
+static const struct pw_core_events asio_core_events = {
+    PW_VERSION_CORE_EVENTS,
+    .done = asio_core_done,
+    .error = asio_core_error,
+};
+
+static int wait_for_core(struct asio_transport *transport)
+{
+    struct timespec deadline;
+    int result;
+
+    result = pw_thread_loop_get_time(transport->loop, &deadline, ASIO_NEGOTIATION_NS);
+    if (result < 0)
+        return asio_error(result);
+    while (!transport->core_ready && !transport->core_failed)
+    {
+        if (pw_thread_loop_timed_wait_full(transport->loop, &deadline) < 0)
+            break;
+    }
+    if (transport->core_ready)
+        return 0;
+    if (transport->core_failed)
+        return transport->core_error;
+    return -ETIMEDOUT;
+}
+
+static int wait_for_stream(struct asio_transport *transport, struct asio_stream *stream,
+                           bool require_streaming)
+{
+    struct timespec deadline;
+    const char *error = NULL;
+    enum pw_stream_state state;
+    int result;
+
+    result = pw_thread_loop_get_time(transport->loop, &deadline, ASIO_NEGOTIATION_NS);
+    if (result < 0)
+        return asio_error(result);
+    for (;;)
+    {
+        if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+            return __atomic_load_n(&stream->error, __ATOMIC_ACQUIRE);
+        state = pw_stream_get_state(stream->pw, &error);
+        if (state == PW_STREAM_STATE_STREAMING
+                || (state == PW_STREAM_STATE_PAUSED && !require_streaming))
+        {
+            stream->ready = 1;
+            return 0;
+        }
+        if (state == PW_STREAM_STATE_ERROR)
+        {
+            result = errno;
+            return asio_error(result);
+        }
+        if (state == PW_STREAM_STATE_UNCONNECTED && stream->ready)
+            return -ENODEV;
+        if (pw_thread_loop_timed_wait_full(transport->loop, &deadline) < 0)
+            break;
+    }
+    if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+        return __atomic_load_n(&stream->error, __ATOMIC_ACQUIRE);
+    state = pw_stream_get_state(stream->pw, &error);
+    if (state == PW_STREAM_STATE_STREAMING
+            || (state == PW_STREAM_STATE_PAUSED && !require_streaming))
+    {
+        stream->ready = 1;
+        return 0;
+    }
+    if (state == PW_STREAM_STATE_ERROR || state == PW_STREAM_STATE_UNCONNECTED)
+    {
+        if (state == PW_STREAM_STATE_UNCONNECTED && !stream->ready)
+            return -ETIMEDOUT;
+        result = state == PW_STREAM_STATE_UNCONNECTED ? -ENODEV : errno;
+        return asio_error(result);
+    }
+    return -ETIMEDOUT;
+}
+
+static void drain_stream_events(struct asio_stream *stream)
+{
+    UINT64 value;
+
+    if (stream->event_fd < 0)
+        return;
+    while (read(stream->event_fd, &value, sizeof(value)) == (ssize_t)sizeof(value))
+        ;
+}
+
+static int wait_for_first_clock(struct asio_stream *stream)
+{
+    struct pollfd pollfd = {stream->event_fd, POLLIN, 0};
+    UINT64 deadline, now, value;
+
+    deadline = monotonic_ns();
+    if (!deadline)
+        return -EIO;
+    deadline = add_u64(deadline, ASIO_NEGOTIATION_NS);
+    while (!__atomic_load_n(&stream->clock.valid, __ATOMIC_ACQUIRE))
+    {
+        int timeout;
+        int result;
+
+        if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+            return __atomic_load_n(&stream->error, __ATOMIC_ACQUIRE);
+        now = monotonic_ns();
+        if (!now || now >= deadline)
+            return -ETIMEDOUT;
+        timeout = (int)((deadline - now + 999999) / 1000000);
+        pollfd.revents = 0;
+        result = poll(&pollfd, 1, timeout);
+        if (result < 0)
+        {
+            if (errno == EINTR)
+                continue;
+            return -errno;
+        }
+        if (!result)
+            return -ETIMEDOUT;
+        if (pollfd.revents & (POLLERR | POLLHUP | POLLNVAL))
+            return -EIO;
+        do
+            result = read(stream->event_fd, &value, sizeof(value));
+        while (result < 0 && errno == EINTR);
+        if (result < 0 && errno != EAGAIN)
+            return -errno;
+    }
+    return 0;
+}
+
+static bool allow_rt_process(void)
+{
+    const char *requested = getenv("WINEPIPEWIRE_RT");
+    struct rlimit limit;
+
+    if (requested && !strcmp(requested, "0"))
+        return false;
+    if (getrlimit(RLIMIT_RTTIME, &limit) < 0)
+        return true;
+    return (limit.rlim_cur == RLIM_INFINITY || limit.rlim_cur >= ASIO_RT_TIME_FLOOR_USEC)
+            && (limit.rlim_max == RLIM_INFINITY || limit.rlim_max >= ASIO_RT_TIME_FLOOR_USEC);
+}
+
+static UINT64 stream_software_latency(const struct asio_stream *stream)
+{
+    if (__atomic_load_n(&stream->clock.valid, __ATOMIC_ACQUIRE))
+        return add_u64(stream->queue.origin, stream->frames);
+    return (UINT64)stream->frames * 2;
+}
+
+static bool verify_stream_ownership(struct asio_stream *stream)
+{
+    const struct pw_properties *effective = pw_stream_get_properties(stream->pw);
+    const char *exclusive = effective ? pw_properties_get(effective, PW_KEY_NODE_EXCLUSIVE) : NULL;
+    const char *dont_fallback = effective ? pw_properties_get(effective, "node.dont-fallback") : NULL;
+    const char *dont_move = effective ? pw_properties_get(effective, "node.dont-move") : NULL;
+
+    if (exclusive && dont_fallback && dont_move
+            && pw_properties_parse_bool(exclusive)
+            && pw_properties_parse_bool(dont_fallback)
+            && pw_properties_parse_bool(dont_move))
+        return true;
+    ERR("ASIO stream ownership was overridden: exclusive=%s, node.dont-fallback=%s, "
+        "node.dont-move=%s.\n", exclusive ? exclusive : "unset",
+        dont_fallback ? dont_fallback : "unset", dont_move ? dont_move : "unset");
+    return false;
+}
+
+static int deactivate_stream_locked(struct asio_stream *stream, bool prepare)
+{
+    bool was_active;
+    int result = ASE_OK, rc;
+
+    was_active = __atomic_load_n(&stream->started, __ATOMIC_ACQUIRE) || stream->preflight_active;
+    __atomic_store_n(&stream->stopped, 1, __ATOMIC_RELEASE);
+    __atomic_store_n(&stream->started, 0, __ATOMIC_RELEASE);
+    if (stream->pw && was_active && (rc = pw_stream_set_active(stream->pw, false)) < 0
+            && !__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE)) result = asio_error(rc);
+    stream->preflight_active = false;
+    wait_stream_callbacks(stream);
+    wait_stream_writes(stream);
+    asio_clock_reset(&stream->clock);
+    stream->nominal_latency_valid = false;
+    if (stream->pw) pw_stream_flush(stream->pw, false);
+    if (prepare && result == ASE_OK && !__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+    {
+        asio_queue_reset(&stream->queue, 0, 0);
+        __atomic_add_fetch(&stream->generation, 1, __ATOMIC_ACQ_REL);
+        stream->next_block = 0;
+        __atomic_store_n(&stream->stopped, 0, __ATOMIC_RELEASE);
+    }
+    if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+        result = __atomic_load_n(&stream->error, __ATOMIC_ACQUIRE);
+    notify_stream(stream);
+    return result;
+}
+
+static void destroy_stream_locked(struct asio_transport *transport)
+{
+    struct asio_stream *stream = transport->stream;
+
+    if (!stream)
+        return;
+    __atomic_store_n(&stream->closing, 1, __ATOMIC_RELEASE);
+    deactivate_stream_locked(stream, false);
+    if (stream->pw)
+    {
+        if (stream->listener_added)
+            spa_hook_remove(&stream->listener);
+        pw_stream_destroy(stream->pw);
+        stream->pw = NULL;
+    }
+    if (stream->event_fd >= 0)
+        close(stream->event_fd);
+    asio_queue_destroy(&stream->queue);
+    free(stream);
+    transport->stream = NULL;
+}
+
+static int create_stream_locked(struct asio_transport *transport, UINT rate,
+                                UINT channels, UINT frames)
+{
+    static const uint32_t positions[] = {
+        SPA_AUDIO_CHANNEL_FL, SPA_AUDIO_CHANNEL_FR, SPA_AUDIO_CHANNEL_FC,
+        SPA_AUDIO_CHANNEL_LFE, SPA_AUDIO_CHANNEL_RL, SPA_AUDIO_CHANNEL_RR,
+        SPA_AUDIO_CHANNEL_SL, SPA_AUDIO_CHANNEL_SR,
+    };
+    struct asio_stream *stream;
+    struct spa_audio_info_raw info;
+    struct pw_properties *props;
+    struct spa_pod_builder builder;
+    uint8_t pod_buffer[1024];
+    const struct spa_pod *params[1];
+    enum pw_stream_flags flags;
+    size_t frame_size;
+    int result, rc;
+
+    if (transport->stream)
+        return ASE_InvalidMode;
+    if (rate < ASIO_MIN_RATE || rate > ASIO_MAX_RATE || !channels || channels > 8
+            || frames < ASIO_MIN_FRAMES || frames > ASIO_MAX_FRAMES
+            || (frames & (frames - 1)))
+        return ASE_InvalidParameter;
+    frame_size = (size_t)channels * 3;
+
+    stream = calloc(1, sizeof(*stream));
+    if (!stream)
+        return ASE_NoMemory;
+    stream->transport = transport;
+    stream->event_fd = -1;
+    stream->rate = rate;
+    stream->channels = channels;
+    stream->frames = frames;
+    stream->frame_size = frame_size;
+    stream->stopped = 0;
+    asio_clock_reset(&stream->clock);
+    stream->event_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+    if (stream->event_fd < 0)
+    {
+        result = asio_error(errno);
+        free(stream);
+        return result;
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.format = SPA_AUDIO_FORMAT_S24_LE;
+    info.rate = rate;
+    info.channels = channels;
+    memcpy(info.position, positions, channels * sizeof(*positions));
+    props = pw_properties_new(PW_KEY_MEDIA_TYPE, "Audio",
+                              PW_KEY_MEDIA_CATEGORY, "Playback",
+                              PW_KEY_MEDIA_ROLE, "Game",
+                              PW_KEY_NODE_NAME, "protonasio",
+                              PW_KEY_NODE_EXCLUSIVE, "true",
+                              "node.dont-fallback", "true",
+                              "node.dont-move", "true",
+                              PW_KEY_NODE_LOCK_QUANTUM, "true",
+                              PW_KEY_NODE_DESCRIPTION, "Proton-BM ASIO",
+                              NULL);
+    if (!props)
+    {
+        close(stream->event_fd);
+        free(stream);
+        return ASE_NoMemory;
+    }
+    if (pw_properties_setf(props, PW_KEY_NODE_LATENCY, "%u/%u", frames, rate) < 0)
+    {
+        pw_properties_free(props);
+        close(stream->event_fd);
+        free(stream);
+        return -ENOMEM;
+    }
+    stream->pw = pw_stream_new(transport->core, "Proton-BM ASIO", props);
+    if (!stream->pw)
+    {
+        close(stream->event_fd);
+        free(stream);
+        return asio_error(errno);
+    }
+    pw_stream_add_listener(stream->pw, &stream->listener, &asio_stream_events, stream);
+    stream->listener_added = true;
+    transport->stream = stream;
+
+    builder = SPA_POD_BUILDER_INIT(pod_buffer, sizeof(pod_buffer));
+    params[0] = spa_format_audio_raw_build(&builder, SPA_PARAM_EnumFormat, &info);
+    if (!params[0])
+    {
+        result = -EINVAL;
+        goto failed;
+    }
+
+    flags = PW_STREAM_FLAG_AUTOCONNECT | PW_STREAM_FLAG_MAP_BUFFERS
+            | PW_STREAM_FLAG_INACTIVE | PW_STREAM_FLAG_DONT_RECONNECT;
+    if (allow_rt_process())
+        flags |= PW_STREAM_FLAG_RT_PROCESS;
+    rc = pw_stream_connect(stream->pw, PW_DIRECTION_OUTPUT, PW_ID_ANY, flags, params, 1);
+    if (rc < 0)
+    {
+        result = asio_error(rc);
+        goto failed;
+    }
+    rc = pw_stream_set_active(stream->pw, true);
+    if (rc < 0)
+    {
+        result = asio_error(rc);
+        goto failed;
+    }
+    /* Preflight activates only PipeWire negotiation; started remains false, so
+     * the process callback emits silence and never consumes client PCM. */
+    stream->preflight_active = true;
+    result = wait_for_stream(transport, stream, true);
+    if (result < 0)
+        goto failed;
+    if (!verify_stream_ownership(stream))
+    {
+        result = -EPERM;
+        goto failed;
+    }
+    result = deactivate_stream_locked(stream, false);
+    if (result < 0)
+        goto failed;
+    return ASE_OK;
+
+failed:
+    stream_fail(stream, result);
+    destroy_stream_locked(transport);
+    return result;
+}
+
+static NTSTATUS asio_unix_open(void *args)
+{
+    struct asio_open_params *params = args;
+    struct asio_transport *transport;
+    int result;
+
+    if (!params)
+        return STATUS_INVALID_PARAMETER;
+    if (params->handle != ASIO_UNIX_ABI)
+    {
+        params->handle = 0;
+        params->result = ASE_InvalidParameter;
+        return STATUS_SUCCESS;
+    }
+    params->handle = 0;
+    params->result = ASE_NotPresent;
+    pthread_mutex_lock(&pipewire_init_mutex);
+    if (!set_pipewire_plugin_dirs())
+    {
+        pthread_mutex_unlock(&pipewire_init_mutex);
+        return STATUS_SUCCESS;
+    }
+    pw_init(NULL, NULL);
+    TRACE("PipeWire %s, header %s\n", pw_get_library_version(), pw_get_headers_version());
+    pthread_mutex_unlock(&pipewire_init_mutex);
+
+    transport = calloc(1, sizeof(*transport));
+    if (!transport)
+    {
+        pw_deinit();
+        params->result = ASE_NoMemory;
+        return STATUS_SUCCESS;
+    }
+    transport->loop = pw_thread_loop_new("protonasio", NULL);
+    if (!transport->loop)
+    {
+        result = asio_error(errno);
+        free(transport);
+        pw_deinit();
+        params->result = result;
+        return STATUS_SUCCESS;
+    }
+    transport->context = pw_context_new(pw_thread_loop_get_loop(transport->loop), NULL, 0);
+    if (!transport->context)
+    {
+        result = asio_error(errno);
+        pw_thread_loop_destroy(transport->loop);
+        free(transport);
+        pw_deinit();
+        params->result = result;
+        return STATUS_SUCCESS;
+    }
+    result = pw_thread_loop_start(transport->loop);
+    if (result < 0)
+    {
+        result = asio_error(result);
+        pw_context_destroy(transport->context);
+        pw_thread_loop_destroy(transport->loop);
+        free(transport);
+        pw_deinit();
+        params->result = result;
+        return STATUS_SUCCESS;
+    }
+
+    pw_thread_loop_lock(transport->loop);
+    transport->core = pw_context_connect(transport->context, NULL, 0);
+    if (!transport->core)
+    {
+        result = asio_error(errno);
+        pw_thread_loop_unlock(transport->loop);
+        pw_thread_loop_stop(transport->loop);
+        pw_context_destroy(transport->context);
+        pw_thread_loop_destroy(transport->loop);
+        free(transport);
+        pw_deinit();
+        params->result = result;
+        return STATUS_SUCCESS;
+    }
+    pw_core_add_listener(transport->core, &transport->core_listener,
+                         &asio_core_events, transport);
+    transport->core_listener_added = true;
+    transport->core_sync_seq = pw_core_sync(transport->core, PW_ID_CORE, 0);
+    if (transport->core_sync_seq < 0)
+        result = asio_error(transport->core_sync_seq);
+    else
+        result = wait_for_core(transport);
+    if (result < 0)
+    {
+        if (transport->core_listener_added)
+            spa_hook_remove(&transport->core_listener);
+        pw_core_disconnect(transport->core);
+        transport->core = NULL;
+        pw_thread_loop_unlock(transport->loop);
+        pw_thread_loop_stop(transport->loop);
+        pw_context_destroy(transport->context);
+        pw_thread_loop_destroy(transport->loop);
+        free(transport);
+        pw_deinit();
+        params->result = result;
+        return STATUS_SUCCESS;
+    }
+    pw_thread_loop_unlock(transport->loop);
+
+    params->handle = (UINT64)(UINT_PTR)transport;
+    params->result = ASIO_UNIX_ABI;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_close(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_transport *transport;
+
+    if (!params)
+        return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = ASE_InvalidParameter;
+    if (!transport)
+        return STATUS_SUCCESS;
+
+    if (transport->loop)
+        pw_thread_loop_lock(transport->loop);
+    destroy_stream_locked(transport);
+    if (transport->core)
+    {
+        if (transport->core_listener_added)
+            spa_hook_remove(&transport->core_listener);
+        pw_core_disconnect(transport->core);
+        transport->core = NULL;
+    }
+    if (transport->loop)
+        pw_thread_loop_unlock(transport->loop);
+    if (transport->loop)
+        pw_thread_loop_stop(transport->loop);
+    if (transport->context)
+        pw_context_destroy(transport->context);
+    if (transport->loop)
+        pw_thread_loop_destroy(transport->loop);
+    free(transport);
+    pw_deinit();
+    params->result = ASE_OK;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_create(void *args)
+{
+    struct asio_create_params *params = args;
+    struct asio_transport *transport;
+
+    if (!params)
+        return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = ASE_InvalidParameter;
+    if (!transport || !transport->loop)
+        return STATUS_SUCCESS;
+    pw_thread_loop_lock(transport->loop);
+    params->result = create_stream_locked(transport, params->rate, params->channels,
+                                          params->frames);
+    pw_thread_loop_unlock(transport->loop);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_destroy(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_transport *transport;
+
+    if (!params)
+        return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = ASE_InvalidParameter;
+    if (!transport || !transport->loop)
+        return STATUS_SUCCESS;
+    pw_thread_loop_lock(transport->loop);
+    destroy_stream_locked(transport);
+    pw_thread_loop_unlock(transport->loop);
+    params->result = ASE_OK;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_reset(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_transport *transport;
+    struct asio_stream *stream;
+
+    if (!params)
+        return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = ASE_InvalidParameter;
+    if (!transport || !transport->loop)
+        return STATUS_SUCCESS;
+    pw_thread_loop_lock(transport->loop);
+    stream = transport->stream;
+    if (!stream)
+        params->result = ASE_InvalidMode;
+    else
+        params->result = deactivate_stream_locked(stream, true);
+    pw_thread_loop_unlock(transport->loop);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_start(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_transport *transport;
+    struct asio_stream *stream;
+    int result;
+
+    if (!params)
+        return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = ASE_InvalidParameter;
+    if (!transport || !transport->loop)
+        return STATUS_SUCCESS;
+    pw_thread_loop_lock(transport->loop);
+    stream = transport->stream;
+    if (!stream)
+        result = ASE_InvalidMode;
+    else if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+        result = __atomic_load_n(&stream->error, __ATOMIC_ACQUIRE);
+    else if (__atomic_load_n(&stream->started, __ATOMIC_ACQUIRE))
+        result = ASE_InvalidMode;
+    else
+    {
+        asio_clock_reset(&stream->clock);
+        drain_stream_events(stream);
+        __atomic_store_n(&stream->stopped, 0, __ATOMIC_RELEASE);
+        __atomic_store_n(&stream->started, 1, __ATOMIC_RELEASE);
+        result = pw_stream_set_active(stream->pw, true);
+        if (result < 0)
+        {
+            __atomic_store_n(&stream->started, 0, __ATOMIC_RELEASE);
+            __atomic_store_n(&stream->stopped, 1, __ATOMIC_RELEASE);
+            result = asio_error(result);
+        }
+    }
+    pw_thread_loop_unlock(transport->loop);
+    if (result == ASE_OK)
+    {
+        result = wait_for_first_clock(stream);
+        if (result < 0)
+        {
+            int stop_result;
+
+            pw_thread_loop_lock(transport->loop);
+            stop_result = deactivate_stream_locked(stream, false);
+            pw_thread_loop_unlock(transport->loop);
+            if (stop_result < 0)
+                result = stop_result;
+        }
+    }
+    params->result = result;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_stop(void *args)
+{
+    struct asio_handle_params *params = args;
+    struct asio_transport *transport;
+    struct asio_stream *stream;
+    int result = ASE_OK;
+
+    if (!params)
+        return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = ASE_InvalidParameter;
+    if (!transport || !transport->loop)
+        return STATUS_SUCCESS;
+    pw_thread_loop_lock(transport->loop);
+    stream = transport->stream;
+    if (!stream)
+        result = ASE_InvalidMode;
+    else
+        result = deactivate_stream_locked(stream, false);
+    pw_thread_loop_unlock(transport->loop);
+    params->result = result;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_wait(void *args)
+{
+    struct asio_wait_params *params = args;
+    struct asio_transport *transport;
+    struct asio_stream *stream;
+    struct pollfd pollfd;
+    uint64_t value;
+    struct asio_clock_value timing;
+    UINT64 ns, output, latency, delta, now, period_ns, remaining_ns;
+    UINT64 generation, id;
+    struct timespec wait_time;
+    ssize_t count;
+    int result;
+
+    if (!params) return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = -1;
+    if (!transport || !(stream = transport->stream)) return STATUS_SUCCESS;
+    period_ns = mul_mul_div_u64(stream->frames, 1000000000ull, 1, stream->rate);
+    for (;;)
+    {
+        if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+        {
+            params->result = __atomic_load_n(&stream->error, __ATOMIC_ACQUIRE);
+            return STATUS_SUCCESS;
+        }
+        if (!__atomic_load_n(&stream->started, __ATOMIC_ACQUIRE)
+                || __atomic_load_n(&stream->stopped, __ATOMIC_ACQUIRE))
+        {
+            params->result = 0;
+            return STATUS_SUCCESS;
+        }
+        id = stream->next_block;
+        if (!asio_queue_next_block(&stream->queue, id, &id)) return STATUS_SUCCESS;
+        stream->next_block = id;
+        generation = __atomic_load_n(&stream->generation, __ATOMIC_ACQUIRE);
+        if (asio_clock_reserve(&stream->clock, id, stream->frames, &timing))
+        {
+            if (!asio_queue_block_position(&stream->queue, id, &output))
+                return STATUS_SUCCESS;
+            ns = timing.nanoseconds;
+            latency = add_u64(stream_software_latency(stream), timing.backend);
+            /* Translate the observed P span once; both API views use this ticket. */
+            delta = add_u64(timing.position, latency);
+            if (delta == UINT64_MAX || latency > MAXLONG
+                    || !audio_presentation_time_at(delta, ns, output, stream->rate, &value))
+                return STATUS_SUCCESS;
+            ns = value;
+
+            now = raw_ns();
+            if (!now)
+            {
+                stream_fail(stream, -EIO);
+                return STATUS_SUCCESS;
+            }
+            /* id0 is the prefill write; its timestamp is one B early and has no host callback. */
+            if (!id || now >= ns)
+            {
+                struct asio_clock_value latest;
+
+                /* Stop, failure, generation, clock and consumed-PCM changes cancel this reservation. */
+                if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE)
+                        || !__atomic_load_n(&stream->started, __ATOMIC_ACQUIRE)
+                        || __atomic_load_n(&stream->stopped, __ATOMIC_ACQUIRE)
+                        || generation != __atomic_load_n(&stream->generation, __ATOMIC_ACQUIRE)
+                        || !asio_clock_reserve(&stream->clock, id, stream->frames, &latest))
+                    continue;
+                if (latest.position != timing.position || latest.nanoseconds != timing.nanoseconds
+                        || latest.backend != timing.backend
+                        || latest.callback_end != timing.callback_end)
+                    continue;
+
+                now = raw_ns();
+                if (!now)
+                {
+                    stream_fail(stream, -EIO);
+                    return STATUS_SUCCESS;
+                }
+                if (id && (now < ns || period_ns == UINT64_MAX || now - ns >= period_ns))
+                {
+                    if (now < ns) continue;
+                    ++stream->next_block;
+                    continue;
+                }
+                if (__atomic_load_n(&stream->queue.deadline_position, __ATOMIC_ACQUIRE) > output)
+                {
+                    ++stream->next_block;
+                    continue;
+                }
+                if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE)
+                        || !__atomic_load_n(&stream->started, __ATOMIC_ACQUIRE)
+                        || __atomic_load_n(&stream->stopped, __ATOMIC_ACQUIRE)
+                        || generation != __atomic_load_n(&stream->generation, __ATOMIC_ACQUIRE))
+                    continue;
+                params->ticket.generation = generation;
+                params->ticket.id = id;
+                params->ticket.position = id ? (id - 1) * stream->frames : 0;
+                params->ticket.nanoseconds = ns;
+                params->ticket.latency = latency;
+                params->ticket.clock_position = timing.position;
+                params->result = 1;
+                return STATUS_SUCCESS;
+            }
+            remaining_ns = ns - now;
+            wait_time.tv_sec = remaining_ns / 1000000000ull;
+            wait_time.tv_nsec = remaining_ns % 1000000000ull;
+            pollfd.fd = stream->event_fd;
+            pollfd.events = POLLIN;
+            pollfd.revents = 0;
+            result = ppoll(&pollfd, 1, &wait_time, NULL);
+            if (!result)
+                continue;
+        }
+        else
+        {
+            pollfd.fd = stream->event_fd;
+            pollfd.events = POLLIN;
+            pollfd.revents = 0;
+            result = poll(&pollfd, 1, 1000);
+            if (!result)
+            {
+                stream_fail(stream, -ETIMEDOUT);
+                return STATUS_SUCCESS;
+            }
+        }
+        if (result < 0)
+        {
+            if (errno == EINTR) continue;
+            return STATUS_SUCCESS;
+        }
+        if (pollfd.revents & (POLLERR | POLLHUP | POLLNVAL)) return STATUS_SUCCESS;
+        do count = read(stream->event_fd, &value, sizeof(value));
+        while (count < 0 && errno == EINTR);
+        if (count < 0 && errno != EAGAIN) return STATUS_SUCCESS;
+    }
+}
+
+static NTSTATUS asio_unix_write(void *args)
+{
+    struct asio_write_params *params = args;
+    struct asio_transport *transport;
+    struct asio_stream *stream;
+    enum asio_commit_result result;
+
+    if (!params) return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->result = ASE_InvalidParameter;
+    if (!transport || !(stream = transport->stream)) return STATUS_SUCCESS;
+    __atomic_add_fetch(&stream->write_inflight, 1, __ATOMIC_ACQ_REL);
+    if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE)
+            || __atomic_load_n(&stream->stopped, __ATOMIC_ACQUIRE))
+    {
+        params->result = ASE_HWMalfunction;
+        goto done;
+    }
+    if (params->frames != stream->frames || params->id != stream->next_block) goto done;
+    result = asio_queue_commit(&stream->queue, params->generation, params->id, params->data);
+    if (result == ASIO_COMMITTED)
+    {
+        ++stream->next_block;
+        params->result = ASE_OK;
+    }
+    else if (result == ASIO_LATE)
+    {
+        /* Late PCM must not be replayed; the next reservation follows the live clock. */
+        ++stream->next_block;
+        params->result = ASIO_WRITE_DROPPED;
+    }
+    else params->result = ASE_HWMalfunction;
+done:
+    __atomic_sub_fetch(&stream->write_inflight, 1, __ATOMIC_RELEASE);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS asio_unix_timing(void *args)
+{
+    struct asio_timing_params *params = args;
+    struct asio_transport *transport;
+    struct asio_stream *stream;
+    struct asio_clock_value timing;
+
+    if (!params) return STATUS_INVALID_PARAMETER;
+    transport = transport_from_handle(params->handle);
+    params->latency = 0;
+    params->result = ASE_InvalidParameter;
+    if (!transport || !transport->loop) return STATUS_SUCCESS;
+    pw_thread_loop_lock(transport->loop);
+    stream = transport->stream;
+    if (!stream) params->result = ASE_InvalidMode;
+    else if (__atomic_load_n(&stream->failed, __ATOMIC_ACQUIRE))
+        params->result = ASE_HWMalfunction;
+    else
+    {
+        params->latency = stream_software_latency(stream);
+        if (asio_clock_read(&stream->clock, &timing)) params->latency += timing.backend;
+        params->result = ASE_OK;
+    }
+    pw_thread_loop_unlock(transport->loop);
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    asio_unix_open,
+    asio_unix_close,
+    asio_unix_create,
+    asio_unix_destroy,
+    asio_unix_start,
+    asio_unix_stop,
+    asio_unix_wait,
+    asio_unix_write,
+    asio_unix_timing,
+    asio_unix_reset,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == asio_calls_count);

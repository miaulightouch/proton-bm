+static void test_exclusive_contention(IASIO *active,
+        dll_get_class_object_proc get_class_object, LONG output_channels)
+{
+    IClassFactory *factory = NULL;
+    IASIO *contender = NULL;
+    ASIOBufferInfo *infos = NULL;
+    HRESULT hr;
+    LONG error, i;
+    BOOL buffers_created = FALSE;
+
+    if (!active || !get_class_object || output_channels <= 0)
+        return;
+    hr = get_class_object(&CLSID_ProtonASIO, &IID_IClassFactory, (void **)&factory);
+    ok(hr == S_OK, "Exclusive contention factory failed: %#lx.\n", hr);
+    if (FAILED(hr))
+        return;
+    hr = IClassFactory_CreateInstance(factory, NULL, &CLSID_ProtonASIO, (void **)&contender);
+    IClassFactory_Release(factory);
+    ok(hr == S_OK, "Exclusive contention instance failed: %#lx.\n", hr);
+    if (FAILED(hr))
+        return;
+    if (!contender->lpVtbl->init(contender, NULL))
+    {
+        skip("Exclusive contention instance could not open PipeWire.\n");
+        goto done;
+    }
+    infos = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY,
+            output_channels * sizeof(*infos));
+    ok(infos != NULL, "Could not allocate exclusive contention buffers.\n");
+    if (!infos)
+        goto done;
+    for (i = 0; i < output_channels; ++i)
+    {
+        infos[i].channelNum = i;
+        infos[i].isInput = FALSE;
+    }
+    error = contender->lpVtbl->createBuffers(contender, infos, output_channels, 256,
+            &callbacks_without_time_info);
+    ok(is_hardware_unavailable(error),
+            "Second ASIO client was not rejected by exclusive ownership: %ld.\n", error);
+    if (error == ASE_OK)
+        buffers_created = TRUE;
+
+done:
+    if (buffers_created)
+    {
+        error = contender->lpVtbl->disposeBuffers(contender);
+        ok(error == ASE_OK || error == ASE_InvalidMode,
+                "Exclusive contention cleanup DisposeBuffers returned %ld.\n", error);
+    }
+    if (contender)
+        contender->lpVtbl->Release(contender);
+    HeapFree(GetProcessHeap(), 0, infos);
+}

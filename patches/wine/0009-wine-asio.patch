+static void test_late_recovery(void)
+{
+    struct asio_deadline_queue queue;
+    struct asio_render_result result;
+    uint32_t input[4], output[8];
+    uint64_t id, ns;
+
+    ok(asio_queue_init(&queue, 4, sizeof(*input), 4), "Queue initialization failed.\n");
+    asio_queue_reset(&queue, 7, 0);
+    fill(input, 4, 1);
+    ok(asio_queue_commit(&queue, 7, 0, input) == ASIO_COMMITTED, "Initial commit failed.\n");
+    ok(asio_queue_render(&queue, output, 6, &result), "Stalled producer render failed.\n");
+    ok(asio_queue_commit(&queue, 7, 1, input) == ASIO_LATE, "Late PCM was published.\n");
+    ok(queue.write_index == 1 && queue.last_committed == 0, "Late PCM changed the FIFO.\n");
+    ok(asio_queue_next_block(&queue, 1, &id) && id == 2, "Recovery did not skip the partial block.\n");
+    fill(input, 4, 9);
+    ok(asio_queue_commit(&queue, 7, id, input) == ASIO_COMMITTED, "Recovery commit failed.\n");
+    ok(asio_queue_render(&queue, output, 6, &result), "Recovery render failed.\n");
+    check_samples(output, 2, 0);
+    check_samples(output + 2, 4, 9);
+    ok(result.copied_frames == 4 && result.silent_frames == 2 && queue.generation == 7,
+       "Recovery replayed stale PCM or reset the stream.\n");
+    ok(audio_presentation_time_at(6, 1000000000, 8, 48000, &ns) && ns > 1000000000,
+       "Recovery timestamp did not follow the actual sample position.\n");
+    ok(asio_queue_next_block(&queue, 3, &id) && id == 3, "Exact deadline skipped a valid block.\n");
+    ok(asio_queue_next_block(&queue, 5, &id) && id == 5, "Recovery moved the producer backward.\n");
+    asio_queue_reset(&queue, 8, 3);
+    ok(asio_queue_render(&queue, output, 6, &result), "Offset-origin render failed.\n");
+    ok(asio_queue_next_block(&queue, 0, &id) && id == 1, "Recovery ignored the queue origin.\n");
+    queue.deadline_position = 1000003;
+    ok(asio_queue_next_block(&queue, 1, &id) && id == 250000, "Long stall was not coalesced.\n");
+    queue.deadline_position = UINT64_MAX;
+    ok(!asio_queue_next_block(&queue, 1, &id), "Recovery accepted position overflow.\n");
+    asio_queue_destroy(&queue);
+}
+
+static void test_origin_wrap_and_generation(void)
+{
+    struct asio_deadline_queue queue;
+    struct asio_render_result result;
+    uint32_t input[4], output[16];
+    uint64_t pos;
+    unsigned i, batch;
+
+    ok(asio_queue_init(&queue, 4, sizeof(*input), 4), "Queue initialization failed.\n");
+    asio_queue_reset(&queue, 3, 3);
+    for (i = 0; i < 4; ++i)
+    {
+        fill(input, 4, i * 4 + 1);
+        ok(asio_queue_commit(&queue, 3, i, input) == ASIO_COMMITTED, "Commit %u failed.\n", i);
+    }
+    ok(asio_queue_commit(&queue, 3, 4, input) == ASIO_QUEUE_FULL, "Full queue accepted data.\n");
+    ok(asio_queue_render(&queue, output, 3, &result), "Startup render failed.\n");
+    check_samples(output, 3, 0);
+    ok(result.silent_frames == 3 && !result.missed_blocks, "Startup charged as underrun.\n");
+    ok(asio_queue_render(&queue, output, 16, &result), "Batched render failed.\n");
+    check_samples(output, 16, 1);
+    for (batch = 1; batch < 12; ++batch)
+    {
+        for (i = 0; i < 4; ++i)
+        {
+            fill(input, 4, (batch * 4 + i) * 4 + 1);
+            ok(asio_queue_commit(&queue, 3, batch * 4 + i, input) == ASIO_COMMITTED,
+               "Wrapped commit failed.\n");
+        }
+        ok(asio_queue_render(&queue, output, 16, &result), "Wrapped render failed.\n");
+        check_samples(output, 16, batch * 16 + 1);
+    }
+    asio_queue_reset(&queue, 4, 0);
+    ok(asio_queue_commit(&queue, 3, 0, input) == ASIO_QUEUE_INVALID, "Stale generation accepted.\n");
+    fill(input, 4, 1);
+    ok(asio_queue_commit(&queue, 4, 0, input) == ASIO_COMMITTED, "Reset commit failed.\n");
+    ok(asio_queue_commit(&queue, 4, 0, input) == ASIO_QUEUE_INVALID, "Duplicate id accepted.\n");
+    ok(!asio_queue_block_position(&queue, UINT64_MAX, &pos), "Position overflow accepted.\n");
+    ok(asio_queue_render(&queue, output, 4, &result), "Reset render failed.\n");
+    check_samples(output, 4, 1);
+    asio_queue_destroy(&queue);
+}
+
+START_TEST(timeline)
+{
+    test_presentation();
+    test_callback_periods();
+    test_one_native_period_lead();
+    test_clock_publication();
+    test_ticket_lifecycle();
+    test_ticket_time();
+    test_partial_and_late();
+    test_late_recovery();
+    test_origin_wrap_and_generation();
+}
+#else
+START_TEST(timeline)
+{
+    win_skip("The ASIO driver is x64 only.\n");
+}
+#endif
diff --git a/dlls/protonasio/timeline.c b/dlls/protonasio/timeline.c
new file mode 100644
--- /dev/null
+++ b/dlls/protonasio/timeline.c
@@ -0,0 +1,239 @@
+/* ASIO deadline queue. LGPL-2.1-or-later. */
+#if 0
+#pragma makedep unix
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+#include "timeline.h"
+
+void asio_clock_reset(struct asio_clock *clock)
+{
+    struct asio_clock_value empty = {0};
+
+    __atomic_store_n(&clock->valid, 0, __ATOMIC_RELEASE);
+    asio_clock_publish(clock, &empty);
+}
+
+/* Publish only after the native buffer containing this span was queued. */
+void asio_clock_publish(struct asio_clock *clock, const struct asio_clock_value *value)
+{
+    __atomic_add_fetch(&clock->sequence, 1, __ATOMIC_ACQ_REL);
+    __atomic_store_n(&clock->value.position, value->position, __ATOMIC_RELAXED);
+    __atomic_store_n(&clock->value.nanoseconds, value->nanoseconds, __ATOMIC_RELAXED);
+    __atomic_store_n(&clock->value.backend, value->backend, __ATOMIC_RELAXED);
+    __atomic_store_n(&clock->value.callback_end, value->callback_end, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&clock->sequence, 1, __ATOMIC_RELEASE);
+    __atomic_store_n(&clock->valid, value->nanoseconds != 0, __ATOMIC_RELEASE);
+}
+
+bool asio_clock_read(const struct asio_clock *clock, struct asio_clock_value *value)
+{
+    uint64_t before, after;
+    unsigned tries;
+
+    for (tries = 0; tries < 8; ++tries)
+    {
+        if (!__atomic_load_n(&clock->valid, __ATOMIC_ACQUIRE)) return false;
+        before = __atomic_load_n(&clock->sequence, __ATOMIC_ACQUIRE);
+        if (before & 1) continue;
+        value->position = __atomic_load_n(&clock->value.position, __ATOMIC_RELAXED);
+        value->nanoseconds = __atomic_load_n(&clock->value.nanoseconds, __ATOMIC_RELAXED);
+        value->backend = __atomic_load_n(&clock->value.backend, __ATOMIC_RELAXED);
+        value->callback_end = __atomic_load_n(&clock->value.callback_end, __ATOMIC_RELAXED);
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        after = __atomic_load_n(&clock->sequence, __ATOMIC_ACQUIRE);
+        if (before == after && !(after & 1)
+                && __atomic_load_n(&clock->valid, __ATOMIC_ACQUIRE)) return true;
+    }
+    return false;
+}
+
+bool asio_clock_reserve(const struct asio_clock *clock, uint64_t id, uint32_t frames,
+                         struct asio_clock_value *value)
+{
+    return asio_clock_read(clock, value) && asio_block_due(id, value->callback_end, frames);
+}
+
+bool asio_queue_init(struct asio_deadline_queue *queue, uint32_t frames,
+                     uint32_t frame_bytes, uint32_t slots)
+{
+    size_t bytes, count = slots;
+
+    memset(queue, 0, sizeof(*queue));
+    if (!frames || !frame_bytes || slots < 2 || frames > SIZE_MAX / frame_bytes)
+        return false;
+    bytes = (size_t)frames * frame_bytes;
+    if (count > SIZE_MAX / bytes || count > SIZE_MAX / sizeof(*queue->ids))
+        return false;
+    if (!(queue->data = malloc(bytes * slots))) return false;
+    if (!(queue->ids = malloc(sizeof(*queue->ids) * slots)))
+    {
+        free(queue->data);
+        queue->data = NULL;
+        return false;
+    }
+    queue->block_frames = frames;
+    queue->frame_bytes = frame_bytes;
+    queue->block_bytes = bytes;
+    queue->slots = slots;
+    queue->current_block = UINT64_MAX;
+    return true;
+}
+
+/* Reset and destruction require both owners to be quiescent. */
+void asio_queue_reset(struct asio_deadline_queue *queue, uint64_t generation, uint64_t origin)
+{
+    queue->generation = generation;
+    queue->origin = origin;
+    queue->write_index = queue->read_index = 0;
+    queue->play_position = queue->deadline_position = queue->callback_end = 0;
+    queue->current_block = UINT64_MAX;
+    queue->last_committed = 0;
+    queue->block_missed = queue->have_committed = false;
+}
+
+void asio_queue_destroy(struct asio_deadline_queue *queue)
+{
+    free(queue->data);
+    free(queue->ids);
+    memset(queue, 0, sizeof(*queue));
+}
+
+/* One callback for each ASIO period covered by the current graph submission. */
+bool asio_block_due(uint64_t id, uint64_t end, uint32_t block_frames)
+{
+    return block_frames && end && (!id || id - 1 <= (end - 1) / block_frames);
+}
+
+bool asio_queue_block_position(const struct asio_deadline_queue *queue, uint64_t id,
+                               uint64_t *position)
+{
+    if (!queue->block_frames || id > (UINT64_MAX - queue->origin) / queue->block_frames)
+        return false;
+    *position = queue->origin + id * queue->block_frames;
+    return *position <= UINT64_MAX - queue->block_frames;
+}
+
+bool asio_queue_next_block(const struct asio_deadline_queue *queue, uint64_t id, uint64_t *next)
+{
+    uint64_t deadline, elapsed, first;
+
+    if (!queue->block_frames) return false;
+    deadline = __atomic_load_n(&queue->deadline_position, __ATOMIC_ACQUIRE);
+    if (deadline > queue->origin)
+    {
+        elapsed = deadline - queue->origin;
+        first = elapsed / queue->block_frames + !!(elapsed % queue->block_frames);
+        if (id < first) id = first;
+    }
+    if (!asio_queue_block_position(queue, id, &first)) return false;
+    *next = id;
+    return true;
+}
+
+/* One Windows worker produces complete blocks. The release publishes PCM and id together. */
+enum asio_commit_result asio_queue_commit(struct asio_deadline_queue *queue, uint64_t generation,
+                                           uint64_t id, const void *data)
+{
+    uint64_t first, read, write;
+    size_t slot;
+
+    if (!data || generation != queue->generation || !generation || !queue->slots ||
+        !asio_queue_block_position(queue, id, &first) ||
+        (queue->have_committed && id <= queue->last_committed))
+        return ASIO_QUEUE_INVALID;
+    if (first < __atomic_load_n(&queue->deadline_position, __ATOMIC_ACQUIRE))
+        return ASIO_LATE;
+    write = __atomic_load_n(&queue->write_index, __ATOMIC_RELAXED);
+    read = __atomic_load_n(&queue->read_index, __ATOMIC_ACQUIRE);
+    if (write - read > queue->slots) return ASIO_QUEUE_INVALID;
+    if (write - read == queue->slots) return ASIO_QUEUE_FULL;
+    slot = write % queue->slots;
+    memcpy(queue->data + slot * queue->block_bytes, data, queue->block_bytes);
+    queue->ids[slot] = id;
+    if (first < __atomic_load_n(&queue->deadline_position, __ATOMIC_ACQUIRE))
+        return ASIO_LATE;
+    queue->last_committed = id;
+    queue->have_committed = true;
+    __atomic_store_n(&queue->write_index, write + 1, __ATOMIC_RELEASE);
+    return ASIO_COMMITTED;
+}
+
+/* A raced late publication stays in the FIFO until the consumer retires its id. */
+bool asio_queue_render(struct asio_deadline_queue *queue, void *output, uint32_t frames,
+                       struct asio_render_result *result)
+{
+    unsigned char *dest = output;
+    uint64_t position, end, block, read, write, id, lead, ahead;
+    uint32_t remaining = frames, take, offset;
+    size_t slot;
+
+    memset(result, 0, sizeof(*result));
+    if (!queue->slots || !output || !frames ||
+        frames > (uint64_t)queue->slots * queue->block_frames)
+        return false;
+    position = __atomic_load_n(&queue->play_position, __ATOMIC_RELAXED);
+    if (position > UINT64_MAX - frames) return false;
+    end = position + frames;
+    if (queue->origin > UINT64_MAX - queue->block_frames) return false;
+    lead = queue->origin + queue->block_frames;
+    ahead = frames > lead ? frames - lead : 0;
+    if (end > UINT64_MAX - ahead) return false;
+    __atomic_store_n(&queue->deadline_position, end, __ATOMIC_RELEASE);
+    /* A forced larger graph period may exceed the initial software lead. */
+    __atomic_store_n(&queue->callback_end, end + ahead, __ATOMIC_RELEASE);
+    while (remaining)
+    {
+        if (position < queue->origin)
+        {
+            take = queue->origin - position < remaining ? queue->origin - position : remaining;
+            memset(dest, 0, (size_t)take * queue->frame_bytes);
+            result->silent_frames += take;
+        }
+        else
+        {
+            block = (position - queue->origin) / queue->block_frames;
+            offset = (position - queue->origin) % queue->block_frames;
+            take = queue->block_frames - offset;
+            if (take > remaining) take = remaining;
+            if (queue->current_block != block)
+            {
+                queue->current_block = block;
+                queue->block_missed = false;
+            }
+            read = __atomic_load_n(&queue->read_index, __ATOMIC_RELAXED);
+            write = __atomic_load_n(&queue->write_index, __ATOMIC_ACQUIRE);
+            if (write - read > queue->slots) return false;
+            while (read != write)
+            {
+                id = queue->ids[read % queue->slots];
+                if (id > block || (id == block && !queue->block_missed)) break;
+                ++read;
+                ++result->discarded_blocks;
+                __atomic_store_n(&queue->read_index, read, __ATOMIC_RELEASE);
+            }
+            if (read != write && queue->ids[read % queue->slots] == block && !queue->block_missed)
+            {
+                slot = read % queue->slots;
+                memcpy(dest, queue->data + slot * queue->block_bytes +
+                       (size_t)offset * queue->frame_bytes, (size_t)take * queue->frame_bytes);
+                result->copied_frames += take;
+                if (offset + take == queue->block_frames)
+                    __atomic_store_n(&queue->read_index, read + 1, __ATOMIC_RELEASE);
+            }
+            else
+            {
+                memset(dest, 0, (size_t)take * queue->frame_bytes);
+                result->silent_frames += take;
+                if (!queue->block_missed) ++result->missed_blocks;
+                queue->block_missed = true;
+            }
+        }
+        remaining -= take;
+        position += take;
+        dest += (size_t)take * queue->frame_bytes;
+    }
+    __atomic_store_n(&queue->play_position, end, __ATOMIC_RELEASE);
+    return true;
+}
diff --git a/dlls/protonasio/timeline.h b/dlls/protonasio/timeline.h
new file mode 100644
--- /dev/null
+++ b/dlls/protonasio/timeline.h
@@ -0,0 +1,78 @@
+/* ASIO deadline queue. LGPL-2.1-or-later. */
+#ifndef PROTONASIO_TIMELINE_H
+#define PROTONASIO_TIMELINE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+
+enum asio_commit_result { ASIO_COMMITTED, ASIO_LATE, ASIO_QUEUE_FULL, ASIO_QUEUE_INVALID };
+
+struct asio_deadline_queue
+{
+    unsigned char *data;
+    uint64_t *ids;
+    uint32_t block_frames, frame_bytes, slots;
+    size_t block_bytes;
+    uint64_t origin, generation;
+    uint64_t write_index, read_index;
+    uint64_t play_position, deadline_position, callback_end;
+    uint64_t current_block, last_committed;
+    bool block_missed, have_committed;
+};
+
+struct asio_render_result
+{
+    uint64_t copied_frames, silent_frames, discarded_blocks, missed_blocks;
+};
+
+struct asio_clock_value
+{
+    uint64_t position, nanoseconds, backend, callback_end;
+};
+
+struct asio_clock
+{
+    uint64_t sequence;
+    struct asio_clock_value value;
+    int valid;
+};
+
+struct asio_time_state
+{
+    uint64_t last_valid, invalid_span;
+    bool invalid;
+};
+
+/* A new native span must restore time; later tickets from a rejected batch cannot. */
+static inline bool asio_time_validate(struct asio_time_state *state, uint64_t span,
+                                     uint64_t nanoseconds)
+{
+    if (nanoseconds <= state->last_valid || (state->invalid && span == state->invalid_span))
+    {
+        state->invalid = true;
+        state->invalid_span = span;
+        return false;
+    }
+    state->last_valid = nanoseconds;
+    state->invalid = false;
+    return true;
+}
+
+void asio_clock_reset(struct asio_clock *);
+void asio_clock_publish(struct asio_clock *, const struct asio_clock_value *);
+bool asio_clock_read(const struct asio_clock *, struct asio_clock_value *);
+bool asio_clock_reserve(const struct asio_clock *, uint64_t, uint32_t, struct asio_clock_value *);
+
+bool asio_queue_init(struct asio_deadline_queue *, uint32_t, uint32_t, uint32_t);
+void asio_queue_destroy(struct asio_deadline_queue *);
+void asio_queue_reset(struct asio_deadline_queue *, uint64_t, uint64_t);
+bool asio_block_due(uint64_t, uint64_t, uint32_t);
+bool asio_queue_block_position(const struct asio_deadline_queue *, uint64_t, uint64_t *);
+bool asio_queue_next_block(const struct asio_deadline_queue *, uint64_t, uint64_t *);
+enum asio_commit_result asio_queue_commit(struct asio_deadline_queue *, uint64_t, uint64_t,
+                                           const void *);
+bool asio_queue_render(struct asio_deadline_queue *, void *, uint32_t,
+                       struct asio_render_result *);
+
+#endif

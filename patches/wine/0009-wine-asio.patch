+/* ASIO deadline queue regressions. LGPL-2.1-or-later. */
+#include <stdint.h>
+#include <string.h>
+#include "wine/test.h"
+
+#ifdef _WIN64
+#include "../timeline.c"
+#include "wine/audio_presentation.h"
+
+static void test_presentation(void)
+{
+    uint64_t first, second, ns;
+
+    ok(audio_presentation_first_ns(1000000000, 0, 0, 0, 1, 48000, 48000, &first)
+       && first == 1000000000, "Current buffer was added to first-sample time.\n");
+    ok(audio_presentation_first_ns(1000000000, 256, 0, 0, 1, 48000, 48000, &second)
+       && second == 1005333333, "Prior queued span was not counted once.\n");
+    ok(audio_presentation_time_at(0, first, 256, 48000, &ns) && ns == second,
+       "Same-tick spans do not meet.\n");
+    ok(audio_presentation_first_ns(1000000000, 1, 1, 0, 1, 48000, 44100, &ns)
+       && ns == 1000045351, "Stream-frame rounding was applied twice.\n");
+    ok(audio_presentation_first_ns(1000000000, 0, 0, -480, 1, 48000, 48000, &ns)
+       && ns == 990000000, "Signed graph delay lost its sign.\n");
+    ok(audio_presentation_first_ns(1000000000, 441, 0, 480, 1, 48000, 44100, &ns)
+       && ns == 1020000000, "Graph and stream rate domains were mixed.\n");
+    ok(audio_presentation_time_at(5760000, 119988001200ULL, 5764800, 48000, &ns)
+       && ns == 120088001200ULL, "Observed drift was replaced by nominal start time.\n");
+    ok(audio_presentation_time_at(48000, 1001000000, 47520, 48000, &ns)
+       && ns == 991000000, "Backward projection failed.\n");
+    ok(!audio_presentation_first_ns(0, 0, 0, 0, 1, 48000, 48000, &ns), "Zero clock accepted.\n");
+    ok(!audio_presentation_first_ns(1, 0, 0, 0, 0, 48000, 48000, &ns), "Zero period accepted.\n");
+    ok(!audio_presentation_first_ns(1, UINT64_MAX, UINT64_MAX, 0, 1, 1, 1, &ns), "Overflow accepted.\n");
+    ok(!audio_presentation_first_ns(1, 0, 0, INT64_MIN, UINT32_MAX, 1, 1, &ns), "Underflow accepted.\n");
+    ok(!audio_presentation_time_at(0, UINT64_MAX, 1, 48000, &ns), "Timestamp overflow accepted.\n");
+    ok(!audio_presentation_time_at(1, 1, 0, 48000, &ns), "Timestamp underflow accepted.\n");
+    ok(!audio_presentation_time_at(0, 1, 0, 0, &ns), "Zero rate accepted.\n");
+}
+
+static void fill(uint32_t *data, unsigned count, unsigned first)
+{
+    unsigned i;
+    for (i = 0; i < count; ++i) data[i] = first + i;
+}
+
+static void check_samples(const uint32_t *data, unsigned count, unsigned first)
+{
+    unsigned i;
+    for (i = 0; i < count; ++i)
+        ok(data[i] == (first ? first + i : 0), "Sample %u got %u, expected %u.\n",
+           i, data[i], first ? first + i : 0);
+}

+static void test_callback_periods(void)
+{
+    struct asio_deadline_queue queue;
+    struct asio_render_result rendered;
+    unsigned char output[2048], block[256] = {1};
+    unsigned end, id;
+
+    ok(asio_queue_init(&queue, 1024, 1, 8), "Queue initialization failed.\n");
+    asio_queue_reset(&queue, 1, 256);
+    ok(!asio_block_due(0, queue.callback_end, queue.block_frames), "Prefill escaped before the first graph clock.\n");
+    /* Q256/B1024 starts callback0 immediately, then waits one full ASIO period. */
+    for (end = 256; end <= 1024; end += 256)
+    {
+        ok(asio_queue_render(&queue, output, 256, &rendered), "Small graph render failed.\n");
+        ok(asio_block_due(0, queue.callback_end, queue.block_frames), "Initial prefill was delayed at %u.\n", end);
+        ok(asio_block_due(1, queue.callback_end, queue.block_frames), "Callback0 was delayed at %u.\n", end);
+        ok(!asio_block_due(2, queue.callback_end, queue.block_frames), "Callback1 was early at %u.\n", end);
+    }
+    ok(asio_queue_render(&queue, output, 256, &rendered), "Small graph render failed.\n");
+    ok(asio_block_due(2, queue.callback_end, queue.block_frames), "Callback1 missed its first graph span.\n");
+    ok(!asio_block_due(3, queue.callback_end, queue.block_frames), "Callback2 was early.\n");
+    asio_queue_destroy(&queue);
+
+    ok(asio_queue_init(&queue, 256, 1, 8), "Queue initialization failed.\n");
+    asio_queue_reset(&queue, 2, 1024);
+    /* Q1024/B256 reserves exactly four callbacks per graph period, plus prefill. */
+    ok(asio_queue_render(&queue, output, 1024, &rendered), "Large graph render failed.\n");
+    for (id = 0; id <= 4; ++id)
+        ok(asio_block_due(id, queue.callback_end, queue.block_frames), "Batched callback %u was delayed.\n", id);
+    ok(!asio_block_due(5, queue.callback_end, queue.block_frames), "Next graph period was reserved early.\n");
+    ok(asio_queue_render(&queue, output, 1024, &rendered), "Large graph render failed.\n");
+    for (id = 5; id <= 8; ++id)
+        ok(asio_block_due(id, queue.callback_end, queue.block_frames), "Second batch %u was delayed.\n", id);
+    ok(!asio_block_due(9, queue.callback_end, queue.block_frames), "Third graph period was reserved early.\n");
+    ok(!asio_block_due(UINT64_MAX, queue.callback_end, queue.block_frames), "Overflowed callback ID became due.\n");
+
+    /* After forced Q256→1024, one recovery batch must cover every following graph span. */
+    asio_queue_reset(&queue, 3, 256);
+    ok(asio_queue_render(&queue, output, 1024, &rendered), "Changed quantum render failed.\n");
+    for (id = 0; asio_block_due(id, queue.callback_end, queue.block_frames); ++id)
+    {
+        enum asio_commit_result result = asio_queue_commit(&queue, 3, id, block);
+        ok(result == ASIO_COMMITTED || result == ASIO_LATE, "Recovery commit failed.\n");
+    }
+    ok(asio_queue_render(&queue, output, 1024, &rendered), "Recovered quantum render failed.\n");
+    ok(rendered.copied_frames == 1024 && !rendered.silent_frames,
+       "Larger quantum retained a permanent supply deficit.\n");
+    asio_queue_destroy(&queue);
+}
+
+static void test_one_native_period_lead(void)
+{
+    static const struct { unsigned quantum, frames; } cases[] =
+    {
+        {256, 256}, {256, 1024}, {1024, 256}, {1024, 1024}, {235, 256}, {941, 256}
+    };
+    struct asio_deadline_queue queue;
+    struct asio_render_result rendered;
+    uint32_t output[1024], expected[1024], block[1024];
+    unsigned i, period, id, quantum, frames;
+
+    for (i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i)
+    {
+        quantum = cases[i].quantum;
+        frames = cases[i].frames;
+        ok(asio_queue_init(&queue, frames, sizeof(*output), 16), "Queue initialization failed.\n");
+        asio_queue_reset(&queue, 1, quantum);
+        ok(asio_queue_render(&queue, output, quantum, &rendered), "Initial render failed.\n");
+        ok(rendered.silent_frames == quantum, "Initial native period was not silent.\n");
+        id = 0;
+        for (period = 0; period < 8; ++period)
+        {
+            while (asio_block_due(id, queue.callback_end, frames))
+            {
+                fill(block, frames, id * frames + 1);
+                ok(asio_queue_commit(&queue, 1, id++, block) == ASIO_COMMITTED,
+                   "Timely block missed at Q%u/B%u period %u.\n", quantum, frames, period);
+            }
+            ok(asio_queue_render(&queue, output, quantum, &rendered), "Steady render failed.\n");
+            fill(expected, quantum, period * quantum + 1);
+            ok(!rendered.silent_frames && !memcmp(output, expected, quantum * sizeof(*output)),
+               "PCM was delayed or lost at Q%u/B%u period %u.\n", quantum, frames, period);
+        }
+        asio_queue_destroy(&queue);
+    }
+}
+
+static void test_partial_and_late(void)
+{
+    struct asio_deadline_queue queue;
+    struct asio_render_result result;
+    uint32_t input[4], output[16];
+    uint64_t slot, write;
+
+    ok(asio_queue_init(&queue, 4, sizeof(*input), 4), "Queue initialization failed.\n");
+    asio_queue_reset(&queue, 1, 0);
+    fill(input, 4, 1);
+    ok(asio_queue_commit(&queue, 1, 0, input) == ASIO_COMMITTED, "Initial commit failed.\n");
+    ok(asio_queue_render(&queue, output, 2, &result), "First partial render failed.\n");
+    check_samples(output, 2, 1);
+    ok(queue.read_index == 0, "Partially read block was released.\n");
+    ok(asio_queue_render(&queue, output, 2, &result), "Second partial render failed.\n");
+    check_samples(output, 2, 3);
+    ok(queue.read_index == 1, "Completed block was retained.\n");
+    ok(asio_queue_render(&queue, output, 2, &result), "Missing block render failed.\n");
+    check_samples(output, 2, 0);
+    ok(result.missed_blocks == 1 && result.silent_frames == 2,
+       "Missing block was not accounted.\n");
+    fill(input, 4, 5);
+    ok(asio_queue_commit(&queue, 1, 1, input) == ASIO_LATE, "Late block was accepted.\n");
+
+    /* Reproduce publication racing the final producer deadline check. */
+    write = queue.write_index;
+    slot = write % queue.slots;
+    memcpy(queue.data + slot * queue.block_bytes, input, sizeof(input));
+    queue.ids[slot] = 1;
+    queue.last_committed = 1;
+    queue.have_committed = true;
+    __atomic_store_n(&queue.write_index, write + 1, __ATOMIC_RELEASE);
+    fill(input, 4, 9);
+    ok(asio_queue_commit(&queue, 1, 2, input) == ASIO_COMMITTED, "Future block rejected.\n");
+    ok(asio_queue_render(&queue, output, 2, &result), "Missed remainder render failed.\n");
+    check_samples(output, 2, 0);
+    ok(result.discarded_blocks == 1 && !result.missed_blocks,
+       "Late publication was not retired exactly once.\n");
+    ok(asio_queue_render(&queue, output, 4, &result), "Future render failed.\n");
+    check_samples(output, 4, 9);
+    ok(result.copied_frames == 4 && !result.silent_frames, "Future block accounting failed.\n");
+    asio_queue_destroy(&queue);
+}

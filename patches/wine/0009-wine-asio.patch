+static void test_one_stream(IASIO *driver, LONG output_channels, double rate, LONG buffer_size)
+{
+    ASIOBufferInfo *infos = NULL;
+    ASIOSamples position = {0}, timestamp = {0};
+    ASIOSamples stopped_position = {0}, stopped_timestamp = {0};
+    LONG input_latency = -1, output_latency = -1;
+    LONG latency_limit = initial_latency_bound(buffer_size);
+    ULONGLONG qpc_before_start, qpc_after_start;
+    LONG i, error, callback_count;
+    BOOL started = FALSE;
+
+    error = driver->lpVtbl->setSampleRate(driver, rate);
+    ok(error == ASE_OK, "SetSampleRate(%.0f) for %ld frames failed: %ld.\n",
+            rate, buffer_size, error);
+    if (error != ASE_OK)
+        return;
+
+    infos = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, output_channels * sizeof(*infos));
+    ok(infos != NULL, "Could not allocate %.0f Hz/%ld frame descriptors.\n", rate, buffer_size);
+    if (!infos)
+        return;
+    for (i = 0; i < output_channels; ++i)
+    {
+        infos[i].channelNum = i;
+        infos[i].isInput = FALSE;
+    }
+
+    callback_state.event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    ok(callback_state.event != NULL, "CreateEvent failed for %.0f Hz/%ld frames.\n",
+            rate, buffer_size);
+    if (!callback_state.event)
+        goto done;
+    callback_state.driver = driver;
+    callback_state.buffers = infos;
+    callback_state.channels = output_channels;
+    callback_state.buffer_size = buffer_size;
+    callback_state.block_size = buffer_size;
+    callback_state.sample_rate = rate;
+    clear_callback_state();
+
+    error = driver->lpVtbl->createBuffers(driver, infos, output_channels, buffer_size, &callbacks);
+    ok(error == ASE_OK, "CreateBuffers(%.0f Hz/%ld frames) failed: %ld.\n",
+            rate, buffer_size, error);
+    if (error != ASE_OK)
+        goto done;
+    error = driver->lpVtbl->getSamplePosition(driver, &position, &timestamp);
+    ok(error == ASE_SPNotAdvancing,
+            "GetSamplePosition before Start at %.0f Hz/%ld frames returned %ld.\n",
+            rate, buffer_size, error);
+    for (i = 0; i < output_channels; ++i)
+    {
+        ok(infos[i].buffers[0] && infos[i].buffers[1],
+                "%.0f Hz/%ld frame channel %ld has a NULL buffer.\n", rate, buffer_size, i);
+        if (infos[i].buffers[0])
+            memset(infos[i].buffers[0], 0, buffer_size * 3);
+        if (infos[i].buffers[1])
+            memset(infos[i].buffers[1], 0, buffer_size * 3);
+    }
+
+    error = driver->lpVtbl->getLatencies(driver, &input_latency, &output_latency);
+    ok(error == ASE_OK && input_latency == 0 && output_latency > 0
+            && output_latency <= latency_limit,
+            "GetLatencies before Start at %.0f Hz/%ld frames returned %ld, %ld/%ld "
+            "(limit %ld).\n", rate, buffer_size, error, input_latency, output_latency,
+            latency_limit);
+    qpc_before_start = query_qpc_nanoseconds();
+    error = driver->lpVtbl->start(driver);
+    qpc_after_start = query_qpc_nanoseconds();
+    ok(error == ASE_OK, "Start(%.0f Hz/%ld frames) failed: %ld.\n", rate, buffer_size, error);
+    if (error != ASE_OK)
+        goto dispose;
+    started = TRUE;
+    ok(wait_for_callbacks(4, 4000), "No callbacks at %.0f Hz/%ld frames.\n", rate, buffer_size);
+    ok(callback_state.time_callbacks >= 4 && !callback_state.plain_callbacks,
+            "Unexpected callback path at %.0f Hz/%ld frames.\n", rate, buffer_size);
+    ok(callback_state.seen_indices == 3 && !callback_state.bad_indices,
+            "Callback indices were invalid at %.0f Hz/%ld frames: seen %#lx, bad %ld.\n",
+            rate, buffer_size, callback_state.seen_indices, callback_state.bad_indices);
+    validate_callback_clock(rate, buffer_size, TRUE, qpc_before_start, qpc_after_start,
+            "Boundary");
+    error = driver->lpVtbl->getSamplePosition(driver, &position, &timestamp);
+    ok(error == ASE_OK && (position.hi || position.lo) && (timestamp.hi || timestamp.lo),
+            "GetSamplePosition did not advance at %.0f Hz/%ld frames: %ld.\n",
+            rate, buffer_size, error);
+    ok(error != ASE_OK || samples_value(position) % buffer_size == 0,
+            "GetSamplePosition was not block-aligned at %.0f Hz/%ld frames: %I64u.\n",
+            rate, buffer_size, samples_value(position));
+    ok(callback_state.reentrant_checks >= 4 && !callback_state.reentrant_failures,
+            "Reentrant checks failed at %.0f Hz/%ld frames: %ld/%ld.\n", rate, buffer_size,
+            callback_state.reentrant_checks, callback_state.reentrant_failures);
+
+    if (rate == 44100.0 && buffer_size == 256)
+    {
+        LONG nominal_latency = -1, steady_latency = -1, notifications;
+
+        ok(wait_for_callbacks(32, 4000), "Startup callbacks did not settle.\n");
+        error = driver->lpVtbl->getLatencies(driver, &input_latency, &nominal_latency);
+        ok(error == ASE_OK, "GetLatencies after startup failed: %ld.\n", error);
+        notifications = callback_state.latency_notifications;
+        ok(wait_for_callbacks(callback_state.time_callbacks + 32, 4000),
+                "Steady-state callbacks did not run.\n");
+        error = driver->lpVtbl->getLatencies(driver, &input_latency, &steady_latency);
+        ok(error == ASE_OK && steady_latency == nominal_latency,
+                "Latency changed on a steady graph: %ld, %ld -> %ld.\n",
+                error, nominal_latency, steady_latency);
+        ok(callback_state.latency_notifications - notifications <= 1,
+                "Steady %.0f Hz/%ld frames graph emitted %ld latency-change notifications.\n", rate, buffer_size,
+                callback_state.latency_notifications - notifications);
+    }
+
+    error = driver->lpVtbl->stop(driver);
+    ok(error == ASE_OK, "Stop(%.0f Hz/%ld frames) failed: %ld.\n", rate, buffer_size, error);
+    started = FALSE;
+    callback_count = callback_state.time_callbacks + callback_state.plain_callbacks;
+    Sleep(100);
+    ok(callback_count == callback_state.time_callbacks + callback_state.plain_callbacks,
+            "Callbacks continued after Stop at %.0f Hz/%ld frames.\n", rate, buffer_size);
+    error = driver->lpVtbl->getSamplePosition(driver, &stopped_position, &stopped_timestamp);
+    ok(error == ASE_OK || error == ASE_SPNotAdvancing,
+            "GetSamplePosition after Stop at %.0f Hz/%ld frames returned %ld.\n",
+            rate, buffer_size, error);
+    if (error == ASE_OK)
+        ok(samples_equal(stopped_position, position) && samples_equal(stopped_timestamp, timestamp),
+                "Sample position advanced after Stop at %.0f Hz/%ld frames.\n", rate, buffer_size);
+
+    clear_callback_state();
+    ResetEvent(callback_state.event);
+    qpc_before_start = query_qpc_nanoseconds();
+    error = driver->lpVtbl->start(driver);
+    qpc_after_start = query_qpc_nanoseconds();
+    ok(error == ASE_OK, "Restart(%.0f Hz/%ld frames) failed: %ld.\n", rate, buffer_size, error);
+    if (error == ASE_OK)
+    {
+        started = TRUE;
+        ok(wait_for_callbacks(4, 4000), "Restart produced no callbacks at %.0f Hz/%ld frames.\n",
+                rate, buffer_size);
+        ok(callback_state.seen_indices == 3 && !callback_state.bad_indices,
+                "Restart indices were invalid at %.0f Hz/%ld frames: seen %#lx, bad %ld.\n",
+                rate, buffer_size, callback_state.seen_indices, callback_state.bad_indices);
+        validate_callback_clock(rate, buffer_size, TRUE, qpc_before_start, qpc_after_start,
+                "Boundary restart");
+        error = driver->lpVtbl->stop(driver);
+        ok(error == ASE_OK, "Restart Stop(%.0f Hz/%ld frames) failed: %ld.\n",
+                rate, buffer_size, error);
+        started = FALSE;
+    }
+
+dispose:
+    if (started)
+        driver->lpVtbl->stop(driver);
+    error = driver->lpVtbl->disposeBuffers(driver);
+    ok(error == ASE_OK, "DisposeBuffers(%.0f Hz/%ld frames) failed: %ld.\n",
+            rate, buffer_size, error);
+    error = driver->lpVtbl->disposeBuffers(driver);
+    ok(error == ASE_OK || error == ASE_InvalidMode,
+            "Second DisposeBuffers(%.0f Hz/%ld frames) returned %ld.\n", rate, buffer_size, error);
+
+done:
+    callback_state.driver = NULL;
+    callback_state.buffers = NULL;
+    callback_state.channels = 0;
+    callback_state.buffer_size = 0;
+    callback_state.block_size = 0;
+    callback_state.sample_rate = 0;
+    if (callback_state.event)
+    {
+        CloseHandle(callback_state.event);
+        callback_state.event = NULL;
+    }
+    HeapFree(GetProcessHeap(), 0, infos);
+}

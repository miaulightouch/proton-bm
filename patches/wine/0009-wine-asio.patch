+static BOOL test_release_from_callback(dll_get_class_object_proc get_class_object,
+        dll_can_unload_now_proc can_unload_now, LONG output_channels)
+{
+    IClassFactory *factory = NULL;
+    IASIO *active = NULL;
+    ASIOBufferInfo *infos = NULL;
+    HANDLE event = NULL;
+    HRESULT hr, unload_result = S_FALSE;
+    LONG i, error, callbacks_before_arm, callback_count;
+    BOOL buffers_created = FALSE, started = FALSE, consumed = FALSE;
+    DWORD wait_start;
+
+    if (!get_class_object || !can_unload_now || output_channels <= 0)
+    {
+        skip("The callback-release unload test needs the DLL unload export.\n");
+        return TRUE;
+    }
+
+    hr = get_class_object(&CLSID_ProtonASIO, &IID_IClassFactory, (void **)&factory);
+    ok(hr == S_OK, "Callback-release DllGetClassObject failed: %#lx.\n", hr);
+    if (FAILED(hr))
+        return TRUE;
+
+    hr = IClassFactory_CreateInstance(factory, NULL, &CLSID_ProtonASIO, (void **)&active);
+    ok(hr == S_OK, "Callback-release CreateInstance failed: %#lx.\n", hr);
+    IClassFactory_Release(factory);
+    factory = NULL;
+    if (FAILED(hr))
+        goto done;
+
+    if (!active->lpVtbl->init(active, NULL))
+    {
+        skip("Callback-release instance could not open PipeWire.\n");
+        goto done;
+    }
+
+    infos = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY,
+            output_channels * sizeof(*infos));
+    ok(infos != NULL, "Could not allocate callback-release buffer descriptors.\n");
+    if (!infos)
+        goto done;
+    for (i = 0; i < output_channels; ++i)
+    {
+        infos[i].channelNum = i;
+        infos[i].isInput = FALSE;
+    }
+
+    event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    ok(event != NULL, "Could not create the callback-release event.\n");
+    if (!event)
+        goto done;
+    callback_state.event = event;
+    callback_state.driver = active;
+    callback_state.buffers = infos;
+    callback_state.channels = output_channels;
+    callback_state.buffer_size = 256;
+    clear_callback_state();
+
+    error = active->lpVtbl->createBuffers(active, infos, output_channels, 256,
+            &callbacks_release_last_reference);
+    if (is_hardware_unavailable(error))
+    {
+        skip("Callback-release PipeWire buffers are unavailable: %ld.\n", error);
+        goto done;
+    }
+    ok(error == ASE_OK, "Callback-release CreateBuffers failed: %ld.\n", error);
+    if (error != ASE_OK)
+        goto done;
+    buffers_created = TRUE;
+    for (i = 0; i < output_channels; ++i)
+    {
+        if (infos[i].buffers[0])
+            memset(infos[i].buffers[0], 0, 256 * 3);
+        if (infos[i].buffers[1])
+            memset(infos[i].buffers[1], 0, 256 * 3);
+    }
+
+    error = active->lpVtbl->start(active);
+    if (is_hardware_unavailable(error))
+    {
+        skip("Callback-release PipeWire stream could not start: %ld.\n", error);
+        goto done;
+    }
+    ok(error == ASE_OK, "Callback-release Start failed: %ld.\n", error);
+    if (error != ASE_OK)
+        goto done;
+    started = TRUE;
+
+    callbacks_before_arm = callback_state.plain_callbacks + callback_state.time_callbacks;
+    ok(callbacks_before_arm >= 1,
+            "Callback-release stream did not complete its priming callback: %ld.\n",
+            callbacks_before_arm);
+    ResetEvent(event);
+    InterlockedExchange(&callback_state.release_armed, 1);
+    wait_start = GetTickCount();
+    while (!InterlockedCompareExchange(&callback_state.release_done, 0, 0))
+    {
+        DWORD elapsed = GetTickCount() - wait_start;
+        DWORD wait = elapsed < 4000 ? 4000 - elapsed : 0;
+
+        if (!wait || WaitForSingleObject(event, wait) != WAIT_OBJECT_0)
+            break;
+        ResetEvent(event);
+    }
+
+    if (InterlockedCompareExchange(&callback_state.release_done, 0, 0))
+    {
+        consumed = TRUE;
+        ok(callback_state.callbacks_after_release_arm >= 1,
+                "Last reference was not released from a post-start callback.\n");
+        ok(!callback_state.release_without_driver,
+                "Post-start callback had no driver reference to release.\n");
+        wait_start = GetTickCount();
+        do
+        {
+            unload_result = can_unload_now();
+            if (unload_result == S_OK)
+                break;
+            if (GetTickCount() - wait_start >= 4000)
+                break;
+            Sleep(1);
+        } while (TRUE);
+        ok(unload_result == S_OK,
+                "DllCanUnloadNow remained busy after callback Release: %#lx.\n",
+                unload_result);
+        ok(callback_state.release_refcount == 0,
+                "Callback Release returned reference count %ld, expected zero.\n",
+                callback_state.release_refcount);
+        callback_count = callback_state.plain_callbacks + callback_state.time_callbacks;
+        Sleep(50);
+        ok(callback_count == callback_state.plain_callbacks + callback_state.time_callbacks,
+                "Callbacks continued after callback-triggered last Release.\n");
+    }
+    else if (InterlockedCompareExchange(&callback_state.release_armed, 0, 1) != 1)
+    {
+        /* The callback claimed the release concurrently with the timeout. */
+        WaitForSingleObject(event, 1000);
+        consumed = TRUE;
+        ok(InterlockedCompareExchange(&callback_state.release_done, 0, 0),
+                "Callback-release worker claimed but did not finish Release.\n");
+    }
+    else
+        ok(FALSE, "No callback released the final IASIO reference after Start.\n");
+
+done:
+    if (started && !consumed)
+    {
+        error = active->lpVtbl->stop(active);
+        ok(error == ASE_OK || error == ASE_InvalidMode,
+                "Callback-release cleanup Stop returned %ld.\n", error);
+    }
+    if (buffers_created && !consumed)
+    {
+        error = active->lpVtbl->disposeBuffers(active);
+        ok(error == ASE_OK || error == ASE_InvalidMode,
+                "Callback-release cleanup DisposeBuffers returned %ld.\n", error);
+    }
+    callback_state.driver = NULL;
+    callback_state.buffers = NULL;
+    callback_state.channels = 0;
+    callback_state.buffer_size = 0;
+    if (!consumed && active)
+        active->lpVtbl->Release(active);
+    if (event)
+        CloseHandle(event);
+    callback_state.event = NULL;
+    HeapFree(GetProcessHeap(), 0, infos);
+    return TRUE;
+}
+
+static HANDLE blocked_entered, blocked_resume, blocked_returned;
+static LONG block_callback_armed, blocked_buffer_written;
+static ASIOBufferInfo blocked_buffer;
+
+static void blocked_switch(LONG index, LONG direct)
+{
+    if (InterlockedCompareExchange(&block_callback_armed, 0, 1) == 1)
+    {
+        SetEvent(blocked_entered);
+        WaitForSingleObject(blocked_resume, 15000);
+        /* A timed-out Stop/Dispose/Release must retain the host's buffer. */
+        memset(blocked_buffer.buffers[index], 0x35, 256 * 3);
+        InterlockedExchange(&blocked_buffer_written, 1);
+        SetEvent(blocked_returned);
+    }
+}
+
+static void test_blocked_callback(dll_get_class_object_proc get_class_object,
+                                   dll_can_unload_now_proc can_unload_now)
+{
+    ASIOCallbacks callbacks = {blocked_switch, NULL, NULL, NULL};
+    IClassFactory *factory = NULL;
+    IASIO *driver = NULL;
+    HRESULT hr;
+    LONG result;
+    DWORD before, elapsed;
+    BOOL released = FALSE;
+
+    if (!can_unload_now) return;
+    hr = get_class_object(&CLSID_ProtonASIO, &IID_IClassFactory, (void **)&factory);
+    ok(hr == S_OK, "Blocked callback factory failed: %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    hr = IClassFactory_CreateInstance(factory, NULL, &CLSID_ProtonASIO, (void **)&driver);
+    IClassFactory_Release(factory);
+    ok(hr == S_OK, "Blocked callback instance failed: %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    blocked_entered = CreateEventW(NULL, TRUE, FALSE, NULL);
+    blocked_resume = CreateEventW(NULL, TRUE, FALSE, NULL);
+    blocked_returned = CreateEventW(NULL, TRUE, FALSE, NULL);
+    block_callback_armed = blocked_buffer_written = 0;
+    memset(&blocked_buffer, 0, sizeof(blocked_buffer));
+    ok(blocked_entered && blocked_resume && blocked_returned, "Event allocation failed.\n");
+    if (!blocked_entered || !blocked_resume || !blocked_returned) goto done;
+    result = driver->lpVtbl->init(driver, NULL);
+    ok(result, "Blocked callback init failed.\n");
+    if (!result) goto done;
+    result = driver->lpVtbl->createBuffers(driver, &blocked_buffer, 1, 256, &callbacks);
+    ok(result == ASE_OK, "Blocked callback buffers failed: %ld.\n", result);
+    if (result != ASE_OK) goto done;
+    result = driver->lpVtbl->start(driver);
+    ok(result == ASE_OK, "Blocked callback start failed: %ld.\n", result);
+    if (result != ASE_OK) goto done;
+    InterlockedExchange(&block_callback_armed, 1);
+    result = WaitForSingleObject(blocked_entered, 4000);
+    ok(result == WAIT_OBJECT_0, "Callback did not enter the blocking region.\n");
+    if (result != WAIT_OBJECT_0) goto done;
+
+    before = GetTickCount();
+    result = driver->lpVtbl->stop(driver);
+    elapsed = GetTickCount() - before;
+    ok(result == ASE_HWMalfunction, "Blocked Stop returned %ld.\n", result);
+    ok(elapsed < 4000, "Blocked Stop took %lu ms.\n", elapsed);
+    result = driver->lpVtbl->disposeBuffers(driver);
+    ok(result == ASE_HWMalfunction, "Blocked DisposeBuffers returned %ld.\n", result);
+    before = GetTickCount();
+    result = driver->lpVtbl->Release(driver);
+    elapsed = GetTickCount() - before;
+    released = TRUE;
+    ok(!result && elapsed < 4000, "Blocked Release returned %ld after %lu ms.\n", result, elapsed);
+    ok(can_unload_now() == S_FALSE, "Module became unloadable while its callback was blocked.\n");
+    SetEvent(blocked_resume);
+    ok(WaitForSingleObject(blocked_returned, 4000) == WAIT_OBJECT_0,
+       "Blocked callback did not return.\n");
+    ok(blocked_buffer_written, "Callback could not write its retained buffer.\n");
+    before = GetTickCount();
+    while (can_unload_now() != S_OK && GetTickCount() - before < 4000) Sleep(1);
+    ok(can_unload_now() == S_OK, "Driver leaked after its blocked callback returned.\n");
+
+done:
+    if (blocked_resume) SetEvent(blocked_resume);
+    if (!released) driver->lpVtbl->Release(driver);
+    if (blocked_entered) CloseHandle(blocked_entered);
+    if (blocked_resume) CloseHandle(blocked_resume);
+    if (blocked_returned) CloseHandle(blocked_returned);
+}

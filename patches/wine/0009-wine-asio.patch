--- /dev/null
+++ b/dlls/protonasio/asio.c
@@ -0,0 +1,785 @@
+/*
+ * ASIO playback driver for PipeWire.
+ *
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+#define COBJMACROS
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winternl.h"
+#include "initguid.h"
+#include "asio.h"
+#include "timeline.h"
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(asio);
+
+#define ASIO_WORKER_TIMEOUT_MS 2000
+enum { WORKER_RUNNING, RELEASE_REQUESTED, WORKER_EXITED };
+
+enum { kAsioResetRequest = 3, kAsioResyncRequest = 5, kAsioLatenciesChanged = 6, kAsioSupportsTimeInfo = 7,
+       kAsioCanTimeInfo = 10 };
+enum { kSystemTimeValid = 1, kSamplePositionValid = 2, kSampleRateValid = 4 };
+
+static LONG objects, factory_refs, server_locks;
+static INIT_ONCE unixlib_init = INIT_ONCE_STATIC_INIT;
+
+struct asio_driver
+{
+    IASIO iface;
+    char name[ASIO_DEVICE_NAME_SIZE];
+    LONG refs;
+    CRITICAL_SECTION lock, position_lock;
+    UINT64 position, timestamp;
+    struct asio_time_state time_state;
+    UINT64 handle;
+    UINT rate, frames;
+    ASIOBufferInfo *buffers;
+    UINT count;
+    BYTE *planar, *interleaved;
+    ASIOCallbacks callbacks;
+    HANDLE thread, ready;
+    HMODULE module;
+    DWORD thread_id;
+    LONG started, error, destroy_pending, reset_notified, latency, channel_mask;
+    BOOL time_info, have_position, resync_pending;
+};
+
+static struct asio_driver *impl_from_IASIO(IASIO *iface)
+{
+    return CONTAINING_RECORD(iface, struct asio_driver, iface);
+}
+
+static LONG asio_result(LONG result)
+{
+    return !result || (result >= ASE_NotPresent && result <= ASE_NoMemory) ? result : ASE_HWMalfunction;
+}
+
+static BOOL release_cancelled(struct asio_driver *driver)
+{
+    return InterlockedCompareExchange(&driver->destroy_pending, 0, 0) == RELEASE_REQUESTED;
+}
+
+static BOOL callback_cancelled(struct asio_driver *driver)
+{
+    return !InterlockedCompareExchange(&driver->started, 0, 0) || release_cancelled(driver);
+}
+
+static BOOL callback_ticket_current(struct asio_driver *driver, const struct asio_ticket *ticket,
+                                    BOOL require_time)
+{
+    BOOL current;
+
+    if (callback_cancelled(driver)) return FALSE;
+    EnterCriticalSection(&driver->position_lock);
+    current = driver->have_position && driver->position == ticket->position
+            && (!require_time || (!driver->time_state.invalid
+                    && driver->timestamp == ticket->nanoseconds));
+    LeaveCriticalSection(&driver->position_lock);
+    return current && !callback_cancelled(driver);
+}
+
+static BOOL query_qpc_nanoseconds(UINT64 *nanoseconds)
+{
+    LARGE_INTEGER counter, frequency;
+    ULONGLONG ticks, hz, whole, remainder, value, fraction;
+
+    if (!nanoseconds || !QueryPerformanceFrequency(&frequency)
+            || !QueryPerformanceCounter(&counter)
+            || counter.QuadPart < 0 || frequency.QuadPart <= 0)
+        return FALSE;
+    ticks = (ULONGLONG)counter.QuadPart;
+    hz = (ULONGLONG)frequency.QuadPart;
+    whole = ticks / hz;
+    remainder = ticks % hz;
+    if (whole > (~(UINT64)0) / 1000000000ULL) return FALSE;
+    value = whole * 1000000000ULL;
+    fraction = remainder * 1000000000ULL / hz;
+    if (value > ~(UINT64)0 - fraction) return FALSE;
+    *nanoseconds = value + fraction;
+    return TRUE;
+}
+
+static BOOL callback_ticket_due(struct asio_driver *driver, const struct asio_ticket *ticket)
+{
+    UINT64 now, period;
+
+    if (!query_qpc_nanoseconds(&now) || !driver->rate || !driver->frames) return FALSE;
+    period = (UINT64)driver->frames * 1000000000ULL / driver->rate;
+    return period && now >= ticket->nanoseconds && now - ticket->nanoseconds < period;
+}
+
+static void callback_reset(struct asio_driver *driver)
+{
+    if (InterlockedCompareExchange(&driver->started, FALSE, TRUE) == TRUE
+            && !InterlockedExchange(&driver->reset_notified, 1)
+            && driver->callbacks.asioMessage)
+        driver->callbacks.asioMessage(kAsioResetRequest, 0, NULL, NULL);
+}
+
+static BOOL write_cancelled(struct asio_driver *driver, const struct asio_ticket *ticket)
+{
+    /* The priming block has no host callback; native stop owns its cancellation. */
+    return release_cancelled(driver)
+            || (ticket->id && !InterlockedCompareExchange(&driver->started, 0, 0));
+}
+
+static LONG handle_call(struct asio_driver *driver, enum asio_unix_call code)
+{
+    struct asio_handle_params params = {driver->handle, ASE_HWMalfunction};
+    if (WINE_UNIX_CALL(code, &params)) return ASE_HWMalfunction;
+    if (params.result < 0) WARN("Native ASIO operation %u failed: %ld.\n", code, params.result);
+    return asio_result(params.result);
+}
+
+static LONG query_timing(struct asio_driver *driver, struct asio_timing_params *params)
+{
+    memset(params, 0, sizeof(*params));
+    params->handle = driver->handle;
+    params->result = ASE_HWMalfunction;
+    if (WINE_UNIX_CALL(asio_timing, params)) return ASE_HWMalfunction;
+    return asio_result(params->result);
+}
+
+static void free_buffers(struct asio_driver *driver)
+{
+    InterlockedExchange(&driver->channel_mask, 0);
+    if (driver->frames) handle_call(driver, asio_destroy);
+    free(driver->buffers);
+    free(driver->planar);
+    free(driver->interleaved);
+    driver->buffers = NULL;
+    driver->planar = driver->interleaved = NULL;
+    driver->frames = driver->count = 0;
+    memset(&driver->callbacks, 0, sizeof(driver->callbacks));
+}
+
+static void destroy_driver(struct asio_driver *driver)
+{
+    free_buffers(driver);
+    if (driver->handle) handle_call(driver, asio_close);
+    if (driver->thread) CloseHandle(driver->thread);
+    if (driver->ready) CloseHandle(driver->ready);
+    DeleteCriticalSection(&driver->position_lock);
+    DeleteCriticalSection(&driver->lock);
+    free(driver);
+    InterlockedDecrement(&objects);
+}
+
+static HRESULT WINAPI driver_QueryInterface(IASIO *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!iid) return E_INVALIDARG;
+    if (!IsEqualGUID(iid, &IID_IUnknown) && !IsEqualGUID(iid, &CLSID_ProtonASIO))
+        return E_NOINTERFACE;
+    *out = iface;
+    iface->lpVtbl->AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI driver_AddRef(IASIO *iface)
+{
+    return InterlockedIncrement(&impl_from_IASIO(iface)->refs);
+}
+
+static ULONG WINAPI driver_Release(IASIO *iface)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    ULONG refs = InterlockedDecrement(&driver->refs);
+    if (!refs)
+    {
+        if (driver->thread)
+        {
+            InterlockedExchange(&driver->started, FALSE);
+            handle_call(driver, asio_stop);
+            if (GetCurrentThreadId() == driver->thread_id
+                    || WaitForSingleObject(driver->thread, ASIO_WORKER_TIMEOUT_MS) != WAIT_OBJECT_0)
+            {
+                /* The worker retains its buffers and module if a host callback is stuck. */
+                if (InterlockedExchange(&driver->destroy_pending, RELEASE_REQUESTED) != WORKER_EXITED)
+                    return 0;
+            }
+        }
+        destroy_driver(driver);
+    }
+    return refs;
+}
+
+static BOOL CALLBACK init_unixlib(INIT_ONCE *once, void *parameter, void **context)
+{
+    return !__wine_init_unix_call();
+}
+
+static LONG driver_init(IASIO *iface, void *window)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    struct asio_open_params params = {ASIO_UNIX_ABI, ASE_HWMalfunction};
+    LONG result;
+    if (driver->handle) return TRUE;
+    EnterCriticalSection(&driver->lock);
+    if (driver->handle) result = TRUE;
+    else if (!InitOnceExecuteOnce(&unixlib_init, init_unixlib, NULL, NULL))
+    {
+        driver->error = ASE_HWMalfunction;
+        result = FALSE;
+    }
+    else
+    {
+        if (WINE_UNIX_CALL(asio_open, &params))
+        {
+            params.handle = 0;
+            params.result = ASE_HWMalfunction;
+        }
+        driver->handle = params.handle;
+        if (params.result != ASIO_UNIX_ABI)
+        {
+            if (driver->handle) handle_call(driver, asio_close);
+            driver->handle = 0;
+            driver->error = params.result < 0 ? asio_result(params.result) : ASE_HWMalfunction;
+            ERR("Incompatible or unavailable native ASIO backend (%ld).\n", params.result);
+            result = FALSE;
+        }
+        else
+        {
+            driver->error = ASE_OK;
+            result = TRUE;
+        }
+    }
+    LeaveCriticalSection(&driver->lock);
+    return result;
+}
+
+static void driver_getDriverName(IASIO *iface, char *name)
+{
+    if (name) strcpy(name, impl_from_IASIO(iface)->name);
+}
+
+static LONG driver_getDriverVersion(IASIO *iface) { return 1; }
+
+static void driver_getErrorMessage(IASIO *iface, char *message)
+{
+    if (message) snprintf(message, 124, "PipeWire ASIO error %ld", impl_from_IASIO(iface)->error);
+}
+
+static ASIOSamples asio_samples(UINT64 value)
+{
+    ASIOSamples result = {value >> 32, value};
+    return result;
+}
+
+static LONG driver_getSamplePosition(IASIO *iface, ASIOSamples *position, ASIOSamples *timestamp)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    if (!position || !timestamp) return ASE_InvalidParameter;
+    if (!driver->handle) return ASE_NotPresent;
+    if (!driver->frames) return ASE_InvalidMode;
+    if (!InterlockedCompareExchange(&driver->started, 0, 0)) return ASE_SPNotAdvancing;
+    EnterCriticalSection(&driver->position_lock);
+    if (!driver->timestamp)
+    {
+        LeaveCriticalSection(&driver->position_lock);
+        return ASE_SPNotAdvancing;
+    }
+    *position = asio_samples(driver->position);
+    *timestamp = asio_samples(driver->timestamp);
+    LeaveCriticalSection(&driver->position_lock);
+    return ASE_OK;
+}
+
+static LONG write_block(struct asio_driver *driver, LONG index, const struct asio_ticket *ticket)
+{
+    struct asio_write_params params = {driver->handle, driver->interleaved, driver->frames,
+                                       ASE_HWMalfunction, ticket->generation, ticket->id};
+    UINT i, frame;
+
+    if (write_cancelled(driver, ticket)) return ASE_InvalidMode;
+    if (driver->count < 8) memset(driver->interleaved, 0, driver->frames * 8 * 3);
+    for (i = 0; i < driver->count; ++i)
+    {
+        const BYTE *source = driver->buffers[i].buffers[index];
+        for (frame = 0; frame < driver->frames; ++frame)
+            memcpy(driver->interleaved + (frame * 8 + driver->buffers[i].channelNum) * 3,
+                   source + frame * 3, 3);
+    }
+    if (write_cancelled(driver, ticket)) return ASE_InvalidMode;
+    if (WINE_UNIX_CALL(asio_write, &params))
+    {
+        if (!callback_cancelled(driver)) callback_reset(driver);
+        return ASE_HWMalfunction;
+    }
+    if (params.result == ASIO_WRITE_DROPPED)
+    {
+        WARN("Dropped late ASIO ticket %llu.\n", (unsigned long long)ticket->id);
+        driver->resync_pending = TRUE;
+        return ASE_OK;
+    }
+    if (params.result != ASE_OK && !callback_cancelled(driver)) callback_reset(driver);
+    return asio_result(params.result);
+}
+
+static LONG fill_block(struct asio_driver *driver, LONG *index, const struct asio_ticket *ticket)
+{
+    ASIOTime time = {0};
+    BOOL latency_changed, time_valid, resync;
+    LONG result;
+    UINT64 timestamp;
+
+    if (callback_cancelled(driver)) return ASE_InvalidMode;
+
+    EnterCriticalSection(&driver->position_lock);
+    resync = !driver->time_state.invalid;
+    time_valid = asio_time_validate(&driver->time_state, ticket->clock_position, ticket->nanoseconds);
+    resync = (resync && !time_valid) || driver->resync_pending || (!driver->have_position
+            && ticket->position) || (driver->have_position
+            && ticket->position > driver->position
+            && ticket->position - driver->position > driver->frames);
+    driver->resync_pending = FALSE;
+    timestamp = time_valid ? ticket->nanoseconds : 0;
+    driver->position = ticket->position;
+    driver->timestamp = timestamp;
+    driver->have_position = TRUE;
+    latency_changed = InterlockedExchange(&driver->latency, min(ticket->latency, MAXLONG))
+            != min(ticket->latency, MAXLONG);
+    LeaveCriticalSection(&driver->position_lock);
+    if (driver->time_info && !time_valid)
+    {
+        /* TimeInfo requires a valid pair; a reset request cannot authorize an invalid callback. */
+        result = handle_call(driver, asio_stop);
+        callback_reset(driver);
+        return result == ASE_OK ? ASE_SPNotAdvancing : result;
+    }
+    if (callback_cancelled(driver)) return ASE_InvalidMode;
+    if (latency_changed && driver->callbacks.asioMessage)
+        driver->callbacks.asioMessage(kAsioLatenciesChanged, 0, NULL, NULL);
+    if (callback_cancelled(driver)) return ASE_InvalidMode;
+    if (resync && driver->callbacks.asioMessage)
+        driver->callbacks.asioMessage(kAsioResyncRequest, 0, NULL, NULL);
+    if (!callback_ticket_current(driver, ticket, driver->time_info)) return ASE_InvalidMode;
+    if (!callback_ticket_due(driver, ticket))
+    {
+        if (callback_cancelled(driver)) return ASE_InvalidMode;
+        WARN("ASIO ticket %llu expired before host callback.\n", (unsigned long long)ticket->id);
+        driver->resync_pending = TRUE;
+        return ASE_OK;
+    }
+    if (callback_cancelled(driver)) return ASE_InvalidMode;
+
+    if (driver->time_info)
+    {
+        time.timeInfo.samplePosition = asio_samples(ticket->position);
+        time.timeInfo.systemTime = asio_samples(timestamp);
+        time.timeInfo.flags = kSamplePositionValid | kSampleRateValid | kSystemTimeValid;
+        time.timeInfo.speed = 1.0;
+        time.timeInfo.sampleRate = driver->rate;
+        driver->callbacks.bufferSwitchTimeInfo(&time, *index, TRUE);
+    }
+    else driver->callbacks.bufferSwitch(*index, TRUE);
+    result = write_block(driver, *index, ticket);
+    *index ^= 1;
+    return result;
+}
+
+static LONG wait_ticket(struct asio_driver *driver, struct asio_wait_params *params)
+{
+    params->handle = driver->handle;
+    params->result = -1;
+    if (WINE_UNIX_CALL(asio_wait, params))
+    {
+        WARN("ASIO wait bridge failed.\n");
+        params->result = -1;
+    }
+    if (params->result < 0)
+    {
+        callback_reset(driver);
+        WARN("ASIO callback reservation failed: %ld.\n", params->result);
+        return ASE_HWMalfunction;
+    }
+    if (params->result && callback_cancelled(driver))
+    {
+        params->result = 0;
+        return ASE_OK;
+    }
+    return ASE_OK;
+}
+
+static DWORD WINAPI callback_thread(void *arg)
+{
+    struct asio_driver *driver = arg;
+    HMODULE module = driver->module;
+    struct asio_wait_params params;
+    LONG index = 0, result;
+
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    result = handle_call(driver, asio_reset);
+    if (result == ASE_OK) result = handle_call(driver, asio_start);
+    if (result == ASE_OK) result = wait_ticket(driver, &params);
+    if (result == ASE_OK && params.result) result = write_block(driver, 1, &params.ticket);
+    if (result == ASE_OK) result = wait_ticket(driver, &params);
+    if (result == ASE_OK && params.result)
+    {
+        result = fill_block(driver, &index, &params.ticket);
+    }
+    InterlockedExchange(&driver->error, result);
+    SetEvent(driver->ready);
+    while (result == ASE_OK)
+    {
+        if ((result = wait_ticket(driver, &params)) != ASE_OK || !params.result) break;
+        result = fill_block(driver, &index, &params.ticket);
+    }
+    InterlockedExchange(&driver->error, result);
+    InterlockedExchange(&driver->started, FALSE);
+    if (InterlockedExchange(&driver->destroy_pending, WORKER_EXITED) == RELEASE_REQUESTED)
+        destroy_driver(driver);
+    FreeLibraryAndExitThread(module, 0);
+    return 0;
+}
+
+static LONG driver_start(IASIO *iface)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    LONG result;
+    if (driver->thread && GetCurrentThreadId() == driver->thread_id) return ASE_InvalidMode;
+    driver_AddRef(iface);
+    EnterCriticalSection(&driver->lock);
+    if (!driver->frames || driver->thread) result = ASE_InvalidMode;
+    else
+    {
+        ResetEvent(driver->ready);
+        InterlockedExchange(&driver->destroy_pending, WORKER_RUNNING);
+        InterlockedExchange(&driver->reset_notified, 0);
+        EnterCriticalSection(&driver->position_lock);
+        driver->position = driver->timestamp = 0;
+        memset(&driver->time_state, 0, sizeof(driver->time_state));
+        driver->have_position = FALSE;
+        driver->resync_pending = FALSE;
+        LeaveCriticalSection(&driver->position_lock);
+        InterlockedExchange(&driver->started, TRUE);
+        /* Keep callback code loaded until the worker has exited. */
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                               (LPCWSTR)callback_thread, &driver->module)) result = ASE_HWMalfunction;
+        else if (!(driver->thread = CreateThread(NULL, 0, callback_thread, driver,
+                                                CREATE_SUSPENDED, &driver->thread_id)))
+        {
+            FreeLibrary(driver->module);
+            result = ASE_NoMemory;
+        }
+        else
+        {
+            ResumeThread(driver->thread);
+            result = WaitForSingleObject(driver->ready, ASIO_WORKER_TIMEOUT_MS) == WAIT_OBJECT_0
+                    ? driver->error : ASE_HWMalfunction;
+            if (result != ASE_OK)
+            {
+                InterlockedExchange(&driver->started, FALSE);
+                handle_call(driver, asio_stop);
+                if (WaitForSingleObject(driver->thread, ASIO_WORKER_TIMEOUT_MS) == WAIT_OBJECT_0)
+                {
+                    CloseHandle(driver->thread);
+                    driver->thread = NULL;
+                }
+            }
+        }
+        if (result != ASE_OK) driver->started = FALSE;
+    }
+    LeaveCriticalSection(&driver->lock);
+    driver_Release(iface);
+    return result;
+}
+
+static LONG stop_locked(struct asio_driver *driver)
+{
+    LONG result = ASE_OK;
+    if (!driver->frames) result = ASE_InvalidMode;
+    else if (driver->thread)
+    {
+        InterlockedExchange(&driver->started, FALSE);
+        result = handle_call(driver, asio_stop);
+        if (WaitForSingleObject(driver->thread, ASIO_WORKER_TIMEOUT_MS) != WAIT_OBJECT_0)
+            result = ASE_HWMalfunction;
+        else
+        {
+            CloseHandle(driver->thread);
+            driver->thread = NULL;
+        }
+    }
+    return result;
+}
+
+static LONG driver_stop(IASIO *iface)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    LONG result;
+    if (driver->thread && GetCurrentThreadId() == driver->thread_id) return ASE_InvalidMode;
+    EnterCriticalSection(&driver->lock);
+    result = stop_locked(driver);
+    LeaveCriticalSection(&driver->lock);
+    return result;
+}
+
+static LONG driver_getChannels(IASIO *iface, LONG *inputs, LONG *outputs)
+{
+    if (!inputs || !outputs) return ASE_InvalidParameter;
+    *inputs = 0;
+    *outputs = 8;
+    return ASE_OK;
+}
+
+static LONG driver_getLatencies(IASIO *iface, LONG *input, LONG *output)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    struct asio_timing_params params;
+    LONG result;
+    if (!input || !output) return ASE_InvalidParameter;
+    if (!driver->frames) return ASE_InvalidMode;
+    if (InterlockedCompareExchange(&driver->started, 0, 0))
+    {
+        EnterCriticalSection(&driver->position_lock);
+        if (driver->have_position)
+        {
+            *output = InterlockedCompareExchange(&driver->latency, 0, 0);
+            *input = 0;
+            LeaveCriticalSection(&driver->position_lock);
+            return ASE_OK;
+        }
+        LeaveCriticalSection(&driver->position_lock);
+    }
+    if ((result = query_timing(driver, &params)) != ASE_OK) return result;
+    *output = min(params.latency, MAXLONG);
+    *input = 0;
+    return ASE_OK;
+}
+
+static LONG driver_getBufferSize(IASIO *iface, LONG *minimum, LONG *maximum,
+                                LONG *preferred, LONG *granularity)
+{
+    if (!minimum || !maximum || !preferred || !granularity) return ASE_InvalidParameter;
+    *minimum = 64;
+    *maximum = 4096;
+    *preferred = 256;
+    *granularity = -1;
+    return ASE_OK;
+}
+
+static LONG driver_canSampleRate(IASIO *iface, double rate)
+{
+    if (!isfinite(rate) || rate < 8000 || rate > 192000 || floor(rate) != rate) return ASE_NoClock;
+    return ASE_OK;
+}
+
+static LONG driver_getSampleRate(IASIO *iface, double *rate)
+{
+    if (!rate) return ASE_InvalidParameter;
+    *rate = impl_from_IASIO(iface)->rate;
+    return ASE_OK;
+}
+
+static LONG driver_setSampleRate(IASIO *iface, double rate)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    LONG result = driver_canSampleRate(iface, rate);
+    if (result != ASE_OK) return result;
+    if (driver->frames) return ASE_InvalidMode;
+    EnterCriticalSection(&driver->lock);
+    if (driver->frames) result = ASE_InvalidMode;
+    else driver->rate = rate;
+    LeaveCriticalSection(&driver->lock);
+    return result;
+}
+
+static LONG driver_getClockSources(IASIO *iface, ASIOClockSource *sources, LONG *count)
+{
+    if (!count || *count < 1 || !sources) return ASE_InvalidParameter;
+    memset(sources, 0, sizeof(*sources));
+    sources->associatedChannel = sources->associatedGroup = -1;
+    sources->isCurrentSource = TRUE;
+    strcpy(sources->name, "PipeWire clock");
+    *count = 1;
+    return ASE_OK;
+}
+
+static LONG driver_setClockSource(IASIO *iface, LONG index)
+{
+    return index ? ASE_InvalidParameter : ASE_OK;
+}
+
+static LONG driver_getChannelInfo(IASIO *iface, ASIOChannelInfo *info)
+{
+    static const char *const names[] = {"Front Left", "Front Right", "Center", "LFE",
+                                       "Rear Left", "Rear Right", "Side Left", "Side Right"};
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    if (!info || info->isInput || info->channel < 0 || info->channel >= 8) return ASE_InvalidParameter;
+    info->isActive = !!(InterlockedCompareExchange(&driver->channel_mask, 0, 0) & (1u << info->channel));
+    info->channelGroup = 0;
+    info->type = ASIOSTInt24LSB;
+    strcpy(info->name, names[info->channel]);
+    return ASE_OK;
+}
+
+static LONG driver_createBuffers(IASIO *iface, ASIOBufferInfo *buffers, LONG count,
+                                 LONG frames, ASIOCallbacks *callbacks)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    struct asio_create_params params = {driver->handle, driver->rate, 8, frames, ASE_HWMalfunction};
+    UINT mask = 0, i;
+    LONG result;
+    BOOL time_info;
+    if (!buffers || !callbacks || count < 1 || count > 8 || frames < 64 || frames > 4096 ||
+        (frames & (frames - 1)) || (!callbacks->bufferSwitch && !callbacks->bufferSwitchTimeInfo))
+        return ASE_InvalidParameter;
+    for (i = 0; i < count; ++i)
+    {
+        if (buffers[i].isInput || buffers[i].channelNum < 0 || buffers[i].channelNum >= 8 ||
+            (mask & (1u << buffers[i].channelNum))) return ASE_InvalidParameter;
+        mask |= 1u << buffers[i].channelNum;
+    }
+    if (driver->frames) return ASE_InvalidMode;
+    time_info = callbacks->bufferSwitchTimeInfo &&
+                (!callbacks->bufferSwitch || (callbacks->asioMessage &&
+                 callbacks->asioMessage(kAsioSupportsTimeInfo, 0, NULL, NULL) == 1));
+    EnterCriticalSection(&driver->lock);
+    params.handle = driver->handle;
+    params.rate = driver->rate;
+    if (!driver->handle) result = ASE_NotPresent;
+    else if (driver->frames) result = ASE_InvalidMode;
+    else if (!(driver->buffers = malloc(count * sizeof(*buffers))) ||
+             !(driver->planar = calloc(count * 2, frames * 3)) ||
+             !(driver->interleaved = malloc(frames * 8 * 3))) result = ASE_NoMemory;
+    else if (WINE_UNIX_CALL(asio_create, &params)) result = ASE_HWMalfunction;
+    else result = asio_result(params.result);
+    if (result == ASE_OK)
+    {
+        driver->frames = frames;
+        driver->count = count;
+        driver->callbacks = *callbacks;
+        driver->time_info = time_info;
+        driver->latency = 2 * frames;
+        for (i = 0; i < count; ++i)
+        {
+            buffers[i].buffers[0] = driver->planar + i * frames * 6;
+            buffers[i].buffers[1] = driver->planar + i * frames * 6 + frames * 3;
+        }
+        memcpy(driver->buffers, buffers, count * sizeof(*buffers));
+        InterlockedExchange(&driver->channel_mask, mask);
+    }
+    else if (!driver->frames) free_buffers(driver);
+    LeaveCriticalSection(&driver->lock);
+    return result;
+}
+
+static LONG driver_disposeBuffers(IASIO *iface)
+{
+    struct asio_driver *driver = impl_from_IASIO(iface);
+    LONG result;
+    if (driver->thread && GetCurrentThreadId() == driver->thread_id) return ASE_InvalidMode;
+    EnterCriticalSection(&driver->lock);
+    result = stop_locked(driver);
+    if (!driver->thread)
+    {
+        free_buffers(driver);
+        result = ASE_OK;
+    }
+    LeaveCriticalSection(&driver->lock);
+    return result;
+}
+
+static LONG driver_controlPanel(IASIO *iface) { return ASE_NotPresent; }
+static LONG driver_future(IASIO *iface, LONG selector, void *opt)
+{
+    return selector == kAsioCanTimeInfo ? ASE_SUCCESS : ASE_InvalidParameter;
+}
+static LONG driver_outputReady(IASIO *iface) { return ASE_NotPresent; }
+
+static const IASIOVtbl driver_vtbl =
+{
+    driver_QueryInterface, driver_AddRef, driver_Release, driver_init, driver_getDriverName,
+    driver_getDriverVersion, driver_getErrorMessage, driver_start, driver_stop,
+    driver_getChannels, driver_getLatencies, driver_getBufferSize, driver_canSampleRate,
+    driver_getSampleRate, driver_setSampleRate, driver_getClockSources, driver_setClockSource,
+    driver_getSamplePosition, driver_getChannelInfo, driver_createBuffers, driver_disposeBuffers,
+    driver_controlPanel, driver_future, driver_outputReady
+};
+
+static HRESULT WINAPI factory_QueryInterface(IClassFactory *iface, REFIID iid, void **out)
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!iid) return E_INVALIDARG;
+    if (!IsEqualGUID(iid, &IID_IUnknown) && !IsEqualGUID(iid, &IID_IClassFactory)) return E_NOINTERFACE;
+    *out = iface;
+    IClassFactory_AddRef(iface);
+    return S_OK;
+}
+static ULONG WINAPI factory_AddRef(IClassFactory *iface) { return InterlockedIncrement(&factory_refs); }
+static ULONG WINAPI factory_Release(IClassFactory *iface) { return InterlockedDecrement(&factory_refs); }
+static HRESULT WINAPI factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID iid, void **out)
+{
+    struct asio_driver *driver;
+    char name[ASIO_DEVICE_NAME_SIZE];
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!iid) return E_INVALIDARG;
+    if (!asio_get_device_name(name)) return CLASS_E_CLASSNOTAVAILABLE;
+    if (!(driver = calloc(1, sizeof(*driver)))) return E_OUTOFMEMORY;
+    driver->iface.lpVtbl = &driver_vtbl;
+    strcpy(driver->name, name);
+    driver->refs = 1;
+    driver->rate = 48000;
+    InitializeCriticalSection(&driver->lock);
+    InitializeCriticalSection(&driver->position_lock);
+    InterlockedIncrement(&objects);
+    if (!(driver->ready = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        destroy_driver(driver);
+        return E_OUTOFMEMORY;
+    }
+    hr = driver_QueryInterface(&driver->iface, iid, out);
+    driver_Release(&driver->iface);
+    return hr;
+}
+static HRESULT WINAPI factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    if (lock) InterlockedIncrement(&server_locks);
+    else InterlockedDecrement(&server_locks);
+    return S_OK;
+}
+static const IClassFactoryVtbl factory_vtbl =
+    {factory_QueryInterface, factory_AddRef, factory_Release, factory_CreateInstance, factory_LockServer};
+static IClassFactory factory = {&factory_vtbl};
+
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID iid, void **out)
+{
+    TRACE("clsid %s, iid %s\n", debugstr_guid(clsid), debugstr_guid(iid));
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!clsid || !iid) return E_INVALIDARG;
+#ifndef _WIN64
+    return CLASS_E_CLASSNOTAVAILABLE;
+#endif
+    if (!IsEqualGUID(clsid, &CLSID_ProtonASIO)) return CLASS_E_CLASSNOTAVAILABLE;
+    return factory_QueryInterface(&factory, iid, out);
+}
+
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    return objects || factory_refs || server_locks ? S_FALSE : S_OK;
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls(instance);
+    }
+    return TRUE;
+}

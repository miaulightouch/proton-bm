+    }
+
+    error = driver->lpVtbl->getChannels(driver, &input_channels, &output_channels);
+    ok(error == ASE_OK, "GetChannels failed: %ld.\n", error);
+    if (error != ASE_OK)
+        goto done;
+    ok(input_channels == 0, "Driver exposes %ld input channels.\n", input_channels);
+    ok(output_channels > 0, "Driver exposes no output channels.\n");
+    if (output_channels <= 0 || output_channels > 128)
+        goto done;
+
+    test_channel_metadata(driver, output_channels);
+    test_sample_rates(driver);
+    test_buffers_and_callbacks(driver, output_channels);
+    test_streaming_boundaries(driver, output_channels);
+    test_concurrent_dispose(driver);
+
+done:
+    error = driver->lpVtbl->disposeBuffers(driver);
+    ok(error == ASE_OK || error == ASE_InvalidMode,
+            "Final DisposeBuffers returned %ld.\n", error);
+    return error == ASE_OK || error == ASE_InvalidMode
+            ? test_release_while_active(driver, output_channels, get_class_object, can_unload_now) : FALSE;
+}
+
+START_TEST(asio)
+{
+    HMODULE module;
+    dll_get_class_object_proc get_class_object;
+    dll_can_unload_now_proc can_unload_now;
+    IASIO *driver = NULL;
+    BOOL driver_consumed = FALSE;
+
+#ifndef _WIN64
+    skip("The Proton-BM ASIO driver is x64-only.\n");
+    return;
+#endif
+    CoInitialize(NULL);
+    module = LoadLibraryA("protonasio.dll");
+    if (!module)
+    {
+        skip("protonasio.dll is not available.\n");
+        CoUninitialize();
+        return;
+    }
+    get_class_object = (void *)GetProcAddress(module, "DllGetClassObject");
+    can_unload_now = (void *)GetProcAddress(module, "DllCanUnloadNow");
+    if (!get_class_object)
+    {
+        skip("protonasio.dll has no DllGetClassObject export.\n");
+        FreeLibrary(module);
+        CoUninitialize();
+        return;
+    }
+
+    test_factory(module, get_class_object, &driver);
+    if (driver)
+    {
+        driver_consumed = test_driver(driver, get_class_object, can_unload_now);
+        if (!driver_consumed)
+            driver->lpVtbl->Release(driver);
+        FreeLibrary(module);
+    }
+    CoUninitialize();
+}
diff --git a/dlls/protonasio/tests/registration.c b/dlls/protonasio/tests/registration.c
new file mode 100644
--- /dev/null
+++ b/dlls/protonasio/tests/registration.c
@@ -0,0 +1,644 @@
+/*
+ * Opt-in registry tests for the Proton-BM ASIO registration entry points.
+ *
+ * These tests deliberately refuse to touch the registry unless the caller
+ * sets PROTON_ASIO_TEST_REGISTRY=1.  The test runner must provide a private
+ * Wine prefix when enabling this switch.
+ */
+
+#define COBJMACROS
+
+#include "windows.h"
+#include "objbase.h"
+#include "../asio.h"
+#include "winreg.h"
+#include "wine/test.h"
+#include <string.h>
+
+typedef HRESULT (WINAPI *server_proc)(void);
+typedef HRESULT (WINAPI *dll_get_class_object_proc)(REFCLSID, REFIID, void **);
+
+static const WCHAR device_name_env[] = L"PROTON_ASIO_DEVICE_NAME";
+static const WCHAR clsid_text[] = L"{ba274ea3-1dd1-4593-a85a-aece49181f47}";
+static const WCHAR class_path[] = L"CLSID\\{ba274ea3-1dd1-4593-a85a-aece49181f47}";
+static const WCHAR class_inproc_path[] =
+        L"CLSID\\{ba274ea3-1dd1-4593-a85a-aece49181f47}\\InprocServer32";
+static const WCHAR generic_path[] = L"Software\\ASIO\\Proton-BM ASIO";
+static const WCHAR xonar_path[] = L"Software\\ASIO\\XONAR SOUND CARD(64)";
+static const WCHAR default_name[] = L"XONAR SOUND CARD(64)";
+static const WCHAR generic_name[] = L"Proton-BM ASIO";
+
+struct saved_environment
+{
+    WCHAR *value;
+    BOOL present;
+};
+
+struct registration_fixture
+{
+    WCHAR custom_name[32], case_name[32], old_name[32], foreign_name[32], conflict_name[32];
+    WCHAR custom_path[128], old_path[128], foreign_path[128], conflict_path[128];
+    WCHAR case_path[128];
+    WCHAR zero_path[128], boundary_name[32], boundary_path[128], overlong_name[33];
+    char custom_name_a[32], case_name_a[32], boundary_name_a[32];
+};
+
+static BOOL test_registry_enabled(void)
+{
+    WCHAR value[8];
+    DWORD length = GetEnvironmentVariableW(L"PROTON_ASIO_TEST_REGISTRY", value, ARRAY_SIZE(value));
+
+    return length == 1 && value[0] == '1';
+}
+
+static BOOL key_absent(HKEY root, const WCHAR *path, REGSAM view)
+{
+    HKEY key;
+    LSTATUS status = RegOpenKeyExW(root, path, 0, KEY_READ | view, &key);
+
+    if (status == ERROR_FILE_NOT_FOUND || status == ERROR_PATH_NOT_FOUND)
+        return TRUE;
+    if (status == ERROR_SUCCESS)
+        RegCloseKey(key);
+    return FALSE;
+}
+
+static BOOL read_string(HKEY root, const WCHAR *path, REGSAM view, const WCHAR *name,
+        WCHAR *value, DWORD count)
+{
+    HKEY key;
+    DWORD type, bytes = count * sizeof(*value);
+    LSTATUS status;
+
+    if (RegOpenKeyExW(root, path, 0, KEY_READ | view, &key) != ERROR_SUCCESS)
+        return FALSE;
+    status = RegQueryValueExW(key, name, NULL, &type, (BYTE *)value, &bytes);
+    RegCloseKey(key);
+    if (status != ERROR_SUCCESS || type != REG_SZ || !bytes || bytes > count * sizeof(*value))
+        return FALSE;
+    value[count - 1] = 0;
+    return value[bytes / sizeof(*value) - 1] == 0;
+}
+
+static BOOL check_asio_entry(const WCHAR *path, const WCHAR *description)
+{
+    WCHAR value[128];
+
+    return read_string(HKEY_LOCAL_MACHINE, path, KEY_WOW64_64KEY, L"CLSID", value, ARRAY_SIZE(value))
+            && !wcsicmp(value, clsid_text)
+            && read_string(HKEY_LOCAL_MACHINE, path, KEY_WOW64_64KEY,
+                    L"Description", value, ARRAY_SIZE(value))
+            && !lstrcmpW(value, description);
+}
+
+static BOOL check_asio_subkey_name(const WCHAR *expected)
+{
+    HKEY parent;
+    WCHAR name[256];
+    DWORD index = 0, length;
+    LSTATUS status;
+
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\ASIO", 0,
+            KEY_READ | KEY_WOW64_64KEY, &parent) != ERROR_SUCCESS)
+        return FALSE;
+    for (;;)
+    {
+        length = ARRAY_SIZE(name);
+        status = RegEnumKeyExW(parent, index++, name, &length, NULL, NULL, NULL, NULL);
+        if (status == ERROR_NO_MORE_ITEMS)
+            break;
+        if (status != ERROR_SUCCESS)
+        {
+            RegCloseKey(parent);
+            return FALSE;
+        }
+        if (!wcsicmp(name, expected))
+        {
+            BOOL exact = !lstrcmpW(name, expected);
+            RegCloseKey(parent);
+            return exact;
+        }
+    }
+    RegCloseKey(parent);
+    return FALSE;
+}
+
+static BOOL owned_entry(const WCHAR *path)
+{
+    WCHAR value[64];
+
+    return read_string(HKEY_LOCAL_MACHINE, path, KEY_WOW64_64KEY,
+            L"CLSID", value, ARRAY_SIZE(value)) && !wcsicmp(value, clsid_text);
+}
+
+static BOOL check_class_entry(void)
+{
+    WCHAR value[64];
+
+    return read_string(HKEY_CLASSES_ROOT, class_inproc_path, 0, NULL, value, ARRAY_SIZE(value))
+            && !lstrcmpW(value, L"protonasio.dll")
+            && read_string(HKEY_CLASSES_ROOT, class_inproc_path, 0,
+                    L"ThreadingModel", value, ARRAY_SIZE(value))
+            && !lstrcmpW(value, L"Both");
+}
+
+static BOOL check_foreign_class(void)
+{
+    WCHAR value[64];
+
+    return read_string(HKEY_CLASSES_ROOT, class_inproc_path, 0, NULL, value, ARRAY_SIZE(value))
+            && !lstrcmpW(value, L"foreignasio.dll");
+}
+
+static BOOL save_environment(const WCHAR *name, struct saved_environment *saved)
+{
+    WCHAR probe;
+    DWORD length;
+
+    saved->value = NULL;
+    saved->present = FALSE;
+    SetLastError(ERROR_SUCCESS);
+    length = GetEnvironmentVariableW(name, &probe, 1);
+    if (!length)
+    {
+        if (GetLastError() == ERROR_ENVVAR_NOT_FOUND)
+            return TRUE;
+        saved->value = HeapAlloc(GetProcessHeap(), 0, sizeof(*saved->value));
+        if (!saved->value)
+            return FALSE;
+        saved->value[0] = 0;
+        saved->present = TRUE;
+        return TRUE;
+    }
+
+    saved->value = HeapAlloc(GetProcessHeap(), 0, (length + 1) * sizeof(*saved->value));
+    if (!saved->value)
+        return FALSE;
+    if (!GetEnvironmentVariableW(name, saved->value, length + 1))
+    {
+        HeapFree(GetProcessHeap(), 0, saved->value);
+        saved->value = NULL;
+        return FALSE;
+    }
+    saved->present = TRUE;
+    return TRUE;
+}
+
+static void restore_environment(const WCHAR *name, struct saved_environment *saved)
+{
+    SetEnvironmentVariableW(name, saved->present ? saved->value : NULL);
+    HeapFree(GetProcessHeap(), 0, saved->value);
+    saved->value = NULL;
+}
+
+static BOOL set_device_name(const WCHAR *value)
+{
+    return SetEnvironmentVariableW(device_name_env, value);
+}
+
+static void delete_asio_entry(const WCHAR *path)
+{
+    const WCHAR *name = wcsrchr(path, '\\');
+    HKEY parent;
+
+    if (!name || RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\ASIO", 0,
+            KEY_WRITE | DELETE | KEY_WOW64_64KEY, &parent) != ERROR_SUCCESS)
+        return;
+    RegDeleteTreeW(parent, name + 1);
+    RegCloseKey(parent);
+}
+
+static void delete_owned_asio_entry(const WCHAR *path)
+{
+    if (owned_entry(path))
+        delete_asio_entry(path);
+}
+
+static BOOL create_entry(const WCHAR *path, const WCHAR *clsid, const WCHAR *description)
+{
+    HKEY key;
+    LSTATUS status;
+
+    status = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0,
+            KEY_WRITE | KEY_WOW64_64KEY, NULL, &key, NULL);
+    if (status != ERROR_SUCCESS)
+        return FALSE;
+    status = RegSetValueExW(key, L"CLSID", 0, REG_SZ, (const BYTE *)clsid,
+            (lstrlenW(clsid) + 1) * sizeof(*clsid));
+    if (!status)
+        status = RegSetValueExW(key, L"Description", 0, REG_SZ,
+                (const BYTE *)description, (lstrlenW(description) + 1) * sizeof(*description));
+    RegCloseKey(key);
+    if (status != ERROR_SUCCESS)
+        delete_owned_asio_entry(path);
+    return status == ERROR_SUCCESS;
+}
+
+static BOOL create_foreign_entry(const WCHAR *path)
+{
+    return create_entry(path, L"{b8f42b5d-7a06-4c7a-a747-bb2dc7a2c77e}",
+            L"Unrelated ASIO test alias");
+}
+
+static BOOL check_foreign_entry(const WCHAR *path)
+{
+    static const WCHAR unrelated_clsid[] = L"{b8f42b5d-7a06-4c7a-a747-bb2dc7a2c77e}";
+    WCHAR value[128];
+
+    return read_string(HKEY_LOCAL_MACHINE, path, KEY_WOW64_64KEY,
+            L"CLSID", value, ARRAY_SIZE(value)) && !wcsicmp(value, unrelated_clsid)
+            && read_string(HKEY_LOCAL_MACHINE, path, KEY_WOW64_64KEY,
+                    L"Description", value, ARRAY_SIZE(value))
+            && !wcsicmp(value, L"Unrelated ASIO test alias");
+}
+
+static BOOL create_foreign_class(void)
+{
+    HKEY key, inproc;
+    LSTATUS status;
+
+    status = RegCreateKeyExW(HKEY_CLASSES_ROOT, class_path, 0, NULL, 0,
+            KEY_WRITE, NULL, &key, NULL);
+    if (status != ERROR_SUCCESS)
+        return FALSE;
+    status = RegCreateKeyExW(key, L"InprocServer32", 0, NULL, 0,
+            KEY_WRITE, NULL, &inproc, NULL);
+    if (!status)
+    {
+        status = RegSetValueExW(inproc, NULL, 0, REG_SZ,
+                (const BYTE *)L"foreignasio.dll", sizeof(L"foreignasio.dll"));
+        RegCloseKey(inproc);
+    }
+    RegCloseKey(key);
+    if (status != ERROR_SUCCESS)
+        RegDeleteTreeW(HKEY_CLASSES_ROOT, class_path);
+    return status == ERROR_SUCCESS;
+}
+
+static void delete_foreign_class(void)
+{
+    if (check_foreign_class() || check_class_entry())
+        RegDeleteTreeW(HKEY_CLASSES_ROOT, class_path);
+}
+
+static BOOL all_owned_entries_absent(const struct registration_fixture *fixture)
+{
+    return key_absent(HKEY_LOCAL_MACHINE, generic_path, KEY_WOW64_64KEY)
+            && key_absent(HKEY_LOCAL_MACHINE, xonar_path, KEY_WOW64_64KEY)
+            && key_absent(HKEY_LOCAL_MACHINE, fixture->custom_path, KEY_WOW64_64KEY)
+            && key_absent(HKEY_LOCAL_MACHINE, fixture->old_path, KEY_WOW64_64KEY)
+            && key_absent(HKEY_LOCAL_MACHINE, fixture->zero_path, KEY_WOW64_64KEY)
+            && key_absent(HKEY_LOCAL_MACHINE, fixture->boundary_path, KEY_WOW64_64KEY)
+            && key_absent(HKEY_CLASSES_ROOT, class_path, 0);
+}
+
+static void test_registered_name(const char *expected)
+{
+    IASIO *driver = NULL;
+    char name[32] = {0};
+    HRESULT hr;
+
+    CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_ProtonASIO, NULL, CLSCTX_INPROC_SERVER,
+                          &CLSID_ProtonASIO, (void **)&driver);
+    ok(hr == S_OK, "Registered ASIO COM activation failed: %#lx.\n", hr);
+    if (driver)
+    {
+        driver->lpVtbl->getDriverName(driver, name);
+        ok(!strcmp(name, expected), "Unexpected ASIO name %s, expected %s.\n", name, expected);
+        driver->lpVtbl->Release(driver);
+    }
+    CoUninitialize();
+}
+
+static void test_invalid_name(server_proc register_server,
+        const struct registration_fixture *fixture, const WCHAR *name, const char *label)
+{
+    HRESULT hr;
+
+    ok(set_device_name(L"0"), "Could not set valid name before %s.\n", label);
+    hr = register_server();
+    ok(hr == S_OK, "Valid registration before %s returned %#lx.\n", label, hr);
+    ok(check_asio_entry(fixture->zero_path, L"0"),
+            "Valid name was not registered before %s.\n", label);
+
+    ok(set_device_name(name), "Could not set invalid name for %s.\n", label);
+    hr = register_server();
+    ok(hr == S_OK, "Invalid name %s returned %#lx.\n", label, hr);
+    ok(all_owned_entries_absent(fixture),
+            "Invalid name %s did not remove all owned ASIO entries.\n", label);
+    ok(check_foreign_entry(fixture->foreign_path),
+            "Invalid name %s removed the foreign ASIO entry.\n", label);
+}
+
+static void test_registration(server_proc register_server, server_proc unregister_server,
+        dll_get_class_object_proc get_class_object, struct registration_fixture *fixture)
+{
+    struct saved_environment device_env;
+    IClassFactory *factory = NULL;
+    IASIO *driver = NULL;
+    HRESULT hr;
+    BOOL generic_created = FALSE, xonar_created = FALSE, old_created = FALSE;
+    BOOL foreign_created = FALSE, conflict_created = FALSE, foreign_class_created = FALSE;
+    static const WCHAR leading_space[] = L" leading";
+    static const WCHAR trailing_space[] = L"trailing ";
+    static const WCHAR control_name[] = L"bad\tname";
+    static const WCHAR backslash_name[] = L"bad\\name";
+    static const WCHAR nonascii_name[] = L"bad\u00e9";
+    static const WCHAR empty_name[] = L"";
+
+    if (!save_environment(device_name_env, &device_env))
+    {
+        skip("Could not save ASIO device name environment state.\n");
+        return;
+    }
+
+    if (!create_entry(generic_path, clsid_text, generic_name))
+    {
+        skip("Could not create the isolated legacy generic ASIO alias.\n");
+        goto done;
+    }
+    generic_created = TRUE;
+    if (!create_entry(xonar_path, clsid_text, default_name))
+    {
+        skip("Could not create the isolated legacy Xonar ASIO alias.\n");
+        goto done;
+    }
+    xonar_created = TRUE;
+    if (!create_entry(fixture->old_path, clsid_text, L"Old custom ASIO alias"))
+    {
+        skip("Could not create the isolated old custom ASIO alias.\n");
+        goto done;
+    }
+    old_created = TRUE;
+    if (!create_foreign_entry(fixture->foreign_path))
+    {
+        skip("Could not create the isolated foreign ASIO alias.\n");
+        goto done;
+    }
+    foreign_created = TRUE;
+
+    ok(set_device_name(fixture->custom_name), "Could not set the custom ASIO name.\n");
+    hr = register_server();
+    ok(hr == S_OK, "Custom DllRegisterServer failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(check_asio_entry(fixture->custom_path, fixture->custom_name),
+                "Custom ASIO entry was not registered correctly.\n");
+        ok(key_absent(HKEY_LOCAL_MACHINE, generic_path, KEY_WOW64_64KEY),
+                "Legacy generic ASIO entry survived custom registration.\n");
+        ok(key_absent(HKEY_LOCAL_MACHINE, xonar_path, KEY_WOW64_64KEY),
+                "Legacy Xonar ASIO entry survived custom registration.\n");
+        ok(key_absent(HKEY_LOCAL_MACHINE, fixture->old_path, KEY_WOW64_64KEY),
+                "Old custom ASIO entry survived custom registration.\n");
+        ok(check_class_entry(), "Custom ASIO CLSID registration is incomplete.\n");
+        test_registered_name(fixture->custom_name_a);
+    }
+
+    hr = register_server();
+    ok(hr == S_OK, "Repeated custom DllRegisterServer failed: %#lx.\n", hr);
+    ok(check_asio_entry(fixture->custom_path, fixture->custom_name),
+            "Repeated custom registration changed the ASIO entry.\n");
+    ok(check_foreign_entry(fixture->foreign_path),
+            "Repeated custom registration removed the foreign ASIO entry.\n");
+
+    ok(set_device_name(fixture->case_name), "Could not set the case-only ASIO name.\n");
+    hr = register_server();
+    ok(hr == S_OK, "Case-only DllRegisterServer failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(check_asio_subkey_name(fixture->case_name),
+                "Case-only registration kept the wrong ASIO subkey spelling.\n");
+        ok(check_asio_entry(fixture->case_path, fixture->case_name),
+                "Case-only ASIO registration has the wrong Description or CLSID.\n");
+        test_registered_name(fixture->case_name_a);
+        ok(check_foreign_entry(fixture->foreign_path),
+                "Case-only registration removed the foreign ASIO entry.\n");
+    }
+
+    hr = get_class_object(&CLSID_ProtonASIO, &IID_IClassFactory, (void **)&factory);
+    ok(hr == S_OK, "Cached DllGetClassObject failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IClassFactory_CreateInstance(factory, NULL, &CLSID_ProtonASIO, (void **)&driver);
+        ok(hr == S_OK, "Cached factory CreateInstance failed: %#lx.\n", hr);
+        if (driver)
+        {
+            char name[32] = {0};
+            driver->lpVtbl->getDriverName(driver, name);
+            ok(!strcmp(name, fixture->case_name_a),
+                    "Cached factory returned %s, expected %s.\n", name, fixture->case_name_a);
+            ok(set_device_name(L"0"), "Could not change the ASIO name after object creation.\n");
+            memset(name, 0, sizeof(name));
+            driver->lpVtbl->getDriverName(driver, name);
+            ok(!strcmp(name, fixture->case_name_a),
+                    "ASIO object name changed after creation: %s.\n", name);
+            driver->lpVtbl->Release(driver);
+            driver = NULL;
+        }
+
+        ok(set_device_name(empty_name), "Could not set the explicit empty ASIO name.\n");
+        hr = register_server();
+        ok(hr == S_OK, "Explicit empty name cleanup failed: %#lx.\n", hr);
+        ok(all_owned_entries_absent(fixture),
+                "Explicit empty name left an owned ASIO registration.\n");
+        ok(check_foreign_entry(fixture->foreign_path),
+                "Explicit empty name removed the foreign ASIO entry.\n");
+        hr = IClassFactory_CreateInstance(factory, NULL, &CLSID_ProtonASIO, (void **)&driver);
+        ok(hr == CLASS_E_CLASSNOTAVAILABLE,
+                "Cached factory created an ASIO object after invalidation: %#lx.\n", hr);
+        ok(!driver, "Cached factory returned an object after invalidation: %p.\n", driver);
+        IClassFactory_Release(factory);
+        factory = NULL;
+    }
+
+    ok(set_device_name(NULL), "Could not unset the ASIO device name.\n");
+    hr = register_server();
+    ok(hr == S_OK, "Unset-name DllRegisterServer failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(check_asio_entry(xonar_path, default_name),
+                "Unset name did not register the default Xonar ASIO entry.\n");
+        ok(key_absent(HKEY_LOCAL_MACHINE, generic_path, KEY_WOW64_64KEY),
+                "Generic ASIO alias appeared for the default name.\n");
+        ok(key_absent(HKEY_LOCAL_MACHINE, fixture->custom_path, KEY_WOW64_64KEY),
+                "Custom ASIO alias survived the rename back to default.\n");
+        ok(check_class_entry(), "Default ASIO CLSID registration is incomplete.\n");
+        test_registered_name("XONAR SOUND CARD(64)");
+    }
+    hr = register_server();
+    ok(hr == S_OK, "Repeated default DllRegisterServer failed: %#lx.\n", hr);
+    ok(check_asio_entry(xonar_path, default_name),
+            "Repeated default registration changed the Xonar ASIO entry.\n");
+
+    test_invalid_name(register_server, fixture, leading_space, "leading-space name");
+    test_invalid_name(register_server, fixture, trailing_space, "trailing-space name");
+    test_invalid_name(register_server, fixture, control_name, "control-character name");
+    test_invalid_name(register_server, fixture, backslash_name, "backslash name");
+    test_invalid_name(register_server, fixture, nonascii_name, "non-ASCII name");
+    test_invalid_name(register_server, fixture, fixture->overlong_name, "32-byte name");
+
+    ok(set_device_name(fixture->boundary_name), "Could not set the 31-byte ASIO name.\n");
+    hr = register_server();
+    ok(hr == S_OK, "31-byte DllRegisterServer failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(check_asio_entry(fixture->boundary_path, fixture->boundary_name),
+                "31-byte ASIO entry was not registered correctly.\n");
+        test_registered_name(fixture->boundary_name_a);
+    }
+
+    ok(set_device_name(L"0"), "Could not set the zero ASIO name.\n");
+    hr = register_server();
+    ok(hr == S_OK, "Zero-name DllRegisterServer failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(check_asio_entry(fixture->zero_path, L"0"),
+                "The zero ASIO name was treated as disabled.\n");
+        ok(key_absent(HKEY_LOCAL_MACHINE, fixture->boundary_path, KEY_WOW64_64KEY),
+                "31-byte ASIO alias survived the zero-name rename.\n");
+        test_registered_name("0");
+    }
+
+    ok(set_device_name(L""), "Could not set the empty ASIO name before conflict tests.\n");
+    hr = register_server();
+    ok(hr == S_OK, "Conflict-test cleanup failed: %#lx.\n", hr);
+    ok(all_owned_entries_absent(fixture), "Conflict tests started with owned ASIO entries.\n");
+    if (!create_foreign_entry(fixture->conflict_path))
+        skip("Could not create the foreign target conflict alias.\n");
+    else
+    {
+        conflict_created = TRUE;
+        ok(set_device_name(fixture->conflict_name), "Could not set the conflict ASIO name.\n");
+        hr = register_server();
+        ok(hr == HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS),
+                "Foreign target conflict returned %#lx.\n", hr);
+        ok(check_foreign_entry(fixture->conflict_path),
+                "Foreign target conflict was overwritten.\n");
+        ok(key_absent(HKEY_CLASSES_ROOT, class_path, 0),
+                "Foreign target conflict created the ASIO class.\n");
+    }
+    if (conflict_created)
+    {
+        delete_asio_entry(fixture->conflict_path);
+        conflict_created = FALSE;
+    }
+
+    if (!create_foreign_class())
+        skip("Could not create the foreign ASIO class conflict.\n");
+    else
+    {
+        foreign_class_created = TRUE;
+        ok(set_device_name(fixture->custom_name), "Could not set the class-conflict ASIO name.\n");
+        hr = register_server();
+        ok(hr == HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS),
+                "Foreign class conflict returned %#lx.\n", hr);
+        ok(check_foreign_class(), "Foreign ASIO class was overwritten.\n");
+        ok(key_absent(HKEY_LOCAL_MACHINE, fixture->custom_path, KEY_WOW64_64KEY),
+                "Foreign class conflict created an ASIO target.\n");
+    }
+
+done:
+    if (driver)
+        driver->lpVtbl->Release(driver);
+    if (factory)
+        IClassFactory_Release(factory);
+    if (foreign_class_created)
+        delete_foreign_class();
+    if (conflict_created)
+        delete_asio_entry(fixture->conflict_path);
+    if (foreign_created)
+        delete_asio_entry(fixture->foreign_path);
+    set_device_name(NULL);
+    hr = unregister_server();
+    ok(hr == S_OK, "Final ASIO registration cleanup failed: %#lx.\n", hr);
+    if (generic_created)
+        delete_owned_asio_entry(generic_path);
+    if (xonar_created)
+        delete_owned_asio_entry(xonar_path);
+    if (old_created)
+        delete_owned_asio_entry(fixture->old_path);
+    delete_owned_asio_entry(fixture->custom_path);
+    delete_owned_asio_entry(fixture->zero_path);
+    delete_owned_asio_entry(fixture->boundary_path);
+    restore_environment(device_name_env, &device_env);
+}
+
+START_TEST(registration)
+{
+    HMODULE module;
+    server_proc register_server, unregister_server;
+    dll_get_class_object_proc get_class_object;
+    struct registration_fixture fixture;
+    DWORD process_id = GetCurrentProcessId();
+    unsigned int i;
+
+#ifndef _WIN64
+    skip("The Proton-BM ASIO registration is x64-only.\n");
+    return;
+#endif
+    if (!test_registry_enabled())
+    {
+        skip("Registry mutation disabled; set PROTON_ASIO_TEST_REGISTRY=1 in a private prefix.\n");
+        return;
+    }
+
+    memset(&fixture, 0, sizeof(fixture));
+    wsprintfW(fixture.custom_name, L"BM/%lu", process_id);
+    wsprintfW(fixture.case_name, L"bm/%lu", process_id);
+    wsprintfW(fixture.old_name, L"BM-old-%lu", process_id);
+    wsprintfW(fixture.foreign_name, L"BM-foreign-%lu", process_id);
+    wsprintfW(fixture.conflict_name, L"BM-conflict-%lu", process_id);
+    wsprintfW(fixture.custom_path, L"Software\\ASIO\\%s", fixture.custom_name);
+    wsprintfW(fixture.case_path, L"Software\\ASIO\\%s", fixture.case_name);
+    wsprintfW(fixture.old_path, L"Software\\ASIO\\%s", fixture.old_name);
+    wsprintfW(fixture.foreign_path, L"Software\\ASIO\\%s", fixture.foreign_name);
+    wsprintfW(fixture.conflict_path, L"Software\\ASIO\\%s", fixture.conflict_name);
+    wsprintfW(fixture.zero_path, L"Software\\ASIO\\0");
+    for (i = 0; i < 31; ++i)
+    {
+        fixture.boundary_name[i] = L'A';
+        fixture.boundary_name_a[i] = 'A';
+    }
+    fixture.boundary_name[31] = 0;
+    fixture.boundary_name_a[31] = 0;
+    for (i = 0; i < 32; ++i)
+        fixture.overlong_name[i] = L'B';
+    fixture.overlong_name[32] = 0;
+    wsprintfW(fixture.boundary_path, L"Software\\ASIO\\%s", fixture.boundary_name);
+    wsprintfA(fixture.custom_name_a, "BM/%lu", process_id);
+    wsprintfA(fixture.case_name_a, "bm/%lu", process_id);
+
+    if (!key_absent(HKEY_LOCAL_MACHINE, generic_path, KEY_WOW64_64KEY)
+            || !key_absent(HKEY_LOCAL_MACHINE, xonar_path, KEY_WOW64_64KEY)
+            || !key_absent(HKEY_CLASSES_ROOT, class_path, 0)
+            || !key_absent(HKEY_LOCAL_MACHINE, fixture.custom_path, KEY_WOW64_64KEY)
+            || !key_absent(HKEY_LOCAL_MACHINE, fixture.old_path, KEY_WOW64_64KEY)
+            || !key_absent(HKEY_LOCAL_MACHINE, fixture.foreign_path, KEY_WOW64_64KEY)
+            || !key_absent(HKEY_LOCAL_MACHINE, fixture.conflict_path, KEY_WOW64_64KEY)
+            || !key_absent(HKEY_LOCAL_MACHINE, fixture.zero_path, KEY_WOW64_64KEY)
+            || !key_absent(HKEY_LOCAL_MACHINE, fixture.boundary_path, KEY_WOW64_64KEY))
+    {
+        skip("ASIO registry targets already exist; refusing to mutate them.\n");
+        return;
+    }
+
+    module = LoadLibraryA("protonasio.dll");
+    if (!module)
+    {
+        skip("protonasio.dll is not available.\n");
+        return;
+    }
+    register_server = (void *)GetProcAddress(module, "DllRegisterServer");
+    unregister_server = (void *)GetProcAddress(module, "DllUnregisterServer");
+    get_class_object = (void *)GetProcAddress(module, "DllGetClassObject");
+    if (!register_server || !unregister_server || !get_class_object)
+    {
+        skip("protonasio.dll does not export the ASIO registration/class entry points.\n");
+        FreeLibrary(module);
+        return;
+    }
+
+    test_registration(register_server, unregister_server, get_class_object, &fixture);
+    FreeLibrary(module);
+}
diff --git a/dlls/protonasio/tests/signal.c b/dlls/protonasio/tests/signal.c
new file mode 100644
--- /dev/null
+++ b/dlls/protonasio/tests/signal.c
@@ -0,0 +1,559 @@
+/*
+ * Isolated signal-path regression test for the Proton-BM ASIO driver.
+ *
+ * The runner puts PipeWire in a private graph and arms this test only after
+ * it has verified the ASIO-to-null-sink links.  The callback therefore never
+ * needs to touch a physical endpoint while this test is running.
+ */
+
+#define COBJMACROS
+
+#include "windows.h"
+#include "objbase.h"
+#include "unknwn.h"
+#include "wine/test.h"
+#include "../asio.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef HRESULT (WINAPI *dll_get_class_object_proc)(REFCLSID, REFIID, void **);
+
+enum
+{
+    kAsioSelectorSupported = 1,
+    kAsioSupportsTimeInfo = 7,
+    signal_channels = 8,
+    signal_buffer_frames = 256,
+    signal_pilot_frames = 512,
+    signal_prefill_frames = signal_buffer_frames,
+};
+
+static const double signal_frequencies[signal_channels] =
+    {197.0, 311.0, 467.0, 683.0, 937.0, 1259.0, 1697.0, 2111.0};
+
+#define SIGNAL_PI 3.14159265358979323846
+#define SIGNAL_AMPLITUDE 0.65
+#define SIGNAL_PREFILL_AMPLITUDE 0.55
+#define SIGNAL_PILOT_AMPLITUDE 0.33
+
+static struct
+{
+    ASIOBufferInfo *buffers;
+    LONG channels;
+    LONG buffer_frames;
+    double rate;
+    HANDLE callback_event;
+    volatile LONG callbacks;
+    volatile LONG callback_errors;
+    volatile LONG restarts;
+    volatile LONG restart_callbacks;
+    UINT64 frame_index;
+    UINT64 generated_frames;
+} signal_state;
+
+static void get_environment_path(const char *name, const char *fallback,
+        char *path, DWORD path_size)
+{
+    DWORD length = GetEnvironmentVariableA(name, path, path_size);
+
+    if (!length || length >= path_size)
+        strcpy(path, fallback);
+}
+
+static BOOL write_text_file(const char *path, const char *text)
+{
+    HANDLE file;
+    DWORD written, length = (DWORD)strlen(text);
+    BOOL result;
+
+    file = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+            NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return FALSE;
+    result = WriteFile(file, text, length, &written, NULL) && written == length;
+    CloseHandle(file);
+    return result;
+}
+
+static void write_signal_state(const char *path, const char *state,
+        double rate, LONG callbacks, LONG callback_errors, UINT64 generated_frames)
+{
+    char text[1024];
+
+    snprintf(text, sizeof(text),
+            "state=%s\n"
+            "rate=%.0f\n"
+            "capture_rate=48000\n"
+            "channels=%d\n"
+            "buffer_frames=%d\n"
+            "prefill_frames=%d\n"
+            "prefill_amplitude=%.8f\n"
+            "pilot_frames=%d\n"
+            "amplitude=%.8f\n"
+            "pilot_amplitude=%.8f\n"
+            "callbacks=%ld\n"
+            "callback_errors=%ld\n"
+            "restarts=%ld\n"
+            "restart_callbacks=%ld\n"
+            "generated_frames=%llu\n"
+            "frequencies=197,311,467,683,937,1259,1697,2111\n",
+            state, rate, signal_channels, signal_buffer_frames, signal_prefill_frames,
+            SIGNAL_PREFILL_AMPLITUDE, signal_pilot_frames, SIGNAL_AMPLITUDE,
+            SIGNAL_PILOT_AMPLITUDE, callbacks, callback_errors,
+            signal_state.restarts, signal_state.restart_callbacks,
+            (unsigned long long)generated_frames);
+    if (!write_text_file(path, text))
+        trace("Could not write signal metadata to %s.\n", path);
+}
+
+static DWORD signal_duration(void)
+{
+    char value[32];
+    DWORD length = GetEnvironmentVariableA("PROTON_ASIO_SIGNAL_DURATION_MS",
+            value, sizeof(value));
+    unsigned long result;
+
+    if (!length || length >= sizeof(value))
+        return 3500;
+    result = strtoul(value, NULL, 10);
+    return result >= 1000 && result <= 30000 ? (DWORD)result : 3500;
+}
+
+static void pack_int24(double value, BYTE *destination)
+{
+    LONG sample = (LONG)(value * 8388607.0);
+
+    if (sample > 8388607)
+        sample = 8388607;
+    if (sample < -8388608)
+        sample = -8388608;
+    destination[0] = (BYTE)sample;
+    destination[1] = (BYTE)(sample >> 8);
+    destination[2] = (BYTE)(sample >> 16);
+}
+
+static void signal_callback(LONG index)
+{
+    LONG channel, frame;
+
+    if (index < 0 || index > 1 || !signal_state.buffers)
+    {
+        InterlockedIncrement(&signal_state.callback_errors);
+        return;
+    }
+
+    for (frame = 0; frame < signal_state.buffer_frames; ++frame)
+    {
+        UINT64 sample_index = signal_state.frame_index++;
+        double sample_time = sample_index >= signal_pilot_frames
+                ? (double)(sample_index - signal_pilot_frames) / signal_state.rate : 0.0;
+
+        signal_state.generated_frames++;
+        for (channel = 0; channel < signal_state.channels; ++channel)
+        {
+            BYTE *destination = (BYTE *)signal_state.buffers[channel].buffers[index]
+                    + frame * 3;
+            double value;
+
+            if (sample_index < signal_pilot_frames)
+                value = SIGNAL_PILOT_AMPLITUDE;
+            else
+                value = SIGNAL_AMPLITUDE * sin(2.0 * SIGNAL_PI
+                        * signal_frequencies[channel] * sample_time);
+            pack_int24(value, destination);
+        }
+    }
+    InterlockedIncrement(&signal_state.callbacks);
+    if (signal_state.callback_event)
+        SetEvent(signal_state.callback_event);
+}
+
+static void prefill_signal_buffer(void)
+{
+    LONG channel, frame;
+
+    if (!signal_state.buffers)
+        return;
+    for (channel = 0; channel < signal_state.channels; ++channel)
+        for (frame = 0; frame < signal_prefill_frames; ++frame)
+            pack_int24(SIGNAL_PREFILL_AMPLITUDE,
+                    (BYTE *)signal_state.buffers[channel].buffers[1] + frame * 3);
+}
+
+static void __cdecl callback_buffer_switch(LONG index, LONG direct_process)
+{
+    (void)direct_process;
+    signal_callback(index);
+}
+
+static void __cdecl callback_sample_rate_changed(double rate)
+{
+    (void)rate;
+}
+
+static LONG __cdecl callback_asio_message(LONG selector, LONG value,
+        void *message, double *opt)
+{
+    (void)message;
+    (void)opt;
+    if (selector == kAsioSupportsTimeInfo
+            || (selector == kAsioSelectorSupported && value == kAsioSupportsTimeInfo))
+        return 1;
+    return 0;
+}
+
+static ASIOTime *__cdecl callback_buffer_switch_time_info(ASIOTime *params,
+        LONG index, LONG direct_process)
+{
+    (void)direct_process;
+    signal_callback(index);
+    return params;
+}
+
+static ASIOCallbacks signal_callbacks =
+{
+    callback_buffer_switch,
+    callback_sample_rate_changed,
+    callback_asio_message,
+    callback_buffer_switch_time_info,
+};
+
+static BOOL wait_for_arm(const char *arm_path, DWORD timeout)
+{
+    DWORD elapsed = 0;
+
+    while (elapsed < timeout)
+    {
+        if (GetFileAttributesA(arm_path) != INVALID_FILE_ATTRIBUTES)
+            return TRUE;
+        Sleep(10);
+        elapsed += 10;
+    }
+    return GetFileAttributesA(arm_path) != INVALID_FILE_ATTRIBUTES;
+}
+
+static BOOL signal_release_mode(void)
+{
+    char value[8];
+    DWORD length = GetEnvironmentVariableA("PROTON_ASIO_SIGNAL_RELEASE",
+            value, sizeof(value));
+
+    return length == 1 && value[0] == '1';
+}
+
+static BOOL signal_restart_mode(void)
+{
+    char value[8];
+    DWORD length = GetEnvironmentVariableA("PROTON_ASIO_SIGNAL_RESTART",
+            value, sizeof(value));
+
+    return length == 1 && value[0] == '1';
+}
+
+START_TEST(signal)
+{
+    HMODULE module = NULL;
+    IClassFactory *factory = NULL;
+    IASIO *driver = NULL;
+    ASIOBufferInfo buffers[signal_channels];
+    dll_get_class_object_proc get_class_object;
+    char enabled[8], meta_path[MAX_PATH], ready_path[MAX_PATH], arm_path[MAX_PATH];
+    char active_path[MAX_PATH], disconnect_path[MAX_PATH], released_path[MAX_PATH];
+    char rate_value[32];
+    double rate = 44100.0, current_rate;
+    LONG inputs, outputs, min_size, max_size, preferred_size, granularity;
+    LONG error, i, callbacks, callback_errors;
+    DWORD length, duration;
+    BOOL started = FALSE, buffers_created = FALSE, release_mode, restart_mode;
+    HRESULT hr;
+
+#ifndef _WIN64
+    win_skip("The Proton-BM ASIO signal test is x64-only.\n");
+    return;
+#endif
+
+    length = GetEnvironmentVariableA("PROTON_ASIO_TEST_SIGNAL", enabled, sizeof(enabled));
+    if (length != 1 || enabled[0] != '1')
+    {
+        win_skip("Set PROTON_ASIO_TEST_SIGNAL=1 to run the isolated signal test.\n");
+        return;
+    }
+
+    length = GetEnvironmentVariableA("PROTON_ASIO_SIGNAL_RATE", rate_value,
+            sizeof(rate_value));
+    if (length && length < sizeof(rate_value))
+    {
+        rate = strtod(rate_value, NULL);
+        if (rate != 44100.0 && rate != 48000.0 && rate != 192000.0)
+            rate = 44100.0;
+    }
+    get_environment_path("PROTON_ASIO_SIGNAL_META", "C:\\protonasio-signal-meta.txt",
+            meta_path, sizeof(meta_path));
+    get_environment_path("PROTON_ASIO_SIGNAL_READY", "C:\\protonasio-signal-ready",
+            ready_path, sizeof(ready_path));
+    get_environment_path("PROTON_ASIO_SIGNAL_ARM", "C:\\protonasio-signal-arm",
+            arm_path, sizeof(arm_path));
+    get_environment_path("PROTON_ASIO_SIGNAL_ACTIVE", "C:\\protonasio-signal-active",
+            active_path, sizeof(active_path));
+    get_environment_path("PROTON_ASIO_SIGNAL_DISCONNECT", "C:\\protonasio-signal-disconnect",
+            disconnect_path, sizeof(disconnect_path));
+    get_environment_path("PROTON_ASIO_SIGNAL_RELEASED", "C:\\protonasio-signal-released",
+            released_path, sizeof(released_path));
+    release_mode = signal_release_mode();
+    restart_mode = signal_restart_mode();
+    DeleteFileA(meta_path);
+    DeleteFileA(ready_path);
+    DeleteFileA(arm_path);
+    DeleteFileA(active_path);
+    DeleteFileA(disconnect_path);
+    DeleteFileA(released_path);
+
+    CoInitialize(NULL);
+    module = LoadLibraryA("protonasio.dll");
+    if (!module)
+    {
+        win_skip("protonasio.dll is not available.\n");
+        goto done;
+    }
+    get_class_object = (void *)GetProcAddress(module, "DllGetClassObject");
+    if (!get_class_object)
+    {
+        win_skip("protonasio.dll has no DllGetClassObject export.\n");
+        goto done;
+    }
+    hr = get_class_object(&CLSID_ProtonASIO, &IID_IClassFactory, (void **)&factory);
+    ok(hr == S_OK, "DllGetClassObject failed: %#lx.\n", hr);
+    if (FAILED(hr))
+        goto done;
+    hr = IClassFactory_CreateInstance(factory, NULL, &CLSID_ProtonASIO,
+            (void **)&driver);
+    ok(hr == S_OK, "CreateInstance failed: %#lx.\n", hr);
+    IClassFactory_Release(factory);
+    factory = NULL;
+    if (FAILED(hr))
+        goto done;
+
+    error = driver->lpVtbl->init(driver, NULL);
+    if (!error)
+    {
+        win_skip("Private PipeWire graph is unavailable.\n");
+        goto done;
+    }
+    error = driver->lpVtbl->getChannels(driver, &inputs, &outputs);
+    ok(error == ASE_OK && inputs == 0 && outputs == signal_channels,
+            "Unexpected channel layout: error %ld, inputs %ld, outputs %ld.\n",
+            error, inputs, outputs);
+    if (error != ASE_OK || inputs || outputs != signal_channels)
+        goto dispose;
+    error = driver->lpVtbl->canSampleRate(driver, rate);
+    ok(error == ASE_OK, "CanSampleRate(%.0f) failed: %ld.\n", rate, error);
+    if (error != ASE_OK)
+        goto dispose;
+    error = driver->lpVtbl->setSampleRate(driver, rate);
+    ok(error == ASE_OK, "SetSampleRate(%.0f) failed: %ld.\n", rate, error);
+    if (error != ASE_OK)
+        goto dispose;
+    error = driver->lpVtbl->getSampleRate(driver, &current_rate);
+    ok(error == ASE_OK && current_rate == rate,
+            "GetSampleRate returned %ld and %.0f Hz after %.0f Hz request.\n",
+            error, current_rate, rate);
+
+    error = driver->lpVtbl->getBufferSize(driver, &min_size, &max_size,
+            &preferred_size, &granularity);
+    ok(error == ASE_OK && min_size <= signal_buffer_frames
+            && signal_buffer_frames <= max_size,
+            "Buffer negotiation failed: %ld, %ld/%ld/%ld/%ld.\n", error,
+            min_size, max_size, preferred_size, granularity);
+    if (error != ASE_OK || min_size > signal_buffer_frames
+            || signal_buffer_frames > max_size)
+        goto dispose;
+
+    for (i = 0; i < signal_channels; ++i)
+    {
+        ASIOChannelInfo info;
+
+        memset(&info, 0, sizeof(info));
+        info.channel = i;
+        error = driver->lpVtbl->getChannelInfo(driver, &info);
+        ok(error == ASE_OK && info.type == ASIOSTInt24LSB && !info.isInput,
+                "Channel %ld metadata is error %ld/type %ld/input %ld.\n",
+                i, error, info.type, info.isInput);
+        buffers[i].isInput = FALSE;
+        buffers[i].channelNum = i;
+        buffers[i].buffers[0] = NULL;
+        buffers[i].buffers[1] = NULL;
+    }
+
+    signal_state.buffers = buffers;
+    signal_state.channels = signal_channels;
+    signal_state.buffer_frames = signal_buffer_frames;
+    signal_state.rate = rate;
+    signal_state.frame_index = 0;
+    signal_state.callbacks = 0;
+    signal_state.callback_errors = 0;
+    signal_state.restarts = 0;
+    signal_state.restart_callbacks = 0;
+    signal_state.generated_frames = 0;
+    signal_state.callback_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    ok(signal_state.callback_event != NULL, "CreateEvent failed.\n");
+    if (!signal_state.callback_event)
+        goto dispose;
+
+    error = driver->lpVtbl->createBuffers(driver, buffers, signal_channels,
+            signal_buffer_frames, &signal_callbacks);
+    ok(error == ASE_OK, "CreateBuffers failed: %ld.\n", error);
+    if (error != ASE_OK)
+        goto dispose_event;
+    buffers_created = TRUE;
+    for (i = 0; i < signal_channels; ++i)
+        ok(buffers[i].buffers[0] && buffers[i].buffers[1],
+                "Channel %ld returned NULL ASIO buffers.\n", i);
+
+    write_signal_state(meta_path, "ready", rate, signal_state.callbacks,
+            signal_state.callback_errors, signal_state.generated_frames);
+    write_text_file(ready_path, "ready\n");
+    if (!wait_for_arm(arm_path, 30000))
+    {
+        ok(FALSE, "Signal runner did not arm the verified private graph.\n");
+        write_signal_state(meta_path, "error", rate, signal_state.callbacks,
+                signal_state.callback_errors, signal_state.generated_frames);
+        goto dispose_buffers;
+    }
+
+    write_signal_state(meta_path, "armed", rate, signal_state.callbacks,
+            signal_state.callback_errors, signal_state.generated_frames);
+    prefill_signal_buffer();
+    error = driver->lpVtbl->start(driver);
+    ok(error == ASE_OK, "Start failed: %ld.\n", error);
+    if (error != ASE_OK)
+    {
+        write_signal_state(meta_path, "error", rate, signal_state.callbacks,
+                signal_state.callback_errors, signal_state.generated_frames);
+        goto dispose_buffers;
+    }
+    started = TRUE;
+    duration = signal_duration();
+
+    if (release_mode)
+    {
+        DWORD elapsed = 0;
+
+        while (signal_state.callbacks < 4 && elapsed < 5000)
+        {
+            Sleep(10);
+            elapsed += 10;
+        }
+        ok(signal_state.callbacks >= 4,
+                "Release fixture did not observe four callbacks before disconnect.\n");
+        write_signal_state(meta_path, "active", rate, signal_state.callbacks,
+                signal_state.callback_errors, signal_state.generated_frames);
+        write_text_file(active_path, "active\n");
+        if (!wait_for_arm(disconnect_path, 10000))
+        {
+            ok(FALSE, "Release fixture did not receive its disconnect request.\n");
+            write_signal_state(meta_path, "error", rate, signal_state.callbacks,
+                    signal_state.callback_errors, signal_state.generated_frames);
+            goto dispose_buffers;
+        }
+        Sleep(250);
+        error = driver->lpVtbl->stop(driver);
+        ok(error == ASE_OK || error == ASE_NotPresent || error == ASE_HWMalfunction
+                || error == ASE_InvalidMode,
+                "Stop after graph disconnect failed: %ld.\n", error);
+        started = FALSE;
+        callbacks = signal_state.callbacks;
+        callback_errors = signal_state.callback_errors;
+        Sleep(100);
+        ok(callbacks == signal_state.callbacks,
+                "ASIO callbacks continued after disconnect Stop (%ld -> %ld).\n",
+                callbacks, signal_state.callbacks);
+        ok(!callback_errors, "Release fixture callback errors: %ld.\n", callback_errors);
+        write_signal_state(meta_path, "disconnect-done", rate, signal_state.callbacks,
+                signal_state.callback_errors, signal_state.generated_frames);
+        goto dispose_buffers;
+    }
+
+    Sleep(duration);
+    error = driver->lpVtbl->stop(driver);
+    ok(error == ASE_OK, "Stop failed: %ld.\n", error);
+    started = FALSE;
+    callbacks = signal_state.callbacks;
+    callback_errors = signal_state.callback_errors;
+    ok(callbacks >= 4, "Only %ld signal callbacks ran.\n", callbacks);
+    ok(!callback_errors, "Signal callback errors: %ld.\n", callback_errors);
+    Sleep(100);
+    ok(callbacks == signal_state.callbacks,
+            "ASIO callbacks continued after Stop (%ld -> %ld).\n",
+            callbacks, signal_state.callbacks);
+
+    if (restart_mode)
+    {
+        signal_state.frame_index = 0;
+        prefill_signal_buffer();
+        error = driver->lpVtbl->start(driver);
+        ok(error == ASE_OK, "Restart failed: %ld.\n", error);
+        if (error != ASE_OK)
+        {
+            write_signal_state(meta_path, "error", rate, signal_state.callbacks,
+                    signal_state.callback_errors, signal_state.generated_frames);
+            goto dispose_buffers;
+        }
+        started = TRUE;
+        signal_state.restarts = 1;
+        write_signal_state(meta_path, "restarted", rate, signal_state.callbacks,
+                signal_state.callback_errors, signal_state.generated_frames);
+        Sleep(duration);
+        error = driver->lpVtbl->stop(driver);
+        ok(error == ASE_OK, "Restart Stop failed: %ld.\n", error);
+        started = FALSE;
+        signal_state.restart_callbacks = signal_state.callbacks - callbacks;
+        callbacks = signal_state.callbacks;
+        callback_errors = signal_state.callback_errors;
+        ok(signal_state.restart_callbacks >= 4,
+                "Only %ld callbacks ran after restart.\n", signal_state.restart_callbacks);
+        ok(!callback_errors, "Signal callback errors after restart: %ld.\n", callback_errors);
+        Sleep(100);
+        ok(callbacks == signal_state.callbacks,
+                "ASIO callbacks continued after restart Stop (%ld -> %ld).\n",
+                callbacks, signal_state.callbacks);
+    }
+
+    write_signal_state(meta_path, "done", rate, signal_state.callbacks,
+            signal_state.callback_errors, signal_state.generated_frames);
+
+dispose_buffers:
+    if (started)
+        driver->lpVtbl->stop(driver);
+    if (buffers_created)
+    {
+        error = driver->lpVtbl->disposeBuffers(driver);
+        ok(error == ASE_OK, "DisposeBuffers failed: %ld.\n", error);
+    }
+dispose_event:
+    if (signal_state.callback_event)
+    {
+        CloseHandle(signal_state.callback_event);
+        signal_state.callback_event = NULL;
+    }
+    signal_state.buffers = NULL;
+dispose:
+    if (driver)
+    {
+        driver->lpVtbl->Release(driver);
+        driver = NULL;
+        if (release_mode)
+            write_text_file(released_path, "released\n");
+    }
+done:
+    if (factory)
+        IClassFactory_Release(factory);
+    if (module)
+    {
+        FreeLibrary(module);
+        if (release_mode)
+            write_text_file(released_path, "unloaded\n");
+    }
+    CoUninitialize();
+}

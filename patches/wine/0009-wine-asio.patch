+static BOOL test_channel_metadata(IASIO *driver, LONG output_channels)
+{
+    ASIOChannelInfo info;
+    LONG i;
+    LONG error;
+
+    error = driver->lpVtbl->getChannelInfo(driver, NULL);
+    ok(error == ASE_InvalidParameter, "NULL channel info returned %ld.\n", error);
+
+    memset(&info, 0, sizeof(info));
+    info.channel = output_channels;
+    error = driver->lpVtbl->getChannelInfo(driver, &info);
+    ok(error == ASE_InvalidParameter, "Out-of-range channel returned %ld.\n", error);
+
+    memset(&info, 0, sizeof(info));
+    info.channel = -1;
+    error = driver->lpVtbl->getChannelInfo(driver, &info);
+    ok(error == ASE_InvalidParameter, "Negative channel returned %ld.\n", error);
+
+    for (i = 0; i < output_channels; ++i)
+    {
+        memset(&info, 0, sizeof(info));
+        info.channel = i;
+        error = driver->lpVtbl->getChannelInfo(driver, &info);
+        ok(error == ASE_OK, "Channel %ld metadata failed: %ld.\n", i, error);
+        if (error != ASE_OK)
+            continue;
+        ok(info.channel == i, "Channel %ld returned channel %ld.\n", i, info.channel);
+        ok(!info.isInput, "Channel %ld is unexpectedly an input.\n", i);
+        ok(info.type == ASIOSTInt24LSB, "Channel %ld type is %ld, expected %d.\n",
+                i, info.type, ASIOSTInt24LSB);
+        ok(info.name[0] != 0, "Channel %ld has no name.\n", i);
+    }
+
+    return output_channels > 0;
+}

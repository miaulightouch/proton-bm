+static void test_sample_rates(IASIO *driver)
+{
+    static const double rates[] = {8000.0, 44100.0, 48000.0, 192000.0};
+    double current, result;
+    LONG error;
+    unsigned int i;
+
+    error = driver->lpVtbl->getSampleRate(driver, NULL);
+    ok(error == ASE_InvalidParameter, "NULL sample rate returned %ld.\n", error);
+    error = driver->lpVtbl->getSampleRate(driver, &current);
+    ok(error == ASE_OK, "GetSampleRate failed: %ld.\n", error);
+    if (error != ASE_OK)
+        return;
+    ok(current == 48000.0, "Unexpected default sample rate %.3f.\n", current);
+
+    for (i = 0; i < sizeof(rates) / sizeof(rates[0]); ++i)
+    {
+        error = driver->lpVtbl->canSampleRate(driver, rates[i]);
+        if (error != ASE_OK)
+        {
+            skip("%.0f Hz is unavailable: %ld.\n", rates[i], error);
+            continue;
+        }
+        error = driver->lpVtbl->setSampleRate(driver, rates[i]);
+        ok(error == ASE_OK, "SetSampleRate(%.0f) failed: %ld.\n", rates[i], error);
+        if (error != ASE_OK)
+            continue;
+        error = driver->lpVtbl->getSampleRate(driver, &result);
+        ok(error == ASE_OK && result == rates[i],
+                "GetSampleRate after %.0f returned %ld, %.3f.\n", rates[i], error, result);
+    }
+
+    if (driver->lpVtbl->canSampleRate(driver, current) == ASE_OK)
+        driver->lpVtbl->setSampleRate(driver, current);
+}
+
+static BOOL wait_for_callbacks(LONG count, DWORD timeout)
+{
+    DWORD start = GetTickCount();
+
+    while (callback_state.plain_callbacks + callback_state.time_callbacks < count)
+    {
+        DWORD elapsed = GetTickCount() - start;
+        DWORD wait = elapsed < timeout ? timeout - elapsed : 0;
+
+        if (wait && WaitForSingleObject(callback_state.event, wait) == WAIT_OBJECT_0)
+        {
+            ResetEvent(callback_state.event);
+            continue;
+        }
+        return callback_state.plain_callbacks + callback_state.time_callbacks >= count;
+    }
+    return TRUE;
+}
+
+static void validate_callback_clock(double rate, LONG buffer_size, BOOL time_info,
+        ULONGLONG qpc_before_start, ULONGLONG qpc_after_start, const char *label)
+{
+    ASIOSamples *positions = time_info ? callback_state.time_info_positions
+                                       : callback_state.reentrant_positions;
+    ASIOSamples *timestamps = time_info ? callback_state.time_info_timestamps
+                                        : callback_state.reentrant_timestamps;
+    LONG *resyncs = time_info ? callback_state.time_info_resyncs : callback_state.reentrant_resyncs;
+    LONG records = time_info ? callback_state.time_info_records
+                             : callback_state.reentrant_records;
+    ULONGLONG nominal_step = (ULONGLONG)((double)buffer_size * 1000000000.0 / rate + 0.5);
+    ULONGLONG first_timestamp = records > 0 ? samples_value(timestamps[0]) : 0;
+    ULONGLONG timestamp_tolerance = 50000000;
+    ULONGLONG observation_tolerance = 5000;
+    BOOL positions_ok = records >= 4;
+    BOOL timestamps_ok = records >= 4;
+    BOOL epoch_ok = qpc_before_start && qpc_after_start && first_timestamp;
+    LONG i;
+
+    for (i = 0; i < MAX_CLOCK_RECORDS && i < records; ++i)
+    {
+        ULONGLONG current_timestamp = samples_value(timestamps[i]);
+        ULONGLONG current_position = samples_value(positions[i]);
+        BOOL resynced = i && resyncs[i] != resyncs[i - 1];
+
+        if (current_position % buffer_size) positions_ok = FALSE;
+        if (!i)
+        {
+            if (!resyncs[i] && current_position) positions_ok = FALSE;
+        }
+        else if (current_position <= samples_value(positions[i - 1])
+                || (!resynced && current_position - samples_value(positions[i - 1]) != buffer_size))
+            positions_ok = FALSE;
+        if (!current_timestamp)
+            timestamps_ok = FALSE;
+        if (time_info && callback_state.callback_entry_timestamps[i]
+                && current_timestamp > callback_state.callback_entry_timestamps[i]
+                && current_timestamp - callback_state.callback_entry_timestamps[i]
+                        > observation_tolerance)
+            timestamps_ok = FALSE;
+        if (i)
+        {
+            ULONGLONG previous_timestamp = samples_value(timestamps[i - 1]);
+            ULONGLONG delta = current_timestamp - previous_timestamp;
+            ULONGLONG min_step = nominal_step / 4;
+            ULONGLONG max_step = nominal_step > ((ULONGLONG)-1) / 8
+                    ? (ULONGLONG)-1 : nominal_step * 8;
+
+            /* Live graph/system clock observations have microsecond-scale noise. */
+            min_step = min_step > observation_tolerance ? min_step - observation_tolerance : 0;
+            if (current_timestamp <= previous_timestamp
+                    || (!resynced && (delta < min_step || delta > max_step)))
+                timestamps_ok = FALSE;
+        }
+    }
+    if (epoch_ok)
+    {
+        ULONGLONG expected_first = qpc_before_start;
+        ULONGLONG lower = expected_first > timestamp_tolerance
+                ? expected_first - timestamp_tolerance : 0;
+        ULONGLONG upper = qpc_after_start + timestamp_tolerance;
+
+        epoch_ok = first_timestamp >= lower && first_timestamp <= upper;
+    }
+
+    ok(records >= 4, "%s %.0f Hz/%ld frames recorded only %ld callback clock samples.\n",
+            label, rate, buffer_size, records);
+    ok(positions_ok, "%s %.0f Hz/%ld frames positions did not follow the ASIO periods/resync.\n",
+            label, rate, buffer_size);
+    if (!timestamps_ok)
+        for (i = 0; i < MAX_CLOCK_RECORDS && i < records; ++i)
+            trace("Clock sample %ld: position %I64u, timestamp %I64u, resync %ld.\n", i,
+                  samples_value(positions[i]), samples_value(timestamps[i]), resyncs[i]);
+    ok(timestamps_ok, "%s %.0f Hz/%ld frames timestamps were not monotonic/rate-bounded.\n",
+            label, rate, buffer_size);
+    ok(epoch_ok, "%s %.0f Hz/%ld frames first timestamp was not in the QPC start interval.\n",
+            label, rate, buffer_size);
+    ok(!callback_state.reentrant_failures && !callback_state.time_info_pair_mismatches
+            && !callback_state.time_info_invalid,
+            "%s %.0f Hz/%ld frames callback metadata failed: reentrant %ld, pair %ld, time-info %ld.\n",
+            label, rate, buffer_size, callback_state.reentrant_failures,
+            callback_state.time_info_pair_mismatches, callback_state.time_info_invalid);
+}
+
+static void test_late_callback_recovery(IASIO *driver, LONG buffer_size)
+{
+    ASIOSamples before_position, before_time, after_position, after_time;
+    LONG count = callback_state.plain_callbacks + callback_state.time_callbacks;
+    LONG resyncs = callback_state.resync_notifications, resets = callback_state.reset_notifications;
+    LONG completed = callback_state.delays_completed, error;
+
+    error = driver->lpVtbl->getSamplePosition(driver, &before_position, &before_time);
+    ok(error == ASE_OK, "Pre-stall position failed: %ld.\n", error);
+    if (error != ASE_OK) return;
+    InterlockedExchange(&callback_state.delay_next_callback, 50);
+    ok(wait_for_callbacks(count + 8, 4000), "Callbacks stopped after a delayed host callback.\n");
+    ok(callback_state.delays_completed == completed + 1, "Delayed callback did not complete.\n");
+    ok(callback_state.reset_notifications == resets, "A transient delay requested a full reset.\n");
+    ok(callback_state.resync_notifications > resyncs, "Dropped PCM did not request resync.\n");
+    error = driver->lpVtbl->getSamplePosition(driver, &after_position, &after_time);
+    ok(error == ASE_OK, "Post-stall position failed: %ld.\n", error);
+    if (error == ASE_OK)
+    {
+        ok(samples_value(after_position) > samples_value(before_position) + 8 * buffer_size,
+           "Recovery replayed expired periods or reset the sample position.\n");
+        ok(samples_value(after_time) > samples_value(before_time)
+                && samples_value(after_time) <= query_qpc_nanoseconds() + 5000,
+           "Recovery returned a backward or future timestamp.\n");
+    }
+    ok(!callback_state.time_info_pair_mismatches && !callback_state.time_info_invalid,
+       "Recovery returned invalid or inconsistent callback metadata.\n");
+    ok(!callback_state.bad_indices, "Recovery broke buffer alternation.\n");
+}
+
+static void test_buffers_and_callbacks(IASIO *driver, LONG output_channels)
+{
+    ASIOBufferInfo *infos = NULL;
+    ASIOBufferInfo invalid_info;
+    LONG min_size, max_size, preferred_size, granularity;
+    LONG buffer_size;
+    LONG i;
+    LONG error;
+    LONG input_latency = -1, output_latency = -1, stopped_latency = -1;
+    LONG latency_limit;
+    double sample_rate;
+    ASIOSamples stopped_position = {0}, stopped_timestamp = {0};
+    ASIOSamples final_position = {0}, final_timestamp = {0};
+    ULONGLONG qpc_before_start, qpc_after_start;
+    BOOL started = FALSE;
+
+    error = driver->lpVtbl->getBufferSize(driver, NULL, &max_size, &preferred_size, &granularity);
+    ok(error == ASE_InvalidParameter, "NULL minimum buffer size returned %ld.\n", error);
+    error = driver->lpVtbl->getBufferSize(driver, &min_size, &max_size, &preferred_size, &granularity);
+    ok(error == ASE_OK, "GetBufferSize failed: %ld.\n", error);
+    if (error != ASE_OK || !output_channels)
+        return;
+
+    ok(min_size > 0 && max_size >= min_size && preferred_size >= min_size
+            && preferred_size <= max_size,
+            "Invalid buffer range: min %ld, max %ld, preferred %ld.\n",
+            min_size, max_size, preferred_size);
+    ok(min_size == 64 && max_size == 4096 && preferred_size == 256 && granularity == -1,
+            "Unexpected buffer negotiation: min %ld, max %ld, preferred %ld, granularity %ld.\n",
+            min_size, max_size, preferred_size, granularity);
+    buffer_size = preferred_size;
+    if (buffer_size <= 0 || buffer_size > 1024 * 1024)
+    {
+        skip("Buffer size %ld is not suitable for the native test.\n", buffer_size);
+        return;
+    }
+
+    infos = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY,
+            output_channels * sizeof(*infos));
+    ok(infos != NULL, "Could not allocate buffer descriptors.\n");
+    if (!infos)
+        return;
+
+    for (i = 0; i < output_channels; ++i)
+    {
+        infos[i].channelNum = i;
+        infos[i].isInput = FALSE;
+    }
+
+    error = driver->lpVtbl->createBuffers(driver, infos, output_channels, buffer_size, NULL);
+    ok(is_invalid_mode_or_parameter(error), "NULL callbacks returned %ld.\n", error);
+    error = driver->lpVtbl->createBuffers(driver, infos, output_channels, 0, &callbacks);
+    ok(is_invalid_mode_or_parameter(error), "Zero buffer size returned %ld.\n", error);
+
+    invalid_info = infos[0];
+    invalid_info.channelNum = output_channels;
+    error = driver->lpVtbl->createBuffers(driver, &invalid_info, 1, buffer_size, &callbacks);
+    ok(error == ASE_InvalidParameter, "Out-of-range buffer channel returned %ld.\n", error);
+
+    invalid_info = infos[0];
+    invalid_info.isInput = TRUE;
+    error = driver->lpVtbl->createBuffers(driver, &invalid_info, 1, buffer_size, &callbacks);
+    ok(error == ASE_InvalidParameter, "Input buffer returned %ld.\n", error);
+
+    callback_state.event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    ok(callback_state.event != NULL, "CreateEvent failed.\n");
+    if (!callback_state.event)
+        goto done;
+
+    callback_state.buffers = infos;
+    callback_state.driver = driver;
+    callback_state.channels = output_channels;
+    callback_state.buffer_size = buffer_size;
+    callback_state.block_size = buffer_size;
+    error = driver->lpVtbl->getSampleRate(driver, &sample_rate);
+    ok(error == ASE_OK, "GetSampleRate before callback setup failed: %ld.\n", error);
+    callback_state.sample_rate = error == ASE_OK ? sample_rate : 0;
+    clear_callback_state();
+
+    error = driver->lpVtbl->createBuffers(driver, infos, output_channels, buffer_size, &callbacks);
+    if (error == ASE_NotPresent || error == ASE_HWMalfunction || error == ASE_NoClock)
+    {
+        skip("PipeWire output buffers are unavailable: %ld.\n", error);
+        goto done;
+    }
+    ok(error == ASE_OK, "CreateBuffers failed: %ld.\n", error);
+    if (error != ASE_OK)
+        goto done;
+
+    error = driver->lpVtbl->getSamplePosition(driver, &final_position, &final_timestamp);
+    ok(error == ASE_SPNotAdvancing,
+            "GetSamplePosition before Start returned %ld instead of ASE_SPNotAdvancing.\n",
+            error);
+
+    error = driver->lpVtbl->getLatencies(driver, NULL, &output_latency);
+    ok(error == ASE_InvalidParameter, "NULL input latency returned %ld.\n", error);
+    error = driver->lpVtbl->getLatencies(driver, &input_latency, &output_latency);
+    latency_limit = initial_latency_bound(buffer_size);
+    ok(error == ASE_OK && input_latency == 0 && output_latency > 0
+            && output_latency <= latency_limit,
+            "GetLatencies before Start returned %ld, %ld/%ld (limit %ld).\n",
+            error, input_latency, output_latency, latency_limit);
+
+    for (i = 0; i < output_channels; ++i)
+    {
+        ok(infos[i].buffers[0] != NULL && infos[i].buffers[1] != NULL,
+                "Channel %ld returned NULL buffers.\n", i);
+        if (infos[i].buffers[0])
+            memset(infos[i].buffers[0], 0, buffer_size * 3);
+        if (infos[i].buffers[1])
+            memset(infos[i].buffers[1], 0, buffer_size * 3);
+    }
+
+    qpc_before_start = query_qpc_nanoseconds();
+    error = driver->lpVtbl->start(driver);
+    qpc_after_start = query_qpc_nanoseconds();
+    if (is_hardware_unavailable(error))
+    {
+        skip("PipeWire output could not start: %ld.\n", error);
+        goto dispose;
+    }
+    ok(error == ASE_OK, "Start failed: %ld.\n", error);
+    if (error != ASE_OK)
+        goto dispose;
+    started = TRUE;
+
+    ok(wait_for_callbacks(4, 4000), "ASIO callback did not run.\n");
+    ok(callback_state.plain_callbacks + callback_state.time_callbacks >= 4,
+            "Only %ld ASIO callbacks were observed.\n",
+            callback_state.plain_callbacks + callback_state.time_callbacks);
+    ok(callback_state.time_callbacks > 0 && !callback_state.plain_callbacks,
+            "Driver did not select bufferSwitchTimeInfo when supported.\n");
+    ok(!callback_state.bad_indices, "ASIO callback indices did not alternate.\n");
+    ok(callback_state.seen_indices == 3, "ASIO callbacks did not visit both buffers: %#lx.\n",
+            callback_state.seen_indices);
+    ok(!callback_state.null_time_info, "ASIO time-info callback received NULL data.\n");
+    ok(callback_state.reentrant_checks >= 4 && !callback_state.reentrant_failures,
+            "Reentrant metadata calls failed (%ld checks, %ld failures).\n",
+            callback_state.reentrant_checks, callback_state.reentrant_failures);
+    error = driver->lpVtbl->getSampleRate(driver, &sample_rate);
+    ok(error == ASE_OK, "GetSampleRate during callback clock test failed: %ld.\n", error);
+    if (error == ASE_OK)
+        validate_callback_clock(sample_rate, buffer_size, TRUE, qpc_before_start,
+                qpc_after_start, "Initial");
+    error = driver->lpVtbl->getLatencies(driver, &input_latency, &stopped_latency);
+    ok(error == ASE_OK && input_latency == 0 && stopped_latency > 0,
+            "GetLatencies after callbacks returned %ld, %ld/%ld.\n",
+            error, input_latency, stopped_latency);
+    ok(stopped_latency == output_latency || callback_state.latency_notifications > 0,
+            "Latency changed without kAsioLatenciesChanged: %ld -> %ld.\n",
+            output_latency, stopped_latency);
+    trace("Latency before/after Start: %ld/%ld frames, %ld notifications.\n",
+            output_latency, stopped_latency, callback_state.latency_notifications);
+
+    test_late_callback_recovery(driver, buffer_size);
+
+    error = driver->lpVtbl->getSamplePosition(driver, &final_position, &final_timestamp);
+    ok(error == ASE_OK, "GetSamplePosition before Stop failed: %ld.\n", error);
+    ok(error != ASE_OK || (samples_value(final_position) % buffer_size) == 0,
+            "Sample position before Stop was not block-aligned: %I64u.\n",
+            samples_value(final_position));
+
+    error = driver->lpVtbl->stop(driver);
+    ok(error == ASE_OK, "Stop failed: %ld.\n", error);
+    started = FALSE;
+    {
+        LONG callback_count = callback_state.plain_callbacks + callback_state.time_callbacks;
+        Sleep(100);
+        ok(callback_count == callback_state.plain_callbacks + callback_state.time_callbacks,
+                "Callbacks continued after Stop.\n");
+    }
+    error = driver->lpVtbl->getSamplePosition(driver, &stopped_position, &stopped_timestamp);
+    ok(error == ASE_OK || error == ASE_SPNotAdvancing,
+            "GetSamplePosition after Stop returned %ld.\n", error);
+    if (error == ASE_OK)
+        ok(samples_equal(stopped_position, final_position)
+                && samples_equal(stopped_timestamp, final_timestamp),
+                "Sample position advanced after Stop.\n");
+    error = driver->lpVtbl->getLatencies(driver, &input_latency, &stopped_latency);
+    ok(error == ASE_OK && input_latency == 0 && stopped_latency > 0,
+            "GetLatencies after Stop returned %ld, %ld/%ld.\n",
+            error, input_latency, stopped_latency);
+    error = driver->lpVtbl->stop(driver);
+    ok(error == ASE_OK || error == ASE_InvalidMode, "Second Stop returned %ld.\n", error);
+
+    clear_callback_state();
+    ResetEvent(callback_state.event);
+    qpc_before_start = query_qpc_nanoseconds();
+    error = driver->lpVtbl->start(driver);
+    qpc_after_start = query_qpc_nanoseconds();
+    ok(error == ASE_OK, "Restart failed: %ld.\n", error);
+    if (error == ASE_OK)
+    {
+        started = TRUE;
+        ok(wait_for_callbacks(4, 4000), "Restart did not produce callbacks.\n");
+        ok(callback_state.time_callbacks > 0 && !callback_state.plain_callbacks,
+                "Restart did not use bufferSwitchTimeInfo.\n");
+        ok(!callback_state.bad_indices, "Restart callback indices did not alternate.\n");
+        ok(callback_state.seen_indices == 3,
+                "Restart callbacks did not visit both buffers: %#lx.\n", callback_state.seen_indices);
+        error = driver->lpVtbl->getSampleRate(driver, &sample_rate);
+        ok(error == ASE_OK, "GetSampleRate during restart clock test failed: %ld.\n", error);
+        if (error == ASE_OK)
+            validate_callback_clock(sample_rate, buffer_size, TRUE, qpc_before_start,
+                    qpc_after_start, "Restart");
+        error = driver->lpVtbl->stop(driver);
+        ok(error == ASE_OK, "Restart Stop failed: %ld.\n", error);
+        started = FALSE;
+    }
+
+    error = driver->lpVtbl->disposeBuffers(driver);
+    ok(error == ASE_OK || error == ASE_InvalidMode,
+            "DisposeBuffers before plain callback test failed: %ld.\n", error);
+    memset(infos, 0, output_channels * sizeof(*infos));
+    for (i = 0; i < output_channels; ++i)
+    {
+        infos[i].channelNum = i;
+        infos[i].isInput = FALSE;
+    }
+    clear_callback_state();
+    callback_state.block_size = buffer_size;
+    ResetEvent(callback_state.event);
+    error = driver->lpVtbl->createBuffers(driver, infos, output_channels, buffer_size,
+            &callbacks_without_time_info);
+    ok(error == ASE_OK, "CreateBuffers without time-info support failed: %ld.\n", error);
+    if (error == ASE_OK)
+    {
+        qpc_before_start = query_qpc_nanoseconds();
+        error = driver->lpVtbl->start(driver);
+        qpc_after_start = query_qpc_nanoseconds();
+        ok(error == ASE_OK, "Plain callback Start failed: %ld.\n", error);
+        if (error == ASE_OK)
+        {
+            started = TRUE;
+            ok(wait_for_callbacks(4, 4000), "Plain callback path did not run.\n");
+            ok(callback_state.plain_callbacks > 0 && !callback_state.time_callbacks,
+                    "Driver did not select bufferSwitch without time-info support.\n");
+            ok(!callback_state.bad_indices, "Plain callback indices did not alternate.\n");
+            ok(callback_state.seen_indices == 3,
+                    "Plain callbacks did not visit both buffers: %#lx.\n", callback_state.seen_indices);
+            error = driver->lpVtbl->getSampleRate(driver, &sample_rate);
+            ok(error == ASE_OK, "GetSampleRate during plain clock test failed: %ld.\n", error);
+            if (error == ASE_OK)
+                validate_callback_clock(sample_rate, buffer_size, FALSE, qpc_before_start,
+                        qpc_after_start, "Plain");
+            test_late_callback_recovery(driver, buffer_size);
+            error = driver->lpVtbl->stop(driver);
+            ok(error == ASE_OK, "Plain callback Stop failed: %ld.\n", error);
+            started = FALSE;
+        }
+    }
+
+dispose:
+    if (started)
+        driver->lpVtbl->stop(driver);
+    error = driver->lpVtbl->disposeBuffers(driver);
+    ok(error == ASE_OK, "DisposeBuffers failed: %ld.\n", error);
+    error = driver->lpVtbl->disposeBuffers(driver);
+    ok(error == ASE_OK || error == ASE_InvalidMode,
+            "Second DisposeBuffers returned %ld.\n", error);
+    error = driver->lpVtbl->start(driver);
+    ok(error == ASE_InvalidMode, "Start after DisposeBuffers returned %ld.\n", error);
+
+done:
+    callback_state.buffers = NULL;
+    callback_state.driver = NULL;
+    callback_state.channels = 0;
+    callback_state.buffer_size = 0;
+    callback_state.block_size = 0;
+    callback_state.sample_rate = 0;
+    if (callback_state.event)
+    {
+        CloseHandle(callback_state.event);
+        callback_state.event = NULL;
+    }
+    HeapFree(GetProcessHeap(), 0, infos);
+}

diff --git a/dlls/protonasio/register.c b/dlls/protonasio/register.c
new file mode 100644
--- /dev/null
+++ b/dlls/protonasio/register.c
@@ -0,0 +1,204 @@
+/* ASIO device naming and registration. LGPL-2.1-or-later. */
+#include <stdarg.h>
+#include <string.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winerror.h"
+#include "asio.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(asio);
+
+static const WCHAR clsid[] = L"{ba274ea3-1dd1-4593-a85a-aece49181f47}";
+static const WCHAR class_path[] = L"CLSID\\{ba274ea3-1dd1-4593-a85a-aece49181f47}";
+static const WCHAR asio_path[] = L"Software\\ASIO";
+
+BOOL asio_get_device_name(char name[ASIO_DEVICE_NAME_SIZE])
+{
+    WCHAR value[ASIO_DEVICE_NAME_SIZE];
+    DWORD length, i;
+
+    name[0] = 0;
+    SetLastError(ERROR_SUCCESS);
+    length = GetEnvironmentVariableW(L"PROTON_ASIO_DEVICE_NAME", value, ARRAY_SIZE(value));
+    if (!length && GetLastError() == ERROR_ENVVAR_NOT_FOUND)
+    {
+        strcpy(name, "XONAR SOUND CARD(64)");
+        return TRUE;
+    }
+    if (!length || length >= ARRAY_SIZE(value) || value[0] == ' ' || value[length - 1] == ' ')
+        goto invalid;
+    for (i = 0; i < length; ++i)
+    {
+        if (value[i] < 0x20 || value[i] > 0x7e || value[i] == '\\') goto invalid;
+        name[i] = value[i];
+    }
+    name[length] = 0;
+    return TRUE;
+
+invalid:
+    name[0] = 0;
+    /* Proton suppresses Wine debug channels by default. */
+    MESSAGE("protonasio: warning: PROTON_ASIO_DEVICE_NAME is empty or invalid; "
+            "ASIO device creation is disabled (use 1-31 printable ASCII characters, "
+            "without backslashes or surrounding spaces).\n");
+    return FALSE;
+}
+
+static BOOL owned_key(HKEY key)
+{
+    WCHAR value[64] = {0};
+    DWORD type, bytes = sizeof(value);
+    return !RegQueryValueExW(key, L"CLSID", NULL, &type, (BYTE *)value, &bytes) &&
+           type == REG_SZ && bytes <= sizeof(value) && bytes >= sizeof(WCHAR) && !(bytes % sizeof(WCHAR)) &&
+           !value[bytes / sizeof(WCHAR) - 1] && !wcsicmp(value, clsid);
+}
+
+static LSTATUS check_key(const WCHAR *path)
+{
+    HKEY key;
+    LSTATUS result = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ | KEY_WOW64_64KEY, &key);
+    if (result == ERROR_FILE_NOT_FOUND) return ERROR_SUCCESS;
+    if (result) return result;
+    result = owned_key(key) ? ERROR_SUCCESS : ERROR_ALREADY_EXISTS;
+    RegCloseKey(key);
+    return result;
+}
+
+static LSTATUS remove_owned_keys(const WCHAR *keep)
+{
+    HKEY parent, key;
+    WCHAR name[256];
+    DWORD index = 0, length;
+    LSTATUS result;
+    BOOL owned;
+
+    result = RegOpenKeyExW(HKEY_LOCAL_MACHINE, asio_path, 0,
+                          KEY_READ | KEY_WRITE | DELETE | KEY_WOW64_64KEY, &parent);
+    if (result == ERROR_FILE_NOT_FOUND) return ERROR_SUCCESS;
+    if (result) return result;
+    for (;;)
+    {
+        length = ARRAY_SIZE(name);
+        result = RegEnumKeyExW(parent, index, name, &length, NULL, NULL, NULL, NULL);
+        if (result == ERROR_NO_MORE_ITEMS)
+        {
+            result = ERROR_SUCCESS;
+            break;
+        }
+        if (result) break;
+        if (keep && !lstrcmpW(name, keep))
+        {
+            ++index;
+            continue;
+        }
+        if ((result = RegOpenKeyExW(parent, name, 0, KEY_READ, &key))) break;
+        owned = owned_key(key);
+        RegCloseKey(key);
+        if (owned)
+        {
+            if ((result = RegDeleteTreeW(parent, name))) break;
+        }
+        else ++index;
+    }
+    RegCloseKey(parent);
+    return result;
+}
+
+static LSTATUS class_owned(BOOL *owned)
+{
+    HKEY key, inproc;
+    WCHAR value[MAX_PATH] = {0};
+    DWORD type, bytes = sizeof(value);
+    LSTATUS result;
+
+    *owned = FALSE;
+    result = RegOpenKeyExW(HKEY_CLASSES_ROOT, class_path, 0, KEY_READ, &key);
+    if (result) return result;
+    result = RegOpenKeyExW(key, L"InprocServer32", 0, KEY_READ, &inproc);
+    RegCloseKey(key);
+    if (result == ERROR_FILE_NOT_FOUND) return ERROR_SUCCESS;
+    if (result) return result;
+    result = RegQueryValueExW(inproc, NULL, NULL, &type, (BYTE *)value, &bytes);
+    RegCloseKey(inproc);
+    if (result == ERROR_FILE_NOT_FOUND || result == ERROR_MORE_DATA) return ERROR_SUCCESS;
+    if (result) return result;
+    *owned = type == REG_SZ && bytes <= sizeof(value) && bytes >= sizeof(WCHAR) &&
+             !(bytes % sizeof(WCHAR)) && !value[bytes / sizeof(WCHAR) - 1] &&
+             !wcsicmp(value, L"protonasio.dll");
+    return ERROR_SUCCESS;
+}
+
+static LSTATUS set_string(HKEY key, const WCHAR *name, const WCHAR *value)
+{
+    return RegSetValueExW(key, name, 0, REG_SZ, (const BYTE *)value,
+                         (lstrlenW(value) + 1) * sizeof(WCHAR));
+}
+
+static LSTATUS register_key(const WCHAR *path, const WCHAR *name)
+{
+    HKEY key;
+    LSTATUS result = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0,
+                                   KEY_WRITE | KEY_WOW64_64KEY, NULL, &key, NULL);
+    if (result) return result;
+    result = set_string(key, L"CLSID", clsid);
+    if (!result) result = set_string(key, L"Description", name);
+    RegCloseKey(key);
+    return result;
+}
+
+HRESULT WINAPI DllUnregisterServer(void)
+{
+    LSTATUS result;
+    BOOL owned;
+#ifndef _WIN64
+    return E_NOTIMPL;
+#endif
+    if ((result = remove_owned_keys(NULL))) return HRESULT_FROM_WIN32(result);
+    result = class_owned(&owned);
+    if (result == ERROR_FILE_NOT_FOUND) return S_OK;
+    if (result) return HRESULT_FROM_WIN32(result);
+    if (!owned) return S_OK;
+    result = RegDeleteTreeW(HKEY_CLASSES_ROOT, class_path);
+    return result == ERROR_FILE_NOT_FOUND ? S_OK : HRESULT_FROM_WIN32(result);
+}
+
+HRESULT WINAPI DllRegisterServer(void)
+{
+    char name[ASIO_DEVICE_NAME_SIZE];
+    WCHAR wide_name[ASIO_DEVICE_NAME_SIZE], path[64];
+    LSTATUS result;
+    HKEY key, inproc;
+    BOOL owned;
+#ifndef _WIN64
+    return E_NOTIMPL;
+#endif
+    if (!asio_get_device_name(name)) return DllUnregisterServer();
+    MultiByteToWideChar(CP_ACP, 0, name, -1, wide_name, ARRAY_SIZE(wide_name));
+    lstrcpyW(path, L"Software\\ASIO\\");
+    lstrcatW(path, wide_name);
+    result = class_owned(&owned);
+    if (result == ERROR_FILE_NOT_FOUND) result = ERROR_SUCCESS;
+    else if (!result && !owned) result = ERROR_ALREADY_EXISTS;
+    if (!result) result = check_key(path);
+    if (result)
+    {
+        WARN("ASIO registration would replace another driver: %ld\n", result);
+        return HRESULT_FROM_WIN32(result);
+    }
+    if ((result = RegCreateKeyExW(HKEY_CLASSES_ROOT, class_path, 0, NULL, 0,
+                                 KEY_WRITE, NULL, &key, NULL))) return HRESULT_FROM_WIN32(result);
+    result = RegCreateKeyExW(key, L"InprocServer32", 0, NULL, 0, KEY_WRITE, NULL, &inproc, NULL);
+    if (!result)
+    {
+        result = set_string(inproc, NULL, L"protonasio.dll");
+        if (!result) result = set_string(inproc, L"ThreadingModel", L"Both");
+        RegCloseKey(inproc);
+    }
+    RegCloseKey(key);
+    /* Remove case variants before creating the requested spelling. */
+    if (!result) result = remove_owned_keys(wide_name);
+    if (!result) result = register_key(path, wide_name);
+    return HRESULT_FROM_WIN32(result);
+}

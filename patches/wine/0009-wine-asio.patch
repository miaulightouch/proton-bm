+static void test_basic_arguments(IASIO *driver)
+{
+    ASIOBufferInfo info = {0};
+    LONG error;
+    LONG input, output;
+
+    error = driver->lpVtbl->createBuffers(driver, NULL, 1, 64, &callbacks);
+    ok(is_invalid_mode_or_parameter(error), "NULL buffer array returned %ld.\n", error);
+    error = driver->lpVtbl->createBuffers(driver, &info, 0, 64, &callbacks);
+    ok(is_invalid_mode_or_parameter(error), "Zero channels returned %ld.\n", error);
+    error = driver->lpVtbl->createBuffers(driver, &info, 1, 0, &callbacks);
+    ok(is_invalid_mode_or_parameter(error), "Zero buffer size returned %ld.\n", error);
+    error = driver->lpVtbl->createBuffers(driver, &info, 1, 64, NULL);
+    ok(is_invalid_mode_or_parameter(error), "NULL callbacks returned %ld.\n", error);
+    error = driver->lpVtbl->start(driver);
+    ok(error == ASE_InvalidMode, "Start before buffers returned %ld.\n", error);
+    error = driver->lpVtbl->stop(driver);
+    ok(error == ASE_InvalidMode, "Stop before buffers returned %ld.\n", error);
+    error = driver->lpVtbl->controlPanel(driver);
+    ok(error == ASE_NotPresent, "ControlPanel returned %ld.\n", error);
+    error = driver->lpVtbl->future(driver, kAsioCanTimeInfo, NULL);
+    ok(error == ASE_SUCCESS, "Future(kAsioCanTimeInfo) returned %ld.\n", error);
+    error = driver->lpVtbl->future(driver, kAsioLatenciesChanged, NULL);
+    ok(error == ASE_InvalidParameter,
+            "Future(unsupported selector %d) returned %ld.\n",
+            kAsioLatenciesChanged, error);
+    error = driver->lpVtbl->future(driver, 0, NULL);
+    ok(error == ASE_InvalidParameter, "Future(unknown) returned %ld.\n", error);
+    error = driver->lpVtbl->outputReady(driver);
+    ok(error == ASE_NotPresent, "OutputReady returned %ld.\n", error);
+
+    error = driver->lpVtbl->getChannels(driver, NULL, &output);
+    ok(error == ASE_InvalidParameter, "NULL input channel count returned %ld.\n", error);
+    error = driver->lpVtbl->getChannels(driver, &input, NULL);
+    ok(error == ASE_InvalidParameter, "NULL output channel count returned %ld.\n", error);
+    error = driver->lpVtbl->getLatencies(driver, &input, &output);
+    ok(error == ASE_InvalidMode, "GetLatencies before buffers returned %ld.\n", error);
+}

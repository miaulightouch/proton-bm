+static BOOL test_release_while_active(IASIO *driver, LONG output_channels,
+        dll_get_class_object_proc get_class_object, dll_can_unload_now_proc can_unload_now)
+{
+    IASIO *active = NULL;
+    ASIOBufferInfo *infos = NULL;
+    LONG i, error, callbacks_after_release = 0;
+    HANDLE event = NULL;
+
+    if (output_channels <= 0)
+        return FALSE;
+
+    error = driver->lpVtbl->QueryInterface(driver, &CLSID_ProtonASIO, (void **)&active);
+    ok(error == S_OK, "Could not retain the active-release test instance: %#lx.\n", error);
+    if (error != S_OK)
+        return FALSE;
+
+    /* Leave active as the only reference so its Release exercises worker shutdown. */
+    driver->lpVtbl->Release(driver);
+    infos = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, output_channels * sizeof(*infos));
+    ok(infos != NULL, "Could not allocate active-release buffer descriptors.\n");
+    if (!infos)
+        goto release;
+    for (i = 0; i < output_channels; ++i)
+    {
+        infos[i].channelNum = i;
+        infos[i].isInput = FALSE;
+    }
+
+    event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    ok(event != NULL, "Could not create the active-release callback event.\n");
+    if (!event)
+        goto release;
+    callback_state.event = event;
+    callback_state.driver = active;
+    callback_state.buffers = infos;
+    callback_state.channels = output_channels;
+    callback_state.buffer_size = 256;
+    clear_callback_state();
+    error = active->lpVtbl->createBuffers(active, infos, output_channels, 256, &callbacks_without_time_info);
+    ok(error == ASE_OK, "Active-release CreateBuffers failed: %ld.\n", error);
+    if (error != ASE_OK)
+        goto release;
+    error = active->lpVtbl->start(active);
+    ok(error == ASE_OK, "Active-release Start failed: %ld.\n", error);
+    if (error == ASE_OK)
+    {
+        ok(wait_for_callbacks(4, 4000), "Active-release stream produced no callbacks.\n");
+        ok(callback_state.plain_callbacks + callback_state.time_callbacks >= 4,
+                "Active-release stream produced only %ld callbacks.\n",
+                callback_state.plain_callbacks + callback_state.time_callbacks);
+        test_exclusive_contention(active, get_class_object, output_channels);
+    }
+
+release:
+    callback_state.driver = NULL;
+    error = active->lpVtbl->Release(active);
+    ok(error == 0, "Last active-release returned reference count %ld.\n", error);
+    callbacks_after_release = callback_state.plain_callbacks + callback_state.time_callbacks;
+    Sleep(100);
+    if (event)
+        ok(callbacks_after_release == callback_state.plain_callbacks + callback_state.time_callbacks,
+                "Callbacks continued after last Release.\n");
+    callback_state.buffers = NULL;
+    callback_state.channels = 0;
+    callback_state.buffer_size = 0;
+    if (event)
+        CloseHandle(event);
+    callback_state.event = NULL;
+    HeapFree(GetProcessHeap(), 0, infos);
+    test_release_from_callback(get_class_object, can_unload_now, output_channels);
+    test_blocked_callback(get_class_object, can_unload_now);
+    return TRUE;
+}

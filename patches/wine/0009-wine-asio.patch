+++ b/dlls/protonasio/tests/asio.c
@@ -0,0 +1,1721 @@
+/*
+ * Native regression tests for the Proton-BM ASIO driver.
+ *
+ * The test intentionally uses the public Windows ABI directly instead of
+ * linking against a C++ ASIO SDK.  ASIO has no Windows SDK header and the
+ * driver is x64-only, where the C vtable has the same calling convention as
+ * the C++ interface.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+
+#include "windows.h"
+#include "objbase.h"
+#include "unknwn.h"
+#include "wine/test.h"
+#include "../asio.h"
+#include <string.h>
+
+typedef HRESULT (WINAPI *dll_get_class_object_proc)(REFCLSID, REFIID, void **);
+typedef HRESULT (WINAPI *dll_can_unload_now_proc)(void);
+
+enum
+{
+    kAsioSelectorSupported = 1,
+    kAsioResetRequest = 3,
+    kAsioResyncRequest = 5,
+    kAsioLatenciesChanged = 6,
+    kAsioSupportsTimeInfo = 7,
+    kAsioCanTimeInfo = 10,
+};
+
+#define MAX_CLOCK_RECORDS 8
+
+static const GUID iid_other =
+        {0x7dfc1c21, 0x4c7e, 0x47d2, {0x9c, 0x18, 0x92, 0x9d, 0x3a, 0xea, 0x17, 0x6d}};
+
+static struct
+{
+    HANDLE event;
+    IASIO *driver;
+    ASIOBufferInfo *buffers;
+    LONG channels;
+    LONG buffer_size;
+    volatile LONG plain_callbacks;
+    volatile LONG time_callbacks;
+    volatile LONG bad_indices;
+    volatile LONG seen_indices;
+    volatile LONG null_time_info;
+    volatile LONG reentrant_checks;
+    volatile LONG reentrant_failures;
+    volatile LONG reentrant_records;
+    volatile LONG time_info_records;
+    volatile LONG time_info_pair_mismatches;
+    volatile LONG time_info_invalid;
+    volatile LONG latency_notifications;
+    volatile LONG resync_notifications, reset_notifications;
+    volatile LONG delay_next_callback, delays_completed;
+    volatile LONG last_plain_index;
+    volatile LONG last_time_index;
+    volatile LONG release_armed;
+    volatile LONG release_done;
+    volatile LONG callbacks_after_release_arm;
+    volatile LONG release_without_driver;
+    volatile LONG release_refcount;
+    LONG block_size;
+    double sample_rate;
+    ASIOSamples reentrant_positions[MAX_CLOCK_RECORDS];
+    ASIOSamples reentrant_timestamps[MAX_CLOCK_RECORDS];
+    ASIOSamples time_info_positions[MAX_CLOCK_RECORDS];
+    ASIOSamples time_info_timestamps[MAX_CLOCK_RECORDS];
+    LONG reentrant_resyncs[MAX_CLOCK_RECORDS], time_info_resyncs[MAX_CLOCK_RECORDS];
+    ULONGLONG callback_entry_timestamps[MAX_CLOCK_RECORDS];
+} callback_state;
+
+static void clear_callback_state(void)
+{
+    callback_state.plain_callbacks = 0;
+    callback_state.time_callbacks = 0;
+    callback_state.bad_indices = 0;
+    callback_state.seen_indices = 0;
+    callback_state.null_time_info = 0;
+    callback_state.reentrant_checks = 0;
+    callback_state.reentrant_failures = 0;
+    callback_state.reentrant_records = 0;
+    callback_state.time_info_records = 0;
+    callback_state.time_info_pair_mismatches = 0;
+    callback_state.time_info_invalid = 0;
+    callback_state.latency_notifications = 0;
+    callback_state.resync_notifications = callback_state.reset_notifications = 0;
+    callback_state.delay_next_callback = callback_state.delays_completed = 0;
+    callback_state.last_plain_index = -1;
+    callback_state.last_time_index = -1;
+    callback_state.release_armed = 0;
+    callback_state.release_done = 0;
+    callback_state.callbacks_after_release_arm = 0;
+    callback_state.release_without_driver = 0;
+    callback_state.release_refcount = -1;
+    memset(callback_state.reentrant_positions, 0, sizeof(callback_state.reentrant_positions));
+    memset(callback_state.reentrant_timestamps, 0, sizeof(callback_state.reentrant_timestamps));
+    memset(callback_state.time_info_positions, 0, sizeof(callback_state.time_info_positions));
+    memset(callback_state.time_info_timestamps, 0, sizeof(callback_state.time_info_timestamps));
+    memset(callback_state.reentrant_resyncs, 0, sizeof(callback_state.reentrant_resyncs));
+    memset(callback_state.time_info_resyncs, 0, sizeof(callback_state.time_info_resyncs));
+    memset(callback_state.callback_entry_timestamps, 0, sizeof(callback_state.callback_entry_timestamps));
+}
+
+static ULONGLONG samples_value(ASIOSamples value)
+{
+    return ((ULONGLONG)value.hi << 32) | value.lo;
+}
+
+static BOOL samples_equal(ASIOSamples left, ASIOSamples right)
+{
+    return left.hi == right.hi && left.lo == right.lo;
+}
+
+static ULONGLONG qpc_to_nanoseconds(LONGLONG ticks, LONGLONG frequency)
+{
+    ULONGLONG whole, remainder;
+
+    if (ticks < 0 || frequency <= 0)
+        return 0;
+    whole = (ULONGLONG)ticks / (ULONGLONG)frequency;
+    remainder = (ULONGLONG)ticks % (ULONGLONG)frequency;
+    return whole * 1000000000ULL
+            + remainder * 1000000000ULL / (ULONGLONG)frequency;
+}
+
+static ULONGLONG query_qpc_nanoseconds(void)
+{
+    LARGE_INTEGER counter, frequency;
+
+    if (!QueryPerformanceFrequency(&frequency) || !QueryPerformanceCounter(&counter))
+        return 0;
+    return qpc_to_nanoseconds(counter.QuadPart, frequency.QuadPart);
+}
+
+static LONG initial_latency_bound(LONG buffer_size)
+{
+    /* Before the first graph observation, assume one native period plus prefill. */
+    ULONGLONG bound = (ULONGLONG)buffer_size * 2;
+
+    return bound > MAXLONG ? MAXLONG : (LONG)bound;
+}
+
+static void check_reentrant_metadata(const ASIOTimeInfo *time_info)
+{
+    LONG inputs = -1, outputs = -1, error;
+    ASIOSamples position, timestamp;
+    LONG slot;
+
+    if (!callback_state.driver)
+        return;
+
+    error = callback_state.driver->lpVtbl->getChannels(callback_state.driver, &inputs, &outputs);
+    if (error != ASE_OK || inputs != 0 || outputs != 8)
+        InterlockedIncrement(&callback_state.reentrant_failures);
+    error = callback_state.driver->lpVtbl->getSamplePosition(callback_state.driver,
+            &position, &timestamp);
+    if (error != ASE_OK)
+        InterlockedIncrement(&callback_state.reentrant_failures);
+    else
+    {
+        slot = InterlockedIncrement(&callback_state.reentrant_records) - 1;
+        if (slot < MAX_CLOCK_RECORDS)
+        {
+            callback_state.reentrant_positions[slot] = position;
+            callback_state.reentrant_timestamps[slot] = timestamp;
+            callback_state.reentrant_resyncs[slot] = callback_state.resync_notifications;
+        }
+        if (time_info && (!samples_equal(position, time_info->samplePosition)
+                || !samples_equal(timestamp, time_info->systemTime)))
+            InterlockedIncrement(&callback_state.time_info_pair_mismatches);
+    }
+    InterlockedIncrement(&callback_state.reentrant_checks);
+}
+
+static void clear_output_buffer(LONG index)
+{
+    LONG i;
+
+    if (!callback_state.buffers || index < 0 || index > 1)
+        return;
+
+    for (i = 0; i < callback_state.channels; ++i)
+        if (callback_state.buffers[i].buffers[index])
+            memset(callback_state.buffers[i].buffers[index], 0,
+                    callback_state.buffer_size * 3);
+}
+
+static void record_callback(volatile LONG *count, volatile LONG *last_index, LONG index)
+{
+    LONG previous = InterlockedExchange(last_index, index);
+    LONG count_after = InterlockedIncrement(count);
+
+    if (index < 0 || index > 1 || (count_after > 1 && previous == index))
+        InterlockedIncrement(&callback_state.bad_indices);
+    else
+        InterlockedOr(&callback_state.seen_indices, 1 << index);
+}
+
+static void delay_callback(void)
+{
+    LONG delay = InterlockedExchange(&callback_state.delay_next_callback, 0);
+
+    if (!delay) return;
+    Sleep(delay);
+    InterlockedIncrement(&callback_state.delays_completed);
+}
+
+static void __cdecl callback_buffer_switch(LONG index, LONG direct_process)
+{
+    (void)direct_process;
+    check_reentrant_metadata(NULL);
+    record_callback(&callback_state.plain_callbacks, &callback_state.last_plain_index, index);
+    clear_output_buffer(index);
+    delay_callback();
+    SetEvent(callback_state.event);
+}
+
+static void __cdecl callback_release_last_reference(LONG index, LONG direct_process)
+{
+    IASIO *driver;
+
+    (void)direct_process;
+    record_callback(&callback_state.plain_callbacks, &callback_state.last_plain_index, index);
+    clear_output_buffer(index);
+    if (InterlockedCompareExchange(&callback_state.release_armed, 2, 1) != 1)
+    {
+        SetEvent(callback_state.event);
+        return;
+    }
+
+    InterlockedIncrement(&callback_state.callbacks_after_release_arm);
+    driver = callback_state.driver;
+    SetEvent(callback_state.event);
+    InterlockedExchange(&callback_state.release_done, 1);
+    if (driver)
+        InterlockedExchange(&callback_state.release_refcount,
+                (LONG)driver->lpVtbl->Release(driver));
+    else
+    {
+        InterlockedIncrement(&callback_state.release_without_driver);
+        InterlockedExchange(&callback_state.release_refcount, -2);
+    }
+}
+
+static void __cdecl callback_sample_rate_changed(double sample_rate)
+{
+    (void)sample_rate;
+}
+
+static LONG __cdecl callback_asio_message(LONG selector, LONG value, void *message, double *opt)
+{
+    if (selector == kAsioResetRequest)
+    {
+        InterlockedIncrement(&callback_state.reset_notifications);
+        return 1;
+    }
+    if (selector == kAsioResyncRequest)
+    {
+        InterlockedIncrement(&callback_state.resync_notifications);
+        return 1;
+    }
+    if (selector == kAsioLatenciesChanged)
+    {
+        InterlockedIncrement(&callback_state.latency_notifications);
+        return 1;
+    }
+    if (selector == kAsioSelectorSupported && value == kAsioLatenciesChanged)
+        return 1;
+    if (selector == kAsioSupportsTimeInfo
+            || (selector == kAsioSelectorSupported && value == kAsioSupportsTimeInfo))
+        return 1;
+    (void)selector;
+    (void)value;
+    (void)message;
+    (void)opt;
+    return 0;
+}
+
+static ASIOTime *__cdecl callback_buffer_switch_time_info(ASIOTime *params,
+        LONG index, LONG direct_process)
+{
+    ULONGLONG entry_timestamp = query_qpc_nanoseconds();
+
+    (void)direct_process;
+    check_reentrant_metadata(params ? &params->timeInfo : NULL);
+    if (!params)
+        InterlockedIncrement(&callback_state.null_time_info);
+    else
+    {
+        LONG slot = InterlockedIncrement(&callback_state.time_info_records) - 1;
+
+        if (!(params->timeInfo.flags & 7) || params->timeInfo.speed != 1.0
+                || params->timeInfo.sampleRate <= 0
+                || (callback_state.sample_rate > 0
+                    && params->timeInfo.sampleRate != callback_state.sample_rate))
+            InterlockedIncrement(&callback_state.time_info_invalid);
+        if (slot < MAX_CLOCK_RECORDS)
+        {
+            callback_state.time_info_positions[slot] = params->timeInfo.samplePosition;
+            callback_state.time_info_timestamps[slot] = params->timeInfo.systemTime;
+            callback_state.time_info_resyncs[slot] = callback_state.resync_notifications;
+            callback_state.callback_entry_timestamps[slot] = entry_timestamp;
+        }
+    }
+    record_callback(&callback_state.time_callbacks, &callback_state.last_time_index, index);
+    clear_output_buffer(index);
+    delay_callback();
+    SetEvent(callback_state.event);
+    return params;
+}
+
+static LONG __cdecl callback_asio_message_without_time_info(LONG selector, LONG value,
+        void *message, double *opt)
+{
+    if (selector == kAsioSupportsTimeInfo
+            || (selector == kAsioSelectorSupported && value == kAsioSupportsTimeInfo))
+        return 0;
+    return callback_asio_message(selector, value, message, opt);
+}
+
+static ASIOCallbacks callbacks =
+{
+    callback_buffer_switch,
+    callback_sample_rate_changed,
+    callback_asio_message,
+    callback_buffer_switch_time_info,
+};
+
+static ASIOCallbacks callbacks_without_time_info =
+{
+    callback_buffer_switch,
+    callback_sample_rate_changed,
+    callback_asio_message_without_time_info,
+    callback_buffer_switch_time_info,
+};
+
+static ASIOCallbacks callbacks_release_last_reference =
+{
+    callback_release_last_reference,
+    callback_sample_rate_changed,
+    callback_asio_message_without_time_info,
+    callback_buffer_switch_time_info,
+};
+
+static BOOL is_invalid_mode_or_parameter(LONG error)
+{
+    return error == ASE_InvalidMode || error == ASE_InvalidParameter;
+}
+
+static BOOL is_hardware_unavailable(LONG error)
+{
+    return error == ASE_NotPresent || error == ASE_HWMalfunction || error == ASE_NoClock;
+}
+
+static void test_factory(HMODULE module, dll_get_class_object_proc get_class_object,
+        IASIO **driver)
+{
+    IClassFactory *factory = NULL;
+    IUnknown *factory_unknown = NULL;
+    IASIO *instance = NULL;
+    HRESULT hr;
+    ULONG ref;
+
+    hr = get_class_object(&CLSID_ProtonASIO, &IID_IClassFactory, (void **)&factory);
+    ok(hr == S_OK, "DllGetClassObject failed: %#lx.\n", hr);
+    if (FAILED(hr))
+        goto done;
+
+    hr = get_class_object(&CLSID_ProtonASIO, &IID_IUnknown, (void **)&factory_unknown);
+    ok(hr == S_OK, "DllGetClassObject(IUnknown) failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IUnknown_Release(factory_unknown);
+
+    factory_unknown = NULL;
+    hr = get_class_object(&iid_other, &IID_IClassFactory, (void **)&factory_unknown);
+    ok(hr == CLASS_E_CLASSNOTAVAILABLE, "Unknown CLSID returned %#lx.\n", hr);
+    ok(!factory_unknown, "Unknown CLSID returned a factory %p.\n", factory_unknown);
+
+    hr = IClassFactory_CreateInstance(factory, NULL, &CLSID_ProtonASIO, (void **)&instance);
+    ok(hr == S_OK, "CreateInstance(IASIO) failed: %#lx.\n", hr);
+    if (FAILED(hr))
+        goto done;
+
+    hr = instance->lpVtbl->QueryInterface(instance, &IID_IUnknown, (void **)&factory_unknown);
+    ok(hr == S_OK, "QueryInterface(IUnknown) failed: %#lx.\n", hr);
+    ok(factory_unknown != NULL, "QueryInterface(IUnknown) returned NULL.\n");
+    if (SUCCEEDED(hr))
+        IUnknown_Release(factory_unknown);
+
+    hr = instance->lpVtbl->QueryInterface(instance, &CLSID_ProtonASIO, (void **)&factory_unknown);
+    ok(hr == S_OK, "QueryInterface(own CLSID) failed: %#lx.\n", hr);
+    ok(factory_unknown != NULL, "QueryInterface(own CLSID) returned NULL.\n");
+    if (SUCCEEDED(hr))
+        IUnknown_Release(factory_unknown);
+
+    factory_unknown = (IUnknown *)0xdeadbeef;
+    hr = instance->lpVtbl->QueryInterface(instance, &iid_other, (void **)&factory_unknown);
+    ok(hr == E_NOINTERFACE, "QueryInterface(unknown IID) returned %#lx.\n", hr);
+    ok(!factory_unknown, "QueryInterface(unknown IID) returned %p.\n", factory_unknown);
+
+    hr = instance->lpVtbl->QueryInterface(instance, &IID_IUnknown, NULL);
+    ok(hr == E_POINTER, "QueryInterface(NULL) returned %#lx.\n", hr);
+
+    ref = IClassFactory_Release(factory);
+    ok(ref == 0, "Class factory has outstanding references: %lu.\n", ref);
+    factory = NULL;
+    *driver = instance;
+    return;
+
+done:
+    if (instance)
+        instance->lpVtbl->Release(instance);
+    if (factory)
+        IClassFactory_Release(factory);
+    if (module)
+        FreeLibrary(module);
+}

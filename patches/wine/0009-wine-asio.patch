+struct control_race
+{
+    IASIO *driver;
+    HANDLE gate;
+    LONG start_result, metadata_errors;
+};
+
+static void race_buffer_switch(LONG index, LONG direct)
+{
+}
+
+static DWORD WINAPI race_start(void *arg)
+{
+    struct control_race *race = arg;
+    WaitForSingleObject(race->gate, INFINITE);
+    race->start_result = race->driver->lpVtbl->start(race->driver);
+    race->driver->lpVtbl->Release(race->driver);
+    return 0;
+}
+
+static DWORD WINAPI race_metadata(void *arg)
+{
+    struct control_race *race = arg;
+    ASIOChannelInfo info;
+    unsigned i;
+    WaitForSingleObject(race->gate, INFINITE);
+    for (i = 0; i < 4096; ++i)
+    {
+        memset(&info, 0, sizeof(info));
+        info.channel = i % 8;
+        if (race->driver->lpVtbl->getChannelInfo(race->driver, &info) != ASE_OK
+                || info.type != ASIOSTInt24LSB || (info.isActive && info.channel != 3))
+            ++race->metadata_errors;
+    }
+    race->driver->lpVtbl->Release(race->driver);
+    return 0;
+}
+
+static void test_concurrent_dispose(IASIO *driver)
+{
+    ASIOCallbacks callbacks = {race_buffer_switch, NULL, NULL, NULL};
+    struct control_race *race;
+    ASIOBufferInfo buffer;
+    ASIOChannelInfo info;
+    HANDLE threads[2];
+    LONG result;
+    unsigned i, j;
+    DWORD wait;
+
+    for (i = 0; i < 16; ++i)
+    {
+        memset(&buffer, 0, sizeof(buffer));
+        buffer.channelNum = 3;
+        result = driver->lpVtbl->createBuffers(driver, &buffer, 1, 256, &callbacks);
+        ok(result == ASE_OK, "Race buffers failed: %ld.\n", result);
+        if (result != ASE_OK) return;
+        race = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*race));
+        if (!race) return;
+        race->driver = driver;
+        race->gate = CreateEventW(NULL, TRUE, FALSE, NULL);
+        if (!race->gate)
+        {
+            HeapFree(GetProcessHeap(), 0, race);
+            return;
+        }
+        driver->lpVtbl->AddRef(driver);
+        threads[0] = CreateThread(NULL, 0, race_start, race, 0, NULL);
+        driver->lpVtbl->AddRef(driver);
+        threads[1] = CreateThread(NULL, 0, race_metadata, race, 0, NULL);
+        for (j = 0; j < 2; ++j)
+        {
+            ok(threads[j] != NULL, "Race thread %u failed.\n", j);
+            if (!threads[j]) driver->lpVtbl->Release(driver);
+        }
+        SetEvent(race->gate);
+        result = driver->lpVtbl->disposeBuffers(driver);
+        ok(result == ASE_OK, "Concurrent DisposeBuffers returned %ld.\n", result);
+        for (j = 0; j < 2; ++j)
+        {
+            if (!threads[j]) continue;
+            wait = WaitForSingleObject(threads[j], 10000);
+            ok(wait == WAIT_OBJECT_0, "Race thread %u timed out: %lu.\n", j, wait);
+            if (wait != WAIT_OBJECT_0) return; /* Keep the live thread's context and reference. */
+            CloseHandle(threads[j]);
+        }
+        ok(race->start_result == ASE_OK || race->start_result == ASE_InvalidMode,
+           "Concurrent Start returned %ld.\n", race->start_result);
+        ok(!race->metadata_errors, "Concurrent metadata failed %ld times.\n", race->metadata_errors);
+        memset(&info, 0, sizeof(info));
+        info.channel = 3;
+        result = driver->lpVtbl->getChannelInfo(driver, &info);
+        ok(result == ASE_OK && !info.isActive, "Disposed channel remained active.\n");
+        result = driver->lpVtbl->start(driver);
+        ok(result == ASE_InvalidMode, "Disposed buffers allowed Start: %ld.\n", result);
+        CloseHandle(race->gate);
+        HeapFree(GetProcessHeap(), 0, race);
+    }
+}

+static void test_ticket_time(void)
+{
+    struct asio_time_state state = {0};
+    uint64_t before = 0, after = 0;
+
+    /* Captured Q1024 -> Q256: both native clocks advanced, but the ticket regressed. */
+    ok(audio_presentation_time_at(416256 + 512, 346349315731280ULL,
+                                  418048, 48000, &before), "Old ticket conversion failed.\n");
+    ok(audio_presentation_time_at(417792 + 512, 346349340203492ULL,
+                                  418304, 48000, &after), "New ticket conversion failed.\n");
+    ok(before == 346349342397946ULL && after == 346349340203492ULL,
+       "Captured regression was not reproduced.\n");
+    ok(asio_time_validate(&state, 416256, before), "Initial timestamp rejected.\n");
+    ok(!asio_time_validate(&state, 417792, after), "Regressing timestamp accepted.\n");
+    ok(state.last_valid == before, "Invalid timestamp replaced the watermark.\n");
+    ok(!asio_time_validate(&state, 417792, before + 5333333),
+       "Rejected native batch restored time without a new observation.\n");
+    ok(!asio_time_validate(&state, 418048, before), "A repeated timestamp restored time.\n");
+    ok(!asio_time_validate(&state, 418048, before + 1),
+       "A later ticket from the rejected batch restored time.\n");
+    ok(asio_time_validate(&state, 418304, before + 5333333),
+       "Fresh native observation did not restore time.\n");
+    ok(asio_time_validate(&state, 418304, before + 10666666),
+       "Valid batched timestamp rejected.\n");
+    ok(!asio_time_validate(&state, 418560, 0), "Missing timestamp accepted.\n");
+    memset(&state, 0, sizeof(state));
+    ok(asio_time_validate(&state, 0, 1000), "New run retained the old watermark.\n");
+}

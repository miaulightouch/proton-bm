 static inline float get_current_sample(const IDirectSoundBufferImpl *dsb,
         BYTE *buffer, DWORD buflen, DWORD mixpos, DWORD channel)
 {
+    DWORD offset;
+
     if (mixpos >= buflen && !(dsb->playflags & DSBPLAY_LOOPING))
         return 0.0f;
+    if (dsb->num_filters)
+    {
+        offset = mixpos - (buffer == dsb->committedbuff ? dsb->committed_mixpos : dsb->sec_mixpos);
+        return dsb->get(dsb, dsb->filter_buffer + offset, channel);
+    }
     return dsb->get(dsb, buffer + (mixpos % buflen), channel);
+}

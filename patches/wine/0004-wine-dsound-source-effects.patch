+/* Effects consume the negotiated secondary format. Keep only the processed
+ * FIR lookahead so overlapping resampler reads never process a frame twice. */
+static BOOL prepare_filter_data(IDirectSoundBufferImpl *dsb, UINT frames)
+{
+    UINT stride = dsb->pwfx->nBlockAlign, committed = 0, i;
+    DWORD size, offset;
+    BYTE *buffer;
+    HRESULT hr;
+
+    if (!stride || frames > ~(DWORD)0 / stride)
+        return FALSE;
+    size = frames * stride;
+    if (size > dsb->filter_buffer_len)
+    {
+        if (!(buffer = realloc(dsb->filter_buffer, size)))
+            return FALSE;
+        dsb->filter_buffer = buffer;
+        dsb->filter_buffer_len = size;
+    }
+    if (frames <= dsb->filter_frames)
+        return TRUE;
+
+    if (dsb->use_committed)
+        committed = (dsb->writelead - dsb->committed_mixpos) / stride;
+    for (i = dsb->filter_frames; i < frames; ++i)
+    {
+        buffer = dsb->filter_buffer + i * stride;
+        if (i < committed)
+            memcpy(buffer, (BYTE *)dsb->committedbuff + dsb->committed_mixpos + i * stride, stride);
+        else
+        {
+            offset = dsb->sec_mixpos + i * stride;
+            if (offset >= dsb->buflen && !(dsb->playflags & DSBPLAY_LOOPING))
+                memset(buffer, dsb->pwfx->wBitsPerSample == 8 ? 0x80 : 0, stride);
+            else
+                memcpy(buffer, dsb->buffer->memory + offset % dsb->buflen, stride);
+        }
+    }
+
+    buffer = dsb->filter_buffer + dsb->filter_frames * stride;
+    size -= dsb->filter_frames * stride;
+    for (i = 0; i < dsb->num_filters; ++i)
+    {
+        if (dsb->filters[i].inplace)
+        {
+            hr = IMediaObjectInPlace_Process(dsb->filters[i].inplace, size, buffer, 0, DMO_INPLACE_NORMAL);
+            if (FAILED(hr)) WARN("IMediaObjectInPlace_Process failed for filter %u, hr %#lx.\n", i, hr);
+        }
+        else WARN("filter %u has no inplace object - unsupported\n", i);
+    }
+    dsb->filter_frames = frames;
+    return TRUE;
 }
 

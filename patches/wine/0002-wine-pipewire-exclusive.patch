+/* Runs with the process callback excluded.  The callback owns pa_offs, so
+ * copy and rebase the native view here before control swaps the mapping. */
+static int do_grow_render_ring(struct spa_loop *loop, bool async, uint32_t seq,
+                               const void *data, size_t size, void *user_data)
+{
+    struct render_ring_rebase *rebase = user_data;
+    struct pipewire_stream *stream = rebase->stream;
+    SIZE_T pa_held, held;
+
+    if (!stream->local_buffer || !stream->real_bufsize_bytes ||
+        stream->pa_offs_bytes >= stream->real_bufsize_bytes ||
+        !rebase->new_buffer || rebase->new_size <= stream->real_bufsize_bytes ||
+        rebase->new_size > UINT32_MAX)
+        return -EINVAL;
+
+    pa_held = __atomic_load_n(&stream->pa_held_bytes, __ATOMIC_ACQUIRE);
+    if (pa_held > stream->real_bufsize_bytes)
+        return -EOVERFLOW;
+    held = stream->held_bytes;
+    if (held > rebase->new_size)
+        return -EOVERFLOW;
+
+    copy_from_ring(rebase->new_buffer, stream->local_buffer,
+                   stream->real_bufsize_bytes, stream->pa_offs_bytes, pa_held);
+    rebase->old_buffer = stream->local_buffer;
+    stream->local_buffer = rebase->new_buffer;
+    stream->real_bufsize_bytes = rebase->new_size;
+    stream->pa_offs_bytes = 0;
+    if (pa_held >= held)
+        stream->lcl_offs_bytes = pa_held - held;
+    else
+        stream->lcl_offs_bytes = rebase->new_size - (held - pa_held);
+    stream->lcl_offs_bytes %= rebase->new_size;
+    return 0;
+}

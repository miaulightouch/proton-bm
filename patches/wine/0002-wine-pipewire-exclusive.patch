diff --git a/dlls/mmdevapi/tests/exclusive.c b/dlls/mmdevapi/tests/exclusive.c
new file mode 100644
--- /dev/null
+++ b/dlls/mmdevapi/tests/exclusive.c
@@ -0,0 +1,388 @@
+/*
+ * Event-driven exclusive render streams.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+#include <io.h>
+#include <math.h>
+#include <stdint.h>
+#include "windows.h"
+#include "wine/test.h"
+#ifdef STANDALONE
+#include "initguid.h"
+#endif
+#include "mmdeviceapi.h"
+#include "audioclient.h"
+#include "../../winepipewire.drv/recovery.h"
+
+static void test_quantum_recovery_retries(void)
+{
+    struct wine_pipewire_recovery state = {1};
+    uint64_t now = 1000000000;
+    unsigned int i;
+
+    for (i = 0; i < 3; ++i)
+    {
+        state.connecting = 1;
+        state.ready = 1;
+        ok(wine_pipewire_recovery_failed(&state, now), "Failure %u escaped early.\n", i + 1);
+        ok(state.pending && state.failures == i + 1 && !state.connecting && !state.ready,
+           "Retry %u has invalid state.\n", i + 1);
+        ok(state.due_ns == now + (UINT64_C(100000000) << i),
+           "Retry %u did not back off.\n", i + 1);
+        now = state.due_ns;
+    }
+    ok(!wine_pipewire_recovery_failed(&state, now), "Fourth failure did not invalidate.\n");
+    ok(!state.pending && state.failures == 4, "Terminal failure state is incorrect.\n");
+
+    state.pending = 1;
+    state.ready = 1;
+    wine_pipewire_recovery_complete(&state);
+    ok(!state.pending && !state.failures && !state.connecting && !state.due_ns && !state.ready,
+       "Success did not clear consecutive failures.\n");
+    state.pending = 1;
+    ok(wine_pipewire_recovery_failed(&state, now) && state.failures == 1 && state.pending,
+       "A later disruption inherited the previous failures.\n");
+    ok(state.due_ns == now + 100000000, "A later disruption inherited the old backoff.\n");
+}
+
+static UINT64 qpc_to_hns(const LARGE_INTEGER *value, const LARGE_INTEGER *frequency)
+{
+    UINT64 qpc, freq, whole, remainder;
+
+    if (!value || !frequency || value->QuadPart < 0 || frequency->QuadPart <= 0)
+        return 0;
+    qpc = (UINT64)value->QuadPart;
+    freq = (UINT64)frequency->QuadPart;
+    whole = qpc / freq;
+    remainder = qpc % freq;
+    return whole * 10000000 + remainder * 10000000 / freq;
+}
+
+static void test_exclusive_event(IMMDevice *device, UINT rate, WORD tag, UINT buffer_frames)
+{
+    WAVEFORMATEX format = {tag, 2, rate};
+    IAudioRenderClient *render = NULL;
+    IAudioClock *clock = NULL;
+    IAudioClock2 *clock2 = NULL;
+    IAudioClockAdjustment *adjustment = NULL;
+    IAudioClient *client;
+    REFERENCE_TIME period;
+    UINT32 frames, padding, i, j;
+    UINT64 frequency, position, qpctime, max_queued_frames, expected_position;
+    UINT64 device_position, device_qpctime, stopped_position, stopped_qpctime;
+    UINT64 stopped_position2, stopped_qpctime2;
+    UINT64 resumed_position, resumed_qpctime;
+    LARGE_INTEGER qpc_before, qpc_after, qpc_frequency = {0};
+    LARGE_INTEGER qpc_query_before, qpc_query_after;
+    HANDLE event = NULL;
+    BYTE *data;
+    REFERENCE_TIME latency, initial_latency;
+    HRESULT hr, clock_hr;
+    double phase = 0.0;
+
+    format.wBitsPerSample = tag == WAVE_FORMAT_PCM ? 16 : 32;
+    format.nBlockAlign = format.nChannels * format.wBitsPerSample / 8;
+    format.nAvgBytesPerSec = rate * format.nBlockAlign;
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client);
+    ok(hr == S_OK, "Activate failed: %#lx.\n", hr);
+    if (FAILED(hr)) return;
+
+    hr = IAudioClient_IsFormatSupported(client, AUDCLNT_SHAREMODE_EXCLUSIVE, &format, NULL);
+    ok(hr == S_OK || hr == AUDCLNT_E_UNSUPPORTED_FORMAT || hr == AUDCLNT_E_EXCLUSIVE_MODE_NOT_ALLOWED,
+       "IsFormatSupported failed: %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        skip("Exclusive %u Hz, tag %u is unavailable: %#lx.\n", rate, tag, hr);
+        goto done;
+    }
+    hr = IAudioClient_GetDevicePeriod(client, NULL, &period);
+    ok(hr == S_OK, "GetDevicePeriod failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    if (buffer_frames)
+    {
+        REFERENCE_TIME requested = (UINT64)buffer_frames * 10000000 / rate;
+
+        if (requested < period)
+        {
+            skip("The device minimum period exceeds %u frames at %u Hz.\n", buffer_frames, rate);
+            goto done;
+        }
+        period = requested;
+    }
+
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_EXCLUSIVE,
+                                AUDCLNT_STREAMFLAGS_EVENTCALLBACK | AUDCLNT_STREAMFLAGS_RATEADJUST,
+                                period, period, &format, NULL);
+    ok(hr == AUDCLNT_E_UNSUPPORTED_FORMAT,
+       "Exclusive RATEADJUST Initialize returned %#lx.\n", hr);
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_EXCLUSIVE, AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                                period + 1, period, &format, NULL);
+    ok(hr == AUDCLNT_E_BUFDURATION_PERIOD_NOT_EQUAL, "Unequal periods returned %#lx.\n", hr);
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_EXCLUSIVE, AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                                period, period, &format, NULL);
+    ok(hr == S_OK || hr == AUDCLNT_E_DEVICE_IN_USE, "Initialize failed: %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+
+    hr = IAudioClient_GetBufferSize(client, &frames);
+    ok(hr == S_OK && frames > 1, "Invalid buffer: %#lx, %u frames.\n", hr, frames);
+    if (FAILED(hr) || frames < 2) goto done;
+    trace("Exclusive event stream: %u Hz, tag %u, %u frames, period %I64d.\n",
+          rate, tag, frames, period);
+    hr = IAudioClient_GetService(client, &IID_IAudioRenderClient, (void **)&render);
+    ok(hr == S_OK, "GetService(render) failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetService(client, &IID_IAudioClock, (void **)&clock);
+    ok(hr == S_OK, "GetService(clock) failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClock_GetFrequency(clock, &frequency);
+    ok(hr == S_OK && frequency == rate, "Frequency %#lx, %I64u, expected %u.\n",
+       hr, frequency, rate);
+    hr = IAudioClient_GetService(client, &IID_IAudioClockAdjustment, (void **)&adjustment);
+    if (SUCCEEDED(hr))
+    {
+        hr = IAudioClockAdjustment_SetSampleRate(adjustment, rate / 2.0f);
+        ok(FAILED(hr), "Exclusive SetSampleRate succeeded: %#lx.\n", hr);
+        IAudioClockAdjustment_Release(adjustment);
+        adjustment = NULL;
+    }
+    hr = IAudioClient_GetStreamLatency(client, &latency);
+    ok(hr == S_OK && latency > 0, "GetStreamLatency before Start failed: %#lx, %I64d.\n",
+       hr, latency);
+    initial_latency = latency;
+
+    hr = IAudioRenderClient_GetBuffer(render, frames - 1, &data);
+    ok(hr == AUDCLNT_E_BUFFER_SIZE_ERROR, "Partial GetBuffer returned %#lx.\n", hr);
+    hr = IAudioRenderClient_GetBuffer(render, frames, &data);
+    ok(hr == S_OK, "GetBuffer failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioRenderClient_ReleaseBuffer(render, frames - 1, AUDCLNT_BUFFERFLAGS_SILENT);
+    ok(hr == AUDCLNT_E_BUFFER_SIZE_ERROR, "Partial ReleaseBuffer returned %#lx.\n", hr);
+    hr = IAudioRenderClient_ReleaseBuffer(render, 0, 0);
+    ok(hr == AUDCLNT_E_BUFFER_SIZE_ERROR, "Empty ReleaseBuffer returned %#lx.\n", hr);
+    hr = IAudioRenderClient_ReleaseBuffer(render, frames, AUDCLNT_BUFFERFLAGS_SILENT);
+    ok(hr == S_OK, "ReleaseBuffer failed: %#lx.\n", hr);
+    hr = IAudioClock_GetPosition(clock, &position, &qpctime);
+    ok(hr == S_OK || hr == S_FALSE, "Pre-start GetPosition failed: %#lx.\n", hr);
+    ok(!position && qpctime, "Pre-start position/QPC pair was not zero/current: %I64u, %I64u.\n",
+       position, qpctime);
+    hr = IAudioClient_Start(client);
+    ok(hr == AUDCLNT_E_EVENTHANDLE_NOT_SET, "Start without an event returned %#lx.\n", hr);
+
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!event, "CreateEvent failed.\n");
+    if (!event) goto done;
+    hr = IAudioClient_SetEventHandle(client, event);
+    ok(hr == S_OK, "SetEventHandle failed: %#lx.\n", hr);
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Start failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetStreamLatency(client, &latency);
+    ok(hr == S_OK && latency == initial_latency,
+       "GetStreamLatency changed at Start: %#lx, %I64d != %I64d.\n",
+       hr, latency, initial_latency);
+    ok(QueryPerformanceFrequency(&qpc_frequency), "QueryPerformanceFrequency failed.\n");
+    QueryPerformanceCounter(&qpc_before);
+    for (i = 0; i < 64; ++i)
+    {
+        DWORD wait = WaitForSingleObject(event, 1000);
+        ok(wait == WAIT_OBJECT_0, "Event %u timed out: %lu.\n", i, wait);
+        if (wait != WAIT_OBJECT_0) break;
+        if (i == 8)
+        {
+            Sleep(20);
+            ok(WaitForSingleObject(event, 0) == WAIT_TIMEOUT, "Buffer readiness was signalled twice.\n");
+        }
+        hr = IAudioClient_GetCurrentPadding(client, &padding);
+        ok(hr == S_OK && padding == 0, "Padding at event %u: %#lx, %u.\n", i, hr, padding);
+        hr = IAudioRenderClient_GetBuffer(render, frames, &data);
+        ok(hr == S_OK, "Full-buffer GetBuffer at event %u: %#lx.\n", i, hr);
+        if (FAILED(hr)) break;
+        if (winetest_interactive)
+            for (j = 0; j < frames * format.nChannels; ++j)
+            {
+                double sample = sin(phase) * 0.1;
+                if (tag == WAVE_FORMAT_PCM) ((short *)data)[j] = sample * 32767;
+                else ((float *)data)[j] = sample;
+                if (j % format.nChannels == format.nChannels - 1) phase += 2.0 * 3.141592653589793 * 440.0 / rate;
+            }
+        hr = IAudioRenderClient_ReleaseBuffer(render, frames, winetest_interactive ? 0 : AUDCLNT_BUFFERFLAGS_SILENT);
+        ok(hr == S_OK, "Full-buffer ReleaseBuffer at event %u: %#lx.\n", i, hr);
+    }
+    QueryPerformanceCounter(&qpc_after);
+    if (i == 64 && qpc_frequency.QuadPart > 0)
+    {
+        UINT64 elapsed_hns = ((UINT64)(qpc_after.QuadPart - qpc_before.QuadPart) * 10000000)
+                / qpc_frequency.QuadPart;
+        UINT64 expected_hns = (UINT64)i * period;
+        UINT64 limit_hns = expected_hns + expected_hns / 2 + 1000000;
+
+        ok(elapsed_hns <= limit_hns,
+           "Exclusive event throughput is below the API period: %I64u hns for %u events, expected <= %I64u.\n",
+           elapsed_hns, i, limit_hns);
+    }
+    QueryPerformanceCounter(&qpc_query_before);
+    hr = IAudioClock_GetPosition(clock, &position, &qpctime);
+    QueryPerformanceCounter(&qpc_query_after);
+    clock_hr = hr;
+    ok(hr == S_OK || hr == S_FALSE, "GetPosition failed: %#lx.\n", hr);
+    ok(qpctime, "GetPosition returned no correlated QPC: %#lx.\n", hr);
+    if (hr == S_OK && qpc_frequency.QuadPart > 0)
+    {
+        UINT64 query_before_hns = qpc_to_hns(&qpc_query_before, &qpc_frequency);
+        UINT64 query_after_hns = qpc_to_hns(&qpc_query_after, &qpc_frequency);
+        UINT64 tolerance_hns = initial_latency > 500000 ? (UINT64)initial_latency : 500000;
+
+        ok(qpctime <= query_after_hns + tolerance_hns,
+           "GetPosition QPC is in the future: %I64u > %I64u.\n",
+           qpctime, query_after_hns + tolerance_hns);
+        ok(qpctime + tolerance_hns >= query_before_hns,
+           "GetPosition QPC is too old for S_OK: %I64u < %I64u.\n",
+           qpctime, query_before_hns - tolerance_hns);
+    }
+    hr = IAudioClock_QueryInterface(clock, &IID_IAudioClock2, (void **)&clock2);
+    ok(hr == S_OK, "IAudioClock2 is unavailable: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IAudioClock2_GetPosition(clock2, &device_position, &device_qpctime);
+        ok(hr == S_OK || hr == S_FALSE, "IAudioClock2_GetPosition failed: %#lx.\n", hr);
+        if (hr == S_OK || hr == S_FALSE)
+        {
+            ok(device_position <= (UINT64)frames * (i + 1),
+               "Device clock position is out of range: %I64u, %u events.\n", device_position, i);
+            ok(device_qpctime, "IAudioClock2 returned no correlated QPC: %#lx.\n", hr);
+        }
+        IAudioClock2_Release(clock2);
+        clock2 = NULL;
+    }
+    hr = IAudioClient_GetStreamLatency(client, &latency);
+    ok(hr == S_OK && latency == initial_latency,
+       "GetStreamLatency changed during playback: %#lx, %I64d != %I64d.\n",
+       hr, latency, initial_latency);
+    if (SUCCEEDED(hr) && latency >= 0 &&
+        (UINT64)latency <= (UINT64_MAX - 9999999) / rate)
+        max_queued_frames = ((UINT64)latency * rate + 9999999) / 10000000;
+    else
+        max_queued_frames = (UINT64)frames * 2;
+    if (max_queued_frames < frames)
+        max_queued_frames = frames;
+    expected_position = (UINT64)frames * (i > 1 ? i - 1 : 0);
+    if (expected_position > max_queued_frames)
+        expected_position -= max_queued_frames;
+    else
+        expected_position = 0;
+    ok((clock_hr == S_OK || clock_hr == S_FALSE) && position >= expected_position &&
+       position <= (UINT64)frames * (i + 1),
+       "Clock did not advance with buffers: %#lx, %I64u, %u events.\n", clock_hr, position, i);
+    hr = IAudioClient_Stop(client);
+    ok(hr == S_OK, "Stop failed: %#lx.\n", hr);
+    hr = IAudioClock_GetPosition(clock, &stopped_position, &stopped_qpctime);
+    ok(hr == S_OK || hr == S_FALSE, "Stopped GetPosition failed: %#lx.\n", hr);
+    hr = IAudioClock_GetPosition(clock, &stopped_position2, &stopped_qpctime2);
+    ok(hr == S_OK || hr == S_FALSE, "Repeated stopped GetPosition failed: %#lx.\n", hr);
+    ok(stopped_position2 == stopped_position && stopped_qpctime2 == stopped_qpctime,
+       "Stopped position/QPC pair changed: %I64u/%I64u -> %I64u/%I64u.\n",
+       stopped_position, stopped_qpctime, stopped_position2, stopped_qpctime2);
+
+    /* Stop must preserve the accepted stream timeline.  Restart this same
+     * client without Reset and verify its clock resumes advancing while the
+     * source/public coordinate mapping remains intact. */
+    ResetEvent(event);
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Start without Reset failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        for (j = 0; j < 8; ++j)
+        {
+            ok(WaitForSingleObject(event, 1000) == WAIT_OBJECT_0,
+               "Restart without Reset did not signal readiness.\n");
+            hr = IAudioRenderClient_GetBuffer(render, frames, &data);
+            ok(hr == S_OK, "Resumed GetBuffer failed: %#lx.\n", hr);
+            if (FAILED(hr)) break;
+            hr = IAudioRenderClient_ReleaseBuffer(render, frames, AUDCLNT_BUFFERFLAGS_SILENT);
+            ok(hr == S_OK, "Resumed ReleaseBuffer failed: %#lx.\n", hr);
+        }
+        hr = IAudioClock_GetPosition(clock, &resumed_position, &resumed_qpctime);
+        ok(hr == S_OK, "Resumed GetPosition did not recover: %#lx.\n", hr);
+        ok(resumed_position > stopped_position && resumed_qpctime > stopped_qpctime,
+           "Resumed clock remained frozen: %I64u/%I64u -> %I64u/%I64u.\n",
+           stopped_position, stopped_qpctime, resumed_position, resumed_qpctime);
+        hr = IAudioClient_Stop(client);
+        ok(hr == S_OK, "Stop after restart without Reset failed: %#lx.\n", hr);
+    }
+    hr = IAudioClient_GetStreamLatency(client, &latency);
+    ok(hr == S_OK && latency == initial_latency,
+       "GetStreamLatency changed at Stop: %#lx, %I64d != %I64d.\n",
+       hr, latency, initial_latency);
+    ResetEvent(event);
+    ok(WaitForSingleObject(event, 50) == WAIT_TIMEOUT, "Stopped stream signalled its event.\n");
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Reset failed: %#lx.\n", hr);
+    hr = IAudioClient_GetStreamLatency(client, &latency);
+    ok(hr == S_OK && latency == initial_latency,
+       "GetStreamLatency changed at Reset: %#lx, %I64d != %I64d.\n",
+       hr, latency, initial_latency);
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && !padding, "Padding after reset: %#lx, %u.\n", hr, padding);
+    ResetEvent(event);
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Empty-buffer Start failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IAudioClient_GetStreamLatency(client, &latency);
+        ok(hr == S_OK && latency == initial_latency,
+           "GetStreamLatency changed at restart: %#lx, %I64d != %I64d.\n",
+           hr, latency, initial_latency);
+        ok(WaitForSingleObject(event, 1000) == WAIT_OBJECT_0, "Empty stream did not signal readiness.\n");
+        hr = IAudioRenderClient_GetBuffer(render, frames, &data);
+        ok(hr == S_OK, "Empty-stream GetBuffer failed: %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IAudioRenderClient_ReleaseBuffer(render, frames, AUDCLNT_BUFFERFLAGS_SILENT);
+            ok(hr == S_OK, "Empty-stream ReleaseBuffer failed: %#lx.\n", hr);
+        }
+    }
+done:
+    IAudioClient_Stop(client);
+    if (clock) IAudioClock_Release(clock);
+    if (clock2) IAudioClock2_Release(clock2);
+    if (adjustment) IAudioClockAdjustment_Release(adjustment);
+    if (render) IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    if (event) CloseHandle(event);
+}
+
+START_TEST(exclusive)
+{
+    IMMDeviceEnumerator *enumerator;
+    IMMDevice *device;
+    HRESULT hr;
+
+    test_quantum_recovery_retries();
+    CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER,
+                         &IID_IMMDeviceEnumerator, (void **)&enumerator);
+    ok(hr == S_OK, "Enumerator creation failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(enumerator, eRender, eMultimedia, &device);
+        if (SUCCEEDED(hr))
+        {
+            test_exclusive_event(device, 44100, WAVE_FORMAT_PCM, 0);
+            test_exclusive_event(device, 48000, WAVE_FORMAT_PCM, 0);
+            test_exclusive_event(device, 44100, WAVE_FORMAT_IEEE_FLOAT, 0);
+            test_exclusive_event(device, 48000, WAVE_FORMAT_IEEE_FLOAT, 0);
+            /* SRC startup can request more than one client period at a tight graph bound. */
+            test_exclusive_event(device, 44100, WAVE_FORMAT_PCM, 256);
+            IMMDevice_Release(device);
+        }
+        else skip("No render endpoint: %#lx.\n", hr);
+        IMMDeviceEnumerator_Release(enumerator);
+    }
+    CoUninitialize();
+}
diff --git a/dlls/mmdevapi/tests/exclusive_shared.c b/dlls/mmdevapi/tests/exclusive_shared.c
new file mode 100644
--- /dev/null
+++ b/dlls/mmdevapi/tests/exclusive_shared.c
@@ -0,0 +1,504 @@
+/*
+ * Shared event-driven render streams.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+#include <io.h>
+#include "windows.h"
+#include "wine/test.h"
+#ifdef STANDALONE
+#include "initguid.h"
+#endif
+#include "mmdeviceapi.h"
+#include "audioclient.h"
+#include "ksmedia.h"
+#include "devpkey.h"
+
+static BOOL is_unavailable(HRESULT hr)
+{
+    return hr == AUDCLNT_E_UNSUPPORTED_FORMAT || hr == AUDCLNT_E_DEVICE_IN_USE;
+}
+
+static DWORD channel_mask(UINT channels)
+{
+    switch (channels)
+    {
+    case 2: return KSAUDIO_SPEAKER_STEREO;
+    case 4: return KSAUDIO_SPEAKER_SURROUND;
+    case 6: return KSAUDIO_SPEAKER_5POINT1;
+    case 8: return KSAUDIO_SPEAKER_7POINT1_SURROUND;
+    default: return 0;
+    }
+}
+
+static void make_format(WAVEFORMATEXTENSIBLE *format, UINT rate, UINT channels, BOOL ieee_float)
+{
+    WORD bits = ieee_float ? 32 : 16;
+
+    ZeroMemory(format, sizeof(*format));
+    format->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    format->Format.nChannels = channels;
+    format->Format.nSamplesPerSec = rate;
+    format->Format.wBitsPerSample = bits;
+    format->Format.nBlockAlign = channels * bits / 8;
+    format->Format.nAvgBytesPerSec = rate * format->Format.nBlockAlign;
+    format->Format.cbSize = sizeof(*format) - sizeof(format->Format);
+    format->Samples.wValidBitsPerSample = bits;
+    format->dwChannelMask = channel_mask(channels);
+    format->SubFormat = ieee_float ? KSDATAFORMAT_SUBTYPE_IEEE_FLOAT : KSDATAFORMAT_SUBTYPE_PCM;
+}
+
+static BOOL wait_event(HANDLE event, UINT number, DWORD timeout)
+{
+    DWORD wait = WaitForSingleObject(event, timeout);
+
+    ok(wait == WAIT_OBJECT_0, "Event %u timed out: %lu.\n", number, wait);
+    return wait == WAIT_OBJECT_0;
+}
+
+static BOOL test_shared_event_format(IMMDevice *device, UINT rate, UINT channels, BOOL ieee_float)
+{
+    WAVEFORMATEXTENSIBLE format;
+    WAVEFORMATEX *closest = NULL;
+    IAudioRenderClient *render = NULL;
+    IAudioClient *client = NULL;
+    REFERENCE_TIME default_period, minimum_period, period;
+    UINT32 frames, padding, available, request;
+    BYTE *data;
+    HANDLE event = NULL;
+    HRESULT hr;
+    UINT i;
+    BOOL started = FALSE;
+    const char *kind = ieee_float ? "float" : "pcm";
+
+    make_format(&format, rate, channels, ieee_float);
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client);
+    ok(hr == S_OK, "Activate %s %u-channel client failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) return FALSE;
+
+    hr = IAudioClient_IsFormatSupported(client, AUDCLNT_SHAREMODE_SHARED,
+            &format.Format, &closest);
+    if (hr == S_FALSE)
+    {
+        ok(!!closest, "S_FALSE without a closest format.\n");
+        skip("Shared %s %u-channel format is not the endpoint mix format.\n", kind, channels);
+        CoTaskMemFree(closest);
+        IAudioClient_Release(client);
+        return TRUE;
+    }
+    if (is_unavailable(hr))
+    {
+        skip("Shared %s %u-channel format is unavailable: %#lx.\n", kind, channels, hr);
+        CoTaskMemFree(closest);
+        IAudioClient_Release(client);
+        return TRUE;
+    }
+    ok(hr == S_OK && !closest, "IsFormatSupported(%s,%u) returned %#lx, suggestion %p.\n",
+       kind, channels, hr, closest);
+    CoTaskMemFree(closest);
+    if (FAILED(hr)) goto fail;
+
+    hr = IAudioClient_GetDevicePeriod(client, &default_period, &minimum_period);
+    ok(hr == S_OK, "GetDevicePeriod(%s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+    period = default_period > minimum_period ? default_period : minimum_period;
+    if (!period)
+    {
+        skip("Shared %s %u-channel endpoint returned a zero period.\n", kind, channels);
+        goto skip_cleanup;
+    }
+
+    /* Shared streams require zero periodicity; their duration need not match it. */
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_SHARED,
+            AUDCLNT_STREAMFLAGS_EVENTCALLBACK, period + 1, 0, &format.Format, NULL);
+    if (is_unavailable(hr))
+    {
+        skip("Shared %s %u-channel Initialize is unavailable: %#lx.\n", kind, channels, hr);
+        goto skip_cleanup;
+    }
+    ok(hr == S_OK, "Initialize(shared event %s,%u; unequal timing) failed: %#lx.\n",
+       kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+
+    hr = IAudioClient_GetBufferSize(client, &frames);
+    ok(hr == S_OK && frames > 1, "GetBufferSize(%s,%u) returned %#lx, %u frames.\n",
+       kind, channels, hr, frames);
+    if (FAILED(hr) || frames <= 1) goto fail;
+
+    hr = IAudioClient_GetService(client, &IID_IAudioRenderClient, (void **)&render);
+    ok(hr == S_OK, "GetService(render %s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!event, "CreateEvent(%s,%u) failed.\n", kind, channels);
+    if (!event) goto fail;
+    hr = IAudioClient_SetEventHandle(client, event);
+    ok(hr == S_OK, "SetEventHandle(%s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Start(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+    started = TRUE;
+
+    for (i = 0; i < 2; ++i)
+        if (!wait_event(event, i, 1000)) goto fail;
+
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && padding <= frames, "Padding(shared event %s,%u) returned %#lx, %u/%u.\n",
+       kind, channels, hr, padding, frames);
+    if (FAILED(hr) || padding > frames) goto fail;
+
+    /* Exercise the shared render contract after an event without imposing the
+     * exclusive whole-buffer rule. */
+    available = frames - padding;
+    request = available > 64 ? 64 : available;
+    if (request)
+    {
+        hr = IAudioRenderClient_GetBuffer(render, request, &data);
+        ok(hr == S_OK && data != NULL, "GetBuffer(shared event %s,%u,%u) returned %#lx, %p.\n",
+           kind, channels, request, hr, data);
+        if (SUCCEEDED(hr))
+        {
+            hr = IAudioRenderClient_ReleaseBuffer(render, request, AUDCLNT_BUFFERFLAGS_SILENT);
+            ok(hr == S_OK, "ReleaseBuffer(shared event %s,%u,%u) failed: %#lx.\n",
+               kind, channels, request, hr);
+        }
+    }
+    else
+        trace("Shared event %s,%u had a full buffer after its callback; no write was attempted.\n",
+              kind, channels);
+
+    hr = IAudioClient_Reset(client);
+    ok(hr == AUDCLNT_E_NOT_STOPPED, "Reset while running (%s,%u) returned %#lx.\n",
+       kind, channels, hr);
+    hr = IAudioClient_Stop(client);
+    ok(hr == S_OK, "Stop(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    started = FALSE;
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Reset(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && !padding, "Padding after reset (%s,%u) returned %#lx, %u.\n",
+       kind, channels, hr, padding);
+
+    /* A reset stream must be restartable and deliver a fresh callback. */
+    ok(ResetEvent(event), "ResetEvent before restart (%s,%u) failed.\n", kind, channels);
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Restart(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (SUCCEEDED(hr))
+    {
+        started = TRUE;
+        wait_event(event, 2, 1000);
+        hr = IAudioClient_Stop(client);
+        ok(hr == S_OK, "Second Stop(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+        started = FALSE;
+    }
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Final Reset(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    trace("Shared event %s,%u lifecycle passed.\n", kind, channels);
+    CloseHandle(event);
+    IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    return TRUE;
+
+skip_cleanup:
+    if (event) CloseHandle(event);
+    if (render) IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    return TRUE;
+
+fail:
+    if (started) IAudioClient_Stop(client);
+    if (event) CloseHandle(event);
+    if (render) IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    return FALSE;
+}
+
+static int lifecycle_env_mode(char *endpoint, DWORD endpoint_size,
+                              char *marker, DWORD marker_size)
+{
+    DWORD endpoint_len, marker_len;
+
+    endpoint_len = GetEnvironmentVariableA("PROTON_BM_ENDPOINT_NAME", endpoint, endpoint_size);
+    marker_len = GetEnvironmentVariableA("PROTON_BM_REMOVED_MARKER", marker, marker_size);
+    if (!endpoint_len && !marker_len)
+        return 0;
+    ok(endpoint_len && marker_len && endpoint_len < endpoint_size && marker_len < marker_size,
+       "Lifecycle requires complete PROTON_BM_ENDPOINT_NAME and PROTON_BM_REMOVED_MARKER.\n");
+    return endpoint_len && marker_len && endpoint_len < endpoint_size && marker_len < marker_size ? 1 : -1;
+}
+
+static HRESULT find_lifecycle_endpoint(IMMDeviceEnumerator *enumerator,
+                                       const char *endpoint_name, IMMDevice **out)
+{
+    IMMDeviceCollection *collection = NULL;
+    IPropertyStore *store = NULL;
+    IMMDevice *device = NULL;
+    PROPVARIANT value;
+    WCHAR target[256];
+    UINT count, i, matches = 0;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!MultiByteToWideChar(CP_UTF8, 0, endpoint_name, -1, target, ARRAY_SIZE(target)))
+        return E_INVALIDARG;
+    hr = IMMDeviceEnumerator_EnumAudioEndpoints(enumerator, eRender, DEVICE_STATE_ACTIVE,
+                                                 &collection);
+    if (FAILED(hr)) return hr;
+    hr = IMMDeviceCollection_GetCount(collection, &count);
+    if (FAILED(hr)) goto done;
+    for (i = 0; i < count; ++i)
+    {
+        PropVariantInit(&value);
+        if (FAILED(IMMDeviceCollection_Item(collection, i, &device)))
+            continue;
+        if (SUCCEEDED(IMMDevice_OpenPropertyStore(device, STGM_READ, &store)) &&
+            SUCCEEDED(IPropertyStore_GetValue(store,
+                (const PROPERTYKEY *)&DEVPKEY_Device_FriendlyName, &value)) &&
+            value.vt == VT_LPWSTR && value.pwszVal && !lstrcmpW(value.pwszVal, target))
+        {
+            ++matches;
+            if (matches == 1)
+            {
+                *out = device;
+                device = NULL;
+            }
+        }
+        PropVariantClear(&value);
+        if (store) IPropertyStore_Release(store);
+        store = NULL;
+        if (device) IMMDevice_Release(device);
+        device = NULL;
+    }
+    ok(matches == 1, "Lifecycle endpoint %s matched %u active render endpoints.\n",
+       endpoint_name, matches);
+    if (matches != 1 && *out)
+    {
+        IMMDevice_Release(*out);
+        *out = NULL;
+    }
+    hr = matches == 1 ? S_OK : E_FAIL;
+
+done:
+    if (device) IMMDevice_Release(device);
+    if (store) IPropertyStore_Release(store);
+    IMMDeviceCollection_Release(collection);
+    return hr;
+}
+
+static BOOL wait_lifecycle_marker(const char *marker)
+{
+    UINT i;
+
+    for (i = 0; i < 3000; ++i)
+    {
+        if (GetFileAttributesA(marker) != INVALID_FILE_ATTRIBUTES)
+            return TRUE;
+        Sleep(10);
+    }
+    return FALSE;
+}
+
+static BOOL wait_lifecycle_invalidation(IAudioClient *client, HRESULT *padding_hr)
+{
+    UINT32 padding;
+    UINT i;
+
+    for (i = 0; i < 300; ++i)
+    {
+        *padding_hr = IAudioClient_GetCurrentPadding(client, &padding);
+        if (*padding_hr == AUDCLNT_E_DEVICE_INVALIDATED)
+            return TRUE;
+        Sleep(10);
+    }
+    return FALSE;
+}
+
+/* Host-coordinated endpoint check.  It is called only when both opt-in
+ * variables are complete, so the normal default-endpoint matrix is skipped
+ * and no physical default output is opened. */
+static void test_lifecycle_removal(IMMDeviceEnumerator *enumerator,
+                                   const char *endpoint_name, const char *marker)
+{
+    IMMDevice *device = NULL;
+    IAudioClient *client = NULL;
+    IAudioRenderClient *render = NULL;
+    WAVEFORMATEX *format = NULL;
+    REFERENCE_TIME default_period, minimum_period, period;
+    UINT32 frames, padding;
+    HANDLE event = NULL;
+    HRESULT hr, padding_hr, buffer_hr;
+    BOOL started = FALSE;
+    BOOL held_buffer = FALSE;
+    BYTE *held_data = NULL;
+
+    trace("Running opt-in PipeWire lifecycle check for %s.\n", endpoint_name);
+    hr = find_lifecycle_endpoint(enumerator, endpoint_name, &device);
+    ok(hr == S_OK, "Lifecycle endpoint lookup failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL,
+                            (void **)&client);
+    ok(hr == S_OK, "Lifecycle activation failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetMixFormat(client, &format);
+    ok(hr == S_OK && format, "Lifecycle GetMixFormat failed: %#lx.\n", hr);
+    if (FAILED(hr) || !format) goto done;
+    hr = IAudioClient_GetDevicePeriod(client, &default_period, &minimum_period);
+    ok(hr == S_OK, "Lifecycle GetDevicePeriod failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    period = default_period > minimum_period ? default_period : minimum_period;
+    if (!period)
+    {
+        ok(FALSE, "Lifecycle endpoint returned a zero period.\n");
+        goto done;
+    }
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_SHARED,
+                                 AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                                 period + 1, 0, format, NULL);
+    ok(hr == S_OK, "Lifecycle Initialize failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetBufferSize(client, &frames);
+    ok(hr == S_OK && frames > 1, "Lifecycle GetBufferSize failed: %#lx, %u.\n", hr, frames);
+    if (FAILED(hr) || frames <= 1) goto done;
+    hr = IAudioClient_GetService(client, &IID_IAudioRenderClient, (void **)&render);
+    ok(hr == S_OK, "Lifecycle GetService failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!event, "Lifecycle CreateEvent failed.\n");
+    if (!event) goto done;
+    hr = IAudioClient_SetEventHandle(client, event);
+    ok(hr == S_OK, "Lifecycle SetEventHandle failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Lifecycle Start failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    started = TRUE;
+    if (!wait_event(event, 0, 1000)) goto done;
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK, "Lifecycle post-Start padding failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    hr = IAudioClient_Stop(client);
+    ok(hr == S_OK, "Lifecycle Stop failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    started = FALSE;
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Lifecycle Reset failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && !padding, "Lifecycle reset padding failed: %#lx, %u.\n", hr, padding);
+    if (FAILED(hr) || padding) goto done;
+    ok(ResetEvent(event), "Lifecycle ResetEvent failed.\n");
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Lifecycle restart failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    started = TRUE;
+    if (!wait_event(event, 1, 1000)) goto done;
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK, "Lifecycle post-restart padding failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    hr = IAudioRenderClient_GetBuffer(render, 1, &held_data);
+    ok(hr == S_OK && held_data, "Lifecycle held GetBuffer returned %#lx, %p.\n",
+       hr, held_data);
+    if (FAILED(hr)) goto done;
+    held_buffer = TRUE;
+
+    printf("TEST_LIFECYCLE_READY\n");
+    fflush(stdout);
+    if (!wait_lifecycle_marker(marker))
+    {
+        ok(FALSE, "Lifecycle host did not remove the endpoint.\n");
+        goto done;
+    }
+    ok(wait_lifecycle_invalidation(client, &padding_hr),
+       "Lifecycle invalidation did not settle within the bounded poll.\n");
+    ok(padding_hr == AUDCLNT_E_DEVICE_INVALIDATED,
+       "Lifecycle removal padding returned %#lx, expected %#lx.\n",
+       padding_hr, AUDCLNT_E_DEVICE_INVALIDATED);
+
+    if (held_buffer)
+    {
+        hr = IAudioRenderClient_ReleaseBuffer(render, 1, 0);
+        ok(hr == AUDCLNT_E_DEVICE_INVALIDATED,
+           "Lifecycle held ReleaseBuffer returned %#lx, expected %#lx.\n",
+           hr, AUDCLNT_E_DEVICE_INVALIDATED);
+        held_buffer = FALSE;
+    }
+
+    held_data = NULL;
+    buffer_hr = IAudioRenderClient_GetBuffer(render, 1, &held_data);
+    ok(buffer_hr == AUDCLNT_E_DEVICE_INVALIDATED,
+       "Lifecycle removal GetBuffer returned %#lx, expected %#lx.\n",
+       buffer_hr, AUDCLNT_E_DEVICE_INVALIDATED);
+
+done:
+    if (held_buffer) IAudioRenderClient_ReleaseBuffer(render, 1, 0);
+    if (started) IAudioClient_Stop(client);
+    if (event) CloseHandle(event);
+    if (render) IAudioRenderClient_Release(render);
+    if (client) IAudioClient_Release(client);
+    CoTaskMemFree(format);
+    if (device) IMMDevice_Release(device);
+}
+
+START_TEST(exclusive_shared)
+{
+    IMMDeviceEnumerator *enumerator = NULL;
+    IMMDevice *device = NULL;
+    IAudioClient *client = NULL;
+    WAVEFORMATEX *mix = NULL;
+    char lifecycle_endpoint[256], lifecycle_marker[MAX_PATH];
+    int lifecycle_mode;
+    HRESULT hr;
+    UINT channels, formats;
+    static const UINT channel_counts[] = {2, 4, 6, 8};
+
+    CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMMDeviceEnumerator, (void **)&enumerator);
+    ok(hr == S_OK, "Enumerator creation failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    lifecycle_mode = lifecycle_env_mode(lifecycle_endpoint, sizeof(lifecycle_endpoint),
+                                         lifecycle_marker, sizeof(lifecycle_marker));
+    if (lifecycle_mode)
+    {
+        if (lifecycle_mode > 0)
+            test_lifecycle_removal(enumerator, lifecycle_endpoint, lifecycle_marker);
+        goto done;
+    }
+
+    hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(enumerator, eRender, eMultimedia, &device);
+    if (FAILED(hr))
+    {
+        skip("No render endpoint for shared event tests: %#lx.\n", hr);
+        goto done;
+    }
+
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client);
+    ok(hr == S_OK, "Mix-format activation failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetMixFormat(client, &mix);
+    ok(hr == S_OK && mix && mix->nSamplesPerSec, "GetMixFormat failed: %#lx.\n", hr);
+    if (FAILED(hr) || !mix || !mix->nSamplesPerSec) goto done;
+
+    trace("Shared EVENTCALLBACK matrix at %lu Hz; unsupported layouts are skips.\n",
+          (ULONG)mix->nSamplesPerSec);
+    for (channels = 0; channels < ARRAY_SIZE(channel_counts); ++channels)
+        for (formats = 0; formats < 2; ++formats)
+            test_shared_event_format(device, mix->nSamplesPerSec, channel_counts[channels], formats);
+
+done:
+    CoTaskMemFree(mix);
+    if (client) IAudioClient_Release(client);
+    if (device) IMMDevice_Release(device);
+    if (enumerator) IMMDeviceEnumerator_Release(enumerator);
+    CoUninitialize();
+}
diff --git a/dlls/mmdevapi/tests/presentation.c b/dlls/mmdevapi/tests/presentation.c
new file mode 100644
--- /dev/null
+++ b/dlls/mmdevapi/tests/presentation.c
@@ -0,0 +1,269 @@
+/* PipeWire presentation timeline regressions. */
+
+#include <stdint.h>
+#include <limits.h>
+#include "wine/test.h"
+
+/* Exercise the production Unix adapter math on both PE architectures. */
+#include "../../winepipewire.drv/presentation.c"
+
+static void test_first_sample_and_pending(void)
+{
+    const struct wine_presentation_observation phase = {
+        1000000000, 256, 0, 480, 1, 48000, 48000
+    };
+    const struct wine_presentation_observation combined = {
+        1000000000, 1, 1, 0, 1, 1, 44100
+    };
+    struct wine_presentation_observation observation = {
+        1000000000, 512, 224, 0, 1, 1, 48000
+    };
+    struct wine_presentation_basis startup = {
+        1, 256, 512, 0, 0, 1015333333, 1020666666, 48000
+    };
+    uint64_t first = 0, end = 0, position = 0;
+
+    ok(wine_presentation_first_ns(&phase, &first), "Phase first-sample time failed.\n");
+    ok(first == 1015333333, "Phase T0 is %I64u, expected 1015333333.\n", first);
+    ok(wine_presentation_span_end(first, 256, 48000, &end), "Phase span end failed.\n");
+    ok(end == 1020666666, "Phase span end is %I64u, expected 1020666666.\n", end);
+    ok(wine_presentation_first_ns(&combined, &first), "Combined backlog T0 failed.\n");
+    ok(first == 1000045351, "Combined backlog T0 is %I64u, expected 1000045351.\n", first);
+
+    ok(wine_presentation_first_ns(&observation, &first), "First-sample time failed.\n");
+    ok(first == 1015333333, "Pending 736-frame T0 is %I64u, expected 1015333333.\n", first);
+    ok(wine_presentation_span_end(first, 256, 48000, &end), "Span end failed.\n");
+    ok(end == 1020666666, "Span end is %I64u, expected 1020666666.\n", end);
+
+    ok(wine_presentation_project_basis(&startup, 1000000000, &position),
+       "Startup projection failed.\n");
+    ok(position == 0, "Startup position escaped early: %I64u.\n", position);
+    ok(wine_presentation_project_basis(&startup, 1010000000, &position),
+       "Startup boundary projection failed.\n");
+    ok(position == 0, "Position advanced before the first sample: %I64u.\n", position);
+    ok(wine_presentation_project_basis(&startup, 1012000000, &position),
+       "Startup middle projection failed.\n");
+    ok(position == 96, "Startup middle position is %I64u, expected 96.\n", position);
+    ok(wine_presentation_project_basis(&startup, 1015333333, &position),
+       "Startup first-sample projection failed.\n");
+    ok(position == 256, "Startup first-sample position is %I64u, expected 256.\n", position);
+}
+
+static void test_retained_resume_origin(void)
+{
+    /* Stop froze public P=768 while native [768,1024) remained queued. */
+    const struct wine_presentation_basis basis = {
+        2, 1024, 1280, 768, 768, 7005333333, 7010666666, 48000
+    };
+    uint64_t position = 0;
+
+    ok(wine_presentation_project_basis(&basis, 7000000000, &position),
+       "Long-pause projection failed.\n");
+    ok(position == 768, "Long-pause position is %I64u, expected 768.\n", position);
+    ok(wine_presentation_project_basis(&basis, 7002666667, &position),
+       "Retained middle projection failed.\n");
+    ok(position == 896, "Retained middle position is %I64u, expected 896.\n", position);
+    ok(wine_presentation_project_basis(&basis, 7005333333, &position),
+       "Retained end projection failed.\n");
+    ok(position == 1024, "Retained end position is %I64u, expected 1024.\n", position);
+    ok(wine_presentation_project_basis(&basis, 7010666666, &position),
+       "Resumed submission projection failed.\n");
+    ok(position == 1280, "Resumed submission position is %I64u, expected 1280.\n", position);
+}
+
+static void test_resume_origin_selection(void)
+{
+    struct wine_presentation_basis discarded = {
+        3, 1024, 1280, 1024, 768, 7000000000, 7005333333, 48000
+    };
+    uint64_t origin = 0, position = 0;
+
+    ok(wine_presentation_resume_origin(1024, 256, 0, &origin),
+       "Retained native origin calculation failed.\n");
+    ok(origin == 768, "Retained native origin is %I64u, expected 768.\n", origin);
+    ok(wine_presentation_resume_origin(1024, 128, 128, &origin),
+       "Queued plus converter origin calculation failed.\n");
+    ok(origin == 768, "Queued plus converter origin is %I64u, expected 768.\n", origin);
+    ok(wine_presentation_resume_origin(1024, 0, 0, &origin),
+       "Empty native origin calculation failed.\n");
+    ok(origin == 1024, "Empty native origin is %I64u, expected 1024.\n", origin);
+    ok(!wine_presentation_resume_origin(1024, 1025, 0, &origin),
+       "Over-retained native queue was accepted.\n");
+    ok(!wine_presentation_resume_origin(UINT64_MAX, UINT64_MAX, 1, &origin),
+       "Native queue arithmetic overflow was accepted.\n");
+    ok(wine_presentation_project_basis(&discarded, 7000000000, &position),
+       "Discarded native origin projection failed.\n");
+    ok(position == 768, "Discarded native origin position is %I64u, expected 768.\n", position);
+    ok(wine_presentation_project_basis(&discarded, 7005333333, &position),
+       "Discarded submission projection failed.\n");
+    ok(position == 1024, "Discarded submission position is %I64u, expected 1024.\n", position);
+}
+
+static void test_resume_source_mapping(void)
+{
+    uint64_t origin;
+
+    /* Measured Stop position was 15324, but the retained source began at 15523. */
+    ok(wine_presentation_reanchor(0, 0, 15523, &origin) && origin == 15523,
+       "Resume replaced the retained source coordinate with the frozen position.\n");
+    ok(wine_presentation_reanchor(15523, origin, 31753, &origin) && origin == 31753,
+       "Repeated Stop/Resume accumulated a clock phase offset.\n");
+    ok(wine_presentation_reanchor(100, 70, 180, &origin) && origin == 150,
+       "Resume lost the existing source/public offset.\n");
+    ok(wine_presentation_reanchor(100, 70, 100, &origin) && origin == 70,
+       "An empty resume extent changed the public coordinate.\n");
+    ok(!wine_presentation_reanchor(100, 70, 99, &origin),
+       "A regressing retained frontier was accepted.\n");
+    ok(!wine_presentation_reanchor(0, UINT64_MAX, 1, &origin),
+       "A wrapped public origin was accepted.\n");
+    ok(!wine_presentation_reanchor(0, 0, 0, NULL), "A missing public origin was accepted.\n");
+}
+
+static void test_undersupply_projection(void)
+{
+    const struct wine_presentation_basis basis = {
+        1, 0, 1024, 0, 0, 2010666666, 2031999999, 48000
+    };
+    const struct wine_presentation_basis one_span = {
+        1, 0, 256, 0, 0, 1015333333, 1020666666, 48000
+    };
+    uint64_t position = 0;
+
+    ok(wine_presentation_project_basis(&basis, 2000000000, &position),
+       "Undersupply basis projection failed.\n");
+    ok(position == 0, "Undersupply basis position is %I64u, expected 0.\n", position);
+    ok(wine_presentation_project_basis(&basis, 2031999999, &position),
+       "Undersupply end projection failed.\n");
+    ok(position == 1024, "Undersupply end position is %I64u, expected 1024.\n", position);
+    ok(wine_presentation_project_basis(&one_span, 1020000000, &position),
+       "One-span middle projection failed.\n");
+    ok(position == 224, "One-span middle position is %I64u, expected 224.\n", position);
+}
+
+static void test_adjacent_sizes(void)
+{
+    const struct wine_presentation_observation previous = {
+        1000000000, 0, 0, 0, 1, 48000, 48000
+    };
+    struct wine_presentation_observation same = previous;
+    struct wine_presentation_observation fresh = previous;
+    uint64_t first_a = 0, first_b = 0, end_a = 0, end_b = 0;
+
+    ok(wine_presentation_first_ns(&previous, &first_a), "A first-sample time failed.\n");
+    ok(wine_presentation_span_end(first_a, 256, 48000, &end_a), "A span end failed.\n");
+    ok(wine_presentation_first_ns(&same, &first_b), "Stale B first-sample time failed.\n");
+    ok(!wine_presentation_span_contiguous(&previous, &same, end_a, first_b),
+       "A256/B128 same snapshot was treated as adjacent.\n");
+    fresh.queued_frames = 256;
+    ok(wine_presentation_first_ns(&fresh, &first_b), "Fresh B first-sample time failed.\n");
+    ok(first_b == end_a, "Fresh B starts at %I64u, expected %I64u.\n", first_b, end_a);
+    ok(wine_presentation_span_contiguous(&previous, &fresh, end_a, first_b),
+       "Fresh A256/B128 snapshot was rejected.\n");
+    ok(wine_presentation_span_end(first_b, 128, 48000, &end_b), "B span end failed.\n");
+    ok(end_b == 1007999999, "B span end is %I64u, expected 1007999999.\n", end_b);
+    ok(wine_presentation_span_contiguous(&previous, &same, end_a, end_a - 1),
+       "One-frame rounding was rejected.\n");
+    same.now_ns++;
+    ok(wine_presentation_span_contiguous(&previous, &same, end_a, end_a - 1),
+       "One-frame graph drift was rejected.\n");
+    same.now_ns -= 2;
+    ok(!wine_presentation_span_contiguous(&previous, &same, end_a, end_a - 1),
+       "Backwards graph time was accepted.\n");
+}
+
+static void test_measured_startup_overlap(void)
+{
+    const struct wine_presentation_observation previous = {
+        1000000000, 0, 0, 0, 1, 48000, 44100
+    };
+    struct wine_presentation_observation current = previous;
+    struct wine_presentation_basis basis;
+    uint64_t first = 0, previous_end = 0, current_first = 0, current_end = 0, position = 0;
+
+    ok(wine_presentation_first_ns(&previous, &first), "Measured A T0 failed.\n");
+    ok(wine_presentation_span_end(first, 256, 44100, &previous_end),
+       "Measured A end failed.\n");
+    /* Native q256/44.1k resampler records observed a -607709 ns startup
+     * transition.  One frame is only 22676 ns, so this is uncertainty, not
+     * an adjacency proof. */
+    current.now_ns = 1001000000;
+    current_first = previous_end - 607709;
+    ok(!wine_presentation_span_contiguous(&previous, &current, previous_end, current_first),
+       "Measured startup overlap was not classified uncertain.\n");
+    ok(wine_presentation_span_end(current_first, 256, 44100, &current_end),
+       "Measured B end failed.\n");
+    basis.epoch = 1;
+    basis.submit_start = 256;
+    basis.submit_end = 512;
+    basis.native_origin = 0;
+    basis.public_origin = 0;
+    basis.first_ns = current_first;
+    basis.end_ns = current_end;
+    basis.stream_rate = 44100;
+    ok(wine_presentation_project_basis(&basis, current_first, &position),
+       "Measured uncertain basis became a fatal projection error.\n");
+    ok(position == 256, "Measured uncertain basis projected %I64u, expected 256.\n", position);
+}
+
+static void test_wide_arithmetic(void)
+{
+    uint64_t value = 0;
+
+    ok(mul_div_u64(UINT64_MAX, UINT32_MAX, UINT32_MAX, &value) && value == UINT64_MAX,
+       "Exact maximum scale failed.\n");
+    ok(mul_div_u64_ceil(UINT64_MAX, UINT32_MAX, UINT32_MAX, &value) && value == UINT64_MAX,
+       "Exact maximum ceiling failed.\n");
+    ok(mul_div_u64(UINT64_MAX - 1, 2, 3, &value) && value == 12297829382473034409ULL,
+       "Wide floor failed.\n");
+    ok(mul_div_u64_ceil(UINT64_MAX - 1, 2, 3, &value) && value == 12297829382473034410ULL,
+       "Wide ceiling failed.\n");
+    ok(mul_div_u64(13176245766935394011ULL, 7, 5, &value) && value == UINT64_MAX,
+       "Fractional maximum floor failed.\n");
+    ok(!mul_div_u64_ceil(13176245766935394011ULL, 7, 5, &value),
+       "Fractional maximum ceiling overflow was accepted.\n");
+    ok(!mul_div_u64(UINT64_MAX, 2, 1, &value), "Product overflow was accepted.\n");
+    ok(!mul_div_u64(1, 1, 0, &value), "A zero divisor was accepted.\n");
+    ok(audio_presentation_first_ns(1000000000, UINT64_MAX, 1, INT64_MIN,
+                                   UINT32_MAX, UINT32_MAX, 2, &value) && value == 1000000000,
+       "Wide pending and negative delay cancellation failed.\n");
+    ok(audio_presentation_first_ns(1000000000, 1, 0, -1, 1, 3, 3, &value)
+       && value == 1000000000, "Signed fractional cancellation failed.\n");
+    ok(audio_presentation_time_at(UINT64_MAX, UINT64_MAX, UINT64_MAX - 1, 1000000000,
+                                  &value) && value == UINT64_MAX - 1,
+       "Timestamp subtraction at the upper bound failed.\n");
+    ok(!audio_presentation_time_at(UINT64_MAX, 1, 0, 1, &value),
+       "A wide negative timestamp was accepted.\n");
+}
+
+static void test_checked_overflow(void)
+{
+    struct wine_presentation_observation observation = {
+        1, UINT64_MAX, UINT64_MAX, 0, 1, 1, 1
+    };
+    struct wine_presentation_basis basis = {
+        1, 0, 1, 0, UINT64_MAX, 1, 2, 48000
+    };
+    uint64_t value = 0;
+
+    ok(!wine_presentation_first_ns(&observation, &value), "T0 overflow was accepted.\n");
+    ok(!wine_presentation_span_end(UINT64_MAX, 1, 48000, &value),
+       "Span timestamp overflow was accepted.\n");
+    ok(!wine_presentation_project_basis(&basis, 2, &value),
+       "Public position overflow was accepted.\n");
+    basis.native_origin = 1;
+    ok(!wine_presentation_project_basis(&basis, 1, &value),
+       "Invalid native origin was accepted.\n");
+}
+
+START_TEST(presentation)
+{
+    test_first_sample_and_pending();
+    test_retained_resume_origin();
+    test_resume_origin_selection();
+    test_resume_source_mapping();
+    test_undersupply_projection();
+    test_adjacent_sizes();
+    test_measured_startup_overlap();
+    test_wide_arithmetic();
+    test_checked_overflow();
+}

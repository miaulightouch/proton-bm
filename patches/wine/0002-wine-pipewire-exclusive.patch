+/* Called with the loop lock held.  A coalesced native wake is sufficient:
+ * readiness follows the actual ring consumption, not the number of wakes. */
+static BOOL exclusive_render_ready(struct pipewire_stream *stream)
+{
+    return stream->started && stream->pw && !core_dead && !stream->pending_error &&
+           !__atomic_load_n(&stream->recovery.pending, __ATOMIC_ACQUIRE) &&
+           !stream->locked && stream->held_bytes &&
+           __atomic_load_n(&stream->pa_held_bytes, __ATOMIC_ACQUIRE) <=
+           exclusive_render_low_water(stream);
+}

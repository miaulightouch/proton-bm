+    stream->presentation_resume_origin_valid = FALSE;
+    __atomic_store_n(&stream->presentation_resume_uncertain, FALSE, __ATOMIC_RELEASE);
+    __atomic_store_n(&stream->presentation_reanchor_pending, FALSE, __ATOMIC_RELEASE);
+    stream->presentation_last_position = 0;
+    stream->presentation_last_qpc = 0;
+    stream->presentation_snapshot_valid = FALSE;
+    stream->presentation_last_observation_valid = FALSE;
+    stream->presentation_last_span_valid = FALSE;

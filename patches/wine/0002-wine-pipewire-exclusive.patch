+static BOOL set_exclusive_latency_bound(struct pipewire_stream *stream)
+{
+    SIZE_T bound_bytes, bound_frames;
+    UINT64 bound_hns;
+
+    if (!stream->frame_size || !stream->info.rate ||
+        !exclusive_render_bound_size(stream, &bound_bytes) ||
+        bound_bytes / stream->frame_size < stream->bufsize_frames)
+        return FALSE;
+    bound_frames = bound_bytes / stream->frame_size;
+    if ((UINT64)bound_frames >
+        (UINT64_MAX - (stream->info.rate - 1)) / 10000000)
+        return FALSE;
+    bound_hns = ((UINT64)bound_frames * 10000000 + stream->info.rate - 1) /
+                stream->info.rate;
+    if (bound_hns > INT64_MAX)
+        return FALSE;
+    stream->latency_bound_bytes = bound_bytes;
+    stream->latency_bound = (REFERENCE_TIME)bound_hns;
+    return TRUE;
+}

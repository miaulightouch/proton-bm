+static BOOL presentation_clock_now(UINT64 *mono_ns, UINT64 *qpc_100ns)
+{
+    struct timespec mono_before, mono_after;
+    LARGE_INTEGER qpc;
+    UINT64 mono_mid, after_ns;
+    UINT64 qpc_value;
+
+    if (!mono_ns || !qpc_100ns || clock_gettime(CLOCK_MONOTONIC, &mono_before) ||
+        NtQueryPerformanceCounter(&qpc, NULL) ||
+        clock_gettime(CLOCK_MONOTONIC, &mono_after))
+        return FALSE;
+    mono_mid = (UINT64)mono_before.tv_sec * 1000000000 + mono_before.tv_nsec;
+    after_ns = (UINT64)mono_after.tv_sec * 1000000000 + mono_after.tv_nsec;
+    if (after_ns < mono_mid)
+        return FALSE;
+    mono_mid += (after_ns - mono_mid) / 2;
+    if (qpc.QuadPart < 0)
+        return FALSE;
+    qpc_value = (UINT64)qpc.QuadPart;
+    *mono_ns = mono_mid;
+    *qpc_100ns = qpc_value;
+    return TRUE;
+}

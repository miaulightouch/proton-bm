+/* One writer (the process callback), bounded reader (the getter).  The basis
+ * contains every value needed for one projection; the getter never combines
+ * a live PipeWire read with a different counter or timestamp. */
+static void presentation_publish_basis(struct pipewire_stream *stream,
+                                       const struct wine_presentation_basis *basis)
+{
+    __atomic_fetch_add(&stream->presentation_latest_seq, 1, __ATOMIC_ACQ_REL);
+    __atomic_store_n(&stream->presentation_latest.epoch, basis->epoch, __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->presentation_latest.submit_start, basis->submit_start,
+                     __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->presentation_latest.submit_end, basis->submit_end,
+                     __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->presentation_latest.native_origin, basis->native_origin,
+                     __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->presentation_latest.public_origin, basis->public_origin,
+                     __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->presentation_latest.first_ns, basis->first_ns,
+                     __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->presentation_latest.end_ns, basis->end_ns,
+                     __ATOMIC_RELAXED);
+    __atomic_store_n(&stream->presentation_latest.stream_rate, basis->stream_rate,
+                     __ATOMIC_RELAXED);
+    __atomic_fetch_add(&stream->presentation_latest_seq, 1, __ATOMIC_RELEASE);
+}

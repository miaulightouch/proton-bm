+/* Round a byte count up without allowing SIZE_T to wrap. */
+static BOOL size_round_up(SIZE_T value, SIZE_T multiple, SIZE_T *out)
+{
+    SIZE_T rem;
+
+    if (!multiple)
+        return FALSE;
+    rem = value % multiple;
+    if (rem && value > SIZE_MAX - (multiple - rem))
+        return FALSE;
+    *out = value + (rem ? multiple - rem : 0);
+    return TRUE;
+}
+
+static SIZE_T exclusive_render_min_target(const struct pipewire_stream *stream)
+{
+    return stream->period_bytes > SIZE_MAX / 2 ? SIZE_MAX : stream->period_bytes * 2;
+}
+
+/* The application-facing ring may be larger than the logical WASAPI buffer.
+ * Keep its transport target separate so a large PipeWire buffer capacity does
+ * not become latency until the process callback demonstrates the demand. */
+static SIZE_T exclusive_render_low_water(const struct pipewire_stream *stream)
+{
+    SIZE_T min_target = exclusive_render_min_target(stream);
+    SIZE_T target = __atomic_load_n(&stream->pa_target_bytes, __ATOMIC_ACQUIRE);
+
+    if (target < min_target)
+        target = min_target;
+    if (target > stream->real_bufsize_bytes)
+        target = stream->real_bufsize_bytes;
+    return target > stream->period_bytes ? target - stream->period_bytes : 0;
+}
+
+static void update_render_target(struct pipewire_stream *stream, UINT32 frames)
+{
+    SIZE_T rounded, target, min_target = exclusive_render_min_target(stream);
+    UINT64 demand64 = (UINT64)frames * stream->frame_size;
+
+    if (demand64 > SIZE_MAX || !size_round_up((SIZE_T)demand64, stream->period_bytes, &rounded)
+        || rounded > SIZE_MAX - stream->period_bytes)
+        target = stream->real_bufsize_bytes;
+    else
+        target = rounded + stream->period_bytes;
+    if (target < min_target)
+        target = min_target;
+    if (target > stream->real_bufsize_bytes)
+        target = stream->real_bufsize_bytes;
+    __atomic_store_n(&stream->pa_target_bytes, target, __ATOMIC_RELEASE);
+}
+
+static BOOL exclusive_render_capacity_size(const struct pipewire_stream *stream, SIZE_T *size)
+{
+    SIZE_T rounded, reserve;
+
+    if (stream->period_bytes > SIZE_MAX / 2)
+        return FALSE;
+    reserve = stream->period_bytes * 2;
+    if (stream->max_pw_buffer_bytes)
+    {
+        if (!size_round_up(stream->max_pw_buffer_bytes, stream->period_bytes, &rounded) ||
+            rounded > SIZE_MAX - stream->period_bytes)
+            return FALSE;
+        rounded += stream->period_bytes;
+        if (rounded > reserve)
+            reserve = rounded;
+    }
+    *size = reserve;
+    return TRUE;
+}
+
+static BOOL exclusive_render_demand_size_for_frames(const struct pipewire_stream *stream,
+                                                    UINT32 frames, BOOL refill, SIZE_T *size)
+{
+    UINT64 demand64;
+    SIZE_T rounded;
+
+    if (!frames)
+    {
+        *size = 0;
+        return TRUE;
+    }
+    demand64 = (UINT64)frames * stream->frame_size;
+    if (demand64 > SIZE_MAX || !size_round_up((SIZE_T)demand64, stream->period_bytes, &rounded) ||
+        (refill && rounded > SIZE_MAX - stream->period_bytes))
+        return FALSE;
+    *size = rounded + (refill ? stream->period_bytes : 0);
+    return TRUE;
+}
+
+static BOOL exclusive_render_demand_size(const struct pipewire_stream *stream, SIZE_T *size)
+{
+    UINT32 frames = __atomic_load_n(&stream->max_request_frames, __ATOMIC_ACQUIRE);
+    UINT32 refill = __atomic_load_n(&stream->max_refill_frames, __ATOMIC_ACQUIRE);
+    SIZE_T initial_size, refill_size;
+
+    if (!exclusive_render_demand_size_for_frames(stream, frames, FALSE, &initial_size) ||
+        !exclusive_render_demand_size_for_frames(stream, refill, TRUE, &refill_size))
+        return FALSE;
+    *size = max(initial_size, refill_size);
+    return TRUE;
+}

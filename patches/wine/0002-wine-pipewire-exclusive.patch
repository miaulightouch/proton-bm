diff --git a/dlls/mmdevapi/tests/exclusive.c b/dlls/mmdevapi/tests/exclusive.c
new file mode 100644
index 000000000000..e1d53fc6b11b
--- /dev/null
+++ b/dlls/mmdevapi/tests/exclusive.c
@@ -0,0 +1,192 @@
+/*
+ * Event-driven exclusive render streams.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+#include <io.h>
+#include <math.h>
+#include "windows.h"
+#include "wine/test.h"
+#ifdef STANDALONE
+#include "initguid.h"
+#endif
+#include "mmdeviceapi.h"
+#include "audioclient.h"
+
+static void test_exclusive_event(IMMDevice *device, UINT rate, WORD tag)
+{
+    WAVEFORMATEX format = {tag, 2, rate};
+    IAudioRenderClient *render = NULL;
+    IAudioClock *clock = NULL;
+    IAudioClient *client;
+    REFERENCE_TIME period;
+    UINT32 frames, padding, i, j;
+    UINT64 frequency, position, qpctime;
+    LARGE_INTEGER qpc_before, qpc_after, qpc_frequency = {0};
+    HANDLE event = NULL;
+    BYTE *data;
+    HRESULT hr;
+    double phase = 0.0;
+
+    format.wBitsPerSample = tag == WAVE_FORMAT_PCM ? 16 : 32;
+    format.nBlockAlign = format.nChannels * format.wBitsPerSample / 8;
+    format.nAvgBytesPerSec = rate * format.nBlockAlign;
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client);
+    ok(hr == S_OK, "Activate failed: %#lx.\n", hr);
+    if (FAILED(hr)) return;
+
+    hr = IAudioClient_IsFormatSupported(client, AUDCLNT_SHAREMODE_EXCLUSIVE, &format, NULL);
+    ok(hr == S_OK || hr == AUDCLNT_E_UNSUPPORTED_FORMAT || hr == AUDCLNT_E_EXCLUSIVE_MODE_NOT_ALLOWED,
+       "IsFormatSupported failed: %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        skip("Exclusive %u Hz, tag %u is unavailable: %#lx.\n", rate, tag, hr);
+        goto done;
+    }
+    hr = IAudioClient_GetDevicePeriod(client, NULL, &period);
+    ok(hr == S_OK, "GetDevicePeriod failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_EXCLUSIVE, AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                                period + 1, period, &format, NULL);
+    ok(hr == AUDCLNT_E_BUFDURATION_PERIOD_NOT_EQUAL, "Unequal periods returned %#lx.\n", hr);
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_EXCLUSIVE, AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                                period, period, &format, NULL);
+    ok(hr == S_OK || hr == AUDCLNT_E_DEVICE_IN_USE, "Initialize failed: %#lx.\n", hr);
+    if (hr != S_OK) goto done;
+
+    hr = IAudioClient_GetBufferSize(client, &frames);
+    ok(hr == S_OK && frames > 1, "Invalid buffer: %#lx, %u frames.\n", hr, frames);
+    if (FAILED(hr) || frames < 2) goto done;
+    trace("Exclusive event stream: %u Hz, tag %u, %u frames, period %I64d.\n",
+          rate, tag, frames, period);
+    hr = IAudioClient_GetService(client, &IID_IAudioRenderClient, (void **)&render);
+    ok(hr == S_OK, "GetService(render) failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetService(client, &IID_IAudioClock, (void **)&clock);
+    ok(hr == S_OK, "GetService(clock) failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClock_GetFrequency(clock, &frequency);
+    ok(hr == S_OK && frequency == rate, "Frequency %#lx, %I64u, expected %u.\n",
+       hr, frequency, rate);
+
+    hr = IAudioRenderClient_GetBuffer(render, frames - 1, &data);
+    ok(hr == AUDCLNT_E_BUFFER_SIZE_ERROR, "Partial GetBuffer returned %#lx.\n", hr);
+    hr = IAudioRenderClient_GetBuffer(render, frames, &data);
+    ok(hr == S_OK, "GetBuffer failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioRenderClient_ReleaseBuffer(render, frames - 1, AUDCLNT_BUFFERFLAGS_SILENT);
+    ok(hr == AUDCLNT_E_BUFFER_SIZE_ERROR, "Partial ReleaseBuffer returned %#lx.\n", hr);
+    hr = IAudioRenderClient_ReleaseBuffer(render, 0, 0);
+    ok(hr == AUDCLNT_E_BUFFER_SIZE_ERROR, "Empty ReleaseBuffer returned %#lx.\n", hr);
+    hr = IAudioRenderClient_ReleaseBuffer(render, frames, AUDCLNT_BUFFERFLAGS_SILENT);
+    ok(hr == S_OK, "ReleaseBuffer failed: %#lx.\n", hr);
+    hr = IAudioClient_Start(client);
+    ok(hr == AUDCLNT_E_EVENTHANDLE_NOT_SET, "Start without an event returned %#lx.\n", hr);
+
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!event, "CreateEvent failed.\n");
+    if (!event) goto done;
+    hr = IAudioClient_SetEventHandle(client, event);
+    ok(hr == S_OK, "SetEventHandle failed: %#lx.\n", hr);
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Start failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    for (i = 0; i < 64; ++i)
+    {
+        DWORD wait = WaitForSingleObject(event, 1000);
+        ok(wait == WAIT_OBJECT_0, "Event %u timed out: %lu.\n", i, wait);
+        if (wait != WAIT_OBJECT_0) break;
+        if (i == 8)
+        {
+            Sleep(20);
+            ok(WaitForSingleObject(event, 0) == WAIT_TIMEOUT, "Buffer readiness was signalled twice.\n");
+        }
+        hr = IAudioClient_GetCurrentPadding(client, &padding);
+        ok(hr == S_OK && padding == 0, "Padding at event %u: %#lx, %u.\n", i, hr, padding);
+        hr = IAudioRenderClient_GetBuffer(render, frames, &data);
+        ok(hr == S_OK, "Full-buffer GetBuffer at event %u: %#lx.\n", i, hr);
+        if (FAILED(hr)) break;
+        if (winetest_interactive)
+            for (j = 0; j < frames * format.nChannels; ++j)
+            {
+                double sample = sin(phase) * 0.1;
+                if (tag == WAVE_FORMAT_PCM) ((short *)data)[j] = sample * 32767;
+                else ((float *)data)[j] = sample;
+                if (j % format.nChannels == format.nChannels - 1) phase += 2.0 * 3.141592653589793 * 440.0 / rate;
+            }
+        hr = IAudioRenderClient_ReleaseBuffer(render, frames, winetest_interactive ? 0 : AUDCLNT_BUFFERFLAGS_SILENT);
+        ok(hr == S_OK, "Full-buffer ReleaseBuffer at event %u: %#lx.\n", i, hr);
+    }
+    ok(QueryPerformanceFrequency(&qpc_frequency), "QueryPerformanceFrequency failed.\n");
+    QueryPerformanceCounter(&qpc_before);
+    hr = IAudioClock_GetPosition(clock, &position, &qpctime);
+    QueryPerformanceCounter(&qpc_after);
+    if (hr == S_OK && qpc_frequency.QuadPart > 0)
+        ok(qpctime / 10000000.0 >= qpc_before.QuadPart / (double)qpc_frequency.QuadPart - 0.1
+                && qpctime / 10000000.0 <= qpc_after.QuadPart / (double)qpc_frequency.QuadPart + 0.1,
+                "Clock QPC %I64u is outside the current performance-counter interval.\n", qpctime);
+    ok(hr == S_OK && position >= (UINT64)frames * (i > 1 ? i - 1 : 0) &&
+       position <= (UINT64)frames * (i + 1),
+       "Clock did not advance with buffers: %#lx, %I64u, %u events.\n", hr, position, i);
+    hr = IAudioClient_Stop(client);
+    ok(hr == S_OK, "Stop failed: %#lx.\n", hr);
+    ResetEvent(event);
+    ok(WaitForSingleObject(event, 50) == WAIT_TIMEOUT, "Stopped stream signalled its event.\n");
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Reset failed: %#lx.\n", hr);
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && !padding, "Padding after reset: %#lx, %u.\n", hr, padding);
+    ResetEvent(event);
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Empty-buffer Start failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(WaitForSingleObject(event, 1000) == WAIT_OBJECT_0, "Empty stream did not signal readiness.\n");
+        hr = IAudioRenderClient_GetBuffer(render, frames, &data);
+        ok(hr == S_OK, "Empty-stream GetBuffer failed: %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IAudioRenderClient_ReleaseBuffer(render, frames, AUDCLNT_BUFFERFLAGS_SILENT);
+            ok(hr == S_OK, "Empty-stream ReleaseBuffer failed: %#lx.\n", hr);
+        }
+    }
+done:
+    IAudioClient_Stop(client);
+    if (clock) IAudioClock_Release(clock);
+    if (render) IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    if (event) CloseHandle(event);
+}
+
+START_TEST(exclusive)
+{
+    IMMDeviceEnumerator *enumerator;
+    IMMDevice *device;
+    HRESULT hr;
+
+    CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER,
+                         &IID_IMMDeviceEnumerator, (void **)&enumerator);
+    ok(hr == S_OK, "Enumerator creation failed: %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(enumerator, eRender, eMultimedia, &device);
+        if (SUCCEEDED(hr))
+        {
+            test_exclusive_event(device, 44100, WAVE_FORMAT_PCM);
+            test_exclusive_event(device, 48000, WAVE_FORMAT_PCM);
+            test_exclusive_event(device, 44100, WAVE_FORMAT_IEEE_FLOAT);
+            test_exclusive_event(device, 48000, WAVE_FORMAT_IEEE_FLOAT);
+            IMMDevice_Release(device);
+        }
+        else skip("No render endpoint: %#lx.\n", hr);
+        IMMDeviceEnumerator_Release(enumerator);
+    }
+    CoUninitialize();
+}
diff --git a/dlls/mmdevapi/tests/exclusive_shared.c b/dlls/mmdevapi/tests/exclusive_shared.c
new file mode 100644
index 000000000000..c07b11e1cb56
--- /dev/null
+++ b/dlls/mmdevapi/tests/exclusive_shared.c
@@ -0,0 +1,504 @@
+/*
+ * Shared event-driven render streams.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+#include <io.h>
+#include "windows.h"
+#include "wine/test.h"
+#ifdef STANDALONE
+#include "initguid.h"
+#endif
+#include "mmdeviceapi.h"
+#include "audioclient.h"
+#include "ksmedia.h"
+#include "devpkey.h"
+
+static BOOL is_unavailable(HRESULT hr)
+{
+    return hr == AUDCLNT_E_UNSUPPORTED_FORMAT || hr == AUDCLNT_E_DEVICE_IN_USE;
+}
+
+static DWORD channel_mask(UINT channels)
+{
+    switch (channels)
+    {
+    case 2: return KSAUDIO_SPEAKER_STEREO;
+    case 4: return KSAUDIO_SPEAKER_SURROUND;
+    case 6: return KSAUDIO_SPEAKER_5POINT1;
+    case 8: return KSAUDIO_SPEAKER_7POINT1_SURROUND;
+    default: return 0;
+    }
+}
+
+static void make_format(WAVEFORMATEXTENSIBLE *format, UINT rate, UINT channels, BOOL ieee_float)
+{
+    WORD bits = ieee_float ? 32 : 16;
+
+    ZeroMemory(format, sizeof(*format));
+    format->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    format->Format.nChannels = channels;
+    format->Format.nSamplesPerSec = rate;
+    format->Format.wBitsPerSample = bits;
+    format->Format.nBlockAlign = channels * bits / 8;
+    format->Format.nAvgBytesPerSec = rate * format->Format.nBlockAlign;
+    format->Format.cbSize = sizeof(*format) - sizeof(format->Format);
+    format->Samples.wValidBitsPerSample = bits;
+    format->dwChannelMask = channel_mask(channels);
+    format->SubFormat = ieee_float ? KSDATAFORMAT_SUBTYPE_IEEE_FLOAT : KSDATAFORMAT_SUBTYPE_PCM;
+}
+
+static BOOL wait_event(HANDLE event, UINT number, DWORD timeout)
+{
+    DWORD wait = WaitForSingleObject(event, timeout);
+
+    ok(wait == WAIT_OBJECT_0, "Event %u timed out: %lu.\n", number, wait);
+    return wait == WAIT_OBJECT_0;
+}
+
+static BOOL test_shared_event_format(IMMDevice *device, UINT rate, UINT channels, BOOL ieee_float)
+{
+    WAVEFORMATEXTENSIBLE format;
+    WAVEFORMATEX *closest = NULL;
+    IAudioRenderClient *render = NULL;
+    IAudioClient *client = NULL;
+    REFERENCE_TIME default_period, minimum_period, period;
+    UINT32 frames, padding, available, request;
+    BYTE *data;
+    HANDLE event = NULL;
+    HRESULT hr;
+    UINT i;
+    BOOL started = FALSE;
+    const char *kind = ieee_float ? "float" : "pcm";
+
+    make_format(&format, rate, channels, ieee_float);
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client);
+    ok(hr == S_OK, "Activate %s %u-channel client failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) return FALSE;
+
+    hr = IAudioClient_IsFormatSupported(client, AUDCLNT_SHAREMODE_SHARED,
+            &format.Format, &closest);
+    if (hr == S_FALSE)
+    {
+        ok(!!closest, "S_FALSE without a closest format.\n");
+        skip("Shared %s %u-channel format is not the endpoint mix format.\n", kind, channels);
+        CoTaskMemFree(closest);
+        IAudioClient_Release(client);
+        return TRUE;
+    }
+    if (is_unavailable(hr))
+    {
+        skip("Shared %s %u-channel format is unavailable: %#lx.\n", kind, channels, hr);
+        CoTaskMemFree(closest);
+        IAudioClient_Release(client);
+        return TRUE;
+    }
+    ok(hr == S_OK && !closest, "IsFormatSupported(%s,%u) returned %#lx, suggestion %p.\n",
+       kind, channels, hr, closest);
+    CoTaskMemFree(closest);
+    if (FAILED(hr)) goto fail;
+
+    hr = IAudioClient_GetDevicePeriod(client, &default_period, &minimum_period);
+    ok(hr == S_OK, "GetDevicePeriod(%s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+    period = default_period > minimum_period ? default_period : minimum_period;
+    if (!period)
+    {
+        skip("Shared %s %u-channel endpoint returned a zero period.\n", kind, channels);
+        goto skip_cleanup;
+    }
+
+    /* Shared streams require zero periodicity; their duration need not match it. */
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_SHARED,
+            AUDCLNT_STREAMFLAGS_EVENTCALLBACK, period + 1, 0, &format.Format, NULL);
+    if (is_unavailable(hr))
+    {
+        skip("Shared %s %u-channel Initialize is unavailable: %#lx.\n", kind, channels, hr);
+        goto skip_cleanup;
+    }
+    ok(hr == S_OK, "Initialize(shared event %s,%u; unequal timing) failed: %#lx.\n",
+       kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+
+    hr = IAudioClient_GetBufferSize(client, &frames);
+    ok(hr == S_OK && frames > 1, "GetBufferSize(%s,%u) returned %#lx, %u frames.\n",
+       kind, channels, hr, frames);
+    if (FAILED(hr) || frames <= 1) goto fail;
+
+    hr = IAudioClient_GetService(client, &IID_IAudioRenderClient, (void **)&render);
+    ok(hr == S_OK, "GetService(render %s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!event, "CreateEvent(%s,%u) failed.\n", kind, channels);
+    if (!event) goto fail;
+    hr = IAudioClient_SetEventHandle(client, event);
+    ok(hr == S_OK, "SetEventHandle(%s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Start(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (FAILED(hr)) goto fail;
+    started = TRUE;
+
+    for (i = 0; i < 2; ++i)
+        if (!wait_event(event, i, 1000)) goto fail;
+
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && padding <= frames, "Padding(shared event %s,%u) returned %#lx, %u/%u.\n",
+       kind, channels, hr, padding, frames);
+    if (FAILED(hr) || padding > frames) goto fail;
+
+    /* Exercise the shared render contract after an event without imposing the
+     * exclusive whole-buffer rule. */
+    available = frames - padding;
+    request = available > 64 ? 64 : available;
+    if (request)
+    {
+        hr = IAudioRenderClient_GetBuffer(render, request, &data);
+        ok(hr == S_OK && data != NULL, "GetBuffer(shared event %s,%u,%u) returned %#lx, %p.\n",
+           kind, channels, request, hr, data);
+        if (SUCCEEDED(hr))
+        {
+            hr = IAudioRenderClient_ReleaseBuffer(render, request, AUDCLNT_BUFFERFLAGS_SILENT);
+            ok(hr == S_OK, "ReleaseBuffer(shared event %s,%u,%u) failed: %#lx.\n",
+               kind, channels, request, hr);
+        }
+    }
+    else
+        trace("Shared event %s,%u had a full buffer after its callback; no write was attempted.\n",
+              kind, channels);
+
+    hr = IAudioClient_Reset(client);
+    ok(hr == AUDCLNT_E_NOT_STOPPED, "Reset while running (%s,%u) returned %#lx.\n",
+       kind, channels, hr);
+    hr = IAudioClient_Stop(client);
+    ok(hr == S_OK, "Stop(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    started = FALSE;
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Reset(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && !padding, "Padding after reset (%s,%u) returned %#lx, %u.\n",
+       kind, channels, hr, padding);
+
+    /* A reset stream must be restartable and deliver a fresh callback. */
+    ok(ResetEvent(event), "ResetEvent before restart (%s,%u) failed.\n", kind, channels);
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Restart(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    if (SUCCEEDED(hr))
+    {
+        started = TRUE;
+        wait_event(event, 2, 1000);
+        hr = IAudioClient_Stop(client);
+        ok(hr == S_OK, "Second Stop(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+        started = FALSE;
+    }
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Final Reset(shared event %s,%u) failed: %#lx.\n", kind, channels, hr);
+    trace("Shared event %s,%u lifecycle passed.\n", kind, channels);
+    CloseHandle(event);
+    IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    return TRUE;
+
+skip_cleanup:
+    if (event) CloseHandle(event);
+    if (render) IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    return TRUE;
+
+fail:
+    if (started) IAudioClient_Stop(client);
+    if (event) CloseHandle(event);
+    if (render) IAudioRenderClient_Release(render);
+    IAudioClient_Release(client);
+    return FALSE;
+}
+
+static int lifecycle_env_mode(char *endpoint, DWORD endpoint_size,
+                              char *marker, DWORD marker_size)
+{
+    DWORD endpoint_len, marker_len;
+
+    endpoint_len = GetEnvironmentVariableA("PROTON_BM_ENDPOINT_NAME", endpoint, endpoint_size);
+    marker_len = GetEnvironmentVariableA("PROTON_BM_REMOVED_MARKER", marker, marker_size);
+    if (!endpoint_len && !marker_len)
+        return 0;
+    ok(endpoint_len && marker_len && endpoint_len < endpoint_size && marker_len < marker_size,
+       "Lifecycle requires complete PROTON_BM_ENDPOINT_NAME and PROTON_BM_REMOVED_MARKER.\n");
+    return endpoint_len && marker_len && endpoint_len < endpoint_size && marker_len < marker_size ? 1 : -1;
+}
+
+static HRESULT find_lifecycle_endpoint(IMMDeviceEnumerator *enumerator,
+                                       const char *endpoint_name, IMMDevice **out)
+{
+    IMMDeviceCollection *collection = NULL;
+    IPropertyStore *store = NULL;
+    IMMDevice *device = NULL;
+    PROPVARIANT value;
+    WCHAR target[256];
+    UINT count, i, matches = 0;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!MultiByteToWideChar(CP_UTF8, 0, endpoint_name, -1, target, ARRAY_SIZE(target)))
+        return E_INVALIDARG;
+    hr = IMMDeviceEnumerator_EnumAudioEndpoints(enumerator, eRender, DEVICE_STATE_ACTIVE,
+                                                 &collection);
+    if (FAILED(hr)) return hr;
+    hr = IMMDeviceCollection_GetCount(collection, &count);
+    if (FAILED(hr)) goto done;
+    for (i = 0; i < count; ++i)
+    {
+        PropVariantInit(&value);
+        if (FAILED(IMMDeviceCollection_Item(collection, i, &device)))
+            continue;
+        if (SUCCEEDED(IMMDevice_OpenPropertyStore(device, STGM_READ, &store)) &&
+            SUCCEEDED(IPropertyStore_GetValue(store,
+                (const PROPERTYKEY *)&DEVPKEY_Device_FriendlyName, &value)) &&
+            value.vt == VT_LPWSTR && value.pwszVal && !lstrcmpW(value.pwszVal, target))
+        {
+            ++matches;
+            if (matches == 1)
+            {
+                *out = device;
+                device = NULL;
+            }
+        }
+        PropVariantClear(&value);
+        if (store) IPropertyStore_Release(store);
+        store = NULL;
+        if (device) IMMDevice_Release(device);
+        device = NULL;
+    }
+    ok(matches == 1, "Lifecycle endpoint %s matched %u active render endpoints.\n",
+       endpoint_name, matches);
+    if (matches != 1 && *out)
+    {
+        IMMDevice_Release(*out);
+        *out = NULL;
+    }
+    hr = matches == 1 ? S_OK : E_FAIL;
+
+done:
+    if (device) IMMDevice_Release(device);
+    if (store) IPropertyStore_Release(store);
+    IMMDeviceCollection_Release(collection);
+    return hr;
+}
+
+static BOOL wait_lifecycle_marker(const char *marker)
+{
+    UINT i;
+
+    for (i = 0; i < 3000; ++i)
+    {
+        if (GetFileAttributesA(marker) != INVALID_FILE_ATTRIBUTES)
+            return TRUE;
+        Sleep(10);
+    }
+    return FALSE;
+}
+
+static BOOL wait_lifecycle_invalidation(IAudioClient *client, HRESULT *padding_hr)
+{
+    UINT32 padding;
+    UINT i;
+
+    for (i = 0; i < 300; ++i)
+    {
+        *padding_hr = IAudioClient_GetCurrentPadding(client, &padding);
+        if (*padding_hr == AUDCLNT_E_DEVICE_INVALIDATED)
+            return TRUE;
+        Sleep(10);
+    }
+    return FALSE;
+}
+
+/* Host-coordinated endpoint check.  It is called only when both opt-in
+ * variables are complete, so the normal default-endpoint matrix is skipped
+ * and no physical default output is opened. */
+static void test_lifecycle_removal(IMMDeviceEnumerator *enumerator,
+                                   const char *endpoint_name, const char *marker)
+{
+    IMMDevice *device = NULL;
+    IAudioClient *client = NULL;
+    IAudioRenderClient *render = NULL;
+    WAVEFORMATEX *format = NULL;
+    REFERENCE_TIME default_period, minimum_period, period;
+    UINT32 frames, padding;
+    HANDLE event = NULL;
+    HRESULT hr, padding_hr, buffer_hr;
+    BOOL started = FALSE;
+    BOOL held_buffer = FALSE;
+    BYTE *held_data = NULL;
+
+    trace("Running opt-in PipeWire lifecycle check for %s.\n", endpoint_name);
+    hr = find_lifecycle_endpoint(enumerator, endpoint_name, &device);
+    ok(hr == S_OK, "Lifecycle endpoint lookup failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL,
+                            (void **)&client);
+    ok(hr == S_OK, "Lifecycle activation failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetMixFormat(client, &format);
+    ok(hr == S_OK && format, "Lifecycle GetMixFormat failed: %#lx.\n", hr);
+    if (FAILED(hr) || !format) goto done;
+    hr = IAudioClient_GetDevicePeriod(client, &default_period, &minimum_period);
+    ok(hr == S_OK, "Lifecycle GetDevicePeriod failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    period = default_period > minimum_period ? default_period : minimum_period;
+    if (!period)
+    {
+        ok(FALSE, "Lifecycle endpoint returned a zero period.\n");
+        goto done;
+    }
+    hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_SHARED,
+                                 AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                                 period + 1, 0, format, NULL);
+    ok(hr == S_OK, "Lifecycle Initialize failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetBufferSize(client, &frames);
+    ok(hr == S_OK && frames > 1, "Lifecycle GetBufferSize failed: %#lx, %u.\n", hr, frames);
+    if (FAILED(hr) || frames <= 1) goto done;
+    hr = IAudioClient_GetService(client, &IID_IAudioRenderClient, (void **)&render);
+    ok(hr == S_OK, "Lifecycle GetService failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!event, "Lifecycle CreateEvent failed.\n");
+    if (!event) goto done;
+    hr = IAudioClient_SetEventHandle(client, event);
+    ok(hr == S_OK, "Lifecycle SetEventHandle failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Lifecycle Start failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    started = TRUE;
+    if (!wait_event(event, 0, 1000)) goto done;
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK, "Lifecycle post-Start padding failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    hr = IAudioClient_Stop(client);
+    ok(hr == S_OK, "Lifecycle Stop failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    started = FALSE;
+    hr = IAudioClient_Reset(client);
+    ok(hr == S_OK, "Lifecycle Reset failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK && !padding, "Lifecycle reset padding failed: %#lx, %u.\n", hr, padding);
+    if (FAILED(hr) || padding) goto done;
+    ok(ResetEvent(event), "Lifecycle ResetEvent failed.\n");
+    hr = IAudioClient_Start(client);
+    ok(hr == S_OK, "Lifecycle restart failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    started = TRUE;
+    if (!wait_event(event, 1, 1000)) goto done;
+    hr = IAudioClient_GetCurrentPadding(client, &padding);
+    ok(hr == S_OK, "Lifecycle post-restart padding failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    hr = IAudioRenderClient_GetBuffer(render, 1, &held_data);
+    ok(hr == S_OK && held_data, "Lifecycle held GetBuffer returned %#lx, %p.\n",
+       hr, held_data);
+    if (FAILED(hr)) goto done;
+    held_buffer = TRUE;
+
+    printf("TEST_LIFECYCLE_READY\n");
+    fflush(stdout);
+    if (!wait_lifecycle_marker(marker))
+    {
+        ok(FALSE, "Lifecycle host did not remove the endpoint.\n");
+        goto done;
+    }
+    ok(wait_lifecycle_invalidation(client, &padding_hr),
+       "Lifecycle invalidation did not settle within the bounded poll.\n");
+    ok(padding_hr == AUDCLNT_E_DEVICE_INVALIDATED,
+       "Lifecycle removal padding returned %#lx, expected %#lx.\n",
+       padding_hr, AUDCLNT_E_DEVICE_INVALIDATED);
+
+    if (held_buffer)
+    {
+        hr = IAudioRenderClient_ReleaseBuffer(render, 1, 0);
+        ok(hr == AUDCLNT_E_DEVICE_INVALIDATED,
+           "Lifecycle held ReleaseBuffer returned %#lx, expected %#lx.\n",
+           hr, AUDCLNT_E_DEVICE_INVALIDATED);
+        held_buffer = FALSE;
+    }
+
+    held_data = NULL;
+    buffer_hr = IAudioRenderClient_GetBuffer(render, 1, &held_data);
+    ok(buffer_hr == AUDCLNT_E_DEVICE_INVALIDATED,
+       "Lifecycle removal GetBuffer returned %#lx, expected %#lx.\n",
+       buffer_hr, AUDCLNT_E_DEVICE_INVALIDATED);
+
+done:
+    if (held_buffer) IAudioRenderClient_ReleaseBuffer(render, 1, 0);
+    if (started) IAudioClient_Stop(client);
+    if (event) CloseHandle(event);
+    if (render) IAudioRenderClient_Release(render);
+    if (client) IAudioClient_Release(client);
+    CoTaskMemFree(format);
+    if (device) IMMDevice_Release(device);
+}
+
+START_TEST(exclusive_shared)
+{
+    IMMDeviceEnumerator *enumerator = NULL;
+    IMMDevice *device = NULL;
+    IAudioClient *client = NULL;
+    WAVEFORMATEX *mix = NULL;
+    char lifecycle_endpoint[256], lifecycle_marker[MAX_PATH];
+    int lifecycle_mode;
+    HRESULT hr;
+    UINT channels, formats;
+    static const UINT channel_counts[] = {2, 4, 6, 8};
+
+    CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMMDeviceEnumerator, (void **)&enumerator);
+    ok(hr == S_OK, "Enumerator creation failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    lifecycle_mode = lifecycle_env_mode(lifecycle_endpoint, sizeof(lifecycle_endpoint),
+                                         lifecycle_marker, sizeof(lifecycle_marker));
+    if (lifecycle_mode)
+    {
+        if (lifecycle_mode > 0)
+            test_lifecycle_removal(enumerator, lifecycle_endpoint, lifecycle_marker);
+        goto done;
+    }
+
+    hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(enumerator, eRender, eMultimedia, &device);
+    if (FAILED(hr))
+    {
+        skip("No render endpoint for shared event tests: %#lx.\n", hr);
+        goto done;
+    }
+
+    hr = IMMDevice_Activate(device, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client);
+    ok(hr == S_OK, "Mix-format activation failed: %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IAudioClient_GetMixFormat(client, &mix);
+    ok(hr == S_OK && mix && mix->nSamplesPerSec, "GetMixFormat failed: %#lx.\n", hr);
+    if (FAILED(hr) || !mix || !mix->nSamplesPerSec) goto done;
+
+    trace("Shared EVENTCALLBACK matrix at %lu Hz; unsupported layouts are skips.\n",
+          (ULONG)mix->nSamplesPerSec);
+    for (channels = 0; channels < ARRAY_SIZE(channel_counts); ++channels)
+        for (formats = 0; formats < 2; ++formats)
+            test_shared_event_format(device, mix->nSamplesPerSec, channel_counts[channels], formats);
+
+done:
+    CoTaskMemFree(mix);
+    if (client) IAudioClient_Release(client);
+    if (device) IMMDevice_Release(device);
+    if (enumerator) IMMDeviceEnumerator_Release(enumerator);
+    CoUninitialize();
+}

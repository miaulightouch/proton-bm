+static int add_u64(uint64_t a, uint64_t b, uint64_t *out)
+{
+    if (a > UINT64_MAX - b)
+        return 0;
+    *out = a + b;
+    return 1;
+}
+
+static int mul_div_u64(uint64_t a, uint32_t b, uint32_t denominator, uint64_t *out)
+{
+    uint64_t quotient, remainder;
+
+    if (!denominator)
+        return 0;
+    quotient = a / denominator;
+    if (b && quotient > UINT64_MAX / b)
+        return 0;
+    /* The remainder and multiplier are both 32-bit, so their product fits. */
+    remainder = (a % denominator) * b / denominator;
+    return add_u64(quotient * b, remainder, out);
+}
+
+static int mul_div_u64_ceil(uint64_t a, uint32_t b, uint32_t denominator, uint64_t *out)
+{
+    uint64_t result;
+
+    if (!mul_div_u64(a, b, denominator, &result))
+        return 0;
+    return add_u64(result, ((a % denominator) * b % denominator) != 0, out);
+}

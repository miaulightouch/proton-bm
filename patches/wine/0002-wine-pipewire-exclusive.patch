+static int do_complete_recovery(struct spa_loop *loop, bool async, uint32_t seq,
+                                const void *data, size_t size, void *user_data)
+{
+    struct pipewire_stream *stream = user_data;
+
+    /* Finish on the data loop so a concurrent quantum change cannot be lost. */
+    if (__atomic_load_n(&stream->recovery.generation, __ATOMIC_ACQUIRE) !=
+        stream->recovery.attempt_generation)
+        return -EAGAIN;
+    wine_pipewire_recovery_complete(&stream->recovery);
+    return 0;
+}

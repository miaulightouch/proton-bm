diff --git a/include/wine/audio_presentation.h b/include/wine/audio_presentation.h
new file mode 100644
--- /dev/null
+++ b/include/wine/audio_presentation.h
@@ -0,0 +1,145 @@
+/* Checked audio presentation arithmetic. LGPL-2.1-or-later. */
+#ifndef __WINE_AUDIO_PRESENTATION_H
+#define __WINE_AUDIO_PRESENTATION_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* 32-bit limbs preserve wide intermediates on native i386 as well as x64. */
+struct audio_presentation_wide
+{
+    uint32_t words[4];
+};
+
+static inline struct audio_presentation_wide audio_presentation_wide_from(uint64_t value)
+{
+    struct audio_presentation_wide result = {{(uint32_t)value, (uint32_t)(value >> 32), 0, 0}};
+    return result;
+}
+
+static inline bool audio_presentation_wide_add(struct audio_presentation_wide a,
+                                              struct audio_presentation_wide b,
+                                              struct audio_presentation_wide *result)
+{
+    uint64_t carry = 0;
+    unsigned int i;
+
+    for (i = 0; i < 4; ++i)
+    {
+        carry += (uint64_t)a.words[i] + b.words[i];
+        result->words[i] = carry;
+        carry >>= 32;
+    }
+    return !carry;
+}
+
+static inline bool audio_presentation_wide_sub(struct audio_presentation_wide a,
+                                              struct audio_presentation_wide b,
+                                              struct audio_presentation_wide *result)
+{
+    uint64_t subtrahend;
+    unsigned int i, borrow = 0;
+
+    for (i = 0; i < 4; ++i)
+    {
+        subtrahend = (uint64_t)b.words[i] + borrow;
+        result->words[i] = a.words[i] - subtrahend;
+        borrow = a.words[i] < subtrahend;
+    }
+    return !borrow;
+}
+
+static inline bool audio_presentation_wide_mul(struct audio_presentation_wide *value,
+                                              uint32_t multiplier)
+{
+    uint64_t carry = 0;
+    unsigned int i;
+
+    for (i = 0; i < 4; ++i)
+    {
+        carry += (uint64_t)value->words[i] * multiplier;
+        value->words[i] = carry;
+        carry >>= 32;
+    }
+    return !carry;
+}
+
+/* Callers validate the divisor before entering the limb division. */
+static inline uint32_t audio_presentation_wide_div(struct audio_presentation_wide *value,
+                                                  uint32_t divisor)
+{
+    uint64_t partial, remainder = 0;
+    unsigned int i;
+
+    for (i = 4; i-- > 0;)
+    {
+        partial = (remainder << 32) | value->words[i];
+        value->words[i] = partial / divisor;
+        remainder = partial % divisor;
+    }
+    return remainder;
+}
+
+static inline bool audio_presentation_wide_u64(struct audio_presentation_wide value,
+                                              uint64_t *result)
+{
+    if (value.words[2] || value.words[3]) return false;
+    *result = ((uint64_t)value.words[1] << 32) | value.words[0];
+    return true;
+}
+
+/* queued and buffered are stream frames; delay is in graph ticks. */
+static inline bool audio_presentation_first_ns(int64_t now, uint64_t queued, uint64_t buffered,
+                                               int64_t delay, uint32_t period_num,
+                                               uint32_t period_denom, uint32_t stream_rate,
+                                               uint64_t *first)
+{
+    struct audio_presentation_wide result, pending, graph_delay;
+    uint64_t magnitude = delay, ns;
+
+    if (now <= 0 || !period_num || !period_denom || !stream_rate || !first)
+        return false;
+    result = audio_presentation_wide_from(now);
+    pending = audio_presentation_wide_from(queued);
+    if (!audio_presentation_wide_add(pending, audio_presentation_wide_from(buffered), &pending)
+        || !audio_presentation_wide_mul(&pending, 1000000000)) return false;
+    audio_presentation_wide_div(&pending, stream_rate);
+    if (delay < 0) magnitude = 0 - magnitude;
+    graph_delay = audio_presentation_wide_from(magnitude);
+    if (!audio_presentation_wide_mul(&graph_delay, period_num)
+        || !audio_presentation_wide_mul(&graph_delay, 1000000000)) return false;
+    audio_presentation_wide_div(&graph_delay, period_denom);
+    if (!audio_presentation_wide_add(result, pending, &result)) return false;
+    if (delay < 0)
+    {
+        if (!audio_presentation_wide_sub(result, graph_delay, &result)) return false;
+    }
+    else if (!audio_presentation_wide_add(result, graph_delay, &result)) return false;
+    if (!audio_presentation_wide_u64(result, &ns) || !ns) return false;
+    *first = ns;
+    return true;
+}
+
+static inline bool audio_presentation_time_at(uint64_t reference_frame, uint64_t reference_ns,
+                                              uint64_t target_frame, uint32_t rate, uint64_t *ns)
+{
+    struct audio_presentation_wide result = audio_presentation_wide_from(reference_ns);
+    struct audio_presentation_wide delta;
+    uint64_t value;
+
+    if (!rate || !ns) return false;
+    delta = audio_presentation_wide_from(target_frame >= reference_frame
+        ? target_frame - reference_frame : reference_frame - target_frame);
+    if (!audio_presentation_wide_mul(&delta, 1000000000)) return false;
+    audio_presentation_wide_div(&delta, rate);
+    if (target_frame >= reference_frame)
+    {
+        if (!audio_presentation_wide_add(result, delta, &result)) return false;
+    }
+    else if (!audio_presentation_wide_sub(result, delta, &result)) return false;
+    if (!audio_presentation_wide_u64(result, &value) || !value) return false;
+    *ns = value;
+    return true;
+}
+
+#endif

diff --git a/dlls/winepipewire.drv/recovery.h b/dlls/winepipewire.drv/recovery.h
new file mode 100644
--- /dev/null
+++ b/dlls/winepipewire.drv/recovery.h
@@ -0,0 +1,40 @@
+/* Bounded retries for a stream rebuilt after an external graph change. */
+#ifndef __WINE_PIPEWIRE_RECOVERY_H
+#define __WINE_PIPEWIRE_RECOVERY_H
+
+#include <stdint.h>
+
+struct wine_pipewire_recovery
+{
+    unsigned int pending; /* atomic: callback requests, Wine worker completes */
+    unsigned int ready; /* atomic: the replacement node has processed a valid span */
+    unsigned int generation; /* atomic: external quantum changes */
+    unsigned int attempt_generation;
+    unsigned int failures;
+    int connecting;
+    uint64_t due_ns;
+};
+
+static inline int wine_pipewire_recovery_failed(struct wine_pipewire_recovery *state, uint64_t now)
+{
+    state->connecting = 0;
+    __atomic_store_n(&state->ready, 0, __ATOMIC_RELEASE);
+    if (++state->failures > 3)
+    {
+        __atomic_store_n(&state->pending, 0, __ATOMIC_RELEASE);
+        return 0;
+    }
+    state->due_ns = now + (UINT64_C(100000000) << (state->failures - 1));
+    return 1;
+}
+
+static inline void wine_pipewire_recovery_complete(struct wine_pipewire_recovery *state)
+{
+    state->failures = 0;
+    state->connecting = 0;
+    state->due_ns = 0;
+    __atomic_store_n(&state->ready, 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&state->pending, 0, __ATOMIC_RELEASE);
+}
+
+#endif

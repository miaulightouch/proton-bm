+            if (quantum_frames > UINT64_MAX / stream->info.rate ||
+                quantum_frames * stream->info.rate > UINT64_MAX - (g_clock_rate - 1))
+                return FALSE;
+            quantum_frames = (quantum_frames * stream->info.rate + g_clock_rate - 1) / g_clock_rate;
+        }
+        if (quantum_frames > SIZE_MAX / stream->frame_size)
+            return FALSE;
+        quantum_bytes = (SIZE_T)quantum_frames * stream->frame_size;
+        if (!size_round_up(quantum_bytes, stream->period_bytes, &rounded) ||
+            rounded > SIZE_MAX - stream->period_bytes)
+            return FALSE;
+        rounded += stream->period_bytes;
+        if (rounded > *size)

+static BOOL exclusive_render_bound_size(const struct pipewire_stream *stream, SIZE_T *size)
+{
+    UINT64 quantum_frames;
+    SIZE_T quantum_bytes, rounded;
+
+    if (!exclusive_render_capacity_size(stream, size))
+        return FALSE;
+    /* clock.max-quantum is the graph's advertised upper bound.  The minimum
+     * quantum only describes the current floor and cannot make a lifetime
+     * latency bound safe when the graph is later raised. */
+    if (g_max_quantum)
+    {
+        quantum_frames = g_max_quantum;
+        if (g_clock_rate && stream->info.rate && stream->info.rate != g_clock_rate)

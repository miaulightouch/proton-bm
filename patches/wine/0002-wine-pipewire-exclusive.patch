+static HRESULT ensure_render_ring_capacity(struct pipewire_stream *stream)
+{
+    struct render_ring_rebase rebase;
+    SIZE_T required, demand, size;
+    int res;
+
+    if (stream->share != AUDCLNT_SHAREMODE_EXCLUSIVE ||
+        !(stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK))
+        return S_OK;
+    if (!exclusive_render_capacity_size(stream, &required))
+        return E_OUTOFMEMORY;
+    if (!exclusive_render_demand_size(stream, &demand))
+        return E_OUTOFMEMORY;
+    if (!stream->latency_bound_bytes || demand > stream->latency_bound_bytes)
+        return AUDCLNT_E_BUFFER_SIZE_ERROR;
+    if (demand > required)
+        required = demand;
+    if (required > stream->latency_bound_bytes)
+        required = stream->latency_bound_bytes;
+    if (required <= stream->real_bufsize_bytes)
+        return S_OK;
+    if (stream->locked)
+        return S_FALSE;
+    if (required > UINT32_MAX)
+        return E_OUTOFMEMORY;
+
+    rebase.stream = stream;
+    rebase.new_buffer = NULL;
+    rebase.new_size = required;
+    rebase.old_buffer = NULL;
+    size = required;
+    if (NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&rebase.new_buffer,

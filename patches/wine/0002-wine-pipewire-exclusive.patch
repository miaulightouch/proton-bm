+            !__atomic_load_n(&stream->recovery.ready, __ATOMIC_ACQUIRE)) return TRUE;
+        if (FAILED(ensure_render_ring_capacity(stream))) goto failed;
+        if (!stream->started && pw_stream_set_active(stream->pw, false) < 0) goto failed;
+        if (stream_loop_locked(stream, do_complete_recovery) < 0) goto failed;

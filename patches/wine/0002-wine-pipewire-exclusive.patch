+}
+
+int wine_presentation_resume_origin(uint64_t submit_frames, uint64_t queued_frames,
+                                    uint64_t buffered_frames, uint64_t *native_origin)
+{
+    uint64_t pending;
+
+    if (!native_origin || queued_frames > UINT64_MAX - buffered_frames)
+        return 0;
+    pending = queued_frames + buffered_frames;
+    if (pending > submit_frames)
+        return 0;
+    *native_origin = submit_frames - pending;
+    return 1;
+}
+
+int wine_presentation_reanchor(uint64_t old_native, uint64_t old_public,
+                                uint64_t next_native, uint64_t *next_public)
+{
+    return next_public && next_native >= old_native &&
+           add_u64(old_public, next_native - old_native, next_public);
+}
+
+int wine_presentation_span_end(uint64_t first_ns, uint32_t frames, uint32_t stream_rate,
+                               uint64_t *end_ns)
+{
+    uint64_t duration;
+
+    if (!end_ns || !frames || !stream_rate ||
+        !mul_div_u64(frames, 1000000000, stream_rate, &duration) ||
+        !add_u64(first_ns, duration, end_ns))
+        return 0;
+    return 1;
+}
+
+int wine_presentation_project_basis(const struct wine_presentation_basis *basis,
+                                    uint64_t now_ns, uint64_t *position)
+{
+    uint64_t before_frames, elapsed_frames, native_position, native_delta;
+    uint64_t span_frames;
+    uint64_t frames;
+
+    if (!basis || !position || !basis->stream_rate ||
+        basis->native_origin > basis->submit_start ||
+        basis->submit_end < basis->submit_start || basis->end_ns < basis->first_ns)
+        return 0;
+
+    span_frames = basis->submit_end - basis->submit_start;
+    if (now_ns < basis->first_ns)
+    {
+        if (!mul_div_u64_ceil(basis->first_ns - now_ns, basis->stream_rate,
+                              1000000000, &before_frames))
+            return 0;
+        native_position = before_frames >= basis->submit_start - basis->native_origin ?
+                          basis->native_origin : basis->submit_start - before_frames;
+    }
+    else if (now_ns >= basis->end_ns)
+    {
+        native_position = basis->submit_end;
+    }
+    else
+    {
+        if (!mul_div_u64(now_ns - basis->first_ns, basis->stream_rate,
+                         1000000000, &frames))
+            return 0;
+        elapsed_frames = frames > span_frames ? span_frames : (uint64_t)frames;
+        native_position = basis->submit_start + elapsed_frames;
+    }
+
+    native_delta = native_position - basis->native_origin;
+    if (!add_u64(basis->public_origin, native_delta, position))
+        return 0;
+    return 1;
+}
+
+int wine_presentation_span_contiguous(const struct wine_presentation_observation *previous,
+                                      const struct wine_presentation_observation *current,
+                                      uint64_t previous_end_ns, uint64_t current_first_ns)
+{
+    uint64_t tolerance_ns;
+
+    if (!previous || !current || !previous->stream_rate ||
+        previous->stream_rate != current->stream_rate ||
+        previous->rate_num != current->rate_num ||
+        previous->rate_denom != current->rate_denom ||
+        current->now_ns < previous->now_ns)
+        return 0;
+    if (current_first_ns >= previous_end_ns)
+        return 1;
+    tolerance_ns = ((uint64_t)1000000000 + previous->stream_rate - 1) /
+                   previous->stream_rate;
+    return previous_end_ns - current_first_ns <= tolerance_ns;
+}

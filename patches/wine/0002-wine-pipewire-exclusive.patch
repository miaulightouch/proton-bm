+    before = __atomic_load_n(&stream->presentation_latest_seq, __ATOMIC_ACQUIRE);
+    if (before & 1)
+        return FALSE;
+    snapshot->epoch = __atomic_load_n(&stream->presentation_latest.epoch, __ATOMIC_RELAXED);
+    snapshot->submit_start = __atomic_load_n(&stream->presentation_latest.submit_start,
+                                             __ATOMIC_RELAXED);
+    snapshot->submit_end = __atomic_load_n(&stream->presentation_latest.submit_end,
+                                           __ATOMIC_RELAXED);
+    snapshot->native_origin = __atomic_load_n(&stream->presentation_latest.native_origin,
+                                              __ATOMIC_RELAXED);
+    snapshot->public_origin = __atomic_load_n(&stream->presentation_latest.public_origin,
+                                              __ATOMIC_RELAXED);
+    snapshot->first_ns = __atomic_load_n(&stream->presentation_latest.first_ns,
+                                         __ATOMIC_RELAXED);
+    snapshot->end_ns = __atomic_load_n(&stream->presentation_latest.end_ns,
+                                       __ATOMIC_RELAXED);
+    snapshot->stream_rate = __atomic_load_n(&stream->presentation_latest.stream_rate,
+                                            __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    after = __atomic_load_n(&stream->presentation_latest_seq, __ATOMIC_ACQUIRE);
+    return before == after;

+static void test_gargle_state(void)
+{
+    IMediaObject *dmo;
+    IDirectSoundFXGargle *effect;
+    IMediaObjectInPlace *inplace;
+    DSFXGargle params = {1000, DSFXGARGLE_WAVE_TRIANGLE};
+    float samples[10], sample, phase_samples[38];
+    unsigned int i;
+    HRESULT hr;
+
+    if (!create_gargle_test_object(&dmo, &effect, &inplace))
+        return;
+    hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx setting initial Gargle parameters.\n", hr);
+    memset(samples, 0, sizeof(samples));
+    for (unsigned int i = 0; i < ARRAY_SIZE(samples); ++i)
+        samples[i] = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx processing initial Gargle phase.\n", hr);
+
+    hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx setting unchanged Gargle parameters.\n", hr);
+    sample = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK && fabsf(sample - 20.0f / 48.0f) < 1e-6f,
+            "Unchanged parameters reset phase: hr %#lx sample %.8e.\n", hr, sample);
+
+    hr = IMediaObject_FreeStreamingResources(dmo);
+    ok(hr == S_OK, "Got hr %#lx freeing Gargle resources.\n", hr);
+    sample = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK && fabsf(sample - 22.0f / 48.0f) < 1e-6f,
+            "FreeStreamingResources reset phase: hr %#lx sample %.8e.\n", hr, sample);
+
+    params.dwRateHz = 500;
+    hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx changing Gargle rate.\n", hr);
+    sample = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK && fabsf(sample - 0.25f) < 1e-6f,
+            "Changed rate lost phase: hr %#lx sample %.8e.\n", hr, sample);
+
+    params.dwWaveShape = DSFXGARGLE_WAVE_SQUARE;
+    hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx changing Gargle wave shape.\n", hr);
+    sample = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK && fabsf(sample - 1.0f) < 1e-6f,
+            "Unexpected changed wave shape: hr %#lx sample %.8e.\n", hr, sample);
+    for (i = 0; i < ARRAY_SIZE(phase_samples); ++i)
+        phase_samples[i] = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(phase_samples), (BYTE *)phase_samples,
+            0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx processing changed waveform.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(phase_samples); ++i)
+        ok(phase_samples[i] == (i < 35 ? 1.0f : 0.0f),
+                "Changed waveform lost phase at sample %u: %.8e.\n", i, phase_samples[i]);
+
+    params.dwRateHz = 1000;
+    params.dwWaveShape = DSFXGARGLE_WAVE_TRIANGLE;
+    hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx restoring Gargle parameters.\n", hr);
+    sample = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK && sample == 0.0f,
+            "Phase beyond the new period was not reset: hr %#lx sample %.8e.\n", hr, sample);
+
+    hr = IMediaObject_Flush(dmo);
+    ok(hr == S_OK, "Got hr %#lx flushing Gargle.\n", hr);
+    sample = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK && fabsf(sample - 2.0f / 48.0f) < 1e-6f,
+            "Flush did not start at phase one: hr %#lx sample %.8e.\n", hr, sample);
+
+    hr = IMediaObject_Discontinuity(dmo, 0);
+    ok(hr == S_OK, "Got hr %#lx discontinuing Gargle.\n", hr);
+    sample = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK && fabsf(sample - 2.0f / 48.0f) < 1e-6f,
+            "Discontinuity did not start at phase one: hr %#lx sample %.8e.\n", hr, sample);
+
+    release_gargle_test_object(dmo, effect, inplace);
+
+    if (create_gargle_test_object(&dmo, &effect, &inplace))
+    {
+        hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+        ok(hr == S_OK, "Got hr %#lx setting fresh Gargle parameters.\n", hr);
+        sample = 1.0f;
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+                DMO_INPLACE_NORMAL);
+        ok(hr == S_OK && fabsf(sample) < 1e-6f,
+                "Fresh typed Gargle did not start at phase zero: hr %#lx sample %.8e.\n",
+                hr, sample);
+        release_gargle_test_object(dmo, effect, inplace);
+    }
+}

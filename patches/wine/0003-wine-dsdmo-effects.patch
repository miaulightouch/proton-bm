+struct mod_delay
+{
+    struct delay_buffer delay;
+    float phase;
+};
+
+static void mod_reset(struct mod_delay *state)
+{
+    delay_reset(&state->delay);
+    state->phase = 0.0f;
+}
+
+static void mod_release(struct mod_delay *state)
+{
+    delay_release(&state->delay);
+    state->phase = 0.0f;
+}
+
+static HRESULT mod_process(struct effect *base, struct mod_delay *state, ULONG size, BYTE *data,
+        DWORD flags, float wetdry, float depth, float feedback, float frequency,
+        LONG waveform, float delay_ms, LONG phase)
+{
+    const WAVEFORMATEX *format = &base->format;
+    DWORD frames, frame, channel;
+    DWORD sample_bytes = format->wBitsPerSample / 8;
+    float wet = wetdry / 100.0f;
+    float phase_offset = (phase - 2) * 0.25f;
+    HRESULT hr;
+
+    if (FAILED(hr = effect_audio_prepare(base, size, data, &frames)))
+        return hr;
+    if (!size)
+        return S_OK;
+
+    for (frame = 0; frame < frames; ++frame)
+    {
+        BYTE *frame_data = data + frame * format->nBlockAlign;
+        for (channel = 0; channel < format->nChannels; ++channel)
+        {
+            float input = flags == DMO_INPLACE_ZERO ? 0.0f :
+                    reverb_read_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample);
+            float lfo = effect_lfo(state->phase + (channel ? phase_offset : 0.0f), waveform);
+            float modulated = delay_ms + delay_ms * depth / 100.0f * (lfo + 1.0f) * 0.5f;
+            float delayed = delay_read(&state->delay, channel,
+                    modulated * format->nSamplesPerSec / 1000.0f, input);
+            float output = input * (1.0f - wet) + delayed * wet;
+
+            delay_write(&state->delay, channel, audio_clip(input + delayed * feedback / 100.0f));
+            reverb_write_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample, output);
+        }
+        delay_advance(&state->delay);
+        state->phase += frequency / format->nSamplesPerSec;
+        state->phase -= floorf(state->phase);
+    }
+    return S_OK;
+}

+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == S_OK, "Got hr %#lx setting native-derived PCM input.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &type, 0);
+    ok(hr == S_OK, "Got hr %#lx setting native-derived PCM output.\n", hr);
+    hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);

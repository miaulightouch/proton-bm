+static void test_eq_pcm8_bypass(void)
+{
+    static const BYTE input[] = {0x00, 0x40, 0x80, 0xff, 0x01, 0x7f, 0xc0, 0xfe};
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_PCM,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    unsigned int channels, i;
+
+    for (channels = 1; channels <= 2; ++channels)
+    {
+        IMediaObjectInPlace *inplace = NULL;
+        IMediaObject *dmo = NULL;
+        BYTE data[sizeof(input)];
+        HRESULT hr;
+
+        winetest_push_context("PCM8, %u channels", channels);
+        hr = CoCreateInstance(&GUID_DSFX_STANDARD_PARAMEQ, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating ParamEq.\n", hr);
+        if (FAILED(hr))
+            goto done;
+        build_pcm_format(&wfx, WAVE_FORMAT_PCM, 8, 48000, channels);
+        hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting PCM8 input.\n", hr);
+        if (FAILED(hr))
+            goto done;
+        hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting PCM8 output.\n", hr);
+        if (FAILED(hr))
+            goto done;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying in-place interface.\n", hr);
+        if (FAILED(hr))
+            goto done;
+
+        memcpy(data, input, sizeof(data));
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(data), data, 0, DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing PCM8 input.\n", hr);
+        ok(!memcmp(data, input, sizeof(data)), "Neutral ParamEq changed PCM8 input.\n");
+
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(data), data, 0, DMO_INPLACE_ZERO);
+        ok(hr == S_OK, "Got hr %#lx bypassing PCM8 with ZERO.\n", hr);
+        ok(!memcmp(data, input, sizeof(data)), "Neutral ParamEq changed PCM8 with ZERO.\n");
+
+        memset(data, 0x80, sizeof(data));
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(data), data, 0, DMO_INPLACE_ZERO);
+        ok(hr == S_OK, "Got hr %#lx processing PCM8 silence.\n", hr);
+        for (i = 0; i < ARRAY_SIZE(data); ++i)
+            ok(data[i] == 0x80, "PCM8 silence sample %u: %#x, expected 0x80.\n", i, data[i]);
+done:
+        if (inplace)
+            IMediaObjectInPlace_Release(inplace);
+        if (dmo)
+            IMediaObject_Release(dmo);
+        winetest_pop_context();
+    }
+}

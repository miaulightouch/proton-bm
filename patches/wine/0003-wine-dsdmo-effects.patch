+static HRESULT compressor_process(struct effect *base, ULONG size, BYTE *data, DWORD flags)
+{
+    struct dmo_compressorfx *effect = CONTAINING_RECORD(base, struct dmo_compressorfx, effect);
+    const WAVEFORMATEX *format = &base->format;
+    DWORD frames, frame, channel;
+    DWORD sample_bytes = format->wBitsPerSample / 8;
+    float attack, release, predelay, threshold, ratio;
+    HRESULT hr;
+
+    if (FAILED(hr = effect_audio_prepare(base, size, data, &frames)))
+        return hr;
+    if (!size)
+        return S_OK;
+    predelay = effect->params.fPredelay * format->nSamplesPerSec / 1000.0f;
+    attack = expf(-1.0f / (effect->params.fAttack * 0.001f * format->nSamplesPerSec));
+    release = expf(-1.0f / (effect->params.fRelease * 0.001f * format->nSamplesPerSec));
+    threshold = effect->params.fThreshold;
+    ratio = effect->params.fRatio;
+
+    for (frame = 0; frame < frames; ++frame)
+    {
+        BYTE *frame_data = data + frame * format->nBlockAlign;
+        for (channel = 0; channel < format->nChannels; ++channel)
+        {
+            float input = flags == DMO_INPLACE_ZERO ? 0.0f :
+                    reverb_read_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample);
+            float level = fabsf(input);
+            float db, gain_db, delayed, output;
+            float coeff;
+
+            coeff = level > effect->envelope[channel] ? attack : release;
+            effect->envelope[channel] = coeff * effect->envelope[channel]
+                    + (1.0f - coeff) * level;
+            db = 20.0f * log10f(fmaxf(effect->envelope[channel], 1e-7f));
+            gain_db = effect->params.fGain;
+            if (db > threshold)
+                gain_db += threshold + (db - threshold) / ratio - db;
+            delayed = delay_read(&effect->delay, channel, predelay, input);
+            delay_write(&effect->delay, channel, input);
+            output = delayed * powf(10.0f, gain_db / 20.0f);
+            reverb_write_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample, output);
+        }
+        delay_advance(&effect->delay);
+    }
+    return S_OK;

+static void test_compressor_blackbox_fixtures(void)
+{
+    static const DWORD chunks[] = {1, 17, 257, 13, 1024};
+    static const WORD impulse_formats[] = {WAVE_FORMAT_PCM, WAVE_FORMAT_IEEE_FLOAT};
+    static const char *impulse_ids[] = {"compressor-01001", "compressor-11001"};
+    static const double impulse_values[] = {8191.0, 0.2499995231628418};
+    DSFXCompressor params = {0.0f, 10.0f, 200.0f, -20.0f, 3.0f, 4.0f};
+    unsigned int case_index;
+
+    for (case_index = 0; case_index < ARRAY_SIZE(compressor_blackbox_noise_cases)
+            + ARRAY_SIZE(impulse_formats); ++case_index)
+    {
+        const struct compressor_blackbox_noise_case *noise = NULL;
+        struct compressor_blackbox_point impulse_point;
+        const struct compressor_blackbox_point *points;
+        const char *id;
+        WORD format, channels;
+        DWORD frames, bytes_per_sample, frame_bytes, bytes;
+        BOOL impulse;
+        unsigned int point_count;
+        WAVEFORMATEX wfx;
+        DMO_MEDIA_TYPE mt;
+        IMediaObject *dmo = NULL;
+        IMediaObjectInPlace *inplace = NULL;
+        IDirectSoundFXCompressor *compressor = NULL;
+        BYTE *data = NULL;
+        REFERENCE_TIME latency;
+        HRESULT hr;
+        unsigned int i;
+
+        impulse = case_index >= ARRAY_SIZE(compressor_blackbox_noise_cases);
+        if (!impulse)
+        {
+            noise = &compressor_blackbox_noise_cases[case_index];
+            id = noise->id;
+            format = noise->format;
+            channels = noise->channels;
+            frames = 4096;
+            points = noise->points;
+            point_count = noise->point_count;
+        }
+        else
+        {
+            unsigned int index = case_index - ARRAY_SIZE(compressor_blackbox_noise_cases);
+
+            id = impulse_ids[index];
+            format = impulse_formats[index];
+            channels = 1;
+            frames = 48000;
+            impulse_point.frame = 2;
+            impulse_point.expected[0] = impulse_values[index];
+            impulse_point.expected[1] = 0.0;
+            points = &impulse_point;
+            point_count = 1;
+        }
+
+        bytes_per_sample = format == WAVE_FORMAT_PCM ? sizeof(SHORT) : sizeof(float);
+        frame_bytes = channels * bytes_per_sample;
+        bytes = frames * frame_bytes;
+        memset(&mt, 0, sizeof(mt));
+        mt.majortype = MEDIATYPE_Audio;
+        mt.subtype = format == WAVE_FORMAT_PCM ? MEDIASUBTYPE_PCM : MEDIASUBTYPE_IEEE_FLOAT;
+        mt.formattype = FORMAT_WaveFormatEx;
+        mt.cbFormat = sizeof(wfx);
+        mt.pbFormat = (BYTE *)&wfx;
+        build_pcm_format(&wfx, format, format == WAVE_FORMAT_PCM ? 16 : 32,
+                48000, channels);
+
+        winetest_push_context("%s", id);
+        data = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, bytes);
+        ok(data != NULL, "Could not allocate %lu-byte fixture.\n", bytes);
+        if (!data)
+            goto next_case;
+        hr = CoCreateInstance(&GUID_DSFX_STANDARD_COMPRESSOR, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating Compressor.\n", hr);
+        if (FAILED(hr))
+            goto next_case;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying in-place.\n", hr);
+        if (FAILED(hr))
+            goto next_case;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXCompressor, (void **)&compressor);
+        ok(hr == S_OK, "Got hr %#lx querying Compressor.\n", hr);
+        if (FAILED(hr))
+            goto next_case;
+        hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting input.\n", hr);
+        if (FAILED(hr))
+            goto next_case;
+        hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting output.\n", hr);
+        if (FAILED(hr))
+            goto next_case;
+        hr = IDirectSoundFXCompressor_SetAllParameters(compressor, &params);
+        ok(hr == S_OK, "Got hr %#lx setting parameters.\n", hr);
+        if (FAILED(hr))
+            goto next_case;
+        hr = IMediaObject_AllocateStreamingResources(dmo);
+        ok(hr == S_OK, "Got hr %#lx allocating resources.\n", hr);
+        if (FAILED(hr))
+            goto next_case;
+        hr = IMediaObjectInPlace_GetLatency(inplace, &latency);
+        ok(hr == S_OK && latency == 0, "Got hr %#lx and latency %I64d.\n", hr, latency);
+        if (FAILED(hr))
+            goto next_case;
+
+        compressor_blackbox_fill_input(data, format, channels, frames, impulse);
+        if (impulse)
+        {
+            DWORD offset = 0, chunk_index = 0;
+
+            while (offset < frames)
+            {
+                DWORD requested = chunks[chunk_index++ % ARRAY_SIZE(chunks)];
+                DWORD count = requested < frames - offset ? requested : frames - offset;
+
+                hr = IMediaObjectInPlace_Process(inplace, count * frame_bytes,
+                        data + offset * frame_bytes, 0, DMO_INPLACE_NORMAL);
+                ok(hr == S_OK, "Got hr %#lx processing chunk at frame %lu.\n", hr, offset);
+                if (FAILED(hr))
+                    goto next_case;
+                offset += count;
+            }
+        }
+        else
+        {
+            hr = IMediaObjectInPlace_Process(inplace, bytes, data, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing noise.\n", hr);
+            if (FAILED(hr))
+                goto next_case;
+        }
+
+        for (i = 0; i < point_count; ++i)
+        {
+            const struct compressor_blackbox_point *point = &points[i];
+            unsigned int channel;
+
+            for (channel = 0; channel < channels; ++channel)
+            {
+                BYTE *sample = data + point->frame * frame_bytes + channel * bytes_per_sample;
+
+                if (format == WAVE_FORMAT_PCM)
+                {
+                    SHORT got;
+                    LONG expected = (LONG)point->expected[channel];
+
+                    memcpy(&got, sample, sizeof(got));
+                    ok(got >= expected - 1 && got <= expected + 1,
+                            "Frame %lu channel %u: got %d, expected %ld.\n",
+                            point->frame, channel, got, expected);
+                }
+                else
+                {
+                    float got;
+
+                    memcpy(&got, sample, sizeof(got));
+                    ok(isfinite(got) && fabsf(got - (float)point->expected[channel]) <= 2e-6f,
+                            "Frame %lu channel %u: got %.9g, expected %.9g.\n",
+                            point->frame, channel, got, (float)point->expected[channel]);
+                }
+            }
+        }
+
+next_case:
+        if (compressor) IDirectSoundFXCompressor_Release(compressor);
+        if (inplace) IMediaObjectInPlace_Release(inplace);
+        if (dmo) IMediaObject_Release(dmo);
+        if (data) HeapFree(GetProcessHeap(), 0, data);
+        winetest_pop_context();
+    }
+}

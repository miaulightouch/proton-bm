+static void test_echo_delay_change(void)
+{
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    DSFXEcho params = {100.0f, 0.0f, 1.0f, 1.0f, FALSE};
+    IMediaObjectInPlace *inplace = NULL;
+    IDirectSoundFXEcho *echo = NULL;
+    IMediaObject *dmo;
+    float input[128] = {0.5f}, output[256] = {0};
+    unsigned int i;
+    HRESULT hr;
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 48000, 1);
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_ECHO, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating Echo.\n", hr);
+    if (FAILED(hr)) return;
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting input.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting output.\n", hr);
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx querying in-place.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXEcho, (void **)&echo);
+    ok(hr == S_OK, "Got hr %#lx querying Echo.\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IDirectSoundFXEcho_SetAllParameters(echo, &params);
+    ok(hr == S_OK, "Got hr %#lx setting short delay.\n", hr);
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(input), (BYTE *)input, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx processing impulse.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(input); ++i)
+        ok(fabsf(input[i] - (i == 48 ? 0.5f : 0.0f)) < 1e-6f,
+                "Unexpected short-delay sample %u: %.8e.\n", i, input[i]);
+    /* The old tap has passed, but a longer tap must still see the same impulse. */
+    hr = IMediaObject_AllocateStreamingResources(dmo);
+    ok(hr == S_OK, "Got hr %#lx allocating prepared history.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, DMO_SET_TYPEF_TEST_ONLY);
+    ok(hr == S_OK, "Got hr %#lx testing the output type.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting the same output type.\n", hr);
+    params.fLeftDelay = params.fRightDelay = 4.0f;
+    hr = IDirectSoundFXEcho_SetAllParameters(echo, &params);
+    ok(hr == S_OK, "Got hr %#lx increasing delay.\n", hr);
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(output), (BYTE *)output, 0, DMO_INPLACE_ZERO);
+    ok(hr == S_OK, "Got hr %#lx processing longer delay.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(output); ++i)
+        ok(fabsf(output[i] - (i == 64 ? 0.5f : 0.0f)) < 1e-6f,
+                "Lost history at sample %u: %.8e.\n", i, output[i]);
+done:
+    if (echo) IDirectSoundFXEcho_Release(echo);
+    if (inplace) IMediaObjectInPlace_Release(inplace);
+    IMediaObject_Release(dmo);
+}

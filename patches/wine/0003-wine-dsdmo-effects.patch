+static void test_chorus_delay_latch(void)
+{
+    enum chorus_latch_action
+    {
+        LATCH_NONE,
+        LATCH_GET_LATENCY,
+        LATCH_FREE_ALLOCATE,
+        LATCH_CLONE_ORIGINAL,
+        LATCH_CLONE_PROCESS,
+        LATCH_TEST_INPUT,
+        LATCH_TEST_OUTPUT,
+        LATCH_TEST_BOTH,
+        LATCH_CACHED,
+        LATCH_SET_INPUT,
+        LATCH_SET_OUTPUT,
+        LATCH_FLUSH,
+        LATCH_DISCONTINUITY,
+        LATCH_CLEAR_RESTORE,
+    };
+    struct chorus_latch_case
+    {
+        const char *name;
+        enum chorus_latch_action action;
+        int cached_delay;
+        float target_delay;
+        LONG phase;
+        int left_first, right_first;
+    };
+    static const struct chorus_latch_case cases[] =
+    {
+        {"none",             LATCH_NONE,             -1, 20.0f, DSFXCHORUS_PHASE_90, 770, 1250},
+        {"get-latency",     LATCH_GET_LATENCY,     -1, 20.0f, DSFXCHORUS_PHASE_90, 770, 1250},
+        {"free-allocate",   LATCH_FREE_ALLOCATE,   -1, 20.0f, DSFXCHORUS_PHASE_90, 770, 1250},
+        {"clone-original",  LATCH_CLONE_ORIGINAL,  -1, 20.0f, DSFXCHORUS_PHASE_90, 770, 1250},
+        {"clone-process",   LATCH_CLONE_PROCESS,   -1, 20.0f, DSFXCHORUS_PHASE_90, 962, 1442},
+        {"test-input",      LATCH_TEST_INPUT,      -1, 20.0f, DSFXCHORUS_PHASE_90, 770, 1250},
+        {"test-output",     LATCH_TEST_OUTPUT,     -1, 20.0f, DSFXCHORUS_PHASE_90, 770, 1250},
+        {"test-both",       LATCH_TEST_BOTH,       -1, 20.0f, DSFXCHORUS_PHASE_90, 770, 1250},
+        {"cache0-neg90",    LATCH_CACHED,           0, 20.0f, DSFXCHORUS_PHASE_NEG_90, 2, -1},
+        {"cache0-pos90",    LATCH_CACHED,           0, 20.0f, DSFXCHORUS_PHASE_90, 2, 482},
+        {"cache5-neg90",    LATCH_CACHED,           5, 20.0f, DSFXCHORUS_PHASE_NEG_90, 242, -1},
+        {"cache5-pos90",    LATCH_CACHED,           5, 20.0f, DSFXCHORUS_PHASE_90, 242, 722},
+        {"cache20-to5",     LATCH_CACHED,          20, 5.0f, DSFXCHORUS_PHASE_90, 962, 1082},
+        {"set-input",       LATCH_SET_INPUT,       -1, 20.0f, DSFXCHORUS_PHASE_90, 962, 1442},
+        {"set-output",      LATCH_SET_OUTPUT,      -1, 20.0f, DSFXCHORUS_PHASE_90, 962, 1442},
+        {"flush",           LATCH_FLUSH,           -1, 20.0f, DSFXCHORUS_PHASE_90, 962, 1442},
+        {"discontinuity",   LATCH_DISCONTINUITY,   -1, 20.0f, DSFXCHORUS_PHASE_90, 962, 1442},
+        {"clear-restore",   LATCH_CLEAR_RESTORE,   -1, 20.0f, DSFXCHORUS_PHASE_90, 962, 1442},
+    };
+    enum { frame_count = 4096 };
+    float data[frame_count * 2];
+    unsigned int case_index, channel, frame;
+    HRESULT hr;
+
+    for (case_index = 0; case_index < ARRAY_SIZE(cases); ++case_index)
+    {
+        const struct chorus_latch_case *test_case = &cases[case_index];
+        DSFXChorus params = {100.0f, 100.0f, 0.0f, 0.0f,
+                DSFXCHORUS_WAVE_SIN, test_case->target_delay, test_case->phase};
+        IMediaObject *dmo = NULL;
+        IDirectSoundFXChorus *chorus = NULL;
+        IMediaObjectInPlace *inplace = NULL, *clone = NULL;
+        REFERENCE_TIME latency;
+        DMO_MEDIA_TYPE type;
+
+        winetest_push_context("action %s", test_case->name);
+        hr = CoCreateInstance(&GUID_DSFX_STANDARD_CHORUS, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating Chorus latch probe.\n", hr);
+        if (FAILED(hr))
+            goto next;
+        hr = set_float_format(dmo, 48000, 2);
+        ok(hr == S_OK, "Got hr %#lx setting Chorus latch format.\n", hr);
+        if (FAILED(hr))
+            goto release_dmo;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXChorus, (void **)&chorus);
+        ok(hr == S_OK, "Got hr %#lx querying Chorus latch parameters.\n", hr);
+        if (FAILED(hr))
+            goto release_dmo;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying Chorus latch in-place interface.\n", hr);
+        if (FAILED(hr))
+            goto release_chorus;
+        hr = IDirectSoundFXChorus_SetAllParameters(chorus, &params);
+        ok(hr == S_OK, "Got hr %#lx setting Chorus latch parameters.\n", hr);
+        if (FAILED(hr))
+            goto release_inplace;
+
+        if (test_case->cached_delay >= 0)
+        {
+            DSFXChorus cached = {100.0f, 0.0f, 0.0f, 0.0f,
+                    DSFXCHORUS_WAVE_SIN, test_case->cached_delay, DSFXCHORUS_PHASE_ZERO};
+
+            hr = IDirectSoundFXChorus_SetAllParameters(chorus, &cached);
+            ok(hr == S_OK, "Got hr %#lx setting Chorus cached parameters.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = set_float_format(dmo, 48000, 2);
+                ok(hr == S_OK, "Got hr %#lx resetting Chorus cached format.\n", hr);
+            }
+            if (SUCCEEDED(hr))
+            {
+                hr = IDirectSoundFXChorus_SetAllParameters(chorus, &params);
+                ok(hr == S_OK, "Got hr %#lx restoring Chorus target parameters.\n", hr);
+            }
+        }
+
+        switch (test_case->action)
+        {
+            case LATCH_NONE:
+                break;
+            case LATCH_GET_LATENCY:
+                hr = IMediaObjectInPlace_GetLatency(inplace, &latency);
+                ok(hr == S_OK, "Got hr %#lx getting Chorus latency.\n", hr);
+                break;
+            case LATCH_FREE_ALLOCATE:
+                hr = IMediaObject_FreeStreamingResources(dmo);
+                ok(hr == S_OK, "Got hr %#lx freeing Chorus resources.\n", hr);
+                if (SUCCEEDED(hr))
+                {
+                    hr = IMediaObject_AllocateStreamingResources(dmo);
+                    ok(hr == S_OK, "Got hr %#lx allocating Chorus resources.\n", hr);
+                }
+                break;
+            case LATCH_CLONE_ORIGINAL:
+                hr = IMediaObjectInPlace_Clone(inplace, &clone);
+                ok(hr == S_OK, "Got hr %#lx cloning Chorus original.\n", hr);
+                break;
+            case LATCH_CLONE_PROCESS:
+                hr = IMediaObjectInPlace_Clone(inplace, &clone);
+                ok(hr == S_OK, "Got hr %#lx cloning Chorus for processing.\n", hr);
+                break;
+            case LATCH_CACHED:
+                break;
+            case LATCH_TEST_INPUT:
+            case LATCH_TEST_BOTH:
+                memset(&type, 0, sizeof(type));
+                hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+                ok(hr == S_OK, "Got hr %#lx getting Chorus input type for TEST_ONLY.\n", hr);
+                if (SUCCEEDED(hr))
+                {
+                    hr = IMediaObject_SetInputType(dmo, 0, &type, DMO_SET_TYPEF_TEST_ONLY);
+                    ok(hr == S_OK, "Got hr %#lx testing Chorus input type.\n", hr);
+                    MoFreeMediaType(&type);
+                }
+                if (SUCCEEDED(hr) && test_case->action == LATCH_TEST_BOTH)
+                {
+                    memset(&type, 0, sizeof(type));
+                    hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+                    ok(hr == S_OK, "Got hr %#lx getting Chorus output type for TEST_ONLY.\n", hr);
+                    if (SUCCEEDED(hr))
+                    {
+                        hr = IMediaObject_SetOutputType(dmo, 0, &type, DMO_SET_TYPEF_TEST_ONLY);
+                        ok(hr == S_OK, "Got hr %#lx testing Chorus output type.\n", hr);
+                        MoFreeMediaType(&type);
+                    }
+                }
+                break;
+            case LATCH_TEST_OUTPUT:
+                memset(&type, 0, sizeof(type));
+                hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+                ok(hr == S_OK, "Got hr %#lx getting Chorus output type for TEST_ONLY.\n", hr);
+                if (SUCCEEDED(hr))
+                {
+                    hr = IMediaObject_SetOutputType(dmo, 0, &type, DMO_SET_TYPEF_TEST_ONLY);
+                    ok(hr == S_OK, "Got hr %#lx testing Chorus output type.\n", hr);
+                    MoFreeMediaType(&type);
+                }
+                break;
+            case LATCH_SET_INPUT:
+                memset(&type, 0, sizeof(type));
+                hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+                ok(hr == S_OK, "Got hr %#lx getting Chorus input type.\n", hr);
+                if (SUCCEEDED(hr))
+                {
+                    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+                    ok(hr == S_OK, "Got hr %#lx reapplying Chorus input type.\n", hr);
+                    MoFreeMediaType(&type);
+                }
+                break;
+            case LATCH_SET_OUTPUT:
+                memset(&type, 0, sizeof(type));
+                hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+                ok(hr == S_OK, "Got hr %#lx getting Chorus output type.\n", hr);
+                if (SUCCEEDED(hr))
+                {
+                    hr = IMediaObject_SetOutputType(dmo, 0, &type, 0);
+                    ok(hr == S_OK, "Got hr %#lx reapplying Chorus output type.\n", hr);
+                    MoFreeMediaType(&type);
+                }
+                break;
+            case LATCH_FLUSH:
+                hr = IMediaObject_Flush(dmo);
+                ok(hr == S_OK, "Got hr %#lx flushing Chorus.\n", hr);
+                break;
+            case LATCH_DISCONTINUITY:
+                hr = IMediaObject_Discontinuity(dmo, 0);
+                ok(hr == S_OK, "Got hr %#lx discontinuing Chorus.\n", hr);
+                break;
+            case LATCH_CLEAR_RESTORE:
+                hr = IMediaObject_SetOutputType(dmo, 0, NULL, DMO_SET_TYPEF_CLEAR);
+                ok(hr == S_OK, "Got hr %#lx clearing Chorus output type.\n", hr);
+                if (SUCCEEDED(hr))
+                {
+                    hr = IMediaObject_SetInputType(dmo, 0, NULL, DMO_SET_TYPEF_CLEAR);
+                    ok(hr == S_OK, "Got hr %#lx clearing Chorus input type.\n", hr);
+                }
+                if (SUCCEEDED(hr))
+                {
+                    hr = set_float_format(dmo, 48000, 2);
+                    ok(hr == S_OK, "Got hr %#lx restoring Chorus types.\n", hr);
+                }
+                break;
+        }
+        if (FAILED(hr))
+            goto release_clone;
+
+        if (test_case->action == LATCH_CACHED || test_case->action == LATCH_CLONE_PROCESS
+                || test_case->action == LATCH_TEST_INPUT
+                || test_case->action == LATCH_TEST_OUTPUT
+                || test_case->action == LATCH_TEST_BOTH)
+        {
+            hr = IMediaObject_AllocateStreamingResources(dmo);
+            ok(hr == S_OK, "Got hr %#lx allocating Chorus boundary resources.\n", hr);
+        }
+        if (FAILED(hr))
+            goto release_clone;
+
+        memset(data, 0, sizeof(data));
+        data[0] = data[1] = 0.5f;
+        hr = IMediaObjectInPlace_Process(test_case->action == LATCH_CLONE_PROCESS ? clone : inplace,
+                sizeof(data), (BYTE *)data, 0,
+                DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing Chorus latch impulse.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            const int first[] = {test_case->left_first, test_case->right_first};
+
+            for (channel = 0; channel < 2; ++channel)
+            {
+                double sum = 0.0, absolute_sum = 0.0, weighted = 0.0;
+                BOOL early_silent = TRUE;
+
+                for (frame = 0; frame < frame_count; ++frame)
+                {
+                    float sample = data[2 * frame + channel];
+                    if (first[channel] >= 0 && frame < (unsigned int)first[channel]
+                            && fabsf(sample) >= 1e-6f)
+                        early_silent = FALSE;
+                    sum += sample;
+                    absolute_sum += fabsf(sample);
+                    weighted += frame * sample;
+                }
+                if (first[channel] < 0)
+                {
+                    ok(absolute_sum < 1e-6,
+                            "Expected a silent channel %u, got absolute sum %.8e.\n", channel, absolute_sum);
+                    continue;
+                }
+                ok(early_silent, "Unexpected pre-tap energy on channel %u.\n", channel);
+                ok(fabs(sum - 0.5) < 1e-4,
+                        "Tap energy changed on channel %u: %.8e.\n", channel, sum);
+                ok(fabsf(data[2 * (unsigned int)first[channel] + channel]) >= 1e-6f,
+                        "Missing fixed tap frame %u on channel %u.\n",
+                        (unsigned int)first[channel], channel);
+                if (fabs(sum) > 1e-12)
+                    ok(fabs(weighted / sum - (unsigned int)first[channel]) < 0.05,
+                            "Unexpected observed tap center on channel %u: %.8e, expected %u.\n",
+                            channel, weighted / sum, (unsigned int)first[channel]);
+            }
+        }
+
+release_clone:
+        if (clone)
+            IMediaObjectInPlace_Release(clone);
+release_inplace:
+        if (inplace)
+            IMediaObjectInPlace_Release(inplace);
+release_chorus:
+        if (chorus)
+            IDirectSoundFXChorus_Release(chorus);
+release_dmo:
+        if (dmo)
+            IMediaObject_Release(dmo);
+next:
+        winetest_pop_context();
+    }
+}

+static void test_i3dl2_default_quality_workaround(void)
+{
+    static const WORD formats[] = {WAVE_FORMAT_IEEE_FLOAT, WAVE_FORMAT_PCM};
+    static const DWORD chunks[] = {127, 512};
+    static const float q1_float = 0.0005488943425007164f;
+    static const float q2_float = 0.0014243442565202713f;
+    static const SHORT q1_pcm = 17, q2_pcm = 46;
+    enum { frame_count = 48000, channels = 2 };
+    unsigned int format_index, chunk_index;
+
+    for (format_index = 0; format_index < ARRAY_SIZE(formats); ++format_index)
+        for (chunk_index = 0; chunk_index < ARRAY_SIZE(chunks); ++chunk_index)
+        {
+            IMediaObject *dmo = NULL;
+            IMediaObjectInPlace *inplace = NULL;
+            IDirectSoundFXI3DL2Reverb *reverb = NULL;
+            BYTE *data = NULL;
+            DWORD block_align, byte_count;
+            LONG quality = -1;
+            BOOL resources = FALSE;
+            HRESULT hr;
+            ULONG ref;
+
+            winetest_push_context("format %u, chunk %lu", formats[format_index], chunks[chunk_index]);
+            block_align = channels * (formats[format_index] == WAVE_FORMAT_PCM ? sizeof(SHORT) : sizeof(float));
+            byte_count = frame_count * block_align;
+
+            hr = CoCreateInstance(&GUID_DSFX_STANDARD_I3DL2REVERB, NULL, CLSCTX_INPROC_SERVER,
+                    &IID_IMediaObject, (void **)&dmo);
+            ok(hr == S_OK, "Got hr %#lx creating I3DL2 DMO.\n", hr);
+            if (FAILED(hr))
+                goto workaround_done;
+            hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+            ok(hr == S_OK, "Got hr %#lx querying I3DL2 in-place interface.\n", hr);
+            if (FAILED(hr))
+                goto workaround_done;
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXI3DL2Reverb, (void **)&reverb);
+            ok(hr == S_OK, "Got hr %#lx querying I3DL2 parameters.\n", hr);
+            if (FAILED(hr))
+                goto workaround_done;
+
+            do
+            {
+                hr = formats[format_index] == WAVE_FORMAT_IEEE_FLOAT
+                        ? set_float_format(dmo, 48000, channels)
+                        : set_pcm16_format(dmo, 48000, channels);
+                ok(hr == S_OK, "Got hr %#lx setting default format.\n", hr);
+                if (FAILED(hr))
+                    break;
+                hr = IDirectSoundFXI3DL2Reverb_GetQuality(reverb, &quality);
+                ok(hr == S_OK && quality == DSFX_I3DL2REVERB_QUALITY_DEFAULT,
+                        "Got hr %#lx, default quality %ld.\n", hr, quality);
+                if (FAILED(hr))
+                    break;
+                hr = IMediaObject_AllocateStreamingResources(dmo);
+                ok(hr == S_OK, "Got hr %#lx allocating default resources.\n", hr);
+                if (FAILED(hr))
+                    break;
+                resources = TRUE;
+                data = calloc(1, byte_count);
+                ok(data != NULL, "Failed to allocate %lu-byte workaround buffer.\n", byte_count);
+                if (!data)
+                    break;
+                hr = check_i3dl2_checkpoint(inplace, data, frame_count, block_align,
+                        chunks[chunk_index], formats[format_index], q1_float, q1_pcm,
+                        "Default Q1");
+                ok(hr == S_OK, "Got hr %#lx processing default Q1 chunks.\n", hr);
+                if (FAILED(hr))
+                    break;
+
+                hr = IMediaObject_Flush(dmo);
+                ok(hr == S_OK, "Got hr %#lx flushing default Q1 state.\n", hr);
+                if (FAILED(hr))
+                    break;
+                hr = IMediaObject_FreeStreamingResources(dmo);
+                ok(hr == S_OK, "Got hr %#lx freeing default Q1 resources.\n", hr);
+                resources = FALSE;
+                if (FAILED(hr))
+                    break;
+                hr = formats[format_index] == WAVE_FORMAT_IEEE_FLOAT
+                        ? set_float_format(dmo, 48000, channels)
+                        : set_pcm16_format(dmo, 48000, channels);
+                ok(hr == S_OK, "Got hr %#lx resetting workaround format.\n", hr);
+                if (FAILED(hr))
+                    break;
+                hr = IDirectSoundFXI3DL2Reverb_GetQuality(reverb, &quality);
+                ok(hr == S_OK && quality == DSFX_I3DL2REVERB_QUALITY_DEFAULT,
+                        "Got hr %#lx, quality %ld after format reset.\n", hr, quality);
+                if (FAILED(hr))
+                    break;
+                hr = IMediaObject_AllocateStreamingResources(dmo);
+                ok(hr == S_OK, "Got hr %#lx reallocating after format reset.\n", hr);
+                if (FAILED(hr))
+                    break;
+                resources = TRUE;
+                hr = check_i3dl2_checkpoint(inplace, data, frame_count, block_align,
+                        chunks[chunk_index], formats[format_index], q1_float, q1_pcm,
+                        "Reset Q1");
+                ok(hr == S_OK, "Got hr %#lx processing Q1 after Flush/format reset.\n", hr);
+                if (FAILED(hr))
+                    break;
+
+                hr = IDirectSoundFXI3DL2Reverb_SetQuality(reverb, -1);
+                ok(hr == E_INVALIDARG, "Got hr %#lx for invalid quality -1.\n", hr);
+                hr = IDirectSoundFXI3DL2Reverb_GetQuality(reverb, &quality);
+                ok(hr == S_OK && quality == DSFX_I3DL2REVERB_QUALITY_DEFAULT,
+                        "Got hr %#lx, quality %ld after invalid -1.\n", hr, quality);
+                hr = IDirectSoundFXI3DL2Reverb_SetQuality(reverb, 4);
+                ok(hr == E_INVALIDARG, "Got hr %#lx for invalid quality 4.\n", hr);
+                hr = IDirectSoundFXI3DL2Reverb_GetQuality(reverb, &quality);
+                ok(hr == S_OK && quality == DSFX_I3DL2REVERB_QUALITY_DEFAULT,
+                        "Got hr %#lx, quality %ld after invalid 4.\n", hr, quality);
+
+                hr = IMediaObject_Flush(dmo);
+                ok(hr == S_OK, "Got hr %#lx flushing after invalid quality.\n", hr);
+                if (FAILED(hr))
+                    break;
+                hr = check_i3dl2_checkpoint(inplace, data, frame_count, block_align,
+                        chunks[chunk_index], formats[format_index], q1_float, q1_pcm,
+                        "Invalid quality default Q1");
+                ok(hr == S_OK, "Got hr %#lx processing after invalid quality.\n", hr);
+                if (FAILED(hr))
+                    break;
+
+                hr = IDirectSoundFXI3DL2Reverb_SetQuality(reverb, 2);
+                ok(hr == S_OK, "Got hr %#lx setting explicit quality 2.\n", hr);
+                hr = IDirectSoundFXI3DL2Reverb_GetQuality(reverb, &quality);
+                ok(hr == S_OK && quality == 2, "Got hr %#lx, explicit quality %ld.\n", hr, quality);
+                hr = IMediaObject_Flush(dmo);
+                ok(hr == S_OK, "Got hr %#lx flushing explicit quality 2.\n", hr);
+                if (FAILED(hr))
+                    break;
+                hr = check_i3dl2_checkpoint(inplace, data, frame_count, block_align,
+                        chunks[chunk_index], formats[format_index], q2_float, q2_pcm,
+                        "Explicit Q2");
+                ok(hr == S_OK, "Got hr %#lx processing explicit Q2 chunks.\n", hr);
+
+                {
+                    IMediaObjectInPlace *clone = NULL;
+                    IMediaObject *clone_dmo = NULL;
+                    IDirectSoundFXI3DL2Reverb *clone_reverb = NULL;
+
+                    hr = IMediaObjectInPlace_Clone(inplace, &clone);
+                    ok(hr == S_OK, "Got hr %#lx cloning explicit quality 2.\n", hr);
+                    if (SUCCEEDED(hr))
+                    {
+                        hr = IMediaObjectInPlace_QueryInterface(clone,
+                                &IID_IDirectSoundFXI3DL2Reverb, (void **)&clone_reverb);
+                        ok(hr == S_OK, "Got hr %#lx querying cloned I3DL2 parameters.\n", hr);
+                    }
+                    if (SUCCEEDED(hr))
+                    {
+                        hr = IDirectSoundFXI3DL2Reverb_GetQuality(clone_reverb, &quality);
+                        ok(hr == S_OK && quality == 2,
+                                "Got hr %#lx, cloned quality %ld.\n", hr, quality);
+                    }
+                    if (SUCCEEDED(hr))
+                    {
+                        hr = IMediaObjectInPlace_QueryInterface(clone, &IID_IMediaObject,
+                                (void **)&clone_dmo);
+                        ok(hr == S_OK, "Got hr %#lx querying cloned I3DL2 DMO.\n", hr);
+                    }
+                    if (SUCCEEDED(hr))
+                    {
+                        hr = IMediaObject_AllocateStreamingResources(clone_dmo);
+                        ok(hr == S_OK, "Got hr %#lx allocating cloned resources.\n", hr);
+                    }
+                    if (SUCCEEDED(hr))
+                    {
+                        hr = check_i3dl2_checkpoint(clone, data, frame_count, block_align,
+                                chunks[chunk_index], formats[format_index], q2_float, q2_pcm,
+                                "Cloned explicit Q2");
+                        ok(hr == S_OK, "Got hr %#lx processing cloned explicit Q2 chunks.\n", hr);
+                    }
+                    if (clone_dmo)
+                    {
+                        HRESULT clone_hr = IMediaObject_FreeStreamingResources(clone_dmo);
+                        ok(clone_hr == S_OK, "Got hr %#lx freeing cloned resources.\n", clone_hr);
+                        IMediaObject_Release(clone_dmo);
+                    }
+                    if (clone_reverb)
+                        IDirectSoundFXI3DL2Reverb_Release(clone_reverb);
+                    if (clone)
+                        IMediaObjectInPlace_Release(clone);
+                }
+            }
+            while (0);
+
+            if (resources)
+            {
+                hr = IMediaObject_FreeStreamingResources(dmo);
+                ok(hr == S_OK, "Got hr %#lx freeing workaround resources.\n", hr);
+            }
+            free(data);
+
+workaround_done:
+            if (reverb)
+            {
+                ref = IDirectSoundFXI3DL2Reverb_Release(reverb);
+                ok(ref != 0, "Got unexpected I3DL2 refcount %lu.\n", ref);
+            }
+            if (inplace)
+            {
+                ref = IMediaObjectInPlace_Release(inplace);
+                ok(ref != 0, "Got unexpected in-place refcount %lu.\n", ref);
+            }
+            if (dmo)
+            {
+                ref = IMediaObject_Release(dmo);
+                ok(!ref, "Got outstanding I3DL2 refcount %lu.\n", ref);
+            }
+            winetest_pop_context();
+        }
+}

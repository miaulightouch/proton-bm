+static void test_echo_complete(void)
+{
+    enum { frames = 48000 };
+    unsigned int c, i;
+    for (c = 0; c < ARRAY_SIZE(echo_compact_cases); ++c)
+    {
+        const struct echo_compact_case *test_case = &echo_compact_cases[c];
+        IDirectSoundFXEcho *echo = NULL;
+        IMediaObjectInPlace *inplace = NULL;
+        IMediaObject *dmo = NULL;
+        BYTE *data = NULL;
+        DWORD size = frames * test_case->channels
+                * (test_case->float_format ? sizeof(float) : sizeof(SHORT));
+        HRESULT hr;
+        winetest_push_context("%s", test_case->id);
+        data = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, size);
+        ok(data != NULL, "Could not allocate the 48000-frame buffer.\n");

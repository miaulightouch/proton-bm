+static void test_subframe_delay(void)
+{
+    const GUID *clsids[] =
+    {
+        &GUID_DSFX_STANDARD_COMPRESSOR, &GUID_DSFX_STANDARD_CHORUS, &GUID_DSFX_STANDARD_FLANGER,
+    };
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    float data[4096], delay_ms = 0.5f * 1000.0f / 48000;
+    IMediaObjectInPlace *inplace;
+    IMediaObject *dmo;
+    unsigned int effect, i;
+    HRESULT hr;
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 48000, 1);
+    for (effect = 0; effect < ARRAY_SIZE(clsids); ++effect)
+    {
+        winetest_push_context("effect %u", effect);
+        hr = CoCreateInstance(clsids[effect], NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating effect.\n", hr);
+        if (FAILED(hr)) goto next;
+        hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting input.\n", hr);
+        hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting output.\n", hr);
+        if (effect == 0)
+        {
+            DSFXCompressor params = {0.0f, 10.0f, 200.0f, -20.0f, 1.0f, delay_ms};
+            IDirectSoundFXCompressor *fx;
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXCompressor, (void **)&fx);
+            ok(hr == S_OK, "Got hr %#lx querying Compressor.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IDirectSoundFXCompressor_SetAllParameters(fx, &params);
+                IDirectSoundFXCompressor_Release(fx);
+            }
+        }
+        else if (effect == 1)
+        {
+            DSFXChorus params = {100.0f, 0.0f, 0.0f, 0.0f,
+                    DSFXCHORUS_WAVE_SIN, delay_ms, DSFXCHORUS_PHASE_ZERO};
+            IDirectSoundFXChorus *fx;
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXChorus, (void **)&fx);
+            ok(hr == S_OK, "Got hr %#lx querying Chorus.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IDirectSoundFXChorus_SetAllParameters(fx, &params);
+                IDirectSoundFXChorus_Release(fx);
+            }
+        }
+        else
+        {
+            DSFXFlanger params = {100.0f, 0.0f, 0.0f, 0.0f,
+                    DSFXFLANGER_WAVE_SIN, delay_ms, DSFXFLANGER_PHASE_ZERO};
+            IDirectSoundFXFlanger *fx;
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXFlanger, (void **)&fx);
+            ok(hr == S_OK, "Got hr %#lx querying Flanger.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IDirectSoundFXFlanger_SetAllParameters(fx, &params);
+                IDirectSoundFXFlanger_Release(fx);
+            }
+        }
+        ok(hr == S_OK, "Got hr %#lx setting half-frame delay.\n", hr);
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying in-place.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            memset(data, 0, sizeof(data));
+            data[0] = 0.5f;
+            hr = IMediaObjectInPlace_Process(inplace, sizeof(data), (BYTE *)data, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing impulse.\n", hr);
+            if (SUCCEEDED(hr))
+                for (i = 0; i < ARRAY_SIZE(data); ++i)
+                    ok(fabsf(data[i] - (effect == 0 ? (i == 2 ? 0.5f : 0.0f)
+                            : effect == 1 ? (i == 770 ? 0.5f : 0.0f)
+                            : (i == 2 || i == 3 ? 0.25f : 0.0f))) < 1e-6f,
+                            "Unexpected delay sample %u: %.8e.\n", i, data[i]);
+            IMediaObjectInPlace_Release(inplace);
+        }
+        IMediaObject_Release(dmo);
+next:
+        winetest_pop_context();
+    }
+}

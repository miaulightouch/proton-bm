+
+static void distortion_recompute(struct distortion *effect)
+{
+    const float pi = 3.14159265358979323846f;
+    float rate, center, bandwidth, cutoff, omega, sine, alpha;
+
+    rate = effect->effect.format.nSamplesPerSec;
+    if (!rate)
+        return;
+
+    center = effect->params.fPostEQCenterFrequency;
+    bandwidth = effect->params.fPostEQBandwidth;
+    cutoff = effect->params.fPreLowpassCutoff;
+    if (center > rate / 3.0f)
+        center = rate / 3.0f;
+    if (bandwidth > rate / 3.0f)
+        bandwidth = rate / 3.0f;
+    if (cutoff > rate / 3.0f)
+        cutoff = rate / 3.0f;
+
+    effect->pre_alpha = expf(-2.0f * pi * cutoff / rate);
+    omega = 2.0f * pi * center / rate;
+    sine = sinf(omega);
+    alpha = sine * bandwidth / (2.0f * center);
+    /* ponytail: approximate the harmonic band with a peaking EQ; native
+     * reference measurements can replace its coefficients later. */
+    biquad_set_peaking_coefficients(&effect->post_eq, cosf(omega), alpha,
+            effect->params.fEdge * 0.1f);
+    effect->rate = effect->effect.format.nSamplesPerSec;
+}
+
+static HRESULT distortion_process(struct effect *base, ULONG size, BYTE *data, DWORD flags)
+{
+    struct distortion *effect = CONTAINING_RECORD(base, struct distortion, effect);
+    const WAVEFORMATEX *format = &base->format;
+    DWORD frames, frame, channel;
+    DWORD sample_bytes = format->wBitsPerSample / 8;
+    float drive, output_gain;
+    HRESULT hr;
+
+    if (FAILED(hr = effect_audio_prepare(base, size, data, &frames)))
+        return hr;
+    if (!size)
+        return S_OK;
+    if (effect->rate != format->nSamplesPerSec)
+        distortion_recompute(effect);
+    drive = 1.0f + effect->params.fEdge / 10.0f;
+    output_gain = powf(10.0f, effect->params.fGain / 20.0f);
+    for (frame = 0; frame < frames; ++frame)
+    {
+        BYTE *frame_data = data + frame * format->nBlockAlign;
+        for (channel = 0; channel < format->nChannels; ++channel)
+        {
+            float input = flags == DMO_INPLACE_ZERO ? 0.0f :
+                    reverb_read_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample);
+            float pre = (1.0f - effect->pre_alpha) * input + effect->pre_alpha * effect->pre[channel];
+            float shaped = pre + (tanhf(pre * drive) - pre) * effect->params.fEdge / 100.0f;
+            float output = biquad_process(&effect->post_eq, channel, shaped) * output_gain;
+            effect->pre[channel] = pre;
+            reverb_write_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample, output);
+        }
+    }
+    return S_OK;
+}
+
+static void distortion_reset(struct effect *base)
+{
+    struct distortion *effect = CONTAINING_RECORD(base, struct distortion, effect);
+    memset(effect->pre, 0, sizeof(effect->pre));
+    biquad_reset(&effect->post_eq);
+    effect->pre_alpha = 0.0f;
+    effect->rate = 0;
 }
 

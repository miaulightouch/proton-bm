+static void test_dmo_contract(void)
+{
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    DMO_MEDIA_TYPE type, type2;
+    IMediaObject *dmo;
+    IMediaObjectInPlace *inplace;
+    DWORD input_count, output_count, status, size, lookahead, alignment;
+    float sample = 1.0f;
+    HRESULT hr, first_type_hr, second_type_hr;
+    ULONG ref;
+
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_PARAMEQ, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating DMO.\n", hr);
+    if (FAILED(hr))
+        return;
+
+    hr = IMediaObject_GetStreamCount(dmo, &input_count, &output_count);
+    ok(hr == S_OK, "Got hr %#lx getting stream count.\n", hr);
+    ok(input_count == 1 && output_count == 1,
+            "Got stream count %lu/%lu.\n", input_count, output_count);
+    hr = IMediaObject_GetStreamCount(dmo, NULL, &output_count);
+    ok(hr == E_POINTER, "Got hr %#lx for NULL input count.\n", hr);
+    hr = IMediaObject_GetInputStatus(dmo, 0, &status);
+    ok(hr == S_OK && status == DMO_INPUT_STATUSF_ACCEPT_DATA,
+            "Got input status hr %#lx flags %#lx.\n", hr, status);
+    hr = IMediaObject_GetInputStatus(dmo, 1, &status);
+    ok(hr == DMO_E_INVALIDSTREAMINDEX, "Got hr %#lx for invalid input status stream.\n", hr);
+
+    memset(&type, 0, sizeof(type));
+    hr = IMediaObject_GetInputType(dmo, 0, 0, &type);
+    ok(hr == S_OK, "Got hr %#lx getting preferred input type.\n", hr);
+    if (hr == S_OK)
+    {
+        ok(type.cbFormat == sizeof(WAVEFORMATEX), "Got preferred format size %lu.\n", type.cbFormat);
+        ok(((WAVEFORMATEX *)type.pbFormat)->nSamplesPerSec == 44100,
+                "Got preferred rate %lu.\n", ((WAVEFORMATEX *)type.pbFormat)->nSamplesPerSec);
+        ok(((WAVEFORMATEX *)type.pbFormat)->nChannels == 2,
+                "Got preferred channels %u.\n", ((WAVEFORMATEX *)type.pbFormat)->nChannels);
+        MoFreeMediaType(&type);
+    }
+    hr = IMediaObject_GetInputType(dmo, 0, 1, &type);
+    ok(hr == DMO_E_NO_MORE_ITEMS, "Got hr %#lx for preferred type counter.\n", hr);
+    hr = IMediaObject_GetOutputType(dmo, 0, 0, &type);
+    ok(hr == S_OK, "Got hr %#lx getting preferred output type.\n", hr);
+    if (hr == S_OK)
+        MoFreeMediaType(&type);
+    hr = IMediaObject_GetInputType(dmo, 1, 0, &type);
+    ok(hr == DMO_E_INVALIDSTREAMINDEX, "Got hr %#lx for invalid preferred input stream.\n", hr);
+    hr = IMediaObject_GetInputType(dmo, 0, 0, NULL);
+    ok(hr == E_POINTER, "Got hr %#lx for NULL preferred type.\n", hr);
+
+    memset(&type, 0, sizeof(type));
+    hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx for unset current input type.\n", hr);
+    hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx for unset current output type.\n", hr);
+    hr = IMediaObject_GetInputSizeInfo(dmo, 0, &size, &lookahead, &alignment);
+    ok(hr == S_OK && !size && !lookahead && alignment == 1,
+            "Got input size info hr %#lx size %lu lookahead %lu alignment %lu.\n",
+            hr, size, lookahead, alignment);
+    hr = IMediaObject_GetOutputSizeInfo(dmo, 0, &size, &alignment);
+    ok(hr == S_OK && !size && alignment == 1,
+            "Got output size info hr %#lx size %lu alignment %lu.\n", hr, size, alignment);
+
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx querying in-place interface.\n", hr);
+    if (hr == S_OK)
+    {
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+                DMO_INPLACE_NORMAL);
+        ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx processing without types.\n", hr);
+        ref = IMediaObjectInPlace_Release(inplace);
+        ok(ref != 0, "Got unexpected in-place refcount %lu.\n", ref);
+    }
+
+    hr = IMediaObject_Lock(dmo, 1);
+    ok(hr == S_OK, "Got hr %#lx acquiring DMO lock.\n", hr);
+    hr = IMediaObject_Lock(dmo, 0);
+    ok(hr == S_OK, "Got hr %#lx releasing DMO lock.\n", hr);
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 48000, 2);
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, DMO_SET_TYPEF_TEST_ONLY);
+    ok(hr == S_OK, "Got hr %#lx testing input type.\n", hr);
+    hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "TEST_ONLY changed input type, hr %#lx.\n", hr);
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting input type.\n", hr);
+    hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+    ok(hr == S_OK, "Got hr %#lx getting current input type.\n", hr);
+    if (hr == S_OK)
+    {
+        ok(((WAVEFORMATEX *)type.pbFormat)->nSamplesPerSec == 48000,
+                "Got current input rate %lu.\n", ((WAVEFORMATEX *)type.pbFormat)->nSamplesPerSec);
+        MoFreeMediaType(&type);
+    }
+    hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx before output type.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, DMO_SET_TYPEF_TEST_ONLY);
+    ok(hr == S_OK, "Got hr %#lx testing output type.\n", hr);
+    hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Output TEST_ONLY changed current type, hr %#lx.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting output type.\n", hr);
+    hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+    ok(hr == S_OK, "Got hr %#lx getting current output type.\n", hr);
+    if (hr == S_OK)
+        MoFreeMediaType(&type);
+    hr = IMediaObject_GetInputSizeInfo(dmo, 0, &size, &lookahead, &alignment);
+    ok(hr == S_OK && size == 8 && !lookahead && alignment == 1,
+            "Got typed input size info hr %#lx size %lu lookahead %lu alignment %lu.\n",
+            hr, size, lookahead, alignment);
+    hr = IMediaObject_GetOutputSizeInfo(dmo, 0, &size, &alignment);
+    ok(hr == S_OK && size == 8 && alignment == 1,
+            "Got typed output size info hr %#lx size %lu alignment %lu.\n", hr, size, alignment);
+
+    memset(&type, 0, sizeof(type));
+    memset(&type2, 0, sizeof(type2));
+    first_type_hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+    ok(first_type_hr == S_OK, "Got hr %#lx getting first type copy.\n", first_type_hr);
+    second_type_hr = IMediaObject_GetInputCurrentType(dmo, 0, &type2);
+    ok(second_type_hr == S_OK, "Got hr %#lx getting second type copy.\n", second_type_hr);
+    if (SUCCEEDED(first_type_hr) && SUCCEEDED(second_type_hr)
+            && type.pbFormat && type2.pbFormat)
+    {
+        ok(type.pbFormat != type2.pbFormat, "Current type copies share format metadata.\n");
+        ((WAVEFORMATEX *)type.pbFormat)->nSamplesPerSec = 12345;
+        ok(((WAVEFORMATEX *)type2.pbFormat)->nSamplesPerSec == 48000,
+                "Mutating one current type changed another copy.\n");
+    }
+    if (SUCCEEDED(first_type_hr))
+        MoFreeMediaType(&type);
+    if (SUCCEEDED(second_type_hr))
+        MoFreeMediaType(&type2);
+
+    hr = IMediaObject_SetOutputType(dmo, 0, NULL, DMO_SET_TYPEF_CLEAR);
+    ok(hr == S_OK, "Got hr %#lx clearing output type.\n", hr);
+    hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx after output type clear.\n", hr);
+    hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+    ok(hr == S_OK, "Input type was lost when output was cleared, hr %#lx.\n", hr);
+    if (hr == S_OK)
+        MoFreeMediaType(&type);
+    hr = IMediaObject_SetInputType(dmo, 0, NULL, DMO_SET_TYPEF_CLEAR);
+    ok(hr == S_OK, "Got hr %#lx clearing input type.\n", hr);
+    hr = IMediaObject_GetInputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx after input type clear.\n", hr);
+    hr = IMediaObject_GetOutputCurrentType(dmo, 0, &type);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx after input-cleared output type.\n", hr);
+
+    ref = IMediaObject_Release(dmo);
+    ok(!ref, "Got outstanding refcount %lu.\n", ref);
+}

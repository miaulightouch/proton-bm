+            effect->state.rate, effect->state.delay, effect->state.allpass, coeff)))
+        return hr;
+    effect->state.params_dirty = FALSE;
+    if (effect->state.integer)
+        return waves_reverb_process_integer(effect, size, data, flags, coeff);
+    return waves_reverb_process_float(effect, size, data, flags, coeff);

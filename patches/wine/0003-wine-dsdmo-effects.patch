+    {
+        {44100, 0, 1, {2, 0}, {0.5f, 0.0f}, 1, {168908, 0}, {0.5f, 0.0f}},
+        {44100, 5, 2, {222, 223}, {0.25f, 0.25f}, 2, {169128, 169129}, {0.25f, 0.25f}},
+        {48000, 0, 1, {2, 0}, {0.5f, 0.0f}, 1, {183845, 0}, {0.5f, 0.0f}},
+        {48000, 5, 1, {242, 0}, {0.5f, 0.0f}, 1, {184085, 0}, {0.5f, 0.0f}},
+        {96000, 0, 1, {2, 0}, {0.5f, 0.0f}, 1, {367685, 0}, {0.5f, 0.0f}},
+        {96000, 5, 1, {482, 0}, {0.5f, 0.0f}, 1, {368165, 0}, {0.5f, 0.0f}},
+    };
+    unsigned int case_index;
+    HRESULT hr;
+
+    for (case_index = 0; case_index < ARRAY_SIZE(cases); ++case_index)
+    {
+        const struct negative_delay_case *test_case = &cases[case_index];
+        const DWORD frame_count = test_case->rate * 4;
+        const SIZE_T bytes = (SIZE_T)frame_count * 2 * sizeof(float);
+        DSFXChorus target = {100.0f, 100.0f, 0.0f, 0.0f,
+                DSFXCHORUS_WAVE_SIN, 20.0f, DSFXCHORUS_PHASE_NEG_90};
+        DSFXChorus cached = {100.0f, 0.0f, 0.0f, 0.0f,
+                DSFXCHORUS_WAVE_SIN, (float)test_case->cached_delay,
+                DSFXCHORUS_PHASE_ZERO};
+        IMediaObject *dmo = NULL;
+        IDirectSoundFXChorus *chorus = NULL;
+        IMediaObjectInPlace *inplace = NULL;
+        float *data = NULL;
+
+        winetest_push_context("rate %lu cached delay %ld", test_case->rate,
+                test_case->cached_delay);
+        data = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, bytes);
+        ok(data != NULL, "Could not allocate %lu-frame Chorus history buffer.\n", frame_count);
+        if (!data)
+            goto next_case;
+        data[0] = data[1] = 0.5f;
+
+        hr = CoCreateInstance(&GUID_DSFX_STANDARD_CHORUS, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating negative-delay Chorus.\n", hr);
+        if (FAILED(hr))
+            goto cleanup;
+        hr = set_float_format(dmo, test_case->rate, 2);
+        ok(hr == S_OK, "Got hr %#lx setting negative-delay format.\n", hr);
+        if (FAILED(hr))
+            goto cleanup;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXChorus, (void **)&chorus);
+        ok(hr == S_OK, "Got hr %#lx querying negative-delay Chorus.\n", hr);
+        if (FAILED(hr))
+            goto cleanup;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying negative-delay in-place interface.\n", hr);
+        if (FAILED(hr))
+            goto cleanup;
+        hr = IDirectSoundFXChorus_SetAllParameters(chorus, &target);
+        ok(hr == S_OK, "Got hr %#lx setting negative-delay target.\n", hr);
+        if (SUCCEEDED(hr))
+            hr = IDirectSoundFXChorus_SetAllParameters(chorus, &cached);
+        ok(hr == S_OK, "Got hr %#lx setting negative-delay cached state.\n", hr);
+        if (SUCCEEDED(hr))
+            hr = set_float_format(dmo, test_case->rate, 2);
+        ok(hr == S_OK, "Got hr %#lx resetting negative-delay format.\n", hr);
+        if (SUCCEEDED(hr))
+            hr = IDirectSoundFXChorus_SetAllParameters(chorus, &target);
+        ok(hr == S_OK, "Got hr %#lx restoring negative-delay target.\n", hr);
+        if (SUCCEEDED(hr))
+            hr = IMediaObject_AllocateStreamingResources(dmo);
+        ok(hr == S_OK, "Got hr %#lx allocating negative-delay resources.\n", hr);
+        if (FAILED(hr))
+            goto cleanup;
+        hr = IMediaObjectInPlace_Process(inplace, (ULONG)bytes, (BYTE *)data, 0,
+                DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing negative-delay history.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            double expected_sum[2] = {0.0, 0.0};
+            double expected_weighted[2] = {0.0, 0.0};
+            double actual_sum[2] = {0.0, 0.0};
+            double actual_weighted[2] = {0.0, 0.0};
+            double max_error = 0.0;
+            unsigned int mismatch_count = 0;
+            BOOL nonfinite = FALSE;
+
+            for (unsigned int frame = 0; frame < frame_count; ++frame)
+            {
+                float expected[2] = {0.0f, 0.0f};
+                float actual[2] = {data[2 * frame], data[2 * frame + 1]};
+                unsigned int i;
+
+                for (i = 0; i < test_case->left_count; ++i)
+                    if (frame == test_case->left[i])
+                        expected[0] += test_case->left_amplitude[i];
+                for (i = 0; i < test_case->right_count; ++i)
+                    if (frame == test_case->right[i])
+                        expected[1] += test_case->right_amplitude[i];
+                for (i = 0; i < 2; ++i)
+                {
+                    double error;
+
+                    if (!isfinite(actual[i]))
+                    {
+                        nonfinite = TRUE;
+                        continue;
+                    }
+                    error = fabs(actual[i] - expected[i]);
+                    if (error > max_error)
+                        max_error = error;
+                    if (error > 1e-5)
+                        ++mismatch_count;
+                    actual_sum[i] += actual[i];
+                    actual_weighted[i] += frame * actual[i];
+                }
+            }
+            for (unsigned int channel = 0; channel < 2; ++channel)
+            {
+                unsigned int i;
+
+                for (i = 0; i < (channel ? test_case->right_count : test_case->left_count); ++i)
+                {
+                    unsigned int frame = channel ? test_case->right[i] : test_case->left[i];
+                    float amplitude = channel ? test_case->right_amplitude[i]
+                                              : test_case->left_amplitude[i];
+                    expected_sum[channel] += amplitude;
+                    expected_weighted[channel] += frame * amplitude;
+                }
+                ok(fabs(actual_sum[channel] - expected_sum[channel]) < 1e-4,
+                        "Rate %lu cached %ld channel %u energy %.8e expected %.8e.\n",
+                        test_case->rate, test_case->cached_delay, channel,
+                        actual_sum[channel], expected_sum[channel]);
+                ok(fabs(actual_sum[channel]) > 1e-12,
+                        "Rate %lu cached %ld channel %u has no output energy.\n",
+                        test_case->rate, test_case->cached_delay, channel);
+                if (fabs(actual_sum[channel]) > 1e-12)
+                    ok(fabs(actual_weighted[channel] / actual_sum[channel]
+                            - expected_weighted[channel] / expected_sum[channel]) < 0.05,
+                            "Rate %lu cached %ld channel %u center %.8e expected %.8e.\n",
+                            test_case->rate, test_case->cached_delay, channel,
+                            actual_weighted[channel] / actual_sum[channel],
+                            expected_weighted[channel] / expected_sum[channel]);
+            }
+            ok(!nonfinite, "Rate %lu cached %ld produced non-finite output.\n",
+                    test_case->rate, test_case->cached_delay);
+            ok(mismatch_count == 0,
+                    "Rate %lu cached %ld had %u unexpected samples, max error %.8e.\n",
+                    test_case->rate, test_case->cached_delay, mismatch_count, max_error);
+        }
+
+cleanup:
+        if (inplace)
+            IMediaObjectInPlace_Release(inplace);
+        if (chorus)
+            IDirectSoundFXChorus_Release(chorus);
+        if (dmo)
+            IMediaObject_Release(dmo);
+        if (data)
+            HeapFree(GetProcessHeap(), 0, data);
+next_case:
+        winetest_pop_context();
+    }
+}

+static void compressor_blackbox_fill_input(void *buffer, WORD format, WORD channels,
+        DWORD frames, BOOL impulse)
+{
+    DWORD state = 123456789, i;
+    DWORD sample_count = frames * channels;
+
+    memset(buffer, 0, sample_count * (format == WAVE_FORMAT_PCM ? sizeof(SHORT) : sizeof(float)));
+    if (impulse)
+    {
+        if (format == WAVE_FORMAT_PCM)
+            ((SHORT *)buffer)[0] = 8192;
+        else
+            ((float *)buffer)[0] = 0.25f;
+        return;
+    }
+
+    for (i = 0; i < sample_count; ++i)
+    {
+        SHORT sample;
+
+        state = state * 1664525u + 1013904223u;
+        sample = (SHORT)(((state >> 16) & 0x7fff) - 16384);
+        if (format == WAVE_FORMAT_PCM)
+            ((SHORT *)buffer)[i] = sample;
+        else
+            ((float *)buffer)[i] = (float)sample / 32768.0f;
+    }
+}

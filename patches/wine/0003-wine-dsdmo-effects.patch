+static void test_effect_process(const GUID *clsid)
+{
+    enum { frames = 1024, channels = 2 };
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    float input[frames * channels], one_shot[frames * channels], chunked[frames * channels];
+    IMediaObject *dmo;
+    IMediaObjectInPlace *inplace;
+    DWORD i;
+    BOOL nonzero = FALSE, changed = FALSE;
+    HRESULT hr;
+    ULONG ref;
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 44100, channels);
+    hr = CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating effect.\n", hr);
+    if (hr != S_OK)
+        return;
+    hr = IMediaObject_AllocateStreamingResources(dmo);
+    ok(hr == S_OK, "Got hr %#lx allocating before type negotiation.\n", hr);
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting input type.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting output type.\n", hr);
+    configure_effect_for_process(clsid, dmo);
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx querying in-place interface.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(input); ++i)
+        input[i] = 0.25f * sinf(i * 0.07f);
+    input[0] = 0.75f;
+    input[1] = -0.5f;
+    hr = IMediaObject_Flush(dmo);
+    ok(hr == S_OK, "Got hr %#lx initializing one-shot state.\n", hr);
+    memcpy(one_shot, input, sizeof(input));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(one_shot), (BYTE *)one_shot, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx processing one chunk.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(one_shot); ++i)
+    {
+        ok(isfinite(one_shot[i]), "Non-finite output at sample %lu.\n", i);
+        if (fabsf(one_shot[i]) > 1e-6f)
+            nonzero = TRUE;
+        if (fabsf(one_shot[i] - input[i]) > 1e-5f)
+            changed = TRUE;
+    }
+    ok(nonzero, "Effect produced only silence.\n");
+    ok(changed, "Effect did not process its input.\n");
+
+    hr = IMediaObject_Flush(dmo);
+    ok(hr == S_OK, "Got hr %#lx flushing effect.\n", hr);
+    memcpy(chunked, input, sizeof(input));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(float) * channels * (frames / 2),
+            (BYTE *)chunked, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx processing first chunk.\n", hr);
+    /* An unchanged parameter update must preserve the filter and delay history. */
+    configure_effect_for_process(clsid, dmo);
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(float) * channels * (frames / 2),
+            (BYTE *)chunked + sizeof(float) * channels * (frames / 2), 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx processing second chunk.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(one_shot); ++i)
+        ok(fabsf(one_shot[i] - chunked[i]) < 1e-5f,
+                "Chunked processing differs at sample %lu (%.8e / %.8e).\n", i, one_shot[i], chunked[i]);
+
+    memset(chunked, 0, sizeof(chunked));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(chunked), (BYTE *)chunked, 0, DMO_INPLACE_ZERO);
+    ok(hr == S_OK, "Got hr %#lx processing zero input.\n", hr);
+    hr = IMediaObject_FreeStreamingResources(dmo);
+    ok(hr == S_OK, "Got hr %#lx freeing effect resources.\n", hr);
+    hr = IMediaObject_Flush(dmo);
+    ok(hr == S_OK, "Got hr %#lx resetting the effect after Free.\n", hr);
+    memset(chunked, 0, sizeof(chunked));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(chunked), (BYTE *)chunked, 0, DMO_INPLACE_ZERO);
+    ok(hr == S_OK, "Got hr %#lx processing after resource free.\n", hr);
+    if (!IsEqualGUID(clsid, &GUID_DSFX_STANDARD_ECHO))
+        for (i = 0; i < ARRAY_SIZE(chunked); ++i)
+            ok(chunked[i] == 0.0f, "Stale output after Flush at sample %lu.\n", i);
+
+    ref = IMediaObjectInPlace_Release(inplace);
+    ok(ref != 0, "Got unexpected refcount %lu.\n", ref);
+    ref = IMediaObject_Release(dmo);
+    ok(!ref, "Got outstanding refcount %lu.\n", ref);
+}

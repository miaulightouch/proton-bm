+static void test_eq_rate_clamp(void)
+{
+    IDirectSoundFXParamEq *effect;
+    IMediaObject *dmo;
+    DSFXParamEq params;
+    HRESULT hr;
+    ULONG ref;
+
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_PARAMEQ, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating ParamEq DMO.\n", hr);
+    if (hr != S_OK)
+        return;
+    hr = set_float_format(dmo, 22050, 1);
+    ok(hr == S_OK, "Got hr %#lx setting ParamEq format.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXParamEq, (void **)&effect);
+    ok(hr == S_OK, "Got hr %#lx querying ParamEq parameters.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    hr = IDirectSoundFXParamEq_GetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx getting ParamEq parameters.\n", hr);
+    if (hr != S_OK)
+        goto done;
+    params.fCenter = 8000.0f;
+    hr = IDirectSoundFXParamEq_SetAllParameters(effect, &params);
+    ok(hr == S_FALSE, "Got hr %#lx for rate-clamped ParamEq center.\n", hr);
+    hr = IDirectSoundFXParamEq_GetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx reading clamped ParamEq parameters.\n", hr);
+    if (hr != S_OK)
+        goto done;
+    ok(fabsf(params.fCenter - 7350.0f) < 0.01f,
+            "Got center %.8e Hz after rate clamp.\n", params.fCenter);
+
+done:
+    ref = IDirectSoundFXParamEq_Release(effect);
+    ok(ref != 0, "Got unexpected ParamEq refcount %lu.\n", ref);
+    ref = IMediaObject_Release(dmo);
+    ok(!ref, "Got outstanding refcount %lu.\n", ref);
+}

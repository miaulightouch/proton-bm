+static void test_gargle_pcm_quantization(void)
+{
+    static const struct
+    {
+        unsigned int frame;
+        int pcm16, pcm8;
+    }
+    anchors[] =
+    {
+        {0, 0, 0}, {1, 5, 0}, {2, 11, 0}, {38, 220, 0}, {100, 580, 2},
+        {1411, 8189, 31}, {1412, 8189, 31}, {2823, 0, 0}, {2824, 0, 0}, {2825, 5, 0},
+    };
+    static const WORD depths[] = {8, 16};
+    enum { sample_count = 2826 };
+    unsigned int depth, negative, i;
+
+    for (depth = 0; depth < ARRAY_SIZE(depths); ++depth)
+    for (negative = 0; negative < 2; ++negative)
+    {
+        IMediaObject *dmo;
+        IDirectSoundFXGargle *effect;
+        IMediaObjectInPlace *inplace;
+        DSFXGargle params = {17, DSFXGARGLE_WAVE_TRIANGLE};
+        WAVEFORMATEX format;
+        DMO_MEDIA_TYPE type =
+        {
+            .majortype = MEDIATYPE_Audio,
+            .subtype = MEDIASUBTYPE_PCM,
+            .formattype = FORMAT_WaveFormatEx,
+            .cbFormat = sizeof(format),
+            .pbFormat = (BYTE *)&format,
+        };
+        union
+        {
+            BYTE pcm8[sample_count];
+            SHORT pcm16[sample_count];
+        } samples;
+        int sign = negative ? -1 : 1;
+        HRESULT hr;
+
+        winetest_push_context("%u-bit sign %d", depths[depth], sign);
+        if (!create_gargle_test_object(&dmo, &effect, &inplace))
+        {
+            winetest_pop_context();
+            continue;
+        }
+        build_pcm_format(&format, WAVE_FORMAT_PCM, depths[depth], 48000, 1);
+        hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+        ok(hr == S_OK, "Got hr %#lx setting PCM input.\n", hr);
+        hr = IMediaObject_SetOutputType(dmo, 0, &type, 0);
+        ok(hr == S_OK, "Got hr %#lx setting PCM output.\n", hr);
+        hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+        ok(hr == S_OK, "Got hr %#lx setting Gargle parameters.\n", hr);
+        for (i = 0; i < sample_count; ++i)
+        {
+            if (depths[depth] == 8)
+                samples.pcm8[i] = 128 + sign * 32;
+            else
+                samples.pcm16[i] = sign * 8192;
+        }
+        hr = IMediaObjectInPlace_Process(inplace, sample_count * format.nBlockAlign,
+                (BYTE *)&samples, 0, DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing PCM DC.\n", hr);
+        if (hr == S_OK)
+        {
+            for (i = 0; i < ARRAY_SIZE(anchors); ++i)
+            {
+                unsigned int frame = anchors[i].frame;
+                int got = depths[depth] == 8 ? samples.pcm8[frame] : samples.pcm16[frame];
+                int expected = depths[depth] == 8 ? 128 + sign * anchors[i].pcm8 : sign * anchors[i].pcm16;
+
+                ok(got == expected, "Sample %u: got %d, expected %d.\n", frame, got, expected);
+            }
+        }
+        release_gargle_test_object(dmo, effect, inplace);
+        winetest_pop_context();
+    }
+}

+        ok(hr == S_OK, "Got hr %#lx querying in-place interface.\n", hr);
+        if (FAILED(hr))
+            goto done;
+        if (test_case->chorus)
+        {
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXChorus,
+                    (void **)&chorus);
+            ok(hr == S_OK, "Got hr %#lx querying Chorus.\n", hr);
+            if (FAILED(hr))
+                goto done;
+            hr = IDirectSoundFXChorus_SetAllParameters(chorus, &test_case->params.chorus);
+        }
+        else
+        {
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXFlanger,
+                    (void **)&flanger);
+            ok(hr == S_OK, "Got hr %#lx querying Flanger.\n", hr);
+            if (FAILED(hr))
+                goto done;
+            hr = IDirectSoundFXFlanger_SetAllParameters(flanger, &test_case->params.flanger);
+        }
+        ok(hr == S_OK, "Got hr %#lx setting parameters.\n", hr);
+        if (FAILED(hr))
+            goto done;
+        hr = IMediaObject_AllocateStreamingResources(dmo);
+        ok(hr == S_OK, "Got hr %#lx allocating streaming resources.\n", hr);
+        if (FAILED(hr))
+            goto done;
+
+        memset(samples, 0, sizeof(samples));
+        samples[0] = 8192;
+        hr = IMediaObjectInPlace_Process(inplace, size, (BYTE *)samples, 0,
+                DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing the 4096-frame impulse.\n", hr);
+        if (FAILED(hr))
+            goto done;
+        for (i = 0; i < test_case->tap_count; ++i)
+        {
+            const struct mod_compact_tap *tap = &test_case->taps[i];
+            const SHORT *frame = samples + tap->frame * test_case->channels;
+            LONG delta = (LONG)frame[0] - tap->left;
+
+            if (delta < 0)
+                delta = -delta;
+            ok(delta <= 1, "frame %lu left: %d, expected %d.\n", tap->frame,
+                    frame[0], tap->left);
+            if (test_case->channels == 2)
+            {
+                delta = (LONG)frame[1] - tap->right;
+                if (delta < 0)
+                    delta = -delta;
+                ok(delta <= 1, "frame %lu right: %d, expected %d.\n", tap->frame,
+                        frame[1], tap->right);
+            }
+        }
+
+done:
+        if (flanger)
+            IDirectSoundFXFlanger_Release(flanger);
+        if (chorus)
+            IDirectSoundFXChorus_Release(chorus);
+        if (inplace)
+            IMediaObjectInPlace_Release(inplace);
+        if (dmo)
+            IMediaObject_Release(dmo);
+        winetest_pop_context();
+    }
+}

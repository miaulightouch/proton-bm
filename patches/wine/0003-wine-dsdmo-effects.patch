+static void test_distortion_compact_pcm16_endpoint(void)
+{
+    static const SHORT levels[] = {1, -1, 64, -64, 32767, -32768};
+    static const DWORD frames_to_check[] =
+            {23998, 23999, 24000, 24001, 29998, 29999, 30000, 30001};
+    static const SHORT expected[] = {-15586, -15586, -12640, -7751, 0, 0, 0, 0};
+    enum { frames = 30004 };
+    DSFXDistortion params = {-18.0f, 100.0f, 2400.0f, 2400.0f, 8000.0f};
+    IDirectSoundFXDistortion *effect = NULL;
+    IMediaObjectInPlace *inplace = NULL;
+    IMediaObject *dmo = NULL;
+    SHORT *samples = NULL;
+    unsigned int i;
+    HRESULT hr;
+
+    winetest_push_context("distortion-01320 PCM16 endpoint");
+    samples = HeapAlloc(GetProcessHeap(), 0, frames * sizeof(*samples));
+    ok(samples != NULL, "Could not allocate %u-frame endpoint buffer.\n", frames);
+    if (!samples)
+        goto endpoint_done;
+    for (i = 0; i < frames; ++i)
+        samples[i] = levels[i / 6000];
+
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_DISTORTION, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating endpoint DMO.\n", hr);
+    if (FAILED(hr))
+        goto endpoint_done;
+    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXDistortion, (void **)&effect);
+    ok(hr == S_OK, "Got hr %#lx querying endpoint parameters.\n", hr);
+    if (FAILED(hr))
+        goto endpoint_done;
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx querying endpoint in-place interface.\n", hr);
+    if (FAILED(hr))
+        goto endpoint_done;
+    hr = set_pcm16_format(dmo, 48000, 1);
+    ok(hr == S_OK, "Got hr %#lx setting endpoint format.\n", hr);
+    if (FAILED(hr))
+        goto endpoint_done;
+    hr = IDirectSoundFXDistortion_SetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx setting endpoint parameters.\n", hr);
+    if (FAILED(hr))
+        goto endpoint_done;
+    hr = IMediaObject_AllocateStreamingResources(dmo);
+    ok(hr == S_OK, "Got hr %#lx allocating endpoint resources.\n", hr);
+    if (FAILED(hr))
+        goto endpoint_done;
+    hr = IMediaObjectInPlace_Process(inplace, frames * sizeof(*samples), (BYTE *)samples, 0,
+            DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx processing endpoint.\n", hr);
+    if (SUCCEEDED(hr))
+        for (i = 0; i < ARRAY_SIZE(frames_to_check); ++i)
+        {
+            LONG delta = (LONG)samples[frames_to_check[i]] - expected[i];
+            if (delta < 0)
+                delta = -delta;
+            ok(delta <= 1, "frame %lu: %d, expected %d.\n", frames_to_check[i],
+                    samples[frames_to_check[i]], expected[i]);
+        }
+
+endpoint_done:
+    if (inplace)
+        IMediaObjectInPlace_Release(inplace);
+    if (effect)
+        IDirectSoundFXDistortion_Release(effect);
+    if (dmo)
+        IMediaObject_Release(dmo);
+    if (samples)
+        HeapFree(GetProcessHeap(), 0, samples);
+    winetest_pop_context();
+}

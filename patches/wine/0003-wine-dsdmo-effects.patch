+static void test_extensible_process_format(WORD tag, WORD depth, WORD channels)
+{
+    enum { frames = 8 };
+    WAVEFORMATEX legacy;
+    WAVEFORMATEXTENSIBLE extensible;
+    DMO_MEDIA_TYPE legacy_type =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = GUID_NULL,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(legacy),
+        .pbFormat = (BYTE *)&legacy,
+    };
+    DMO_MEDIA_TYPE extensible_type =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = GUID_NULL,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(extensible),
+        .pbFormat = (BYTE *)&extensible,
+    };
+    BYTE legacy_data[frames * 2 * sizeof(float)], extensible_data[sizeof(legacy_data)];
+    IMediaObject *legacy_dmo, *extensible_dmo;
+    IMediaObjectInPlace *legacy_inplace, *extensible_inplace;
+    const GUID *subtype = tag == WAVE_FORMAT_PCM ? &MEDIASUBTYPE_PCM : &MEDIASUBTYPE_IEEE_FLOAT;
+    DWORD size = frames * channels * depth / 8;
+    unsigned int i;
+    HRESULT hr, legacy_hr, extensible_hr;
+
+    build_pcm_format(&legacy, tag, depth, 44100, channels);
+    build_extensible_format(&extensible, tag, depth, 44100, channels);
+    legacy_type.subtype = *subtype;
+    extensible_type.subtype = *subtype;
+
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_PARAMEQ, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&legacy_dmo);
+    ok(hr == S_OK, "Got hr %#lx creating legacy DMO.\n", hr);
+    if (FAILED(hr))
+        return;
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_PARAMEQ, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&extensible_dmo);
+    ok(hr == S_OK, "Got hr %#lx creating extensible DMO.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(legacy_dmo);
+        return;
+    }
+
+    hr = IMediaObject_SetInputType(legacy_dmo, 0, &legacy_type, 0);
+    ok(hr == S_OK, "Got hr %#lx setting legacy input, depth %u, channels %u.\n", hr, depth, channels);
+    hr = IMediaObject_SetOutputType(legacy_dmo, 0, &extensible_type, DMO_SET_TYPEF_TEST_ONLY);
+    ok(hr == S_OK, "Got hr %#lx testing extensible output, depth %u, channels %u.\n", hr, depth, channels);
+    hr = IMediaObject_SetOutputType(legacy_dmo, 0, &extensible_type, 0);
+    ok(hr == S_OK, "Got hr %#lx setting extensible output, depth %u, channels %u.\n", hr, depth, channels);
+
+    hr = IMediaObject_SetInputType(extensible_dmo, 0, &extensible_type, 0);
+    ok(hr == S_OK, "Got hr %#lx setting extensible input, depth %u, channels %u.\n", hr, depth, channels);
+    hr = IMediaObject_SetOutputType(extensible_dmo, 0, &legacy_type, DMO_SET_TYPEF_TEST_ONLY);
+    ok(hr == S_OK, "Got hr %#lx testing legacy output, depth %u, channels %u.\n", hr, depth, channels);
+    hr = IMediaObject_SetOutputType(extensible_dmo, 0, &legacy_type, 0);
+    ok(hr == S_OK, "Got hr %#lx setting legacy output, depth %u, channels %u.\n", hr, depth, channels);
+
+    for (i = 0; i < size; ++i)
+        legacy_data[i] = (BYTE)(i * 29 + 7);
+    if (tag == WAVE_FORMAT_IEEE_FLOAT)
+    {
+        for (i = 0; i < size / sizeof(float); ++i)
+        {
+            float sample = ((int)(i % 7) - 3) * 0.1f;
+            memcpy(legacy_data + i * sizeof(sample), &sample, sizeof(sample));
+        }
+    }
+    memcpy(extensible_data, legacy_data, size);
+
+    hr = IMediaObject_QueryInterface(legacy_dmo, &IID_IMediaObjectInPlace, (void **)&legacy_inplace);
+    ok(hr == S_OK, "Got hr %#lx querying legacy in-place interface.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IMediaObject_QueryInterface(extensible_dmo, &IID_IMediaObjectInPlace,
+                (void **)&extensible_inplace);
+        ok(hr == S_OK, "Got hr %#lx querying extensible in-place interface.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            legacy_hr = IMediaObjectInPlace_Process(legacy_inplace, size, legacy_data, 0, DMO_INPLACE_NORMAL);
+            extensible_hr = IMediaObjectInPlace_Process(extensible_inplace, size, extensible_data, 0,
+                    DMO_INPLACE_NORMAL);
+            ok(legacy_hr == S_OK && extensible_hr == S_OK,
+                    "Got process results %#lx/%#lx, depth %u, channels %u.\n",
+                    legacy_hr, extensible_hr, depth, channels);
+            if (legacy_hr == S_OK && extensible_hr == S_OK)
+                ok(!memcmp(legacy_data, extensible_data, size),
+                        "Legacy and extensible output differs, depth %u, channels %u.\n", depth, channels);
+            IMediaObjectInPlace_Release(extensible_inplace);
+        }
+        IMediaObjectInPlace_Release(legacy_inplace);
+    }
+
+    IMediaObject_Release(extensible_dmo);
+    IMediaObject_Release(legacy_dmo);
+}

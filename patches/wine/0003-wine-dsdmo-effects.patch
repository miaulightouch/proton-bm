+/*
+ * Native-derived W1 checkpoints from the approved 12-quality-and-format
+ * cases (the source table is i3dl2-test-complete.c). Each value is sampled
+ * at frame 336 after processing one 48000-frame impulse. The table
+ * intentionally covers only the approved quality 0..2 cases.
+ */
+static void test_i3dl2_quality_checkpoints(void)
+{
+    static const struct i3dl2_checkpoint
+    {
+        LONG quality;
+        WORD format;
+        WORD channels;
+        float float_value[2];
+        SHORT pcm_value[2];
+    }
+    checkpoints[] =
+    {
+        {0, WAVE_FORMAT_IEEE_FLOAT, 1, {0.0006261314265429974f, 0.0f}, {0, 0}},
+        {0, WAVE_FORMAT_IEEE_FLOAT, 2, {0.0008881296962499619f, 0.0f}, {0, 0}},
+        {0, WAVE_FORMAT_PCM,        1, {0.0f, 0.0f}, {20, 0}},
+        {0, WAVE_FORMAT_PCM,        2, {0.0f, 0.0f}, {29, 0}},
+        {1, WAVE_FORMAT_IEEE_FLOAT, 1, {0.0003869705251418054f, 0.0f}, {0, 0}},
+        {1, WAVE_FORMAT_IEEE_FLOAT, 2, {0.0005488943425007164f, 0.0f}, {0, 0}},
+        {1, WAVE_FORMAT_PCM,        1, {0.0f, 0.0f}, {12, 0}},
+        {1, WAVE_FORMAT_PCM,        2, {0.0f, 0.0f}, {17, 0}},
+        {2, WAVE_FORMAT_IEEE_FLOAT, 1, {0.002008325420320034f, 0.0f}, {0, 0}},
+        {2, WAVE_FORMAT_IEEE_FLOAT, 2, {0.0014243442565202713f, 0.0f}, {0, 0}},
+        {2, WAVE_FORMAT_PCM,        1, {0.0f, 0.0f}, {32, 0}},
+        {2, WAVE_FORMAT_PCM,        2, {0.0f, 0.0f}, {46, 0}},
+    };
+    static const DSFXI3DL2Reverb baseline_params =
+    {
+        -1000, -100, 0.0f, 1.49f, 0.83f, -2602, 0.007f, 200, 0.011f,
+        100.0f, 100.0f, 5000.0f
+    };
+    IDirectSoundFXI3DL2Reverb *reverb = NULL;
+    IMediaObject *dmo = NULL;
+    IMediaObjectInPlace *inplace = NULL;
+    LONG active_quality = -1;
+    BOOL resources = FALSE;
+    HRESULT hr;
+    ULONG ref;
+    unsigned int i;
+
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_I3DL2REVERB, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating I3DL2 DMO.\n", hr);
+    if (FAILED(hr))
+        return;
+
+    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXI3DL2Reverb,
+            (void **)&reverb);
+    ok(hr == S_OK, "Got hr %#lx querying I3DL2 parameters.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace,
+            (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx querying in-place interface.\n", hr);
+    if (FAILED(hr))
+    {
+        IDirectSoundFXI3DL2Reverb_Release(reverb);
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    /* Keep the object alive across type changes; rows are ordered F32 mono,
+     * F32 stereo, PCM mono, PCM stereo per quality. */
+    for (i = 0; i < ARRAY_SIZE(checkpoints); ++i)
+    {
+        const struct i3dl2_checkpoint *checkpoint = &checkpoints[i];
+        WAVEFORMATEX wfx;
+        DMO_MEDIA_TYPE mt =
+        {
+            .majortype = MEDIATYPE_Audio,
+            .subtype = checkpoint->format == WAVE_FORMAT_PCM
+                    ? MEDIASUBTYPE_PCM : MEDIASUBTYPE_IEEE_FLOAT,
+            .formattype = FORMAT_WaveFormatEx,
+            .cbFormat = sizeof(wfx),
+            .pbFormat = (BYTE *)&wfx,
+        };
+        BYTE *data = NULL;
+        DWORD block_align, byte_count, offset;
+        BOOL case_failed = FALSE;
+        unsigned int channel;
+
+        winetest_push_context("quality %ld, format %u, channels %u", checkpoint->quality,
+                checkpoint->format, checkpoint->channels);
+
+        do
+        {
+            if (checkpoint->quality != active_quality)
+            {
+                hr = IDirectSoundFXI3DL2Reverb_SetAllParameters(reverb, &baseline_params);
+                ok(hr == S_OK, "Got hr %#lx setting baseline parameters.\n", hr);
+                if (FAILED(hr))
+                {
+                    case_failed = TRUE;
+                    break;
+                }
+                hr = IDirectSoundFXI3DL2Reverb_SetQuality(reverb, checkpoint->quality);
+                ok(hr == S_OK, "Got hr %#lx setting quality %ld.\n", hr, checkpoint->quality);
+                if (FAILED(hr))
+                {
+                    case_failed = TRUE;
+                    break;
+                }
+                active_quality = checkpoint->quality;
+            }
+
+            build_pcm_format(&wfx, checkpoint->format,
+                    checkpoint->format == WAVE_FORMAT_PCM ? 16 : 32, 48000,
+                    checkpoint->channels);
+            mt.bFixedSizeSamples = TRUE;
+            mt.lSampleSize = wfx.nBlockAlign;
+
+            hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+            ok(hr == S_OK, "Got hr %#lx setting input type.\n", hr);
+            if (FAILED(hr))
+            {
+                case_failed = TRUE;
+                break;
+            }
+            hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+            ok(hr == S_OK, "Got hr %#lx setting output type.\n", hr);
+            if (FAILED(hr))
+            {
+                case_failed = TRUE;
+                break;
+            }
+
+            hr = IMediaObject_AllocateStreamingResources(dmo);
+            ok(hr == S_OK, "Got hr %#lx allocating streaming resources.\n", hr);
+            if (FAILED(hr))
+            {
+                case_failed = TRUE;
+                break;
+            }
+            resources = TRUE;
+
+            block_align = wfx.nBlockAlign;
+            byte_count = 48000 * block_align;
+            data = calloc(1, byte_count);
+            ok(data != NULL, "Failed to allocate %lu-byte checkpoint buffer.\n", byte_count);
+            if (!data)
+            {
+                case_failed = TRUE;
+                break;
+            }
+            if (checkpoint->format == WAVE_FORMAT_PCM)
+            {
+                SHORT impulse = 8192;
+                memcpy(data, &impulse, sizeof(impulse));
+            }
+            else
+            {
+                float impulse = 0.25f;
+                memcpy(data, &impulse, sizeof(impulse));
+            }
+
+            hr = IMediaObjectInPlace_Process(inplace, byte_count, data, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing checkpoint impulse.\n", hr);
+            if (FAILED(hr))
+            {
+                case_failed = TRUE;
+                break;
+            }
+
+            offset = 336 * block_align;
+            for (channel = 0; channel < checkpoint->channels; ++channel)
+            {
+                if (checkpoint->format == WAVE_FORMAT_PCM)
+                {
+                    SHORT actual;
+                    int difference;
+
+                    memcpy(&actual, data + offset + channel * sizeof(actual), sizeof(actual));
+                    difference = (int)actual - checkpoint->pcm_value[channel];
+                    ok(difference >= -1 && difference <= 1,
+                            "PCM16 frame 336 channel %u: got %d, expected %d.\n", channel,
+                            actual, checkpoint->pcm_value[channel]);
+                }
+                else
+                {
+                    float actual;
+
+                    memcpy(&actual, data + offset + channel * sizeof(actual), sizeof(actual));
+                    ok(fabsf(actual - checkpoint->float_value[channel]) <= 2e-6f,
+                            "FLOAT32 frame 336 channel %u: got %.9e, expected %.9e.\n", channel,
+                            actual, checkpoint->float_value[channel]);
+                }
+            }
+        }
+        while (0);
+
+        free(data);
+        winetest_pop_context();
+        if (case_failed)
+            break;
+    }
+
+    if (resources)
+    {
+        hr = IMediaObject_FreeStreamingResources(dmo);
+        ok(hr == S_OK, "Got hr %#lx freeing streaming resources.\n", hr);
+    }
+    ref = IMediaObjectInPlace_Release(inplace);
+    ok(ref != 0, "Got unexpected in-place refcount %lu.\n", ref);
+    ref = IDirectSoundFXI3DL2Reverb_Release(reverb);
+    ok(ref != 0, "Got unexpected I3DL2 refcount %lu.\n", ref);
+    ref = IMediaObject_Release(dmo);
+    ok(!ref, "Got outstanding I3DL2 DMO refcount %lu.\n", ref);
+}
+
+static HRESULT set_pcm16_format(IMediaObject *dmo, DWORD sample_rate, WORD channels);
+
+static HRESULT check_i3dl2_checkpoint(IMediaObjectInPlace *inplace, BYTE *data,
+        DWORD frames, DWORD block_align, DWORD chunk, WORD format,
+        float expected_float, SHORT expected_pcm, const char *phase)
+{
+    DWORD offset = 0, count, checkpoint_offset = 336 * block_align;
+    HRESULT hr;
+
+    memset(data, 0, frames * block_align);
+    if (format == WAVE_FORMAT_PCM)
+    {
+        SHORT impulse = 8192;
+        memcpy(data, &impulse, sizeof(impulse));
+    }
+    else
+    {
+        float impulse = 0.25f;
+        memcpy(data, &impulse, sizeof(impulse));
+    }
+
+    while (offset < frames)
+    {
+        count = chunk < frames - offset ? chunk : frames - offset;
+        hr = IMediaObjectInPlace_Process(inplace, count * block_align,
+                data + offset * block_align, 0, DMO_INPLACE_NORMAL);
+        if (FAILED(hr))
+            return hr;
+        offset += count;
+    }
+
+    if (format == WAVE_FORMAT_PCM)
+    {
+        SHORT actual[2];
+
+        memcpy(actual, data + checkpoint_offset, sizeof(actual));
+        ok(actual[0] >= expected_pcm - 1 && actual[0] <= expected_pcm + 1,
+                "%s PCM16 frame 336: got %d, expected %d.\n", phase,
+                actual[0], expected_pcm);
+        ok(actual[1] >= -1 && actual[1] <= 1,
+                "%s PCM16 right frame 336: got %d.\n", phase, actual[1]);
+    }
+    else
+    {
+        float actual[2];
+
+        memcpy(actual, data + checkpoint_offset, sizeof(actual));
+        ok(fabsf(actual[0] - expected_float) <= 2e-6f,
+                "%s FLOAT32 frame 336: got %.9e, expected %.9e.\n", phase,
+                actual[0], expected_float);
+        ok(fabsf(actual[1]) <= 2e-6f,
+                "%s FLOAT32 right frame 336: got %.9e.\n", phase, actual[1]);
+    }
+    return S_OK;
+}

+    hr = IDirectSoundFXWavesReverb_GetAllParameters(reverb, &params);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        IDirectSoundFXWavesReverb_Release(reverb);
+        return;
+    }
+    ok(params.fInGain == DSFX_WAVESREVERB_INGAIN_DEFAULT, "Got input gain %.8e dB.\n", params.fInGain);
+    ok(params.fReverbMix == DSFX_WAVESREVERB_REVERBMIX_DEFAULT, "Got reverb mix %.8e dB.\n", params.fReverbMix);
+    ok(params.fReverbTime == DSFX_WAVESREVERB_REVERBTIME_DEFAULT, "Got reverb time %.8e ms.\n", params.fReverbTime);
+    ok(params.fHighFreqRTRatio == DSFX_WAVESREVERB_HIGHFREQRTRATIO_DEFAULT,
+            "Got high-frequency ratio %.8e.\n", params.fHighFreqRTRatio);
+
+    params.fReverbMix = 1.0f;
+    hr = IDirectSoundFXWavesReverb_SetAllParameters(reverb, &params);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    params.fInGain = NAN;
+    hr = IDirectSoundFXWavesReverb_SetAllParameters(reverb, &params);
+    ok(hr == E_INVALIDARG, "Got hr %#lx for NaN.\n", hr);
+    params.fInGain = INFINITY;
+    hr = IDirectSoundFXWavesReverb_SetAllParameters(reverb, &params);
+    ok(hr == E_INVALIDARG, "Got hr %#lx for infinity.\n", hr);
+
+    ref = IDirectSoundFXWavesReverb_Release(reverb);
+    ok(!ref, "Got outstanding refcount %ld.\n", ref);
+}

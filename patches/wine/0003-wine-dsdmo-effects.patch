+static void i3dl2_state_release(struct i3dl2_state *state)
+{
+    unsigned int side, branch, stage;
+
+    for (side = 0; side < 2; ++side)
+    {
+        free(state->filtered[side]);
+        free(state->early_ap[side].q);
+        free(state->long_q[side]);
+    }
+    for (branch = 0; branch < 2; ++branch)
+        for (stage = 0; stage < 6; ++stage)
+            free(state->stage[branch][stage].q);
+    memset(state, 0, sizeof(*state));
+}
+
+static void i3dl2_state_reset(struct i3dl2_state *state)
+{
+    unsigned int side, branch, stage;
+
+    for (side = 0; side < 2; ++side)
+    {
+        if (state->filtered[side])
+            memset(state->filtered[side], 0, state->filtered_length * sizeof(float));
+        if (state->early_ap[side].q)
+            memset(state->early_ap[side].q, 0,
+                    state->early_ap[side].capacity * sizeof(float));
+        state->early_ap[side].p = 0.0f;
+        if (state->long_q[side])
+            memset(state->long_q[side], 0, state->long_length * sizeof(float));
+        state->long_p[side] = 0.0f;
+    }
+    for (branch = 0; branch < 2; ++branch)
+        for (stage = 0; stage < 6; ++stage)
+        {
+            if (state->stage[branch][stage].q)
+                memset(state->stage[branch][stage].q, 0,
+                        state->stage[branch][stage].capacity * sizeof(float));
+            state->stage[branch][stage].p = 0.0f;
+        }
+    memset(state->feedback, 0, sizeof(state->feedback));
+    memset(state->filtered_previous, 0, sizeof(state->filtered_previous));
+    memset(state->half_current, 0, sizeof(state->half_current));
+    memset(state->half_previous, 0, sizeof(state->half_previous));
+    state->position = 0;
+    state->frame_position = 0;
+}
+
+static BOOL i3dl2_supported(const WAVEFORMATEX *format, LONG quality)
+{
+    return format->nSamplesPerSec == 48000 && quality >= 0 && quality <= 3
+            && ((format->wFormatTag == WAVE_FORMAT_PCM && format->wBitsPerSample == 16)
+            || (format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT && format->wBitsPerSample == 32))
+            && (format->nChannels == 1 || format->nChannels == 2);
+}
+
+static HRESULT i3dl2_state_prepare(struct i3dl2_state *state,
+        const DSFXI3DL2Reverb *params, const WAVEFORMATEX *format, LONG quality)
+{
+    static const float left_ratio[5] = {0.0f, 0.1768f, 0.3953f, 0.6899f, 0.94f};
+    static const float right_ratio[5] = {0.1078f, 0.2727f, 0.5386f, 0.8306f, 0.98f};
+    static const unsigned int exponent[6] = {15, 10, 6, 3, 1, 0};
+    static const float left_capacity[6] = {22, 32, 43, 53, 62, 67};
+    static const float right_capacity[6] = {25, 36, 48, 60, 69, 75};
+    float tau, h, g, density, left_ms, right_ms, t_reflections, t_reverb;
+    float room_reverb, energy[2], tap_power[2];
+    float value, feedback_energy;
+    double late_amp, mono_factor_d;
+    double high_gain, omega, pole, normal;
+    size_t max_delay, long_nominal;
+    unsigned int side, stage, i;
+    HRESULT hr = E_OUTOFMEMORY;
+
+    if (!i3dl2_supported(format, quality))
+        return DMO_E_TYPE_NOT_ACCEPTED;
+    i3dl2_state_release(state);
+    state->channels = format->nChannels;
+    state->input_rate = format->nSamplesPerSec;
+    state->rate = quality < 2 ? format->nSamplesPerSec / 2 : format->nSamplesPerSec;
+    state->quality = quality;
+    state->format = format->wFormatTag;
+    state->depth = format->wBitsPerSample;
+
+    tau = i3dl2_fmul(1000.0f, params->flDecayTime);
+    h = i3dl2_fdiv(i3dl2_fmul(10.0f, params->flDecayHFRatio), 10.0f);
+    g = i3dl2_fmul(i3dl2_fdiv(params->flDiffusion, 100.0f), 0.618034f);
+    high_gain = pow(10.0, (double)params->lRoomHF / 1000.0);
+    omega = 2.0 * I3DL2_PI * params->flHFReference / state->rate;
+    if (high_gain == 1.0)
+        pole = 0.0;
+    else
+        pole = (high_gain * cos(omega) - 1.0
+                + sqrt(2.0 * high_gain * (1.0 - cos(omega))
+                - high_gain * high_gain * (1.0 - cos(omega) * cos(omega))))
+                / (high_gain - 1.0);
+    if (pole < 0.0)
+        pole = 0.0;
+    if (pole > 1.0)
+        pole = 1.0;
+    state->pole = i3dl2_r32((float)pole);
+
+    t_reflections = i3dl2_fmul(1000.0f, params->flReflectionsDelay);
+    t_reverb = i3dl2_fmul(1000.0f, params->flReverbDelay);
+    if (t_reverb < 5.0f)
+        t_reverb = 5.0f;
+    max_delay = 0;
+    for (side = 0; side < 2; ++side)
+    {
+        const float *ratios = side ? right_ratio : left_ratio;
+
+        for (i = 0; i < 5; ++i)
+        {
+            value = i3dl2_fadd(t_reflections, i3dl2_fmul(ratios[i], t_reverb));
+            state->early_delay[side][i] = i3dl2_ms_to_samples(value, state->rate);
+            if (state->early_delay[side][i] > max_delay)
+                max_delay = state->early_delay[side][i];
+        }
+    }
+    state->late_delay[0] = i3dl2_ms_to_samples(i3dl2_fadd(i3dl2_fadd(t_reflections, t_reverb), 7.0f),
+            state->rate);
+    state->late_delay[1] = i3dl2_ms_to_samples(i3dl2_fadd(t_reflections, t_reverb),
+            state->rate);
+    if (state->late_delay[0] > max_delay)
+        max_delay = state->late_delay[0];
+    if (state->late_delay[1] > max_delay)
+        max_delay = state->late_delay[1];
+    if (max_delay >= I3DL2_MAX_DELAY)
+        return E_OUTOFMEMORY;
+    state->filtered_length = max_delay + 1;
+    state->filtered[0] = calloc(state->filtered_length, sizeof(float));
+    state->filtered[1] = calloc(state->filtered_length, sizeof(float));
+    if (!state->filtered[0] || !state->filtered[1])
+        goto oom;
+
+    if (quality == 1 || quality == 3)
+    {
+        for (side = 0; side < 2; ++side)
+        {
+            float nominal_ms = side ? 3.53f : 3.25f;
+            size_t nominal = i3dl2_ms_to_samples(nominal_ms, state->rate);
+            size_t capacity = i3dl2_ms_to_samples(3.0f, state->rate);
+
+            if (!capacity || !nominal)
+                goto oom;
+            state->early_ap[side].capacity = capacity;
+            state->early_ap[side].delay = 1 + (nominal - 1) % capacity;
+            state->early_ap[side].c = 1.0f;
+            state->early_ap[side].b = 0.0f;
+            state->early_ap[side].g = i3dl2_r32(0.618034f);
+            state->early_ap[side].q = calloc(capacity, sizeof(float));
+            if (!state->early_ap[side].q)

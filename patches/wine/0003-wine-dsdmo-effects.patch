+static void free_filters(DSFilter *filters, DWORD count)
+{
+    DWORD i;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (filters[i].obj) IMediaObject_Release(filters[i].obj);
+        if (filters[i].inplace) IMediaObjectInPlace_Release(filters[i].inplace);
+    }
+    free(filters);

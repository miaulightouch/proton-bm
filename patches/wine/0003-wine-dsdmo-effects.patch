+        .cbFormat = sizeof(format),
+        .pbFormat = (BYTE *)&format,
+    };
+    SHORT samples[sample_count];
+    HRESULT hr;
+
+    /* WindowsA Gargle case 018: phase 1764 (P=2400), input -1200 -> -636;
+     * the old float path produced -635. */
+    if (!create_gargle_test_object(&dmo, &effect, &inplace))
+        return;
+

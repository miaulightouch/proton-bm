+static void test_clone_parameters_and_metadata(void)
+{
+    WAVEFORMATEX wfx, changed_wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    DMO_MEDIA_TYPE source_type, clone_type;
+    DSFXGargle source_params, clone_params;
+    IDirectSoundFXGargle *source_effect, *clone_effect = NULL;
+    IMediaObjectInPlace *source_inplace, *clone_inplace;
+    IMediaObject *source_dmo, *clone_dmo = NULL;
+    HRESULT hr, source_hr;
+    ULONG ref;
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 48000, 1);
+    build_pcm_format(&changed_wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 44100, 1);
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_GARGLE, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&source_dmo);
+    ok(hr == S_OK, "Got hr %#lx creating clone source.\n", hr);
+    if (FAILED(hr))
+        return;
+    hr = IMediaObject_SetInputType(source_dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting source input type.\n", hr);
+    hr = IMediaObject_SetOutputType(source_dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx setting source output type.\n", hr);
+    hr = IMediaObject_QueryInterface(source_dmo, &IID_IDirectSoundFXGargle,
+            (void **)&source_effect);
+    ok(hr == S_OK, "Got hr %#lx querying source parameters.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(source_dmo);
+        return;
+    }
+    source_params.dwRateHz = 1000;
+    source_params.dwWaveShape = DSFXGARGLE_WAVE_SQUARE;
+    hr = IDirectSoundFXGargle_SetAllParameters(source_effect, &source_params);
+    ok(hr == S_OK, "Got hr %#lx setting source parameters.\n", hr);
+    hr = IMediaObject_QueryInterface(source_dmo, &IID_IMediaObjectInPlace,
+            (void **)&source_inplace);
+    ok(hr == S_OK, "Got hr %#lx querying source in-place.\n", hr);
+    if (FAILED(hr))
+    {
+        IDirectSoundFXGargle_Release(source_effect);
+        IMediaObject_Release(source_dmo);
+        return;
+    }
+
+    hr = IMediaObjectInPlace_Clone(source_inplace, NULL);
+    ok(hr == E_POINTER, "Got hr %#lx cloning to a NULL output.\n", hr);
+    clone_inplace = NULL;
+    hr = IMediaObjectInPlace_Clone(source_inplace, &clone_inplace);
+    ok(hr == S_OK, "Got hr %#lx cloning Gargle.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObjectInPlace_Release(source_inplace);
+        IDirectSoundFXGargle_Release(source_effect);
+        IMediaObject_Release(source_dmo);
+        return;
+    }
+    hr = IMediaObjectInPlace_QueryInterface(clone_inplace, &IID_IMediaObject,
+            (void **)&clone_dmo);
+    ok(hr == S_OK, "Got hr %#lx querying clone DMO.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObjectInPlace_Release(clone_inplace);
+        IMediaObjectInPlace_Release(source_inplace);
+        IDirectSoundFXGargle_Release(source_effect);
+        IMediaObject_Release(source_dmo);
+        return;
+    }
+    hr = IMediaObjectInPlace_QueryInterface(clone_inplace, &IID_IDirectSoundFXGargle,
+            (void **)&clone_effect);
+    ok(hr == S_OK, "Got hr %#lx querying clone parameters.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(clone_dmo);
+        IMediaObjectInPlace_Release(clone_inplace);
+        IMediaObjectInPlace_Release(source_inplace);
+        IDirectSoundFXGargle_Release(source_effect);
+        IMediaObject_Release(source_dmo);
+        return;
+    }
+    ref = get_refcount((IUnknown *)clone_inplace);
+    ok(ref >= 3, "Got unexpected clone refcount %lu.\n", ref);
+
+    hr = IDirectSoundFXGargle_GetAllParameters(source_effect, &source_params);
+    ok(hr == S_OK, "Got hr %#lx reading source parameters.\n", hr);
+    hr = IDirectSoundFXGargle_GetAllParameters(clone_effect, &clone_params);
+    ok(hr == S_OK, "Got hr %#lx reading clone parameters.\n", hr);
+    ok(clone_params.dwRateHz == 1000 && clone_params.dwWaveShape == DSFXGARGLE_WAVE_SQUARE,
+            "Clone did not copy nondefault parameters %lu/%lu.\n",
+            clone_params.dwRateHz, clone_params.dwWaveShape);
+
+    memset(&source_type, 0, sizeof(source_type));
+    memset(&clone_type, 0, sizeof(clone_type));
+    source_hr = IMediaObject_GetInputCurrentType(source_dmo, 0, &source_type);
+    ok(source_hr == S_OK, "Got hr %#lx reading source current type.\n", source_hr);
+    hr = IMediaObject_GetInputCurrentType(clone_dmo, 0, &clone_type);
+    ok(hr == S_OK, "Got hr %#lx reading clone current type.\n", hr);
+    if (SUCCEEDED(source_hr) && SUCCEEDED(hr))
+    {
+        ok(source_type.pbFormat != clone_type.pbFormat,
+                "Clone shares current type format metadata.\n");
+        ok(((WAVEFORMATEX *)clone_type.pbFormat)->nSamplesPerSec == 48000,
+                "Clone current type has rate %lu.\n", ((WAVEFORMATEX *)clone_type.pbFormat)->nSamplesPerSec);
+        ((WAVEFORMATEX *)source_type.pbFormat)->nSamplesPerSec = 12345;
+        ok(((WAVEFORMATEX *)clone_type.pbFormat)->nSamplesPerSec == 48000,
+                "Mutating source type copy changed clone type copy.\n");
+    }
+    MoFreeMediaType(&source_type);
+    MoFreeMediaType(&clone_type);
+
+    source_params.dwRateHz = 500;
+    source_params.dwWaveShape = DSFXGARGLE_WAVE_TRIANGLE;
+    hr = IDirectSoundFXGargle_SetAllParameters(source_effect, &source_params);
+    ok(hr == S_OK, "Got hr %#lx changing source parameters.\n", hr);
+    hr = IDirectSoundFXGargle_GetAllParameters(clone_effect, &clone_params);
+    ok(hr == S_OK, "Got hr %#lx rereading clone parameters.\n", hr);
+    ok(clone_params.dwRateHz == 1000 && clone_params.dwWaveShape == DSFXGARGLE_WAVE_SQUARE,
+            "Changing source parameters changed clone parameters.\n");
+
+    mt.pbFormat = (BYTE *)&changed_wfx;
+    hr = IMediaObject_SetInputType(source_dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx changing source media type.\n", hr);
+    memset(&clone_type, 0, sizeof(clone_type));
+    hr = IMediaObject_GetInputCurrentType(clone_dmo, 0, &clone_type);
+    ok(hr == S_OK, "Got hr %#lx reading clone type after source type change.\n", hr);
+    if (hr == S_OK)
+    {
+        ok(((WAVEFORMATEX *)clone_type.pbFormat)->nSamplesPerSec == 48000,
+                "Changing source media type changed clone rate %lu.\n",
+                ((WAVEFORMATEX *)clone_type.pbFormat)->nSamplesPerSec);
+        MoFreeMediaType(&clone_type);
+    }
+
+    ref = IDirectSoundFXGargle_Release(source_effect);
+    ok(ref != 0, "Got unexpected source parameter refcount %lu.\n", ref);
+    ref = IMediaObject_Release(source_dmo);
+    ok(ref != 0, "Got unexpected source DMO refcount %lu.\n", ref);
+    ref = IMediaObjectInPlace_Release(source_inplace);
+    ok(!ref, "Got outstanding source refcount %lu.\n", ref);
+
+    hr = IDirectSoundFXGargle_GetAllParameters(clone_effect, &clone_params);
+    ok(hr == S_OK && clone_params.dwRateHz == 1000,
+            "Clone did not outlive source, hr %#lx rate %lu.\n", hr, clone_params.dwRateHz);
+    ref = IDirectSoundFXGargle_Release(clone_effect);
+    ok(ref != 0, "Got unexpected clone parameter refcount %lu.\n", ref);
+    ref = IMediaObject_Release(clone_dmo);
+    ok(ref != 0, "Got unexpected clone DMO refcount %lu.\n", ref);
+    ref = IMediaObjectInPlace_Release(clone_inplace);
+    ok(!ref, "Got outstanding clone refcount %lu.\n", ref);
+}
+
+static void test_clone_history(void)
+{
+    IMediaObject *source_dmo;
+    IMediaObjectInPlace *source_inplace, *clone_inplace;
+    IDirectSoundFXGargle *gargle;
+    DSFXGargle gargle_params = {1000, DSFXGARGLE_WAVE_TRIANGLE};
+    float gargle_prime = 1.0f, gargle_clone_data[2] = {1.0f, 1.0f};
+    IMediaObject *echo_dmo;
+    IMediaObjectInPlace *echo_inplace;
+    IDirectSoundFXEcho *echo = NULL;
+    DSFXEcho echo_params = {100.0f, 0.0f, 1.0f, 1.0f, FALSE};
+    float echo_prime[128] = {0}, echo_clone_data[128] = {0};
+    HRESULT hr;
+    ULONG ref;
+    unsigned int i;
+
+    if (create_gargle_test_object(&source_dmo, &gargle, &source_inplace))
+    {
+        hr = IDirectSoundFXGargle_SetAllParameters(gargle, &gargle_params);
+        ok(hr == S_OK, "Got hr %#lx setting Gargle clone parameters.\n", hr);
+        hr = IMediaObjectInPlace_Process(source_inplace, sizeof(gargle_prime),
+                (BYTE *)&gargle_prime, 0, DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx priming Gargle before clone.\n", hr);
+        clone_inplace = NULL;
+        hr = IMediaObjectInPlace_Clone(source_inplace, &clone_inplace);
+        ok(hr == S_OK, "Got hr %#lx cloning primed Gargle.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IMediaObjectInPlace_Process(clone_inplace, sizeof(gargle_clone_data),
+                    (BYTE *)gargle_clone_data, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing cloned Gargle.\n", hr);
+            ok(fabsf(gargle_clone_data[0]) < 1e-6f,
+                    "Cloned Gargle retained source phase at sample 0: %.8e.\n",
+                    gargle_clone_data[0]);
+            ok(fabsf(gargle_clone_data[1] - 2.0f / 48.0f) < 1e-6f,
+                    "Cloned Gargle phase sample 1 %.8e, expected %.8e.\n",
+                    gargle_clone_data[1], 2.0f / 48.0f);
+            ref = IMediaObjectInPlace_Release(clone_inplace);
+            ok(!ref, "Got outstanding cloned Gargle refcount %lu.\n", ref);
+        }
+        release_gargle_test_object(source_dmo, gargle, source_inplace);
+    }
+
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_ECHO, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&echo_dmo);
+    ok(hr == S_OK, "Got hr %#lx creating Echo clone source.\n", hr);
+    if (FAILED(hr))
+        return;
+    hr = set_float_format(echo_dmo, 48000, 1);
+    ok(hr == S_OK, "Got hr %#lx setting Echo clone format.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(echo_dmo);
+        return;
+    }
+    hr = IMediaObject_QueryInterface(echo_dmo, &IID_IDirectSoundFXEcho, (void **)&echo);
+    ok(hr == S_OK, "Got hr %#lx querying Echo clone parameters.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(echo_dmo);
+        return;
+    }
+    echo_inplace = NULL;
+    hr = IMediaObject_QueryInterface(echo_dmo, &IID_IMediaObjectInPlace,
+            (void **)&echo_inplace);
+    ok(hr == S_OK, "Got hr %#lx querying Echo clone in-place.\n", hr);
+    if (FAILED(hr))
+    {
+        IDirectSoundFXEcho_Release(echo);
+        IMediaObject_Release(echo_dmo);
+        return;
+    }
+    hr = IDirectSoundFXEcho_SetAllParameters(echo, &echo_params);
+    ok(hr == S_OK, "Got hr %#lx setting Echo clone parameters.\n", hr);
+    echo_prime[0] = 0.5f;
+    hr = IMediaObjectInPlace_Process(echo_inplace, sizeof(echo_prime),
+            (BYTE *)echo_prime, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx priming Echo before clone.\n", hr);
+    echo_clone_data[0] = 0.0f;
+    clone_inplace = NULL;
+    hr = IMediaObjectInPlace_Clone(echo_inplace, &clone_inplace);
+    ok(hr == S_OK, "Got hr %#lx cloning primed Echo.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IMediaObjectInPlace_Process(clone_inplace, sizeof(echo_clone_data),
+                (BYTE *)echo_clone_data, 0, DMO_INPLACE_ZERO);
+        ok(hr == S_OK, "Got hr %#lx processing cloned Echo.\n", hr);
+        for (i = 0; i < ARRAY_SIZE(echo_clone_data); ++i)
+            ok(fabsf(echo_clone_data[i]) < 1e-7f,
+                    "Cloned Echo retained source history at sample %u: %.8e.\n",
+                    i, echo_clone_data[i]);
+        ref = IMediaObjectInPlace_Release(clone_inplace);
+        ok(!ref, "Got outstanding cloned Echo refcount %lu.\n", ref);
+    }
+    ref = IMediaObjectInPlace_Release(echo_inplace);
+    ok(ref != 0, "Got unexpected Echo in-place refcount %lu.\n", ref);
+    ref = IDirectSoundFXEcho_Release(echo);
+    ok(ref != 0, "Got unexpected Echo parameter refcount %lu.\n", ref);
+    ref = IMediaObject_Release(echo_dmo);
+    ok(!ref, "Got outstanding Echo clone source refcount %lu.\n", ref);
+}

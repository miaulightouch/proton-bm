+static void test_echo_impulse(void)
+{
+    static const struct
+    {
+        WORD channels;
+        BOOL pan;
+        unsigned int frame, channel;
+        float expected;
+    }
+    cases[] =
+    {
+        {2, FALSE, 48, 0, 0.43301270f},
+        {2, FALSE, 96, 0, 0.10825317f},
+        {2, FALSE, 97, 0, 0.10825317f},
+        {2, TRUE,  48, 1, 0.43301270f},
+        {2, TRUE, 144, 0, 0.10825317f},
+        {2, TRUE, 145, 0, 0.10825317f},
+        {1, FALSE, 48, 0, 0.21650635f},
+        {1, FALSE, 96, 0, 0.27063293f},
+        {1, FALSE, 97, 0, 0.05412659f},
+    };
+    DSFXEcho params = {100.0f, 50.0f, 1.0f, 2.0f, FALSE};
+    IMediaObjectInPlace *inplace;
+    IDirectSoundFXEcho *echo;
+    IMediaObject *dmo;
+    float samples[512], chunk[512];
+    unsigned int c, i;
+    HRESULT hr;
+
+    for (c = 0; c < ARRAY_SIZE(cases); ++c)
+    {
+        winetest_push_context("case %u", c);
+        hr = CoCreateInstance(&GUID_DSFX_STANDARD_ECHO, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating Echo.\n", hr);
+        if (FAILED(hr)) goto next;
+        hr = set_float_format(dmo, 48000, cases[c].channels);
+        ok(hr == S_OK, "Got hr %#lx setting format.\n", hr);
+        hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXEcho, (void **)&echo);
+        ok(hr == S_OK, "Got hr %#lx querying Echo.\n", hr);
+        if (FAILED(hr)) { IMediaObject_Release(dmo); goto next; }
+        params.lPanDelay = cases[c].pan;
+        hr = IDirectSoundFXEcho_SetAllParameters(echo, &params);
+        ok(hr == S_OK, "Got hr %#lx setting parameters.\n", hr);
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying in-place.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            memset(samples, 0, sizeof(samples));
+            samples[0] = 0.5f;
+            hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing impulse.\n", hr);
+            i = cases[c].frame * cases[c].channels + cases[c].channel;
+            ok(fabsf(samples[i] - cases[c].expected) < 1e-6f,
+                    "Unexpected Echo sample %u: %.8e, expected %.8e.\n", i, samples[i], cases[c].expected);
+
+            hr = IMediaObject_Flush(dmo);
+            ok(hr == S_OK, "Got hr %#lx flushing.\n", hr);
+            memset(chunk, 0, sizeof(chunk));
+            chunk[0] = 0.5f;
+            hr = IMediaObjectInPlace_Process(inplace, 13 * cases[c].channels * sizeof(float),
+                    (BYTE *)chunk, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing onset.\n", hr);
+            hr = IMediaObject_FreeStreamingResources(dmo);
+            ok(hr == S_OK, "Got hr %#lx freeing resources.\n", hr);
+            hr = IMediaObjectInPlace_Process(inplace, sizeof(chunk) - 13 * cases[c].channels * sizeof(float),
+                    (BYTE *)(chunk + 13 * cases[c].channels), 0, DMO_INPLACE_ZERO);
+            ok(hr == S_OK, "Got hr %#lx processing tail.\n", hr);
+            for (i = 0; i < ARRAY_SIZE(samples); ++i)
+                ok(fabsf(samples[i] - chunk[i]) < 1e-6f,
+                        "Free changed Echo history at sample %u: %.8e / %.8e.\n", i, samples[i], chunk[i]);
+            hr = IMediaObject_Flush(dmo);
+            ok(hr == S_OK, "Got hr %#lx resetting feedback.\n", hr);
+            memset(chunk, 0, sizeof(chunk));
+            hr = IMediaObjectInPlace_Process(inplace, sizeof(chunk), (BYTE *)chunk, 0, DMO_INPLACE_ZERO);
+            ok(hr == S_OK, "Got hr %#lx processing silence.\n", hr);
+            for (i = 0; i < ARRAY_SIZE(chunk); ++i)
+                ok(chunk[i] == 0.0f, "Stale Echo feedback at sample %u: %.8e.\n", i, chunk[i]);
+            IMediaObjectInPlace_Release(inplace);
+        }
+        IDirectSoundFXEcho_Release(echo);
+        IMediaObject_Release(dmo);
+next:
+        winetest_pop_context();
+    }
+}

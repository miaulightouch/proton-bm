+static void test_compressor_float(void)
+{
+    static const DWORD rates[] = {44100, 48000, 96000};
+    static const float predelays[] = {0.0f, 2.0f, 4.0f};
+    DSFXCompressor params = {6.0f, 0.01f, 50.0f, -60.0f, 100.0f, 0.0f};
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    IMediaObjectInPlace *inplace;
+    IDirectSoundFXCompressor *compressor;
+    IMediaObject *dmo;
+    float data[32], tail[32];
+    unsigned int r, p, i, delay;
+    HRESULT hr;
+
+    for (r = 0; r < ARRAY_SIZE(rates); ++r)
+    {
+        delay = rates[r] == 96000 ? 4 : 2;
+        build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, rates[r], 1);
+        hr = CoCreateInstance(&GUID_DSFX_STANDARD_COMPRESSOR, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating Compressor.\n", hr);
+        if (FAILED(hr)) continue;
+        hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting input.\n", hr);
+        hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx setting output.\n", hr);
+        hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXCompressor, (void **)&compressor);
+        ok(hr == S_OK, "Got hr %#lx querying Compressor.\n", hr);
+        if (FAILED(hr)) { IMediaObject_Release(dmo); continue; }
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying in-place.\n", hr);
+        if (FAILED(hr)) goto release;
+        for (p = 0; p < ARRAY_SIZE(predelays); ++p)
+        {
+            params.fPredelay = predelays[p];
+            hr = IDirectSoundFXCompressor_SetAllParameters(compressor, &params);
+            ok(hr == S_OK, "Got hr %#lx setting parameters.\n", hr);
+            hr = IMediaObject_Flush(dmo);
+            ok(hr == S_OK, "Got hr %#lx flushing Compressor.\n", hr);
+            memset(data, 0, sizeof(data));
+            data[0] = 0.5f;
+            data[1] = -0.25f;
+            hr = IMediaObjectInPlace_Process(inplace, sizeof(data), (BYTE *)data, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing impulse.\n", hr);
+            for (i = 0; i < ARRAY_SIZE(data); ++i)
+                ok(fabsf(data[i] - (i == delay ? 0.997629225f : i == delay + 1 ? -0.498814613f : 0.0f)) < 1e-6f,
+                        "Rate %lu predelay %.1f sample %u: %.8e.\n", rates[r], predelays[p], i, data[i]);
+        }
+        hr = IMediaObject_Flush(dmo);
+        ok(hr == S_OK, "Got hr %#lx flushing Compressor.\n", hr);
+        data[0] = 0.5f;
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(float), (BYTE *)data, 0, DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing onset.\n", hr);
+        hr = IMediaObject_FreeStreamingResources(dmo);
+        ok(hr == S_OK, "Got hr %#lx freeing Compressor resources.\n", hr);
+        memset(tail, 0, sizeof(tail));
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(tail), (BYTE *)tail, 0, DMO_INPLACE_ZERO);
+        ok(hr == S_OK, "Got hr %#lx processing tail.\n", hr);
+        for (i = 0; i < ARRAY_SIZE(tail); ++i)
+            ok(fabsf(tail[i] - (i == delay - 1 ? 0.997629225f : 0.0f)) < 1e-6f,
+                    "Free changed Compressor history at sample %u: %.8e.\n", i, tail[i]);
+        IMediaObjectInPlace_Release(inplace);
+release:
+        IDirectSoundFXCompressor_Release(compressor);
+        IMediaObject_Release(dmo);
+    }
+}

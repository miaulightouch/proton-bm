+static float i3dl2_stage_process(struct i3dl2_stage_state *stage,
+        float input, uint64_t position)
+{
+    float delayed = stage->q[i3dl2_ring_index(position, stage->delay, stage->capacity)];
+    float value = i3dl2_fmul(stage->b, i3dl2_fsub(stage->p, delayed));
+    float output;
+
+    stage->p = i3dl2_fadd(delayed, value);
+    output = i3dl2_fadd(i3dl2_fmul(stage->g, input), i3dl2_fmul(stage->c, stage->p));
+    stage->q[(size_t)(position % stage->capacity)] = i3dl2_fsub(input,
+            i3dl2_fmul(stage->g, output));
+    return output;
+}
+
+static float i3dl2_long_process(struct i3dl2_state *state,
+        unsigned int side, float input, uint64_t position)
+{
+    float delayed = state->long_q[side][i3dl2_ring_index(position,
+            state->long_delay, state->long_length)];
+    float value = i3dl2_fmul(state->long_c, delayed);
+
+    state->long_p[side] = i3dl2_fadd(value,
+            i3dl2_fmul(state->long_b, i3dl2_fsub(state->long_p[side], value)));
+    state->long_q[side][(size_t)(position % state->long_length)] = input;
+    return state->long_p[side];
+}

+#define I3DL2_MAX_DELAY 1048576
+#define I3DL2_PI 3.14159265358979323846
+
+static float i3dl2_r32(float value)
+{
+    volatile float rounded = value;
+    return rounded;
+}
+
+static float i3dl2_fadd(float left, float right)
+{
+    volatile float result = left + right;
+    return result;
+}
+
+static float i3dl2_fsub(float left, float right)
+{
+    volatile float result = left - right;
+    return result;
+}
+
+static float i3dl2_fmul(float left, float right)
+{
+    volatile float result = left * right;
+    return result;
+}
+
+static float i3dl2_fdiv(float left, float right)
+{
+    volatile float result = left / right;
+    return result;
+}
+
+static float i3dl2_pow10(float value)
+{
+    return i3dl2_r32(powf(10.0f, value));
+}
+
+static size_t i3dl2_ms_to_samples(float milliseconds, DWORD rate)
+{
+    float value = i3dl2_fmul(milliseconds, (float)rate);
+    value = i3dl2_fdiv(value, 1000.0f);
+    return (size_t)truncf(value);
+}
+
+static size_t i3dl2_ring_index(uint64_t position, size_t delay, size_t length)
+{
+    size_t current = (size_t)(position % length);
+    size_t offset = delay % length;
+
+    return current >= offset ? current - offset : length - offset + current;
+}
+
+static float i3dl2_stage_energy(const struct i3dl2_stage_state *stage)
+{
+    float g2 = i3dl2_fmul(stage->g, stage->g);
+    float c2 = i3dl2_fmul(stage->c, stage->c);
+    float one_minus_g2 = i3dl2_fsub(1.0f, g2);
+    float numerator = i3dl2_fmul(one_minus_g2, one_minus_g2);
+    float denominator = i3dl2_fsub(1.0f, i3dl2_fmul(c2, g2));
+    float quotient = i3dl2_fdiv(c2, denominator);
+    float term = i3dl2_fmul(quotient, numerator);
+
+    return i3dl2_fadd(term, g2);
+}
+
+static void i3dl2_stage_parameters(float *c, float *b, size_t nominal,
+        DWORD rate, float tau, float hf_ratio, float hf_reference)
+{
+    float delta = i3dl2_fmul(i3dl2_fdiv((float)nominal, (float)rate), 1000.0f);
+    float exponent = i3dl2_fdiv(i3dl2_fdiv(i3dl2_fmul(-60.0f, delta), tau), 20.0f);
+    float h0 = hf_ratio < 0.1f ? 0.1f : hf_ratio;
+    float w;
+    float r;
+    double s, root0, root1, chosen;
+
+    *c = i3dl2_pow10(exponent);
+    if (h0 > 1.0f)
+        w = i3dl2_r32((float)I3DL2_PI);
+    else
+        w = i3dl2_r32((float)(2.0 * I3DL2_PI * hf_reference / rate));
+    r = i3dl2_r32(pow((double)*c,
+            (double)i3dl2_fsub(2.0f, i3dl2_fdiv(2.0f, h0))));
+    s = ((double)r - 1.0) / (1.0 - (double)i3dl2_r32(cos((double)w)));
+    if (s == 0.0)
+        *b = 0.0f;
+    else
+    {
+        root0 = (s + 1.0 - sqrt(2.0 * s + 1.0)) / s;
+        root1 = (s + 1.0 + sqrt(2.0 * s + 1.0)) / s;
+        chosen = fabs(root0) <= 1.0 ? root0 : root1;
+        *b = i3dl2_r32((float)chosen);
+    }
+}

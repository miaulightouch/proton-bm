+static void test_mod_delay_capacity(void)
+{
+    const GUID *clsids[] = {&GUID_DSFX_STANDARD_CHORUS, &GUID_DSFX_STANDARD_FLANGER};
+    enum { frames = 2048 };
+    unsigned int effect, i, first;
+    float data[frames * 2], sum;
+    IMediaObjectInPlace *inplace;
+    IMediaObject *dmo;
+    HRESULT hr;
+
+    for (effect = 0; effect < ARRAY_SIZE(clsids); ++effect)
+    {
+        winetest_push_context("maximum delay effect %u", effect);
+        hr = CoCreateInstance(clsids[effect], NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating effect.\n", hr);
+        if (FAILED(hr)) goto next;
+        hr = set_float_format(dmo, 44100, 2);
+        ok(hr == S_OK, "Got hr %#lx setting stereo format.\n", hr);
+        if (effect == 0)
+        {
+            DSFXChorus params = {100.0f, 100.0f, 0.0f, 0.0f,
+                    DSFXCHORUS_WAVE_SIN, DSFXCHORUS_DELAY_MAX, DSFXCHORUS_PHASE_90};
+            IDirectSoundFXChorus *fx;
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXChorus, (void **)&fx);
+            ok(hr == S_OK, "Got hr %#lx querying Chorus.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IDirectSoundFXChorus_SetAllParameters(fx, &params);
+                IDirectSoundFXChorus_Release(fx);
+                if (SUCCEEDED(hr))
+                    hr = set_float_format(dmo, 44100, 2);
+            }
+        }
+        else
+        {
+            DSFXFlanger params = {100.0f, 100.0f, 0.0f, 0.0f,
+                    DSFXFLANGER_WAVE_SIN, DSFXFLANGER_DELAY_MAX, DSFXFLANGER_PHASE_90};
+            IDirectSoundFXFlanger *fx;
+            hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXFlanger, (void **)&fx);
+            ok(hr == S_OK, "Got hr %#lx querying Flanger.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IDirectSoundFXFlanger_SetAllParameters(fx, &params);
+                IDirectSoundFXFlanger_Release(fx);
+            }
+        }
+        ok(hr == S_OK, "Got hr %#lx setting maximum delay.\n", hr);
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying in-place.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            memset(data, 0, sizeof(data));
+            data[0] = data[1] = 0.5f;
+            hr = IMediaObjectInPlace_Process(inplace, sizeof(data), (BYTE *)data, 0, DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing impulse.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                /* A fractional maximum delay must not wrap wet energy to frame 1. */
+                first = effect == 0 ? 1325 : 266;
+                for (i = 0; i < first; ++i)
+                    ok(fabsf(data[2 * i + 1]) < 1e-6f,
+                            "Early right-channel sample %u: %.8e.\n", i, data[2 * i + 1]);
+                for (sum = 0.0f; i < frames; ++i)
+                    sum += data[2 * i + 1];
+                ok(fabsf(sum - 0.5f) < 1e-4f, "Lost delayed wet energy: %.8e.\n", sum);
+                if (effect == 1)
+                    ok(data[2 * first + 1] > 0.0f && data[2 * (first + 1) + 1] > 0.0f,
+                            "Lost an interpolation sample: %.8e, %.8e.\n",
+                            data[2 * first + 1], data[2 * (first + 1) + 1]);
+            }
+            IMediaObjectInPlace_Release(inplace);
+        }
+        IMediaObject_Release(dmo);
+next:
+        winetest_pop_context();
+    }
+}

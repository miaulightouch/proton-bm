+static void test_extensible_validation(void)
+{
+    WAVEFORMATEXTENSIBLE format;
+    DMO_MEDIA_TYPE type =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_PCM,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(format),
+        .pbFormat = (BYTE *)&format,
+    };
+    IMediaObject *dmo;
+    WORD extension_size = sizeof(format) - sizeof(format.Format);
+    HRESULT hr;
+
+    build_extensible_format(&format, WAVE_FORMAT_PCM, 16, 44100, 2);
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_PARAMEQ, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating validation DMO.\n", hr);
+    if (FAILED(hr))
+        return;
+
+    type.cbFormat = sizeof(format) - 1;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for short extensible buffer.\n", hr);
+    type.cbFormat = sizeof(format);
+
+    format.Format.cbSize = extension_size - 1;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for short extensible cbSize.\n", hr);
+    format.Format.cbSize = extension_size;
+
+    format.Format.cbSize = extension_size + 1;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for truncated declared extension.\n", hr);
+    format.Format.cbSize = extension_size;
+
+    format.SubFormat = GUID_NULL;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for unsupported extensible subtype.\n", hr);
+    format.SubFormat = MEDIASUBTYPE_PCM;
+
+    type.subtype = MEDIASUBTYPE_IEEE_FLOAT;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for mismatched DMO subtype.\n", hr);
+    type.subtype = MEDIASUBTYPE_PCM;
+
+    format.Samples.wValidBitsPerSample = 8;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for partial valid bits.\n", hr);
+    format.Samples.wValidBitsPerSample = 0;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, DMO_SET_TYPEF_TEST_ONLY);
+    ok(hr == S_OK, "Got hr %#lx for zero valid bits.\n", hr);
+    format.Samples.wValidBitsPerSample = 16;
+
+    format.Format.nBlockAlign--;
+    hr = IMediaObject_SetInputType(dmo, 0, &type, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for invalid block alignment.\n", hr);
+
+    IMediaObject_Release(dmo);
+}

+static void test_chorus_delay_center(void)
+{
+    struct chorus_delay_fixture
+    {
+        DWORD rate;
+        float depth, delay;
+        LONG phase;
+        unsigned int left_first, right_first;
+        float left_center, right_center;
+    };
+    static const struct chorus_delay_fixture fixtures[] =
+    {
+        {44100, 0.0f, 0.0f, DSFXCHORUS_PHASE_ZERO, 2, 2, 2.0f, 2.0f},
+        {44100, 0.0f, 20.0f, DSFXCHORUS_PHASE_ZERO, 884, 884, 884.0f, 884.0f},
+        {44100, 100.0f, 5.0f, DSFXCHORUS_PHASE_90, 222, 332, 222.5f, 332.75f},
+        {44100, 100.0f, 12.0f, DSFXCHORUS_PHASE_90, 531, 795, 531.2f, 795.8f},
+        {48000, 0.0f, 0.0f, DSFXCHORUS_PHASE_ZERO, 2, 2, 2.0f, 2.0f},
+        {48000, 0.0f, 20.0f, DSFXCHORUS_PHASE_ZERO, 962, 962, 962.0f, 962.0f},
+        {48000, 100.0f, 5.0f, DSFXCHORUS_PHASE_90, 242, 362, 242.0f, 362.0f},
+        {48000, 100.0f, 12.0f, DSFXCHORUS_PHASE_90, 578, 866, 578.0f, 866.0f},
+    };
+    enum { frame_count = 2048 };
+    float data[frame_count * 2];
+    IDirectSoundFXChorus *chorus;
+    IMediaObjectInPlace *inplace;
+    IMediaObject *dmo;
+    unsigned int fixture_index, channel, frame;
+    HRESULT hr;
+
+    for (fixture_index = 0; fixture_index < ARRAY_SIZE(fixtures); ++fixture_index)
+    {
+        const struct chorus_delay_fixture *fixture = &fixtures[fixture_index];
+        DSFXChorus params = {100.0f, fixture->depth, 0.0f, 0.0f,
+                DSFXCHORUS_WAVE_SIN, fixture->delay, fixture->phase};
+
+        winetest_push_context("rate %lu delay %.1f depth %.1f phase %ld", fixture->rate,
+                fixture->delay, fixture->depth, fixture->phase);
+        hr = CoCreateInstance(&GUID_DSFX_STANDARD_CHORUS, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&dmo);
+        ok(hr == S_OK, "Got hr %#lx creating Chorus center probe.\n", hr);
+        if (FAILED(hr))
+            goto next;
+        hr = set_float_format(dmo, fixture->rate, 2);
+        ok(hr == S_OK, "Got hr %#lx setting Chorus center format.\n", hr);
+        if (FAILED(hr))
+            goto release_dmo;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXChorus, (void **)&chorus);
+        ok(hr == S_OK, "Got hr %#lx querying Chorus center parameters.\n", hr);
+        if (FAILED(hr))
+            goto release_dmo;
+        hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+        ok(hr == S_OK, "Got hr %#lx querying Chorus center in-place interface.\n", hr);
+        if (FAILED(hr))
+            goto release_chorus;
+        hr = IDirectSoundFXChorus_SetAllParameters(chorus, &params);
+        ok(hr == S_OK, "Got hr %#lx setting Chorus center parameters.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            /* Reapplying the type is part of the observed native center latch. */
+            hr = set_float_format(dmo, fixture->rate, 2);
+            ok(hr == S_OK, "Got hr %#lx reapplying Chorus center format.\n", hr);
+        }
+        memset(data, 0, sizeof(data));
+        data[0] = data[1] = 0.5f;
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(data), (BYTE *)data, 0,
+                DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing Chorus center impulse.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            const unsigned int first[] = {fixture->left_first, fixture->right_first};
+            const float expected[] = {fixture->left_center, fixture->right_center};
+
+            for (channel = 0; channel < 2; ++channel)
+            {
+                double sum = 0.0, weighted = 0.0;
+                BOOL early_silent = TRUE;
+
+                for (frame = 0; frame < frame_count; ++frame)
+                {
+                    float sample = data[2 * frame + channel];
+                    if (frame < first[channel] && fabsf(sample) >= 1e-6f)
+                        early_silent = FALSE;
+                    sum += sample;
+                    weighted += frame * sample;
+                }
+                ok(early_silent, "Unexpected pre-tap energy on channel %u.\n", channel);
+                ok(fabs(sum - 0.5) < 1e-4,
+                        "Tap energy changed on channel %u: %.8e.\n", channel, sum);
+                if (fabs(sum) > 1e-12)
+                    ok(fabs(weighted / sum - expected[channel]) < 0.05,
+                            "Unexpected observed center on channel %u: %.8e, expected %.8e.\n",
+                            channel, weighted / sum, expected[channel]);
+                else
+                    ok(FALSE, "No tap energy on channel %u.\n", channel);
+            }
+        }
+        IMediaObjectInPlace_Release(inplace);
+release_chorus:
+        IDirectSoundFXChorus_Release(chorus);
+release_dmo:
+        IMediaObject_Release(dmo);
+next:
+        winetest_pop_context();
+    }
+}

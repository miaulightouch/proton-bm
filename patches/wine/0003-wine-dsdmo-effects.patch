+static void test_reverb_process(const GUID *clsid)
+{
+    enum { frame_count = 256, tail_chunks = 20 };
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    float samples[frame_count * 2];
+    IMediaObject *dmo;
+    IMediaObjectInPlace *inplace;
+    DWORD i, chunk;
+    BOOL delayed = FALSE;
+    BOOL silent = TRUE;
+    HRESULT hr;
+    ULONG ref;
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 44100, 2);
+    hr = CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+        return;
+
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    memset(samples, 0, sizeof(samples));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_NORMAL);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx before setting the input type.\n", hr);
+    hr = IMediaObjectInPlace_Process(inplace, 0, NULL, 0, DMO_INPLACE_NORMAL);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx for an empty buffer without a type.\n", hr);
+
+    hr = IMediaObject_SetInputType(dmo, 1, NULL, 0);
+    ok(hr == DMO_E_INVALIDSTREAMINDEX, "Got hr %#lx for invalid input stream.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 1, NULL, 0);
+    ok(hr == DMO_E_INVALIDSTREAMINDEX, "Got hr %#lx for invalid output stream.\n", hr);
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0x4);
+    ok(hr == E_INVALIDARG, "Got hr %#lx for invalid input flags.\n", hr);
+
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    mt.cbFormat = 1;
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for a short output format.\n", hr);
+    mt.cbFormat = sizeof(wfx);
+    mt.pbFormat = NULL;
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == DMO_E_TYPE_NOT_ACCEPTED, "Got hr %#lx for a NULL output format.\n", hr);
+    mt.pbFormat = (BYTE *)&wfx;
+
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), NULL, 0, DMO_INPLACE_NORMAL);
+    ok(hr == E_POINTER, "Got hr %#lx for a NULL buffer.\n", hr);
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples) - 1, (BYTE *)samples, 0, DMO_INPLACE_NORMAL);
+    ok(hr == E_INVALIDARG, "Got hr %#lx for an unaligned buffer.\n", hr);
+
+    memset(samples, 0, sizeof(samples));
+    samples[0] = 1.0f;
+    samples[1] = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (IsEqualGUID(clsid, &GUID_DSFX_WAVES_REVERB))
+        ok(fabsf(samples[0]) < 1e-7f && fabsf(samples[1]) < 1e-7f,
+                "Default Waves mix retained direct signal (%.8e, %.8e).\n", samples[0], samples[1]);
+    else
+        ok(fabsf(samples[0]) > 0.5f && fabsf(samples[1]) > 0.5f,
+                "I3DL2 lost the direct signal (%.8e, %.8e).\n", samples[0], samples[1]);
+
+    for (chunk = 0; chunk < tail_chunks; ++chunk)
+    {
+        memset(samples, 0, sizeof(samples));
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_ZERO);
+        ok(hr == S_OK, "Got hr %#lx for zero input chunk %lu.\n", hr, chunk);
+        for (i = 0; i < ARRAY_SIZE(samples); ++i)
+            if (fabsf(samples[i]) > 1e-7f)
+                delayed = TRUE;
+    }
+    ok(delayed, "Reverb did not produce a delayed signal.\n");
+
+    hr = IMediaObject_SetOutputType(dmo, 0, NULL, DMO_SET_TYPEF_CLEAR);
+    ok(hr == S_OK, "Got hr %#lx for output type clear.\n", hr);
+    memset(samples, 0, sizeof(samples));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_ZERO);
+    ok(hr == DMO_E_TYPE_NOT_SET, "Got hr %#lx after output type clear.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx after restoring output type.\n", hr);
+    memset(samples, 0, sizeof(samples));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_ZERO);
+    ok(hr == S_OK, "Got hr %#lx after restoring output type.\n", hr);
+    silent = TRUE;
+    for (i = 0; i < ARRAY_SIZE(samples); ++i)
+        if (fabsf(samples[i]) > 1e-7f)
+            silent = FALSE;
+    ok(silent, "Output type clear did not clear the reverb tail.\n");
+
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, 2);
+    ok(hr == E_INVALIDARG, "Got hr %#lx for invalid flags.\n", hr);
+
+    silent = TRUE;
+    hr = IMediaObject_Flush(dmo);
+    ok(hr == S_OK, "Got hr %#lx for Flush.\n", hr);
+    memset(samples, 0, sizeof(samples));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_ZERO);
+    ok(hr == S_OK, "Got hr %#lx after Flush.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(samples); ++i)
+        if (fabsf(samples[i]) > 1e-7f)
+            silent = FALSE;
+    ok(silent, "Flush did not clear the reverb tail.\n");
+
+    memset(samples, 0, sizeof(samples));
+    samples[0] = 1.0f;
+    samples[1] = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx before Discontinuity.\n", hr);
+    hr = IMediaObject_Discontinuity(dmo, 1);
+    ok(hr == DMO_E_INVALIDSTREAMINDEX, "Got hr %#lx for invalid stream index.\n", hr);
+    hr = IMediaObject_Discontinuity(dmo, 0);
+    ok(hr == S_OK, "Got hr %#lx for Discontinuity.\n", hr);
+    memset(samples, 0, sizeof(samples));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_ZERO);
+    ok(hr == S_OK, "Got hr %#lx after Discontinuity.\n", hr);
+    silent = TRUE;
+    for (i = 0; i < ARRAY_SIZE(samples); ++i)
+        if (fabsf(samples[i]) > 1e-7f)
+            silent = FALSE;
+    ok(silent, "Discontinuity did not clear the reverb tail.\n");
+
+    memset(samples, 0, sizeof(samples));
+    samples[0] = 1.0f;
+    samples[1] = 1.0f;
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_NORMAL);
+    ok(hr == S_OK, "Got hr %#lx before FreeStreamingResources.\n", hr);
+    hr = IMediaObject_FreeStreamingResources(dmo);
+    ok(hr == S_OK, "Got hr %#lx for FreeStreamingResources.\n", hr);
+    memset(samples, 0, sizeof(samples));
+    hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0, DMO_INPLACE_ZERO);
+    ok(hr == S_OK, "Got hr %#lx after FreeStreamingResources.\n", hr);
+    silent = TRUE;
+    for (i = 0; i < ARRAY_SIZE(samples); ++i)
+        if (fabsf(samples[i]) > 1e-7f)
+            silent = FALSE;
+    ok(silent, "FreeStreamingResources did not clear the reverb tail.\n");
+
+    ref = IMediaObjectInPlace_Release(inplace);
+    ok(ref != 0, "Got unexpected refcount %lu.\n", ref);
+    ref = IMediaObject_Release(dmo);
+    ok(!ref, "Got outstanding refcount %lu.\n", ref);
+}

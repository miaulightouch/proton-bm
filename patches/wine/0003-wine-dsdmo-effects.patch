+/* shortcut: native high-rate capacity folding is unverified; reject oversized histories until captured. */
+#define WAVES_REVERB_MAX_DELAY 1048576
+
+static float waves_r32(float value)
+{
+    volatile float rounded = value;
+    return rounded;
+}
+
+static float waves_fadd(float left, float right)
+{
+    volatile float result = left + right;
+    return result;
+}
+
+static float waves_fsub(float left, float right)
+{
+    volatile float result = left - right;
+    return result;
+}
+
+static float waves_fmul(float left, float right)
+{
+    volatile float result = left * right;
+    return result;
+}
+
+static float waves_fdiv(float left, float right)
+{
+    volatile float result = left / right;
+    return result;
+}
+
+static float waves_fneg(float value)
+{
+    volatile float result = -value;
+    return result;
+}
+
+static float waves_pow10(float value)
+{
+    return waves_r32(powf(10.0f, value));
+}
+
+static float waves_sqrt(float value)
+{
+    return waves_r32(sqrtf(value));
+}
+
+static BOOL waves_round_delay(float value, size_t *result)
+{
+    float rounded;
+
+    if (!isfinite(value) || value < 0.0f)
+        return FALSE;
+    rounded = waves_fadd(value, 0.5f);
+    if (!isfinite(rounded) || rounded > WAVES_REVERB_MAX_DELAY)
+        return FALSE;
+    *result = (size_t)floorf(rounded);
+    return TRUE;
+}
+
+static BOOL waves_configure_delays(DWORD rate, size_t *delay, size_t *allpass)
+{
+    float ratio = 1.189207077f;
+    float d0, d1, d2, d3;
+
+    if (!rate)
+        return FALSE;
+
+    d0 = waves_fmul(0.045f, (float)rate);
+    if (!waves_round_delay(d0, &delay[0]))
+        return FALSE;
+    d2 = waves_fmul((float)delay[0], ratio);
+    if (!waves_round_delay(d2, &delay[2]))
+        return FALSE;
+    d1 = waves_fmul((float)delay[2], ratio);
+    if (!waves_round_delay(d1, &delay[1]))
+        return FALSE;
+    d3 = waves_fmul((float)delay[1], ratio);
+    if (!waves_round_delay(d3, &delay[3]))
+        return FALSE;
+
+    if (!waves_round_delay(waves_fmul(waves_fadd((float)delay[0], (float)delay[1]),
+            0.115466669201851f), &allpass[0])
+            || !waves_round_delay(waves_fmul(waves_fadd((float)delay[2], (float)delay[3]),
+            0.115466669201851f), &allpass[1]))
+        return FALSE;
+
+    return TRUE;
+}
+
+static HRESULT waves_make_coefficients(const DSFXWavesReverb *params, DWORD rate,
+        const size_t *delay, const size_t *allpass, struct waves_reverb_coefficients *coeff)
+{
+    float lambda, gain, mix, norm, sum, value, beta, c;
+    float resistance[4];
+    unsigned int i, j;
+
+    lambda = waves_fdiv(-3000.0f, waves_fmul((float)rate, params->fReverbTime));
+    for (i = 0; i < 4; ++i)
+    {
+        size_t full_delay = delay[i] + allpass[i / 2];
+
+        c = waves_pow10(waves_fmul(lambda, (float)delay[i]));
+        value = waves_fsub(waves_fdiv(1.0f, params->fHighFreqRTRatio), 1.0f);
+        value = waves_pow10(waves_fmul(waves_fmul(lambda, (float)full_delay), value));
+        beta = waves_fdiv(waves_fsub(1.0f, value), 2.0f);
+        coeff->b[i] = waves_fmul(c, waves_fsub(1.0f, beta));
+        coeff->e[i] = waves_fmul(c, beta);
+        resistance[i] = waves_fmul(c, waves_pow10(waves_fmul(lambda,
+                (float)allpass[i / 2])));
+    }
+
+    norm = 0.0f;
+    for (i = 0; i < 4; ++i)
+    {
+        sum = 1.0f;
+        for (j = 0; j < 4; ++j)
+            sum = waves_fadd(waves_fmul(sum, resistance[i]), 1.0f);
+        value = waves_fmul(sum, sum);
+        norm = waves_fadd(norm, value);
+    }
+    norm = waves_sqrt(norm);
+
+    gain = waves_pow10(waves_fdiv(params->fInGain, 20.0f));
+    mix = waves_pow10(waves_fdiv(params->fReverbMix, 10.0f));
+    coeff->dry = waves_fmul(gain, waves_sqrt(waves_fsub(1.0f, mix)));
+    coeff->wet = waves_fdiv(waves_fmul(waves_fmul(4.0f, gain), waves_sqrt(mix)), norm);
+    coeff->allpass[0] = waves_pow10(waves_fmul(lambda, (float)allpass[0]));
+    coeff->allpass[1] = waves_pow10(waves_fmul(lambda, (float)allpass[1]));
+
+    if (!isfinite(coeff->dry) || !isfinite(coeff->wet)
+            || !isfinite(coeff->allpass[0]) || !isfinite(coeff->allpass[1]))
+        return E_INVALIDARG;
+    return S_OK;
+}
+
+static int32_t waves_s32(int64_t value)
+{
+    uint32_t bits = (uint32_t)value;
+
+    if (bits <= 0x7fffffffu)
+        return (int32_t)bits;
+    return (int32_t)((int64_t)bits - 0x100000000LL);
+}
+
+static int32_t waves_floor_q15(int32_t value)
+{
+    int64_t quotient = value / 32768;
+
+    if (value < 0 && value % 32768)
+        --quotient;
+    return (int32_t)quotient;
+}
+
+static int32_t waves_p(int32_t left, int32_t right)
+{
+    return waves_floor_q15(waves_s32((int64_t)left * right));
+}
+
+static int32_t waves_p2(int32_t a, int32_t b, int32_t c, int32_t d)
+{
+    return waves_floor_q15(waves_s32((int64_t)a * b + (int64_t)c * d));
+}
+
+static int32_t waves_q15(float value)
+{
+    float scaled = waves_fadd(waves_fmul(value, 32768.0f), 0.5f);
+
+    if (!isfinite(scaled) || scaled <= -32768.0f)
+        return -32768;
+    if (scaled >= 32767.0f)
+        return 32767;
+    return (int32_t)truncf(scaled);
+}
+
+static size_t waves_delay_index(uint64_t position, size_t delay, size_t length)
+{
+    size_t current = (size_t)(position % length);
+    size_t offset = delay % length;
+
+    return current >= offset ? current - offset : length - offset + current;
+}
+
+static void waves_state_release(struct waves_reverb_state *state)
+{
+    unsigned int i;
+
+    for (i = 0; i < 4; ++i)
+    {
+        free(state->float_q[i]);
+        free(state->float_v[i]);
+        free(state->int_q[i]);
+        free(state->int_v[i]);
+    }
+    memset(state, 0, sizeof(*state));
+}
+
+static void waves_state_reset(struct waves_reverb_state *state)
+{
+    unsigned int i;
+
+    for (i = 0; i < 4; ++i)
+    {
+        if (state->float_q[i])
+            memset(state->float_q[i], 0, state->q_length[i] * sizeof(*state->float_q[i]));
+        if (state->float_v[i])
+            memset(state->float_v[i], 0, state->v_length[i] * sizeof(*state->float_v[i]));
+        if (state->int_q[i])
+            memset(state->int_q[i], 0, state->q_length[i] * sizeof(*state->int_q[i]));
+        if (state->int_v[i])
+            memset(state->int_v[i], 0, state->v_length[i] * sizeof(*state->int_v[i]));
+    }
+    memset(state->float_previous, 0, sizeof(state->float_previous));
+    memset(state->int_previous, 0, sizeof(state->int_previous));
+    state->position = 0;
+    state->params_dirty = TRUE;
+}
+
+static HRESULT waves_state_prepare(struct waves_reverb_state *state,
+        const WAVEFORMATEX *format)
+{
+    float *float_q[4] = {0}, *float_v[4] = {0};
+    int32_t *int_q[4] = {0}, *int_v[4] = {0};
+    size_t delay[4], allpass[2], q_length[4], v_length[4];
+    BOOL integer = format->wFormatTag == WAVE_FORMAT_PCM;
+    unsigned int i, j;
+
+    if (!waves_configure_delays(format->nSamplesPerSec, delay, allpass))
+        return DMO_E_TYPE_NOT_ACCEPTED;
+    for (i = 0; i < 4; ++i)
+        delay[i] -= allpass[i / 2];
+    if (format->wBitsPerSample != 16 && format->wBitsPerSample != 32)
+        return DMO_E_TYPE_NOT_ACCEPTED;
+    if (state->prepared && state->rate == format->nSamplesPerSec
+            && state->channels == format->nChannels && state->format == format->wFormatTag
+            && state->depth == format->wBitsPerSample)
+        return S_OK;
+
+    for (i = 0; i < 4; ++i)
+    {
+        q_length[i] = delay[i] + 1;
+        if (q_length[i] <= delay[i] || q_length[i] > SIZE_MAX / sizeof(*int_q[i]))
+            goto oom;
+        if (integer)
+            int_q[i] = calloc(q_length[i], sizeof(*int_q[i]));
+        else
+            float_q[i] = calloc(q_length[i], sizeof(*float_q[i]));
+        if ((integer && !int_q[i]) || (!integer && !float_q[i]))
+            goto oom;
+    }
+    for (j = 0; j < 2; ++j)
+        for (i = 2 * j; i < 2 * j + 2; ++i)
+        {
+            v_length[i] = allpass[j] + 1;
+            if (v_length[i] <= allpass[j] || v_length[i] > SIZE_MAX / sizeof(*int_v[i]))
+                goto oom;
+            if (integer)
+                int_v[i] = calloc(v_length[i], sizeof(*int_v[i]));
+            else
+                float_v[i] = calloc(v_length[i], sizeof(*float_v[i]));
+            if ((integer && !int_v[i]) || (!integer && !float_v[i]))
+                goto oom;
+        }
+
+    waves_state_release(state);
+    for (i = 0; i < 4; ++i)
+    {
+        state->float_q[i] = float_q[i];
+        state->float_v[i] = float_v[i];
+        state->int_q[i] = int_q[i];
+        state->int_v[i] = int_v[i];
+        state->q_length[i] = q_length[i];
+        state->v_length[i] = v_length[i];
+        state->delay[i] = delay[i];
+    }
+    state->allpass[0] = allpass[0];
+    state->allpass[1] = allpass[1];
+    state->channels = format->nChannels;
+    state->rate = format->nSamplesPerSec;
+    state->format = format->wFormatTag;
+    state->depth = format->wBitsPerSample;
+    state->integer = integer;
+    state->prepared = TRUE;
+    state->params_dirty = TRUE;
+    return S_OK;
+
+oom:
+    for (i = 0; i < 4; ++i)
+    {
+        free(float_q[i]);
+        free(float_v[i]);
+        free(int_q[i]);
+        free(int_v[i]);
+    }
+    return E_OUTOFMEMORY;
+}
+
+static float reverb_read_sample(const BYTE *data, WORD format, WORD depth)
+{
+    if (format == WAVE_FORMAT_IEEE_FLOAT)
+    {
+        float sample;
+        memcpy(&sample, data, sizeof(sample));
+        return sample;
+    }
+
+    if (depth == 8)
+        return ((float)data[0] - 128.0f) / 128.0f;
+    else
+    {
+        SHORT sample;
+        memcpy(&sample, data, sizeof(sample));
+        return sample / 32768.0f;
+    }
+}
+
+static void reverb_write_sample(BYTE *data, WORD format, WORD depth, float sample)
+{
+    if (format == WAVE_FORMAT_IEEE_FLOAT)
+    {
+        memcpy(data, &sample, sizeof(sample));
+        return;
+    }
+
+    if (sample < -1.0f)
+        sample = -1.0f;
+    else if (sample > 1.0f)
+        sample = 1.0f;
+
+    if (depth == 8)
+    {
+        if (sample <= -1.0f)
+            data[0] = 0;
+        else if (sample >= 127.0f / 128.0f)
+            data[0] = 0xff;
+        else
+            data[0] = (BYTE)lrintf((sample + 1.0f) * 128.0f);
+    }
+    else
+    {
+        SHORT value;
+
+        if (sample <= -1.0f)
+            value = -32768;
+        else if (sample >= 32767.0f / 32768.0f)
+            value = 32767;
+        else
+            value = (SHORT)lrintf(sample * 32768.0f);
+        memcpy(data, &value, sizeof(value));
+    }
+}
+
+static void write_truncated_sample(BYTE *data, WORD format, WORD depth, float sample)
+{
+    if (format == WAVE_FORMAT_PCM)
+    {
+        float scale = depth == 8 ? 128.0f : 32768.0f;
+
+        /* Truncate before the shared round-to-nearest packing helper. */
+        sample = truncf(sample * scale) / scale;
+    }
+    reverb_write_sample(data, format, depth, sample);
+}
+
+static void reverb_state_release(struct reverb_state *state)
+{
+    if (state->locked)
+    {
+        state->fapo->UnlockForProcess(state->fapo);
+        state->locked = FALSE;
+    }
+    if (state->fapo)
+    {
+        state->fapo->Release(state->fapo);
+        state->fapo = NULL;
+    }
+
+    free(state->samples);
+    state->samples = NULL;
+    state->sample_count = 0;
+    memset(&state->format, 0, sizeof(state->format));
+}
+
+static void reverb_state_reset(struct reverb_state *state)
+{
+    if (state->fapo)
+        state->fapo->Reset(state->fapo);
+}
+
+static HRESULT reverb_state_prepare(struct reverb_state *state, const WAVEFORMATEX *format)
+{
+    FAPOLockForProcessBufferParameters lock;
+    FAudioWaveFormatEx fapo_format;
+    HRESULT hr;
+
+    if (format->nSamplesPerSec < FAUDIOFX_REVERB_MIN_FRAMERATE
+            || format->nSamplesPerSec > FAUDIOFX_REVERB_MAX_FRAMERATE)
+        return DMO_E_TYPE_NOT_ACCEPTED;
+
+    memset(&fapo_format, 0, sizeof(fapo_format));
+    fapo_format.wFormatTag = FAUDIO_FORMAT_IEEE_FLOAT;
+    fapo_format.nChannels = format->nChannels;
+    fapo_format.nSamplesPerSec = format->nSamplesPerSec;
+    fapo_format.nBlockAlign = format->nChannels * sizeof(float);
+    fapo_format.nAvgBytesPerSec = fapo_format.nSamplesPerSec * fapo_format.nBlockAlign;
+    fapo_format.wBitsPerSample = 32;
+    fapo_format.cbSize = 0;
+
+    if (state->locked && !memcmp(&state->format, &fapo_format, sizeof(fapo_format)))
+        return S_OK;
+
+    reverb_state_release(state);
+
+    if (FAILED(hr = FAudioCreateReverb(&state->fapo, 0)))
+        return hr;
+
+    state->format = fapo_format;
+    lock.pFormat = &state->format;
+    lock.MaxFrameCount = UINT32_MAX;
+    if (FAILED(hr = state->fapo->LockForProcess(state->fapo, 1, &lock, 1, &lock)))
+    {
+        reverb_state_release(state);
+        return hr;
+    }
+
+    state->locked = TRUE;
+    state->params_dirty = TRUE;
+    return S_OK;
+}
+
+static HRESULT reverb_state_reserve(struct reverb_state *state, size_t sample_count)
+{
+    float *samples;
+
+    if (sample_count <= state->sample_count)
+        return S_OK;
+    if (!(samples = realloc(state->samples, sample_count * sizeof(*samples))))
+        return E_OUTOFMEMORY;
+
+    state->samples = samples;
+    state->sample_count = sample_count;
+    return S_OK;
+}
+
+static HRESULT reverb_validate_audio(const struct effect *base, ULONG size, const BYTE *data);
+
+static HRESULT reverb_process_audio(struct effect *base, struct reverb_state *state,
+        ULONG size, BYTE *data, DWORD flags, float input_gain, float dry_gain, float wet_gain)
+{
+    const WAVEFORMATEX *format = &base->format;
+    FAPOProcessBufferParameters input, output;
+    DWORD sample_bytes, frame_count, frame, channel;
+    size_t sample_count;
+    HRESULT hr;
+
+    sample_bytes = format->wBitsPerSample / 8;
+    frame_count = size / format->nBlockAlign;
+    if (frame_count > (size_t)-1 / format->nChannels)
+        return E_OUTOFMEMORY;
+    sample_count = (size_t)frame_count * format->nChannels;
+    if (sample_count > (size_t)-1 / sizeof(*state->samples))
+        return E_OUTOFMEMORY;
+
+    if (FAILED(hr = reverb_state_reserve(state, sample_count)))
+        return hr;
+
+    if (flags == DMO_INPLACE_ZERO)
+    {
+        memset(state->samples, 0, sample_count * sizeof(*state->samples));
+    }
+    else
+    {
+        for (frame = 0; frame < frame_count; ++frame)
+        {
+            BYTE *frame_data = data + frame * format->nBlockAlign;
+
+            for (channel = 0; channel < format->nChannels; ++channel)
+            {
+                state->samples[frame * format->nChannels + channel] =
+                        reverb_read_sample(frame_data + channel * sample_bytes,
+                        format->wFormatTag, format->wBitsPerSample) * input_gain;
+            }
+        }
+    }
+
+    input.pBuffer = state->samples;
+    input.BufferFlags = flags == DMO_INPLACE_ZERO ? FAPO_BUFFER_SILENT : FAPO_BUFFER_VALID;
+    input.ValidFrameCount = frame_count;
+    output.pBuffer = state->samples;
+    output.BufferFlags = FAPO_BUFFER_VALID;
+    output.ValidFrameCount = frame_count;
+    state->fapo->Process(state->fapo, 1, &input, 1, &output, TRUE);
+
+    for (frame = 0; frame < frame_count; ++frame)
+    {
+        BYTE *frame_data = data + frame * format->nBlockAlign;
+
+        for (channel = 0; channel < format->nChannels; ++channel)
+        {
+            float dry = flags == DMO_INPLACE_ZERO ? 0.0f :
+                    reverb_read_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample) * input_gain;
+
+            reverb_write_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample,
+                    dry * dry_gain
+                    + state->samples[frame * format->nChannels + channel] * wet_gain);
+        }
+    }
+
+    return S_OK;
+}
+
+static HRESULT reverb_validate_audio(const struct effect *base, ULONG size, const BYTE *data)
+{
+    const WAVEFORMATEX *format = &base->format;
+    DWORD sample_bytes;
+
+    if (!format->nSamplesPerSec || !base->output_type_set)
+        return DMO_E_TYPE_NOT_SET;
+    if (size && !data)
+        return E_POINTER;
+    if (!size)
+        return S_OK;
+
+    sample_bytes = format->wBitsPerSample / 8;
+    if (!sample_bytes || !format->nBlockAlign
+            || format->nBlockAlign != sample_bytes * format->nChannels
+            || size % format->nBlockAlign)
+        return E_INVALIDARG;
+
+    return S_OK;
+}
+
+/* Shared sample conversion and delay storage for in-place processing. */
+
+struct delay_buffer
+{
+    float *data[2];
+    size_t frames;
+    size_t pos;
+    DWORD channels;
+    DWORD rate;
+};
+
+static void delay_release(struct delay_buffer *delay)
+{
+    free(delay->data[0]);
+    free(delay->data[1]);
+    memset(delay, 0, sizeof(*delay));
+}
+
+static void delay_reset(struct delay_buffer *delay)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(delay->data); ++i)
+        if (delay->data[i])
+            memset(delay->data[i], 0, delay->frames * sizeof(*delay->data[i]));
+    delay->pos = 0;
+}
+
+static HRESULT delay_prepare(struct delay_buffer *delay, DWORD channels, DWORD rate, double requested)
+{
+    float *left, *right = NULL;
+    size_t frames;
+
+    if (requested > SIZE_MAX / sizeof(*left))
+        return E_OUTOFMEMORY;
+    frames = requested < 1.0 ? 1 : (size_t)ceil(requested);
+    if (delay->frames >= frames && delay->channels == channels && delay->rate == rate)
+        return S_OK;
+
+    left = calloc(frames, sizeof(*left));
+    if (!left)
+        return E_OUTOFMEMORY;
+    if (channels > 1 && !(right = calloc(frames, sizeof(*right))))
+    {
+        free(left);
+        return E_OUTOFMEMORY;
+    }
+
+    delay_release(delay);
+    delay->data[0] = left;
+    delay->data[1] = right;
+    delay->frames = frames;
+    delay->channels = channels;
+    delay->rate = rate;
+    return S_OK;
+}
+
+static float delay_read(const struct delay_buffer *delay, unsigned int channel, float frames, float current)
+{
+    double position;
+    float fraction;
+    size_t first, second;
+
+    if (!delay->frames || !delay->data[channel])
+        return 0.0f;
+    if (frames >= 0.0f && frames < 1.0f)
+        return current * (1.0f - frames)
+                + delay->data[channel][delay->pos ? delay->pos - 1 : delay->frames - 1] * frames;
+    position = (double)delay->pos - frames;
+    while (position < 0.0f)
+        position += delay->frames;
+    while (position >= delay->frames)
+        position -= delay->frames;
+    first = (size_t)position;
+    second = first + 1 < delay->frames ? first + 1 : 0;
+    fraction = position - first;
+    return delay->data[channel][first] * (1.0f - fraction)
+            + delay->data[channel][second] * fraction;
+}
+
+static void delay_write(struct delay_buffer *delay, unsigned int channel, float value)
+{
+    if (delay->data[channel])
+        delay->data[channel][delay->pos] = value;
+}
+
+static void delay_advance(struct delay_buffer *delay)
+{
+    if (++delay->pos == delay->frames)
+        delay->pos = 0;
+}
+
+static HRESULT effect_audio_prepare(struct effect *base, ULONG size, const BYTE *data,
+        DWORD *frame_count)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = reverb_validate_audio(base, size, data)))
+        return hr;
+    if (!size)
+    {
+        *frame_count = 0;
+        return S_OK;
+    }
+    /* Retain Process-after-Free support without reallocating prepared histories. */
+    if (base->ops->allocate_streaming_resources
+            && FAILED(hr = base->ops->allocate_streaming_resources(base)))
+        return hr;
+    *frame_count = size / base->format.nBlockAlign;
+    return S_OK;
+}
+
+static float eq_r32(float value)
+{
+    volatile float rounded = value;
+    return rounded;
+}
+
+static float eq_add(float left, float right)
+{
+    return eq_r32(left + right);
+}
+
+static float eq_sub(float left, float right)
+{
+    return eq_r32(left - right);
+}
+
+static float eq_mul(float left, float right)
+{
+    return eq_r32(left * right);
+}
+
+static float eq_div(float left, float right)
+{
+    return eq_r32(left / right);
+}
+
+static void eq_recompute(struct eq *effect)
+{
+    const double pi = 3.1415926535;
+    float center, rate, omega, sine, cosine, gain, alpha;
+    float c_plus, c_minus, maximum;
+    double alpha_argument, alpha_value;
+
+    rate = (float)effect->effect.format.nSamplesPerSec;
+    if (!rate)
+        return;
+    effect->rate = effect->effect.format.nSamplesPerSec;
+    effect->bypass = effect->params.fGain == 0.0f;
+    if (effect->bypass)
+        return;
+
+    center = effect->params.fCenter;
+    if (center > rate / 3.0f)
+        center = rate / 3.0f;
+    omega = eq_r32((float)(2.0 * pi * (double)center / (double)rate));
+    sine = eq_r32((float)sin((double)omega));
+    cosine = eq_r32((float)cos((double)omega));
+    gain = eq_r32(powf(10.0f, eq_div(effect->params.fGain, 20.0f)));
+    alpha_argument = (log(2.0) / 24.0) * (double)effect->params.fBandwidth
+            * (double)omega / (double)sine;
+    alpha_value = (double)sine * sinh(alpha_argument) / sqrt((double)gain);
+    alpha = eq_r32((float)alpha_value);
+    effect->k = eq_div(eq_sub(1.0f, alpha), eq_add(1.0f, alpha));
+    effect->a = eq_r32(-cosine);
+    c_plus = eq_div(eq_add(1.0f, gain), 2.0f);
+    c_minus = eq_div(eq_sub(1.0f, gain), 2.0f);
+    maximum = max(1.0f, max(fabsf(c_plus), fabsf(c_minus)));
+    effect->scale = eq_r32(ceilf(maximum));
+    effect->c_plus = c_plus;
+    effect->c_minus = c_minus;
+}
+
+static HRESULT eq_process(struct effect *base, ULONG size, BYTE *data, DWORD flags)
+{
+    struct eq *effect = CONTAINING_RECORD(base, struct eq, effect);
+    const WAVEFORMATEX *format = &base->format;
+    DWORD frames, frame, channel;
+    DWORD sample_bytes = format->wBitsPerSample / 8;
+    float minus_coeff, plus_coeff;
+    HRESULT hr;
+
+    if (FAILED(hr = effect_audio_prepare(base, size, data, &frames)))
+        return hr;
+    if (!size)
+        return S_OK;
+    if (effect->rate != format->nSamplesPerSec)
+        eq_recompute(effect);
+    if (effect->bypass)
+        return S_OK;
+
+    minus_coeff = eq_div(effect->c_minus, effect->scale);
+    plus_coeff = eq_div(effect->c_plus, effect->scale);
+    for (frame = 0; frame < frames; ++frame)
+    {
+        BYTE *frame_data = data + frame * format->nBlockAlign;
+        for (channel = 0; channel < format->nChannels; ++channel)
+        {
+            float input = flags == DMO_INPLACE_ZERO ? 0.0f :
+                    reverb_read_sample(frame_data + channel * sample_bytes,
+                    format->wFormatTag, format->wBitsPerSample);
+            float z, u, d, v, minus, plus, output;
+
+            if (format->wFormatTag == WAVE_FORMAT_PCM && format->wBitsPerSample == 16)
+                input = eq_mul(input, 32768.0f);
+            z = eq_div(input, 4.0f);
+            u = eq_add(eq_mul(effect->k, z), effect->s[channel]);
+            d = eq_sub(z, eq_mul(effect->k, u));
+            v = eq_add(eq_mul(effect->a, d), effect->r[channel]);
+            effect->s[channel] = v;
+            effect->r[channel] = eq_sub(d, eq_mul(effect->a, v));
+            minus = eq_mul(minus_coeff, u);
+            plus = eq_mul(plus_coeff, z);
+            output = eq_mul(eq_mul(4.0f, effect->scale), eq_add(minus, plus));
+
+            if (format->wFormatTag == WAVE_FORMAT_PCM && format->wBitsPerSample == 16)
+                write_truncated_sample(frame_data + channel * sample_bytes,
+                        format->wFormatTag, format->wBitsPerSample, eq_div(output, 32768.0f));
+            else
+                reverb_write_sample(frame_data + channel * sample_bytes,
+                        format->wFormatTag, format->wBitsPerSample, output);
+        }
+    }
+    return S_OK;
+}
+
+static void eq_reset(struct effect *base)
+{
+    struct eq *effect = CONTAINING_RECORD(base, struct eq, effect);
+    memset(effect->r, 0, sizeof(effect->r));
+    memset(effect->s, 0, sizeof(effect->s));
+    effect->bypass = FALSE;
+    effect->rate = 0;
+}

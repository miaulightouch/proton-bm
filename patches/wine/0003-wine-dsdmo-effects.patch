+static void reverb_set_i3dl2_parameters(struct reverb_state *state,
+        const DSFXI3DL2Reverb *params)
+{
+    FAudioFXReverbI3DL2Parameters i3dl2;
+    FAudioFXReverbParameters native;
+
+    if (!state->fapo || !state->params_dirty)
+        return;
+
+    i3dl2.WetDryMix = 100.0f;
+    i3dl2.Room = params->lRoom;
+    i3dl2.RoomHF = params->lRoomHF;
+    i3dl2.RoomRolloffFactor = params->flRoomRolloffFactor;
+    i3dl2.DecayTime = params->flDecayTime;
+    i3dl2.DecayHFRatio = params->flDecayHFRatio;
+    i3dl2.Reflections = params->lReflections;
+    i3dl2.ReflectionsDelay = params->flReflectionsDelay;
+    i3dl2.Reverb = params->lReverb;
+    i3dl2.ReverbDelay = params->flReverbDelay;
+    i3dl2.Diffusion = params->flDiffusion;
+    i3dl2.Density = params->flDensity;
+    i3dl2.HFReference = params->flHFReference;
+
+    ReverbConvertI3DL2ToNative(&i3dl2, &native);
+    state->fapo->SetParameters(state->fapo, &native, sizeof(native));
+    state->params_dirty = FALSE;
+}
+
+static float i3dl2_read_sample(const BYTE *data, WORD format)
+{
+    SHORT sample;
+    float value;
+
+    if (format == WAVE_FORMAT_IEEE_FLOAT)
+    {
+        memcpy(&value, data, sizeof(value));
+        return i3dl2_r32(value);
+    }
+    memcpy(&sample, data, sizeof(sample));
+    return (float)sample;
+}
+
+static void i3dl2_write_float(BYTE *data, float value)
+{
+    value = i3dl2_r32(value);
+    memcpy(data, &value, sizeof(value));
+}
+
+static void i3dl2_write_pcm16(BYTE *data, float value)
+{
+    SHORT sample;
+
+    value = truncf(value);
+    if (value < -32768.0f)
+        value = -32768.0f;
+    else if (value > 32767.0f)
+        value = 32767.0f;
+    sample = (SHORT)value;
+    memcpy(data, &sample, sizeof(sample));
+}
+
+static void i3dl2_process_network(struct i3dl2_state *state,
+        const float input[2], float output[2])
+{
+    static const float left_weight[5] = {0.68f, -0.5f, -0.62f, -0.5f, -0.62f};
+    static const float right_weight[5] = {0.707f, -0.6f, -0.5f, -0.6f, -0.5f};
+    float filtered[2], early[2], late[2];
+    float a, b, u, v, z_left, z_right, sum;
+    float a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5;
+    uint64_t position = state->position;
+    unsigned int side, tap;
+
+    for (side = 0; side < 2; ++side)
+    {
+        filtered[side] = i3dl2_fadd(input[side],
+                i3dl2_fmul(i3dl2_fsub(state->filtered_previous[side], input[side]), state->pole));
+        state->filtered[side][(size_t)(position % state->filtered_length)] = filtered[side];
+        state->filtered_previous[side] = filtered[side];
+    }
+    for (side = 0; side < 2; ++side)
+    {
+        const float *weights = side ? right_weight : left_weight;
+
+        sum = 0.0f;
+        for (tap = 0; tap < 5; ++tap)
+            sum = i3dl2_fadd(sum, i3dl2_fmul(weights[tap],
+                    state->filtered[side][i3dl2_ring_index(position,
+                    state->early_delay[side][tap], state->filtered_length)]));
+        if (state->quality == 1 || state->quality == 3)
+            sum = i3dl2_stage_process(&state->early_ap[side], sum, position);
+        early[side] = i3dl2_fmul(sum, state->early_gain);
+        late[side] = state->filtered[side][i3dl2_ring_index(position,
+                state->late_delay[side], state->filtered_length)];
+    }
+
+    a = i3dl2_fadd(late[0], state->feedback[0]);
+    b = i3dl2_fadd(late[1], state->feedback[1]);
+    u = i3dl2_fadd(i3dl2_fmul(-0.707f, a), i3dl2_fmul(0.707f, b));
+    v = i3dl2_fsub(i3dl2_fmul(-0.707f, a), i3dl2_fmul(0.707f, b));
+    a0 = i3dl2_stage_process(&state->stage[0][0], u, position);
+    a1 = i3dl2_stage_process(&state->stage[0][1], a0, position);
+    if (state->quality == 1 || state->quality == 3)
+    {
+        a2 = i3dl2_stage_process(&state->stage[0][2], a1, position);
+        a3 = i3dl2_stage_process(&state->stage[0][3], a2, position);
+        a = i3dl2_long_process(state, 0, a3, position);
+    }
+    else
+    {
+        a2 = a3 = 0.0f;
+        a = i3dl2_long_process(state, 0, a1, position);
+    }
+    a4 = i3dl2_stage_process(&state->stage[0][4], a, position);
+    a5 = i3dl2_stage_process(&state->stage[0][5], a4, position);
+    b0 = i3dl2_stage_process(&state->stage[1][0], v, position);
+    b1 = i3dl2_stage_process(&state->stage[1][1], b0, position);
+    if (state->quality == 1 || state->quality == 3)
+    {
+        b2 = i3dl2_stage_process(&state->stage[1][2], b1, position);
+        b3 = i3dl2_stage_process(&state->stage[1][3], b2, position);
+        b = i3dl2_long_process(state, 1, b3, position);
+    }
+    else
+    {
+        b2 = b3 = 0.0f;
+        b = i3dl2_long_process(state, 1, b1, position);
+    }
+    b4 = i3dl2_stage_process(&state->stage[1][4], b, position);
+    b5 = i3dl2_stage_process(&state->stage[1][5], b4, position);
+    state->feedback[0] = a5;
+    state->feedback[1] = b5;
+
+    z_left = i3dl2_fadd(i3dl2_fmul(-0.15f, a0), i3dl2_fmul(-0.2f, a1));
+    z_right = i3dl2_fadd(i3dl2_fadd(i3dl2_fmul(0.38f, a4),
+            i3dl2_fmul(-0.15f, b0)), i3dl2_fmul(-0.2f, b1));
+    if (state->quality == 1 || state->quality == 3)
+    {
+        z_left = i3dl2_fadd(z_left, i3dl2_fmul(0.35f, a2));
+        z_left = i3dl2_fadd(z_left, i3dl2_fmul(-0.38f, a3));
+        z_right = i3dl2_fadd(z_right, i3dl2_fmul(0.35f, b2));
+        z_right = i3dl2_fadd(z_right, i3dl2_fmul(-0.38f, b3));
+    }
+    z_left = i3dl2_fadd(z_left, i3dl2_fmul(-0.38f, a5));
+    z_left = i3dl2_fadd(z_left, i3dl2_fmul(0.38f, b4));
+    z_right = i3dl2_fadd(z_right, i3dl2_fmul(-0.38f, b5));
+    output[0] = i3dl2_fadd(i3dl2_fmul(z_left, state->late_gain[0]), early[0]);
+    output[1] = i3dl2_fadd(i3dl2_fmul(z_right, state->late_gain[1]), early[1]);
+    state->position = position + 1;
+}
+
+static HRESULT i3dl2_process_audio(struct reverb *effect, ULONG size,
+        BYTE *data, DWORD flags)
+{
+    struct i3dl2_state *state = &effect->dsp;
+    const WAVEFORMATEX *format = &effect->effect.format;
+    DWORD frame_count = size / format->nBlockAlign;
+    /* shortcut: use Q1 for the captured 48 kHz stereo default until native initialization is understood. */
+    LONG quality = effect->quality_set || format->nChannels != 2 ? effect->quality : 1;
+    float input[2], network[2], output[2] = {0.0f, 0.0f};
+    BOOL half_rate;
+    unsigned int frame;
+    BYTE *frame_data;
+    HRESULT hr;
+
+    if (!state->prepared || state->params_dirty || state->channels != format->nChannels
+            || state->input_rate != format->nSamplesPerSec || state->format != format->wFormatTag
+            || state->depth != format->wBitsPerSample || state->quality != quality)
+    {
+        if (FAILED(hr = i3dl2_state_prepare(state, &effect->params, format,
+                quality)))
+            return hr;
+    }
+    half_rate = state->quality < 2;
+    for (frame = 0; frame < frame_count; ++frame)
+    {
+        frame_data = data + (size_t)frame * format->nBlockAlign;
+        if (!half_rate || !(state->frame_position & 1))
+        {
+            input[0] = flags == DMO_INPLACE_ZERO ? 0.0f :
+                    i3dl2_read_sample(frame_data, format->wFormatTag);
+            input[1] = flags == DMO_INPLACE_ZERO || state->channels == 1 ? input[0] :
+                    i3dl2_read_sample(frame_data + format->wBitsPerSample / 8,
+                    format->wFormatTag);
+            i3dl2_process_network(state, input, network);
+            if (half_rate)
+            {
+                if (state->channels == 1 && format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT)
+                {
+                    float left = i3dl2_fadd(state->half_previous[0], network[0]);
+                    output[0] = i3dl2_fmul(i3dl2_fadd(left, network[1]), 0.25f);
+                }
+                else if (state->channels == 1)
+                {
+                    float left = i3dl2_fadd(state->half_previous[0], network[0]);
+                    float right = i3dl2_fadd(state->half_previous[1], network[1]);
+                    output[0] = i3dl2_fmul(i3dl2_fadd(left, right), 0.25f);
+                }
+                else
+                {
+                    output[0] = i3dl2_fmul(i3dl2_fadd(state->half_previous[0], network[0]), 0.5f);
+                    output[1] = i3dl2_fmul(i3dl2_fadd(state->half_previous[1], network[1]), 0.5f);
+                }
+                state->half_current[0] = network[0];
+                state->half_current[1] = network[1];
+                state->half_previous[0] = network[0];
+                state->half_previous[1] = network[1];
+            }
+            else
+            {
+                output[0] = network[0];
+                output[1] = network[1];
+            }
+        }
+        else
+        {
+            if (state->channels == 1 && format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT)
+                output[0] = state->half_current[0];
+            else if (state->channels == 1)
+                output[0] = i3dl2_fmul(i3dl2_fadd(state->half_current[0],
+                        state->half_current[1]), 0.5f);
+            else
+            {
+                output[0] = state->half_current[0];
+                output[1] = state->half_current[1];
+            }
+        }
+        ++state->frame_position;
+
+        if (format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT)
+        {
+            if (state->channels == 1)
+                i3dl2_write_float(frame_data, output[0]);
+            else
+            {
+                i3dl2_write_float(frame_data, output[0]);
+                i3dl2_write_float(frame_data + sizeof(float), output[1]);
+            }
+        }
+        else if (state->channels == 1)
+        {
+            if (half_rate)
+                i3dl2_write_pcm16(frame_data, output[0]);
+            else
+                i3dl2_write_pcm16(frame_data,
+                        i3dl2_fmul(i3dl2_fadd(output[0], output[1]), 0.5f));
+        }
+        else
+        {
+            i3dl2_write_pcm16(frame_data, output[0]);
+            i3dl2_write_pcm16(frame_data + sizeof(SHORT), output[1]);
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT reverb_process(struct effect *base, ULONG size, BYTE *data, DWORD flags)
+{
+    struct reverb *effect = CONTAINING_RECORD(base, struct reverb, effect);
+    HRESULT hr;
+
+    if (FAILED(hr = reverb_validate_audio(base, size, data)))
+        return hr;
+    if (!size)
+        return S_OK;
+    if (i3dl2_supported(&base->format, effect->quality))
+        return i3dl2_process_audio(effect, size, data, flags);
+    if (FAILED(hr = reverb_state_prepare(&effect->state, &base->format)))
+        return hr;
+    reverb_set_i3dl2_parameters(&effect->state, &effect->params);
+    return reverb_process_audio(base, &effect->state, size, data, flags, 1.0f, 0.0f, 1.0f);
+}
+
+static void reverb_reset(struct effect *base)
+{
+    struct reverb *effect = CONTAINING_RECORD(base, struct reverb, effect);
+    reverb_state_reset(&effect->state);
+    i3dl2_state_reset(&effect->dsp);
+}
 

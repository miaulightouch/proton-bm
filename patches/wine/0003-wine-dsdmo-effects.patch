+static void test_gargle_pcm16_native_quantization(void)
+{
+    enum { checkpoint_frame = 13769, sample_count = checkpoint_frame + 1 };
+    IMediaObject *dmo;
+    IDirectSoundFXGargle *effect;
+    IMediaObjectInPlace *inplace;
+    DSFXGargle params = {20, DSFXGARGLE_WAVE_TRIANGLE};

+        }
+    }
+
+    density = i3dl2_fdiv(params->flDensity, 100.0f);
+    density = i3dl2_fadd(density, 0.1f);
+    density = i3dl2_fmul(density, 0.9091f);
+    if (density > 1.0f)
+        density = 1.0f;
+    left_ms = i3dl2_fmul(67.0f, density);
+    right_ms = i3dl2_fmul(75.0f, density);
+    for (side = 0; side < 2; ++side)
+    {
+        float base_ms = side ? right_ms : left_ms;
+        const float *capacity = side ? right_capacity : left_capacity;
+
+        for (stage = 0; stage < 6; ++stage)
+        {
+            float stage_ms = base_ms;
+            size_t nominal, capacity_samples;
+
+            for (i = 0; i < exponent[stage]; ++i)
+                stage_ms = i3dl2_fmul(stage_ms, 0.93f);
+            nominal = i3dl2_ms_to_samples(stage_ms, state->rate);
+            capacity_samples = i3dl2_ms_to_samples(capacity[stage], state->rate) + 5;
+            state->stage[side][stage].capacity = capacity_samples;
+            state->stage[side][stage].delay = 1 + (nominal - 1) % capacity_samples;
+            state->stage[side][stage].g = g;
+            i3dl2_stage_parameters(&state->stage[side][stage].c,
+                    &state->stage[side][stage].b, nominal,
+                    state->rate, tau, h, params->flHFReference);
+            state->stage[side][stage].q = calloc(capacity_samples, sizeof(float));
+            if (!state->stage[side][stage].q)
+                goto oom;
+        }
+    }
+    long_nominal = i3dl2_ms_to_samples(10.0f, state->rate);
+    state->long_length = long_nominal;
+    state->long_delay = long_nominal - 1;
+    i3dl2_stage_parameters(&state->long_c, &state->long_b, long_nominal,
+            state->rate, tau, h, params->flHFReference);
+    state->long_q[0] = calloc(state->long_length, sizeof(float));
+    state->long_q[1] = calloc(state->long_length, sizeof(float));
+    if (!state->long_q[0] || !state->long_q[1])
+        goto oom;
+
+    state->early_gain = i3dl2_fmul(0.761f,
+            i3dl2_pow10(i3dl2_fdiv(i3dl2_r32((float)(params->lRoom + params->lReflections)), 2000.0f)));
+    if (state->early_gain > 0.761f)
+        state->early_gain = 0.761f;
+    if (state->channels == 1)
+        state->early_gain = i3dl2_r32((float)((double)state->early_gain * 1.41));
+
+    for (side = 0; side < 2; ++side)
+    {
+        energy[side] = 1.0f;
+        tap_power[side] = 0.0f;
+        energy[side] = i3dl2_fmul(energy[side], i3dl2_stage_energy(&state->stage[side][0]));
+        tap_power[side] = i3dl2_fadd(tap_power[side],
+                i3dl2_fmul(i3dl2_fmul(0.15f, 0.15f), energy[side]));
+        energy[side] = i3dl2_fmul(energy[side], i3dl2_stage_energy(&state->stage[side][1]));
+        tap_power[side] = i3dl2_fadd(tap_power[side],
+                i3dl2_fmul(i3dl2_fmul(0.2f, 0.2f), energy[side]));
+        if (quality == 1 || quality == 3)
+        {
+            energy[side] = i3dl2_fmul(energy[side],
+                    i3dl2_stage_energy(&state->stage[side][2]));
+            tap_power[side] = i3dl2_fadd(tap_power[side],
+                    i3dl2_fmul(i3dl2_fmul(0.35f, 0.35f), energy[side]));
+            energy[side] = i3dl2_fmul(energy[side],
+                    i3dl2_stage_energy(&state->stage[side][3]));
+            tap_power[side] = i3dl2_fadd(tap_power[side],
+                    i3dl2_fmul(i3dl2_fmul(0.38f, 0.38f), energy[side]));
+        }
+        energy[side] = i3dl2_fmul(energy[side], i3dl2_fmul(state->long_c, state->long_c));
+        energy[side] = i3dl2_fmul(energy[side], i3dl2_stage_energy(&state->stage[side][4]));
+    }
+    tap_power[0] = i3dl2_fadd(tap_power[0], i3dl2_fmul(0.1444f, energy[1]));
+    tap_power[1] = i3dl2_fadd(tap_power[1], i3dl2_fmul(0.1444f, energy[0]));
+    energy[0] = i3dl2_fmul(energy[0], i3dl2_stage_energy(&state->stage[0][5]));
+    energy[1] = i3dl2_fmul(energy[1], i3dl2_stage_energy(&state->stage[1][5]));
+    tap_power[0] = i3dl2_fadd(tap_power[0], i3dl2_fmul(0.1444f, energy[0]));
+    tap_power[1] = i3dl2_fadd(tap_power[1], i3dl2_fmul(0.1444f, energy[1]));
+    feedback_energy = i3dl2_fmul(i3dl2_fadd(energy[0], energy[1]), 0.5f);
+    room_reverb = i3dl2_r32((float)(params->lRoom + params->lReverb));
+    late_amp = pow(10.0, (double)room_reverb / 2000.0);
+    if (late_amp > 1.0)
+        late_amp = 1.0;
+    mono_factor_d = 1.41 * pow(10.0,
+            (double)g * 3.5 / 0.6180340051651 / 20.0);
+    if (state->channels == 1)
+        late_amp *= mono_factor_d;
+    for (side = 0; side < 2; ++side)
+    {

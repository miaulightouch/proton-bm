+static void test_gargle_waveform_period(void)
+{
+    struct gargle_anchor { unsigned int index; float expected; };
+    static const struct gargle_anchor triangle_anchors[] =
+    {
+        {0, 0.0f}, {1, 0.0416667f}, {24, 1.0f}, {25, 0.9583333f}, {48, 0.0f},
+        {49, 0.0f}, {50, 0.0416667f}, {73, 1.0f}, {74, 0.9583333f}, {97, 0.0f},
+    };
+    static const struct gargle_anchor square_anchors[] =
+    {
+        {24, 1.0f}, {25, 0.0f}, {48, 0.0f}, {49, 1.0f},
+        {73, 1.0f}, {74, 0.0f}, {97, 0.0f},
+    };
+    enum { sample_count = 98 };
+    DWORD shapes[] = {DSFXGARGLE_WAVE_TRIANGLE, DSFXGARGLE_WAVE_SQUARE};
+    unsigned int shape_index, i;
+
+    /* Public gold at 48 kHz / 1 kHz: period 49, square first low at sample 25. */
+
+    for (shape_index = 0; shape_index < ARRAY_SIZE(shapes); ++shape_index)
+    {
+        IMediaObject *dmo;
+        IDirectSoundFXGargle *effect;
+        IMediaObjectInPlace *inplace;
+        DSFXGargle params = {1000, shapes[shape_index]};
+        const struct gargle_anchor *anchors;
+        unsigned int anchor_count;
+        float samples[sample_count];
+        HRESULT hr;
+
+        winetest_push_context("wave shape %lu", shapes[shape_index]);
+        if (!create_gargle_test_object(&dmo, &effect, &inplace))
+        {
+            winetest_pop_context();
+            continue;
+        }
+        hr = IDirectSoundFXGargle_SetAllParameters(effect, &params);
+        ok(hr == S_OK, "Got hr %#lx setting Gargle parameters.\n", hr);
+        for (i = 0; i < ARRAY_SIZE(samples); ++i)
+            samples[i] = 1.0f;
+        hr = IMediaObjectInPlace_Process(inplace, sizeof(samples), (BYTE *)samples, 0,
+                DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing Gargle DC.\n", hr);
+        if (hr == S_OK)
+        {
+            if (shapes[shape_index] == DSFXGARGLE_WAVE_TRIANGLE)
+            {
+                anchors = triangle_anchors;
+                anchor_count = ARRAY_SIZE(triangle_anchors);
+            }
+            else
+            {
+                anchors = square_anchors;
+                anchor_count = ARRAY_SIZE(square_anchors);
+            }
+            for (i = 0; i < anchor_count; ++i)
+                ok(fabsf(samples[anchors[i].index] - anchors[i].expected) < 1e-6f,
+                        "Anchor sample %u: %.8e, expected %.8e.\n",
+                        anchors[i].index, samples[anchors[i].index], anchors[i].expected);
+        }
+        release_gargle_test_object(dmo, effect, inplace);
+        winetest_pop_context();
+    }
+}

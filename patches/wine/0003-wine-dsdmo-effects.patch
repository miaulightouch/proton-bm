+static void test_distortion_compact_impulses(void)
+{
+    enum { prefix_frames = 8, max_channels = 2 };
+    unsigned int float_format, edge_index, channels, chunked, frame, channel;
+
+    for (float_format = 0; float_format < 2; ++float_format)
+        for (edge_index = 0; edge_index < 4; ++edge_index)
+            for (channels = 1; channels <= max_channels; ++channels)
+                for (chunked = 0; chunked < 2; ++chunked)
+                {
+                    union
+                    {
+                        SHORT pcm[prefix_frames * max_channels];
+                        float f32[prefix_frames * max_channels];
+                    } data;
+                    DSFXDistortion params = {-18.0f, distortion_compact_edges[edge_index],
+                            2400.0f, 2400.0f, 8000.0f};
+                    IDirectSoundFXDistortion *effect = NULL;
+                    IMediaObjectInPlace *inplace = NULL;
+                    IMediaObject *dmo = NULL;
+                    BYTE *raw;
+                    DWORD frame_bytes;
+                    HRESULT hr;
+
+                    winetest_push_context("%s edge %.0f %u-channel %s",
+                            float_format ? "FLOAT32" : "PCM16",
+                            distortion_compact_edges[edge_index], channels,
+                            chunked ? "chunked" : "whole");
+
+                    hr = CoCreateInstance(&GUID_DSFX_STANDARD_DISTORTION, NULL,
+                            CLSCTX_INPROC_SERVER, &IID_IMediaObject, (void **)&dmo);
+                    ok(hr == S_OK, "Got hr %#lx creating distortion DMO.\n", hr);
+                    if (FAILED(hr))
+                        goto impulse_done;
+                    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXDistortion,
+                            (void **)&effect);
+                    ok(hr == S_OK, "Got hr %#lx querying distortion parameters.\n", hr);
+                    if (FAILED(hr))
+                        goto impulse_done;
+                    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace,
+                            (void **)&inplace);
+                    ok(hr == S_OK, "Got hr %#lx querying in-place interface.\n", hr);
+                    if (FAILED(hr))
+                        goto impulse_done;
+
+                    hr = float_format ? set_float_format(dmo, 48000, channels) :
+                            set_pcm16_format(dmo, 48000, channels);
+                    ok(hr == S_OK, "Got hr %#lx setting format.\n", hr);
+                    if (FAILED(hr))
+                        goto impulse_done;
+                    hr = IDirectSoundFXDistortion_SetAllParameters(effect, &params);
+                    ok(hr == S_OK, "Got hr %#lx setting parameters.\n", hr);
+                    if (FAILED(hr))
+                        goto impulse_done;
+                    hr = IMediaObject_AllocateStreamingResources(dmo);
+                    ok(hr == S_OK, "Got hr %#lx allocating resources.\n", hr);
+                    if (FAILED(hr))
+                        goto impulse_done;
+
+                    memset(&data, 0, sizeof(data));
+                    if (float_format)
+                        data.f32[0] = 0.25f;
+                    else
+                        data.pcm[0] = 8192;
+                    raw = float_format ? (BYTE *)data.f32 : (BYTE *)data.pcm;
+                    frame_bytes = channels * (float_format ? sizeof(float) : sizeof(SHORT));
+                    hr = process_distortion_compact(inplace, raw, frame_bytes, chunked);
+                    ok(hr == S_OK, "Got hr %#lx processing impulse.\n", hr);
+                    if (FAILED(hr))
+                        goto impulse_done;
+
+                    for (frame = 0; frame < prefix_frames; ++frame)
+                        for (channel = 0; channel < channels; ++channel)
+                        {
+                            unsigned int sample_index = frame * channels + channel;
+                            double expected = channel ? 0.0 :
+                                    distortion_compact_expected[float_format][edge_index][frame];
+
+                            if (float_format)
+                            {
+                                double tolerance = 2e-6;
+                                double scaled = fabs(expected) * 2e-6;
+                                if (scaled > tolerance)
+                                    tolerance = scaled;
+                                ok(fabs(data.f32[sample_index] - expected) <= tolerance,
+                                        "sample %u: %.9e, expected %.9e (tol %.3e).\n",
+                                        sample_index, data.f32[sample_index], expected, tolerance);
+                            }
+                            else
+                            {
+                                LONG delta = (LONG)data.pcm[sample_index] - (LONG)expected;
+                                if (delta < 0)
+                                    delta = -delta;
+                                ok(delta <= 1, "sample %u: %d, expected %d.\n", sample_index,
+                                        data.pcm[sample_index], (int)expected);
+                            }
+                        }
+
+impulse_done:
+                    if (inplace)
+                        IMediaObjectInPlace_Release(inplace);
+                    if (effect)
+                        IDirectSoundFXDistortion_Release(effect);
+                    if (dmo)
+                        IMediaObject_Release(dmo);
+                    winetest_pop_context();
+                }
+}

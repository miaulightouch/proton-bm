+static HRESULT process_distortion_probe(IMediaObject *dmo, IDirectSoundFXDistortion *effect,
+        IMediaObjectInPlace *inplace, const DSFXDistortion *params,
+        const float *input, float *output, DWORD sample_count)
+{
+    HRESULT hr;
+
+    hr = IDirectSoundFXDistortion_SetAllParameters(effect, params);
+    if (FAILED(hr))
+        return hr;
+    hr = IMediaObject_Flush(dmo);
+    if (FAILED(hr))
+        return hr;
+    memcpy(output, input, sample_count * sizeof(*output));
+    return IMediaObjectInPlace_Process(inplace, sample_count * sizeof(*output),
+            (BYTE *)output, 0, DMO_INPLACE_NORMAL);
+}
+
+static void test_distortion_rate_and_bands(void)
+{
+    enum { sample_count = 128 };
+    float input[sample_count], center_a[sample_count], center_b[sample_count];
+    float bandwidth_a[sample_count], bandwidth_b[sample_count];
+    IDirectSoundFXDistortion *effect;
+    IMediaObjectInPlace *inplace;
+    IMediaObject *dmo;
+    DSFXDistortion params;
+    HRESULT hr;
+    ULONG ref;
+    DWORD i;
+    BOOL center_changed = FALSE, bandwidth_changed = FALSE;
+
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_DISTORTION, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating distortion DMO.\n", hr);
+    if (hr != S_OK)
+        return;
+
+    hr = set_float_format(dmo, 22050, 1);
+    ok(hr == S_OK, "Got hr %#lx setting distortion format.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXDistortion, (void **)&effect);
+    ok(hr == S_OK, "Got hr %#lx querying distortion parameters.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx querying distortion in-place interface.\n", hr);
+    if (hr != S_OK)
+    {
+        IDirectSoundFXDistortion_Release(effect);
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    hr = IDirectSoundFXDistortion_GetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx getting distortion parameters.\n", hr);
+    if (hr != S_OK)
+        goto done;
+    params.fPostEQCenterFrequency = 8000.0f;
+    params.fPostEQBandwidth = 8000.0f;
+    params.fPreLowpassCutoff = 8000.0f;
+    hr = IDirectSoundFXDistortion_SetAllParameters(effect, &params);
+    ok(hr == S_FALSE, "Got hr %#lx for rate-clamped distortion parameters.\n", hr);
+    hr = IDirectSoundFXDistortion_GetAllParameters(effect, &params);
+    ok(hr == S_OK, "Got hr %#lx reading clamped distortion parameters.\n", hr);
+    if (hr != S_OK)
+        goto done;
+    ok(fabsf(params.fPostEQCenterFrequency - 7350.0f) < 0.01f,
+            "Got center %.8e Hz after rate clamp.\n", params.fPostEQCenterFrequency);
+    ok(fabsf(params.fPostEQBandwidth - 7350.0f) < 0.01f,
+            "Got bandwidth %.8e Hz after rate clamp.\n", params.fPostEQBandwidth);
+    ok(fabsf(params.fPreLowpassCutoff - 7350.0f) < 0.01f,
+            "Got cutoff %.8e Hz after rate clamp.\n", params.fPreLowpassCutoff);
+
+    memset(input, 0, sizeof(input));
+    input[0] = 0.75f;
+    params.fPostEQCenterFrequency = 1000.0f;
+    params.fPostEQBandwidth = 500.0f;
+    params.fPreLowpassCutoff = 3000.0f;
+    params.fEdge = 0.0f;
+    params.fGain = 0.0f;
+    hr = process_distortion_probe(dmo, effect, inplace, &params, input, center_a, sample_count);
+    ok(hr == S_OK, "Got hr %#lx processing zero-edge distortion.\n", hr);
+    input[0] *= 0.5f;
+    hr = process_distortion_probe(dmo, effect, inplace, &params, input, center_b, sample_count);
+    ok(hr == S_OK, "Got hr %#lx processing scaled zero-edge distortion.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(input); ++i)
+        ok(fabsf(center_a[i] - center_b[i] * 2.0f) < 1e-6f,
+                "Zero edge added nonlinear distortion at sample %lu.\n", i);
+    input[0] *= 2.0f;
+    params.fEdge = 15.0f;
+    params.fGain = -18.0f;
+    hr = process_distortion_probe(dmo, effect, inplace, &params, input, center_a, sample_count);
+    ok(hr == S_OK, "Got hr %#lx processing center baseline.\n", hr);
+    params.fPostEQCenterFrequency = 4000.0f;
+    hr = process_distortion_probe(dmo, effect, inplace, &params, input, center_b, sample_count);
+    ok(hr == S_OK, "Got hr %#lx processing changed center.\n", hr);
+    params.fPostEQCenterFrequency = 2000.0f;
+    params.fPostEQBandwidth = 500.0f;
+    hr = process_distortion_probe(dmo, effect, inplace, &params, input, bandwidth_a, sample_count);
+    ok(hr == S_OK, "Got hr %#lx processing bandwidth baseline.\n", hr);
+    params.fPostEQBandwidth = 4000.0f;
+    hr = process_distortion_probe(dmo, effect, inplace, &params, input, bandwidth_b, sample_count);
+    ok(hr == S_OK, "Got hr %#lx processing changed bandwidth.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(input); ++i)
+    {
+        if (fabsf(center_a[i] - center_b[i]) > 1e-5f)
+            center_changed = TRUE;
+        if (fabsf(bandwidth_a[i] - bandwidth_b[i]) > 1e-5f)
+            bandwidth_changed = TRUE;
+    }
+    ok(center_changed, "Changing fixed-bandwidth post-EQ center had no effect.\n");
+    ok(bandwidth_changed, "Changing fixed-center post-EQ bandwidth had no effect.\n");
+
+done:
+    ref = IMediaObjectInPlace_Release(inplace);
+    ok(ref != 0, "Got unexpected in-place refcount %lu.\n", ref);
+    ref = IDirectSoundFXDistortion_Release(effect);
+    ok(ref != 0, "Got unexpected distortion refcount %lu.\n", ref);
+    ref = IMediaObject_Release(dmo);
+    ok(!ref, "Got outstanding refcount %lu.\n", ref);
+}

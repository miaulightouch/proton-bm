+        .subtype = MEDIASUBTYPE_PCM,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    IDirectSoundFXWavesReverb *reverb;
+    IMediaObject *dmo;
+    IMediaObjectInPlace *inplace;
+    DSFXWavesReverb params;
+    BYTE data[sizeof(pcm16)], expected[sizeof(pcm16)];
+    unsigned int i, j;
+    HRESULT hr;
+    ULONG ref;
+
+    hr = CoCreateInstance(&GUID_DSFX_WAVES_REVERB, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+        return;
+
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXWavesReverb, (void **)&reverb);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        IMediaObjectInPlace_Release(inplace);
+        IMediaObject_Release(dmo);
+        return;
+    }
+
+    hr = IDirectSoundFXWavesReverb_GetAllParameters(reverb, &params);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+        goto done;
+    params.fInGain = 0.0f;
+    params.fReverbMix = -96.0f;
+    hr = IDirectSoundFXWavesReverb_SetAllParameters(reverb, &params);
+    ok(hr == S_OK, "Got hr %#lx setting a dry signal.\n", hr);
+    if (hr != S_OK)
+        goto done;
+
+    for (i = 0; i < ARRAY_SIZE(depths); ++i)
+    {
+        ULONG size;
+
+        build_pcm_format(&wfx, WAVE_FORMAT_PCM, depths[i], 44100, 1);
+        hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx for %u-bit input.\n", hr, depths[i]);
+        if (hr != S_OK)
+            continue;
+        hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+        ok(hr == S_OK, "Got hr %#lx for %u-bit output.\n", hr, depths[i]);
+        if (hr != S_OK)
+            continue;
+
+        size = sizeof(pcm16);
+        memcpy(expected, pcm16, size);
+        memcpy(data, expected, size);
+        hr = IMediaObjectInPlace_Process(inplace, size, data, 0, DMO_INPLACE_NORMAL);
+        ok(hr == S_OK, "Got hr %#lx processing %u-bit dry input.\n", hr, depths[i]);
+        if (hr == S_OK)
+        {
+            for (j = 0; j < size / wfx.nBlockAlign; ++j)
+            {
+                int got, input;
+
+                SHORT value;
+                memcpy(&value, data + j * sizeof(value), sizeof(value));
+                got = value;
+                input = pcm16_dry[j];
+                ok(got == input, "%u-bit near-dry sample %u: got %d, input %d.\n",
+                        depths[i], j, got, input);
+            }
+        }
+    }
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, 44100, 1);
+    mt.subtype = MEDIASUBTYPE_IEEE_FLOAT;
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx for float input.\n", hr);
+    hr = IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+    ok(hr == S_OK, "Got hr %#lx for float output.\n", hr);
+    if (hr == S_OK)
+    {
+        static const float mixes[] = {-96.0f, -6.0f, 0.0f};
+        float previous = 1.0f;
+
+        for (i = 0; i < ARRAY_SIZE(mixes); ++i)
+        {
+            float sample = 0.25f;
+
+            hr = IMediaObject_Flush(dmo);
+            ok(hr == S_OK, "Got hr %#lx for Flush.\n", hr);
+            params.fReverbMix = mixes[i];
+            hr = IDirectSoundFXWavesReverb_SetAllParameters(reverb, &params);
+            ok(hr == S_OK, "Got hr %#lx for mix %.2f dB.\n", hr, mixes[i]);
+            hr = IMediaObjectInPlace_Process(inplace, sizeof(sample), (BYTE *)&sample, 0,
+                    DMO_INPLACE_NORMAL);
+            ok(hr == S_OK, "Got hr %#lx processing mix %.2f dB.\n", hr, mixes[i]);
+            if (hr == S_OK)
+            {
+                if (!i)
+                    ok(fabsf(sample - 0.25f) < 1e-4f, "Near-dry sample %.8e.\n", sample);
+                else
+                    ok(sample < previous, "Direct sample did not decrease: %.8e -> %.8e.\n",
+                            previous, sample);
+                if (mixes[i] == -6.0f)
+                    ok(fabsf(sample - 0.2163347f) < 1e-6f, "Equal-power direct sample %.8e.\n", sample);
+                if (mixes[i] == 0.0f)
+                    ok(fabsf(sample) < 1e-7f, "Fully wet mix retained direct sample %.8e.\n", sample);
+                previous = sample;
+            }
+        }
+    }
+
+done:
+    ref = IDirectSoundFXWavesReverb_Release(reverb);
+    ok(ref != 0, "Got unexpected refcount %lu.\n", ref);
+    ref = IMediaObjectInPlace_Release(inplace);
+    ok(ref != 0, "Got unexpected refcount %lu.\n", ref);
+    ref = IMediaObject_Release(dmo);
+    ok(!ref, "Got outstanding refcount %lu.\n", ref);
+}

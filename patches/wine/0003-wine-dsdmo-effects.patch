+static HRESULT gargle_process(struct effect *base, ULONG size, BYTE *data, DWORD flags)
+{
+    struct gargle *effect = CONTAINING_RECORD(base, struct gargle, effect);
+    const WAVEFORMATEX *format = &base->format;
+    DWORD frames, frame, channel;
+    DWORD period = max(1, format->nSamplesPerSec / effect->params.dwRateHz);
+    DWORD sample_bytes = format->wBitsPerSample / 8;
+    HRESULT hr;
+    if (FAILED(hr = effect_audio_prepare(base, size, data, &frames)))
+        return hr;
+    if (!size)
+        return S_OK;
+    for (frame = 0; frame < frames; ++frame)
+    {
+        BYTE *frame_data = data + frame * format->nBlockAlign;
+        DWORD position = effect->position;
+        DWORD magnitude;
+        float gain;
+        if (effect->params.dwWaveShape == DSFXGARGLE_WAVE_SQUARE)
+        {
+            magnitude = position <= period / 2 ? period / 2 : 0;
+            gain = position <= period / 2 ? 2.0f * (period / 2) / period : 0.0f;
+        }
+        else
+        {
+            magnitude = position <= period / 2 ? position : period - position;
+            gain = 2.0f * (position <= period / 2 ? position : period - position) / period;
+        }
+        for (channel = 0; channel < format->nChannels; ++channel)
+        {
+            BYTE *sample_ptr = frame_data + channel * sample_bytes;
+
+            if (format->wFormatTag == WAVE_FORMAT_PCM && format->wBitsPerSample == 16)
+            {
+                SHORT input, output;
+                uint32_t numerator;
+                int64_t signed_numerator, quotient;
+
+                if (flags == DMO_INPLACE_ZERO)
+                    output = 0;
+                else
+                {
+                    memcpy(&input, sample_ptr, sizeof(input));
+                    numerator = (uint32_t)(int32_t)input * 2u;
+                    numerator *= magnitude;
+                    signed_numerator = numerator <= INT32_MAX ? (int64_t)numerator :
+                            (int64_t)numerator - 0x100000000LL;
+                    quotient = signed_numerator / period;
+                    if (quotient < -32768)
+                        quotient = -32768;
+                    else if (quotient > 32767)
+                        quotient = 32767;
+                    output = (SHORT)quotient;
+                }
+                memcpy(sample_ptr, &output, sizeof(output));
+            }
+            else
+            {
+                float input = flags == DMO_INPLACE_ZERO ? 0.0f :
+                        reverb_read_sample(sample_ptr,
+                        format->wFormatTag, format->wBitsPerSample);
+                write_truncated_sample(sample_ptr,
+                        format->wFormatTag, format->wBitsPerSample, input * gain);
+            }
+        }
+        effect->position = position >= period ? 0 : position + 1;
+    }
+    return S_OK;
+}
+
+static void gargle_reset(struct effect *base)
+{
+    struct gargle *effect = CONTAINING_RECORD(base, struct gargle, effect);
+    effect->position = 0;
+}
+
+static void gargle_flush(struct effect *base)
+{
+    struct gargle *effect = CONTAINING_RECORD(base, struct gargle, effect);
+    effect->position = 1;
 }
 

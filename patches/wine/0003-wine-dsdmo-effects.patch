+        state->late_gain[side] = i3dl2_r32((float)normal);
+        state->late_gain[side] = i3dl2_r32((float)((double)state->late_gain[side]
+                * late_amp));
+    }
+    state->prepared = TRUE;
+    state->params_dirty = FALSE;
+    return S_OK;
+
+oom:
+    i3dl2_state_release(state);
+    return hr;
+}

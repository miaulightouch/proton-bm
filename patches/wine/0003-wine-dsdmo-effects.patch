+static HRESULT set_pcm16_format(IMediaObject *dmo, DWORD sample_rate,
+        WORD channels)
+{
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_PCM,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    HRESULT hr;
+
+    build_pcm_format(&wfx, WAVE_FORMAT_PCM, 16, sample_rate, channels);
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+    if (hr != S_OK)
+        return hr;
+    return IMediaObject_SetOutputType(dmo, 0, &mt, 0);
+}
+
+static HRESULT process_distortion_compact(IMediaObjectInPlace *inplace, BYTE *data,
+        DWORD frame_bytes, BOOL chunked)
+{
+    HRESULT hr;
+
+    if (!chunked)
+        return IMediaObjectInPlace_Process(inplace, 8 * frame_bytes, data, 0, DMO_INPLACE_NORMAL);
+
+    hr = IMediaObjectInPlace_Process(inplace, frame_bytes, data, 0, DMO_INPLACE_NORMAL);
+    if (hr != S_OK)
+        return hr;
+    return IMediaObjectInPlace_Process(inplace, 7 * frame_bytes, data + frame_bytes, 0,
+            DMO_INPLACE_NORMAL);
+}

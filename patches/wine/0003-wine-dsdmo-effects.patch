+static HRESULT effect_copy_type(struct effect *effect, BOOL output, BOOL preferred, DMO_MEDIA_TYPE *type)
+{
+    WAVEFORMATEX format = {WAVE_FORMAT_PCM, 2, 44100, 176400, 4, 16, 0};
+    DMO_MEDIA_TYPE fallback =
+    {
+        .majortype = MEDIATYPE_Audio, .subtype = MEDIASUBTYPE_PCM,
+        .formattype = FORMAT_WaveFormatEx, .cbFormat = sizeof(format), .pbFormat = (BYTE *)&format,
+    };
+    const DMO_MEDIA_TYPE *source;
+    HRESULT hr;
+
+    if (!type)
+        return E_POINTER;
+    EnterCriticalSection(&effect->cs);
+    source = output ? &effect->output_type : &effect->input_type;
+    if (preferred)
+        source = effect->input_type.cbFormat ? &effect->input_type : &fallback;
+    hr = source->cbFormat ? MoCopyMediaType(type, source) : DMO_E_TYPE_NOT_SET;
+    LeaveCriticalSection(&effect->cs);
+    return hr;
 }
 

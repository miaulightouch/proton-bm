+static BOOL create_gargle_test_object(IMediaObject **dmo_out,
+        IDirectSoundFXGargle **effect_out, IMediaObjectInPlace **inplace_out)
+{
+    IMediaObject *dmo = NULL;
+    IDirectSoundFXGargle *effect = NULL;
+    IMediaObjectInPlace *inplace = NULL;
+    HRESULT hr;
+
+    *dmo_out = NULL;
+    *effect_out = NULL;
+    *inplace_out = NULL;
+    hr = CoCreateInstance(&GUID_DSFX_STANDARD_GARGLE, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMediaObject, (void **)&dmo);
+    ok(hr == S_OK, "Got hr %#lx creating Gargle DMO.\n", hr);
+    if (FAILED(hr))
+        return FALSE;
+    hr = set_float_format(dmo, 48000, 1);
+    ok(hr == S_OK, "Got hr %#lx setting Gargle format.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(dmo);
+        return FALSE;
+    }
+    hr = IMediaObject_QueryInterface(dmo, &IID_IDirectSoundFXGargle, (void **)&effect);
+    ok(hr == S_OK, "Got hr %#lx querying Gargle parameters.\n", hr);
+    if (FAILED(hr))
+    {
+        IMediaObject_Release(dmo);
+        return FALSE;
+    }
+    hr = IMediaObject_QueryInterface(dmo, &IID_IMediaObjectInPlace, (void **)&inplace);
+    ok(hr == S_OK, "Got hr %#lx querying Gargle in-place interface.\n", hr);
+    if (FAILED(hr))
+    {
+        IDirectSoundFXGargle_Release(effect);
+        IMediaObject_Release(dmo);
+        return FALSE;
+    }
+    *dmo_out = dmo;
+    *effect_out = effect;
+    *inplace_out = inplace;
+    return TRUE;
+}
+
+static void release_gargle_test_object(IMediaObject *dmo,
+        IDirectSoundFXGargle *effect, IMediaObjectInPlace *inplace)
+{
+    ULONG ref;
+
+    if (inplace)
+    {
+        ref = IMediaObjectInPlace_Release(inplace);
+        ok(ref != 0, "Got unexpected Gargle in-place refcount %lu.\n", ref);
+    }
+    if (effect)
+    {
+        ref = IDirectSoundFXGargle_Release(effect);
+        ok(ref != 0, "Got unexpected Gargle parameter refcount %lu.\n", ref);
+    }
+    if (dmo)
+    {
+        ref = IMediaObject_Release(dmo);
+        ok(!ref, "Got outstanding Gargle refcount %lu.\n", ref);
+    }
+}

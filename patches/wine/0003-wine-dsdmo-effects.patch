+static void build_extensible_format(WAVEFORMATEXTENSIBLE *format, WORD tag, WORD depth,
+        DWORD sample_rate, WORD channels)
+{
+    memset(format, 0, sizeof(*format));
+    build_pcm_format(&format->Format, WAVE_FORMAT_EXTENSIBLE, depth, sample_rate, channels);
+    format->Format.cbSize = sizeof(*format) - sizeof(format->Format);
+    format->Samples.wValidBitsPerSample = depth;
+    format->SubFormat = tag == WAVE_FORMAT_PCM ? MEDIASUBTYPE_PCM : MEDIASUBTYPE_IEEE_FLOAT;
+}
+
+static HRESULT set_float_format(IMediaObject *dmo, DWORD sample_rate, WORD channels)
+{
+    WAVEFORMATEX wfx;
+    DMO_MEDIA_TYPE mt =
+    {
+        .majortype = MEDIATYPE_Audio,
+        .subtype = MEDIASUBTYPE_IEEE_FLOAT,
+        .formattype = FORMAT_WaveFormatEx,
+        .cbFormat = sizeof(wfx),
+        .pbFormat = (BYTE *)&wfx,
+    };
+    HRESULT hr;
+
+    build_pcm_format(&wfx, WAVE_FORMAT_IEEE_FLOAT, 32, sample_rate, channels);
+    hr = IMediaObject_SetInputType(dmo, 0, &mt, 0);
+    if (hr != S_OK)
+        return hr;
+    return IMediaObject_SetOutputType(dmo, 0, &mt, 0);
 }
 

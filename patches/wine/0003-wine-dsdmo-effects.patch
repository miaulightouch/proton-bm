+static HRESULT normalize_audio_format(const DMO_MEDIA_TYPE *type, WAVEFORMATEX *format)
+{
+    const WAVEFORMATEX *input;
+    const WAVEFORMATEXTENSIBLE *ext;
+    size_t ext_size = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+
+    if (!type || !format)
+        return E_POINTER;
+    if (!IsEqualGUID(&type->majortype, &MEDIATYPE_Audio)
+            || (!IsEqualGUID(&type->subtype, &MEDIASUBTYPE_PCM)
+            && !IsEqualGUID(&type->subtype, &MEDIASUBTYPE_IEEE_FLOAT))
+            || !IsEqualGUID(&type->formattype, &FORMAT_WaveFormatEx))
+        return DMO_E_TYPE_NOT_ACCEPTED;
+    if (type->cbFormat < sizeof(WAVEFORMATEX) || !type->pbFormat)
+        return DMO_E_TYPE_NOT_ACCEPTED;
+
+    input = (const WAVEFORMATEX *)type->pbFormat;
+    if (input->wFormatTag == WAVE_FORMAT_EXTENSIBLE)
+    {
+        if (type->cbFormat < sizeof(WAVEFORMATEXTENSIBLE)
+                || input->cbSize < ext_size
+                || type->cbFormat < sizeof(WAVEFORMATEX) + input->cbSize)
+            return DMO_E_TYPE_NOT_ACCEPTED;
+
+        ext = (const WAVEFORMATEXTENSIBLE *)input;
+        /* DirectSound accepts zero as the container width. */
+        if (!IsEqualGUID(&ext->SubFormat, &type->subtype)
+                || (ext->Samples.wValidBitsPerSample
+                && ext->Samples.wValidBitsPerSample != input->wBitsPerSample))
+            return DMO_E_TYPE_NOT_ACCEPTED;
+
+        *format = ext->Format;
+        format->wFormatTag = IsEqualGUID(&type->subtype, &MEDIASUBTYPE_PCM) ?
+                WAVE_FORMAT_PCM : WAVE_FORMAT_IEEE_FLOAT;
+        format->cbSize = 0;
+    }
+    else
+        *format = *input;
+
+    if (format->wFormatTag == WAVE_FORMAT_PCM)
+    {
+        if (format->wBitsPerSample != 8 && format->wBitsPerSample != 16)
+            return DMO_E_TYPE_NOT_ACCEPTED;
+    }
+    else if (format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT)
+    {
+        if (format->wBitsPerSample != 32)
+            return DMO_E_TYPE_NOT_ACCEPTED;
+    }
+    else
+        return DMO_E_TYPE_NOT_ACCEPTED;
+    if (format->nChannels != 1 && format->nChannels != 2)
+        return DMO_E_TYPE_NOT_ACCEPTED;
+    if (!format->nSamplesPerSec
+            || format->nBlockAlign != format->nChannels * format->wBitsPerSample / 8)
+        return DMO_E_TYPE_NOT_ACCEPTED;
+
+    return S_OK;
+}

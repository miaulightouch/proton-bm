+
+static HRESULT WINAPI IDirectSoundBufferImpl_SetFX(IDirectSoundBuffer8 *iface, DWORD count,
+        LPDSEFFECTDESC desc, DWORD *results)
+{
+    IDirectSoundBufferImpl *This = impl_from_IDirectSoundBuffer8(iface);
+    DSFilter *filters, *old_filters;
+    DWORD i, old_count;
+    HRESULT hr = DS_OK, hr2;
+    DMO_MEDIA_TYPE type;
+    BOOL can_set;
+
+    TRACE("(%p,%lu,%p,%p)\n", This, count, desc, results);
+
+    if (results)
+        for (i = 0; i < count; ++i) results[i] = DSFXR_UNKNOWN;
+    if ((count && !desc) || (!count && (desc || results)))
+        return E_INVALIDARG;
+    if (!(This->dsbd.dwFlags & DSBCAPS_CTRLFX))
+        return DSERR_CONTROLUNAVAIL;
+
+    AcquireSRWLockShared(&This->lock);
+    can_set = This->state == STATE_STOPPED && !This->buffer->lockedbytes;
+    ReleaseSRWLockShared(&This->lock);
+    if (!can_set) return DSERR_INVALIDCALL;
+
+    filters = count ? calloc(count, sizeof(*filters)) : NULL;
+    if (count && !filters) return DSERR_OUTOFMEMORY;
+
+    type.majortype = KSDATAFORMAT_TYPE_AUDIO;
+    type.subtype = This->pwfx->wFormatTag == WAVE_FORMAT_EXTENSIBLE ?
+            ((WAVEFORMATEXTENSIBLE *)This->pwfx)->SubFormat :
+            (This->pwfx->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ?
+            KSDATAFORMAT_SUBTYPE_IEEE_FLOAT : KSDATAFORMAT_SUBTYPE_PCM);
+    type.bFixedSizeSamples = TRUE;
+    type.bTemporalCompression = FALSE;
+    type.lSampleSize = This->pwfx->nBlockAlign;
+    type.formattype = FORMAT_WaveFormatEx;
+    type.pUnk = NULL;
+    type.cbFormat = sizeof(WAVEFORMATEX) + This->pwfx->cbSize;
+    type.pbFormat = (BYTE *)This->pwfx;
+
+    /* Construct external objects without holding the buffer lock. */
+    for (i = 0; i < count; ++i)
+    {
+        TRACE("%lu: %#lx, %s\n", i, desc[i].dwFlags, dump_DSFX_guid(&desc[i]));
+        filters[i].guid = desc[i].guidDSFXClass;
+        hr2 = CoCreateInstance(&desc[i].guidDSFXClass, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IMediaObject, (void **)&filters[i].obj);
+        if (SUCCEEDED(hr2)) hr2 = IMediaObject_SetInputType(filters[i].obj, 0, &type, 0);
+        if (SUCCEEDED(hr2)) hr2 = IMediaObject_SetOutputType(filters[i].obj, 0, &type, 0);
+        if (FAILED(hr2))
+        {
+            if (SUCCEEDED(hr)) hr = hr2;
+            if (results) results[i] = hr2 == REGDB_E_CLASSNOTREG ? DSFXR_UNKNOWN : DSFXR_FAILED;
+        }
+        else
+        {
+            if (results) results[i] = DSFXR_LOCSOFTWARE;
+            IMediaObject_QueryInterface(filters[i].obj, &IID_IMediaObjectInPlace,
+                    (void **)&filters[i].inplace);
+        }
+    }
+    if (FAILED(hr)) goto failed;
+
+    AcquireSRWLockExclusive(&This->lock);
+    if (This->state != STATE_STOPPED || This->buffer->lockedbytes)
+    {
+        ReleaseSRWLockExclusive(&This->lock);
+        hr = DSERR_INVALIDCALL;
+        goto failed;
+    }
+    old_filters = This->filters;
+    old_count = This->num_filters;
+    This->filters = filters;
+    This->num_filters = count;
+    This->filter_frames = 0;
+    if (!count)
+    {
+        free(This->filter_buffer);
+        This->filter_buffer = NULL;
+        This->filter_buffer_len = 0;
+    }

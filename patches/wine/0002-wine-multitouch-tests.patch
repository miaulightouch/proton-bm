diff --git a/dlls/winewayland.drv/tests/touch.c b/dlls/winewayland.drv/tests/touch.c
new file mode 100644
index 0000000..ab0186a
--- /dev/null
+++ b/dlls/winewayland.drv/tests/touch.c
@@ -0,0 +1,276 @@
+/*
+ * Wayland touch callback tests.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../waylanddrv.h"
+
+struct wayland process_wayland;
+
+static struct wayland_surface fake_surface;
+static struct wayland_win_data fake_data;
+static HWND fake_hwnd = (HWND)(ULONG_PTR)0x1234;
+
+struct sent_event
+{
+    HWND hwnd;
+    INPUT input;
+    LPARAM lparam;
+};
+
+static struct sent_event sent[32];
+static unsigned int sent_count;
+static unsigned int touch_add_count;
+static unsigned int touch_release_count;
+static unsigned int touch_destroy_count;
+
+struct wayland_win_data *wayland_win_data_get( HWND hwnd )
+{
+    return hwnd == fake_hwnd ? &fake_data : NULL;
+}
+
+void wayland_win_data_release( struct wayland_win_data *data )
+{
+}
+
+POINT map_point_from_surface( struct wayland_surface *surface, POINT point )
+{
+    point.x = (LONG)( point.x * surface->window.scale );
+    point.y = (LONG)( point.y * surface->window.scale );
+    return point;
+}
+
+ULONG_PTR WINAPI NtUserCallTwoParam( ULONG_PTR first, ULONG_PTR second, DWORD code )
+{
+    if ( code == NtUserCallTwoParam_GetVirtualScreenRect )
+    {
+        RECT *rect = (RECT *)first;
+        rect->left = -100;
+        rect->top = -50;
+        rect->right = 1820;
+        rect->bottom = 1030;
+    }
+    return 1;
+}
+
+ULONG_PTR WINAPI NtUserCallHwndParam( HWND hwnd, DWORD_PTR param, DWORD code )
+{
+    struct send_hardware_input_params *params = (struct send_hardware_input_params *)param;
+
+    if ( code == NtUserCallHwndParam_SendHardwareInput && sent_count < ARRAY_SIZE( sent ) )
+    {
+        sent[sent_count].hwnd = hwnd;
+        sent[sent_count].input = *params->input;
+        sent[sent_count].lparam = params->lparam;
+        sent_count++;
+    }
+    return 1;
+}
+
+static void fail( const char *message )
+{
+    fprintf( stderr, "FAIL: %s\n", message );
+    exit( 1 );
+}
+
+static void check( BOOL condition, const char *message )
+{
+    if ( !condition ) fail( message );
+}
+
+static unsigned int sent_flags( unsigned int index )
+{
+    return sent[index].input.hi.wParamH;
+}
+
+static WORD sent_id( unsigned int index )
+{
+    return sent[index].input.hi.wParamL;
+}
+
+static POINT sent_position( unsigned int index )
+{
+    POINT point = { (LONG)(USHORT)LOWORD( sent[index].lparam ),
+                    (LONG)(USHORT)HIWORD( sent[index].lparam ) };
+    return point;
+}
+
+static void *harness_wl_surface_get_user_data( struct wl_surface *surface )
+{
+    return fake_hwnd;
+}
+
+static int harness_wl_touch_add_listener( struct wl_touch *touch,
+                                          const struct wl_touch_listener *listener, void *data )
+{
+    touch_add_count++;
+    return 0;
+}
+
+static uint32_t harness_wl_touch_get_version( struct wl_touch *touch )
+{
+    return 3;
+}
+
+static void harness_wl_touch_release( struct wl_touch *touch )
+{
+    touch_release_count++;
+}
+
+static void harness_wl_touch_destroy( struct wl_touch *touch )
+{
+    touch_destroy_count++;
+}
+
+/* Include the implementation so the test feeds the backend's real static
+ * listener and state helpers instead of reimplementing them. */
+#define wl_surface_get_user_data harness_wl_surface_get_user_data
+#define wl_touch_add_listener harness_wl_touch_add_listener
+#define wl_touch_get_version harness_wl_touch_get_version
+#define wl_touch_release harness_wl_touch_release
+#define wl_touch_destroy harness_wl_touch_destroy
+#include "../wayland_touch.c"
+#undef wl_surface_get_user_data
+#undef wl_touch_add_listener
+#undef wl_touch_get_version
+#undef wl_touch_release
+#undef wl_touch_destroy
+
+int main(void)
+{
+    struct wl_surface *surface = (struct wl_surface *)(ULONG_PTR)0x1111;
+    struct wl_touch *touch = (struct wl_touch *)(ULONG_PTR)0x5678;
+    POINT point;
+
+    memset( &fake_surface, 0, sizeof( fake_surface ) );
+    fake_surface.hwnd = fake_hwnd;
+    fake_surface.wl_surface = surface;
+    fake_surface.window.rect.left = 100;
+    fake_surface.window.rect.top = 50;
+    fake_surface.window.rect.right = 1100;
+    fake_surface.window.rect.bottom = 850;
+    fake_surface.window.scale = 2.0;
+    memset( &fake_data, 0, sizeof( fake_data ) );
+    fake_data.hwnd = fake_hwnd;
+    fake_data.wayland_surface = &fake_surface;
+    pthread_mutex_init( &process_wayland.touch.mutex, NULL );
+    check( !WAYLAND_GetTouchCapabilities(),
+           "touch capability is present before device initialization" );
+    wayland_touch_init( touch );
+    check( touch_add_count == 1, "touch listener was not registered" );
+    check( WAYLAND_GetTouchCapabilities() == 256,
+           "touch capability did not appear after device initialization" );
+
+    touch_listener.down( NULL, touch, 1, 10, surface, 7, wl_fixed_from_int( 100 ),
+                         wl_fixed_from_int( 50 ) );
+    touch_listener.down( NULL, touch, 2, 11, surface, 8, wl_fixed_from_int( 200 ),
+                         wl_fixed_from_int( 100 ) );
+    check( sent_count == 2, "two down callbacks did not emit two events" );
+    check( sent_id( 0 ) == 2 && sent_id( 1 ) == 3,
+           "touch IDs did not start at 2 and remain independent" );
+    check( sent_flags( 0 ) & POINTER_MESSAGE_FLAG_PRIMARY, "first contact is not primary" );
+    check( !( sent_flags( 1 ) & POINTER_MESSAGE_FLAG_PRIMARY ),
+           "second contact is unexpectedly primary" );
+    point = sent_position( 0 );
+    check( point.x == ( 100 * 2 + 100 - ( -100 ) ) * 65535 / 1920 &&
+               point.y == ( 50 * 2 + 50 - ( -50 ) ) * 65535 / 1080,
+           "down coordinate normalization is wrong" );
+
+    touch_listener.motion( NULL, touch, 12, 7, wl_fixed_from_int( 110 ), wl_fixed_from_int( 60 ) );
+    check( sent_count == 3 && sent_id( 2 ) == 2, "motion lost the original contact ID" );
+    check( sent[2].input.hi.uMsg == WM_POINTERUPDATE &&
+               ( sent_flags( 2 ) & POINTER_MESSAGE_FLAG_INCONTACT ),
+           "motion flags are wrong" );
+
+    touch_listener.motion( NULL, touch, 13, 8, wl_fixed_from_int( 210 ), wl_fixed_from_int( 110 ) );
+    check( sent_count == 4 && sent_id( 3 ) == 3, "second motion lost the independent contact ID" );
+    check( sent[3].input.hi.uMsg == WM_POINTERUPDATE &&
+               ( sent_flags( 3 ) & POINTER_MESSAGE_FLAG_INCONTACT ),
+           "second motion flags are wrong" );
+
+    touch_listener.up( NULL, touch, 3, 14, 7 );
+    check( sent_count == 5 && sent_id( 4 ) == 2, "first up lost the original contact ID" );
+    check( sent[4].input.hi.uMsg == WM_POINTERUP &&
+               !( sent_flags( 4 ) & POINTER_MESSAGE_FLAG_INCONTACT ),
+           "first up retained INCONTACT" );
+
+    touch_listener.up( NULL, touch, 4, 15, 8 );
+    check( sent_count == 6 && sent_id( 5 ) == 3, "second up lost the independent contact ID" );
+    check( sent[5].input.hi.uMsg == WM_POINTERUP &&
+               !( sent_flags( 5 ) & POINTER_MESSAGE_FLAG_INCONTACT ),
+           "second up retained INCONTACT" );
+    check( !process_wayland.touch.contacts, "individual up did not remove both contacts" );
+
+    touch_listener.down( NULL, touch, 5, 16, surface, 9, wl_fixed_from_int( 1 ),
+                         wl_fixed_from_int( 2 ) );
+    touch_listener.down( NULL, touch, 6, 17, surface, 10, wl_fixed_from_int( 2 ),
+                         wl_fixed_from_int( 3 ) );
+    check( sent_count == 8 && sent_id( 6 ) == 4 && sent_id( 7 ) == 5,
+           "second two-contact sequence did not allocate independent IDs" );
+    touch_listener.cancel( NULL, touch );
+    check( sent_count == 10 && !process_wayland.touch.contacts,
+           "cancel did not release both active contacts" );
+    check( sent[8].input.hi.uMsg == WM_POINTERUP && sent[9].input.hi.uMsg == WM_POINTERUP &&
+               ( sent_flags( 8 ) & POINTER_MESSAGE_FLAG_CANCELED ) &&
+               ( sent_flags( 9 ) & POINTER_MESSAGE_FLAG_CANCELED ) &&
+               !( sent_flags( 8 ) & POINTER_MESSAGE_FLAG_INCONTACT ) &&
+               !( sent_flags( 9 ) & POINTER_MESSAGE_FLAG_INCONTACT ),
+           "cancel flags are wrong" );
+
+    touch_listener.down( NULL, touch, 7, 18, surface, 11, wl_fixed_from_int( 1 ),
+                         wl_fixed_from_int( 2 ) );
+    check( sent_count == 11 && sent_id( 10 ) == 6,
+           "new contact ID was not stable after cancellation" );
+    wayland_touch_clear_surface( fake_hwnd );
+    check( sent_count == 12 && sent_id( 11 ) == 6 && !process_wayland.touch.contacts,
+           "surface cleanup did not release contact" );
+    check( sent[11].input.hi.uMsg == WM_POINTERUP &&
+               ( sent_flags( 11 ) & POINTER_MESSAGE_FLAG_CANCELED ),
+           "surface cleanup flags are wrong" );
+
+    wayland_touch_deinit();
+    check( !process_wayland.touch.wl_touch && !WAYLAND_GetTouchCapabilities(),
+           "touch capability did not disappear after device removal" );
+    check( touch_release_count == 1 && !touch_destroy_count,
+           "device removal did not release the versioned touch object" );
+
+    wayland_touch_init( touch );
+    check( WAYLAND_GetTouchCapabilities() == 256,
+           "touch capability did not return after device reinitialization" );
+    touch_listener.down( NULL, touch, 8, 19, surface, 12, wl_fixed_from_int( 3 ),
+                         wl_fixed_from_int( 4 ) );
+    check( sent_count == 13 && sent_id( 12 ) == 2,
+           "reinitialized device did not reset pointer IDs" );
+    wayland_touch_deinit();
+    check( sent_count == 14 && sent_id( 13 ) == 2 && !process_wayland.touch.contacts,
+           "device removal did not cancel the active contact" );
+    check( sent[13].input.hi.uMsg == WM_POINTERUP &&
+               ( sent_flags( 13 ) & POINTER_MESSAGE_FLAG_CANCELED ),
+           "device removal cancellation flags are wrong" );
+    check( !process_wayland.touch.wl_touch && !WAYLAND_GetTouchCapabilities() &&
+               touch_release_count == 2,
+           "device capability remained present after the second removal" );
+
+    pthread_mutex_destroy( &process_wayland.touch.mutex );
+    puts( "wayland touch callback harness: PASS" );
+    return 0;
+}

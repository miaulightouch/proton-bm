+/* Only direct slave devices are counted: master devices describe the same contacts. */
+UINT X11DRV_GetTouchCapabilities(void)
+{
+    UINT contacts = 0;
+#if defined(SONAME_LIBXI) && defined(HAVE_X11_EXTENSIONS_XINPUT2_H)
+    XIDeviceInfo *devices;
+    int count, i, j;
+
+    if (!xinput2_available) return 0;
+    if (!(devices = pXIQueryDevice( thread_init_display(), XIAllDevices, &count ))) return 0;
+    for (i = 0; i < count; i++)
+    {
+        if (!devices[i].enabled || devices[i].use != XISlavePointer) continue;
+        for (j = 0; j < devices[i].num_classes; j++)
+        {
+            XITouchClassInfo *touch = (XITouchClassInfo *)devices[i].classes[j];
+            if (touch->type == XITouchClass && touch->mode == XIDirectTouch)
+                contacts += touch->num_touches ? touch->num_touches : 256;
+        }
+    }
+    pXIFreeDeviceInfo( devices );
+#endif
+    return min( contacts, 256 );
+}

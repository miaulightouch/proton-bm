+ */
+
+#include "config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../waylanddrv.h"
+
+struct wayland process_wayland;
+
+static struct wayland_surface fake_surface;
+static struct wayland_win_data fake_data;
+static HWND fake_hwnd = (HWND)(ULONG_PTR)0x1234;
+
+struct sent_event
+{
+    HWND hwnd;
+    INPUT input;
+    LPARAM lparam;
+};
+
+static struct sent_event sent[32];
+static unsigned int sent_count;
+static unsigned int touch_add_count;
+static unsigned int touch_release_count;
+static unsigned int touch_destroy_count;
+
+struct wayland_win_data *wayland_win_data_get( HWND hwnd )
+{
+    return hwnd == fake_hwnd ? &fake_data : NULL;
+}
+
+void wayland_win_data_release( struct wayland_win_data *data )
+{
+}
+
+POINT map_point_from_surface( struct wayland_surface *surface, POINT point )
+{
+    point.x = (LONG)( point.x * surface->window.scale );
+    point.y = (LONG)( point.y * surface->window.scale );
+    return point;
+}
+
+ULONG_PTR WINAPI NtUserCallTwoParam( ULONG_PTR first, ULONG_PTR second, DWORD code )
+{
+    if ( code == NtUserCallTwoParam_GetVirtualScreenRect )
+    {
+        RECT *rect = (RECT *)first;
+        rect->left = -100;
+        rect->top = -50;
+        rect->right = 1820;
+        rect->bottom = 1030;
+    }
+    return 1;
+}
+
+ULONG_PTR WINAPI NtUserCallHwndParam( HWND hwnd, DWORD_PTR param, DWORD code )
+{
+    struct send_hardware_input_params *params = (struct send_hardware_input_params *)param;
+
+    if ( code == NtUserCallHwndParam_SendHardwareInput && sent_count < ARRAY_SIZE( sent ) )
+    {
+        sent[sent_count].hwnd = hwnd;
+        sent[sent_count].input = *params->input;
+        sent[sent_count].lparam = params->lparam;
+        sent_count++;
+    }
+    return 1;
+}
+
+static void fail( const char *message )
+{
+    fprintf( stderr, "FAIL: %s\n", message );
+    exit( 1 );
+}
+
+static void check( BOOL condition, const char *message )
+{
+    if ( !condition ) fail( message );
+}
+
+static unsigned int sent_flags( unsigned int index )
+{
+    return sent[index].input.hi.wParamH;
+}
+
+static WORD sent_id( unsigned int index )
+{
+    return sent[index].input.hi.wParamL;
+}
+
+static POINT sent_position( unsigned int index )
+{
+    POINT point = { (LONG)(USHORT)LOWORD( sent[index].lparam ),
+                    (LONG)(USHORT)HIWORD( sent[index].lparam ) };
+    return point;
+}
+
+static void *harness_wl_surface_get_user_data( struct wl_surface *surface )
+{
+    return fake_hwnd;
+}
+
+static int harness_wl_touch_add_listener( struct wl_touch *touch,
+                                          const struct wl_touch_listener *listener, void *data )
+{
+    touch_add_count++;
+    return 0;
+}
+
+static uint32_t harness_wl_touch_get_version( struct wl_touch *touch )
+{
+    return 3;
+}
+
+static void harness_wl_touch_release( struct wl_touch *touch )
+{
+    touch_release_count++;
+}
+
+static void harness_wl_touch_destroy( struct wl_touch *touch )
+{
+    touch_destroy_count++;
+}
+
+/* Include the implementation so the test feeds the backend's real static
+ * listener and state helpers instead of reimplementing them. */
+#define wl_surface_get_user_data harness_wl_surface_get_user_data
+#define wl_touch_add_listener harness_wl_touch_add_listener
+#define wl_touch_get_version harness_wl_touch_get_version
+#define wl_touch_release harness_wl_touch_release
+#define wl_touch_destroy harness_wl_touch_destroy
+#include "../wayland_touch.c"
+#undef wl_surface_get_user_data

+void destroy_thread_pointers(void)
+{
+    struct user_thread_info *thread_info = get_user_thread_info();
+    struct pointer *pointer, *next;
+    struct pending_pointer_message *pending, *pending_next;
+    free( thread_info->pointer_frames );
+    thread_info->pointer_frames = NULL;
+    for (pending = thread_info->pending_pointer_messages; pending; pending = pending_next)
+    {
+        pending_next = pending->next;
+        free( pending->frame );
+        free( pending );
+    }
+    thread_info->pending_pointer_messages = NULL;
+    LIST_FOR_EACH_ENTRY_SAFE( pointer, next, &thread_info->known_pointers, struct pointer, entry )
+    {
+        list_remove( &pointer->entry );
+        free( pointer );
+    }
+}
+
+static struct pointer *pointer_create( UINT32 id, POINTER_INPUT_TYPE type )
+{
+    struct user_thread_info *thread_info = get_user_thread_info();
+    struct pointer *pointer;
+
+    TRACE( "allocating pointer id %d, type %#x\n", id, type );
+
+    if (!(pointer = calloc( 1, sizeof(*pointer) ))) return NULL;
+    pointer->id = id;
+    pointer->type = type;
+    list_add_tail( &thread_info->known_pointers, &pointer->entry );
+
+    return pointer;
+}
+
+static struct pointer *find_pointer( UINT32 id )
+{
+    struct user_thread_info *thread_info = get_user_thread_info();
+    struct pointer *pointer;
+
+    TRACE( "looking for pointer id %d\n", id );
+
+    LIST_FOR_EACH_ENTRY( pointer, &thread_info->known_pointers, struct pointer, entry )
+        if (pointer->id == id) return pointer;
+
+    WARN( "failed to find pointer with id %d\n", id );
+    return NULL;
+}
+
+static POINTER_INFO pointer_info_from_msg( const MSG *msg )
+{
+    POINT location = { (SHORT)LOWORD( msg->lParam ), (SHORT)HIWORD( msg->lParam ) };
+    LARGE_INTEGER counter;
+    POINTER_INFO info =
+    {
+        .pointerId = GET_POINTERID_WPARAM( msg->wParam ),
+        .sourceDevice = INVALID_HANDLE_VALUE,
+        .frameId = InterlockedIncrement( &last_frame ),
+        .hwndTarget = msg->hwnd,
+        .historyCount = 1,
+        .dwTime = msg->time,
+    };
+
+    info.pointerFlags = HIWORD( msg->wParam );
+    switch (msg->message)
+    {
+    case WM_POINTERUPDATE: info.pointerFlags |= POINTER_FLAG_UPDATE; break;
+    case WM_POINTERDOWN: info.pointerFlags |= POINTER_FLAG_DOWN; break;
+    case WM_POINTERUP:
+        info.pointerFlags = (info.pointerFlags & ~POINTER_FLAG_INCONTACT) | POINTER_FLAG_UP;
+        break;
+    }
+    info.ptPixelLocation = info.ptPixelLocationRaw = location;
+
+    info.ptHimetricLocation.x = location.x * HIMETRIC_PER_INCH / get_system_dpi();
+    info.ptHimetricLocation.y = location.y * HIMETRIC_PER_INCH / get_system_dpi();
+    info.ptHimetricLocationRaw = info.ptHimetricLocation;
+
+    NtQueryPerformanceCounter( &counter, NULL );
+    info.PerformanceCount = counter.QuadPart;
+
+    return info;
+}
+
+static POINTER_BUTTON_CHANGE_TYPE compare_button( const POINTER_INFO *old, const POINTER_INFO *new )
+{
+    POINTER_BUTTON_CHANGE_TYPE change = POINTER_CHANGE_NONE;
+    static const struct
+    {
+        POINTER_FLAGS flag;
+        POINTER_BUTTON_CHANGE_TYPE down, up;
+    } map[] =
+    {
+        { POINTER_FLAG_FIRSTBUTTON, POINTER_CHANGE_FIRSTBUTTON_DOWN, POINTER_CHANGE_FIRSTBUTTON_UP },
+        { POINTER_FLAG_SECONDBUTTON, POINTER_CHANGE_SECONDBUTTON_DOWN, POINTER_CHANGE_SECONDBUTTON_UP },
+        { POINTER_FLAG_THIRDBUTTON, POINTER_CHANGE_THIRDBUTTON_DOWN, POINTER_CHANGE_THIRDBUTTON_UP },
+        { POINTER_FLAG_FOURTHBUTTON, POINTER_CHANGE_FOURTHBUTTON_DOWN, POINTER_CHANGE_FOURTHBUTTON_UP },
+        { POINTER_FLAG_FIFTHBUTTON, POINTER_CHANGE_FIFTHBUTTON_DOWN, POINTER_CHANGE_FIFTHBUTTON_UP },
+    };
+    POINTER_FLAGS down = ~old->pointerFlags & new->pointerFlags, up = old->pointerFlags & ~new->pointerFlags;
+
+    for (size_t i = 0; i < ARRAY_SIZE(map); i++)
+    {
+        if (down & map[i].flag) change |= map[i].down;
+        if (up & map[i].flag) change |= map[i].up;
+    }
+    return change;
+}
+
+static void update_pointer_from_msg( POINTER_INPUT_TYPE type, const MSG *msg )
+{
+    POINTER_INFO info = pointer_info_from_msg( msg );
+    POINTER_BUTTON_CHANGE_TYPE buttons;
+    struct pointer *pointer;
+
+    TRACE( "updating pointer id %d.\n", info.pointerId );
+
+    if (!(pointer = find_pointer( info.pointerId )) && !(pointer = pointer_create( info.pointerId, type ))) return;
+
+    buttons = compare_button( &pointer->info, &info );
+    pointer->info = info;
+    pointer->info.pointerType = pointer->type;
+    if (type == PT_TOUCH) pointer->info.sourceDevice = WINE_TOUCH_DEVICE;
+    pointer->info.ButtonChangeType = buttons;
+}
+
+static BOOL save_pointer_frame( UINT32 changed_id )
+{
+    struct user_thread_info *thread = get_user_thread_info();
+    struct pointer_frame *frame;
+    struct pointer *pointer, *changed = find_pointer( changed_id );
+    UINT count = 0, i = 0;
+
+    if (!changed || changed->type != PT_TOUCH) return TRUE;
+    LIST_FOR_EACH_ENTRY( pointer, &thread->known_pointers, struct pointer, entry )
+        if (pointer->type == PT_TOUCH && pointer->info.hwndTarget == changed->info.hwndTarget &&
+            (pointer == changed || (pointer->info.pointerFlags & POINTER_FLAG_INCONTACT))) count++;
+    if (!(frame = malloc( offsetof(struct pointer_frame, info[count]) ))) return FALSE;
+    frame->count = count;
+    LIST_FOR_EACH_ENTRY( pointer, &thread->known_pointers, struct pointer, entry )
+    {
+        if (pointer->type != PT_TOUCH || pointer->info.hwndTarget != changed->info.hwndTarget ||
+            (pointer != changed && !(pointer->info.pointerFlags & POINTER_FLAG_INCONTACT))) continue;
+        if (pointer != changed)
+        {
+            pointer->info.pointerFlags &= ~(POINTER_FLAG_DOWN | POINTER_FLAG_UP | POINTER_FLAG_NEW);
+            pointer->info.pointerFlags |= POINTER_FLAG_UPDATE;
+        }
+        pointer->info.frameId = changed->info.frameId;
+        frame->info[i++] = pointer->info;
+    }
+    free( thread->pointer_frames );
+    thread->pointer_frames = frame;
+    return TRUE;
+}
+
+static POINTER_INPUT_TYPE pointer_type_from_hw( const struct hw_msg_source *source )
+{
+    switch (source->device)
+    {
+    case IMDT_PEN: return PT_PEN;
+    case IMDT_MOUSE: return PT_MOUSE;
+    case IMDT_TOUCH: return PT_TOUCH;
+    case IMDT_TOUCHPAD: return PT_TOUCHPAD;
+    default: return PT_POINTER;
+    }
+}
+
+/***********************************************************************
+ *          process_pointer_message
+ *
+ * returns TRUE if the contents of 'msg' should be passed to the application
+ */
+BOOL process_pointer_message( MSG *msg, UINT hw_id, const struct hardware_msg_data *msg_data, BOOL remove )
+{
+    struct user_thread_info *thread = get_user_thread_info();
+    struct pending_pointer_message **cursor = (void *)&thread->pending_pointer_messages, *pending;
+    struct pointer *pointer;
+    RECT rect;
+    UINT32 id = GET_POINTERID_WPARAM( msg->wParam );
+
+    while (*cursor && (*cursor)->hw_id != hw_id) cursor = &(*cursor)->next;
+    if ((pending = *cursor))
+    {
+        struct pointer_frame *frame = pending->frame;
+        if (!remove && frame)
+        {
+            SIZE_T size = offsetof(struct pointer_frame, info[pending->frame->count]);
+            if (!(frame = malloc( size ))) return FALSE;
+            memcpy( frame, pending->frame, size );
+        }
+        if (remove) pending->frame = NULL;
+        free( thread->pointer_frames );
+        thread->pointer_frames = frame;
+        pointer = find_pointer( pending->info.pointerId );
+        if (!pointer) pointer = pointer_create( pending->info.pointerId, pending->info.pointerType );
+        if (pointer) pointer->info = pending->info;
+        *msg = pending->msg;
+        if (remove)
+        {
+            *cursor = pending->next;
+            free( pending );
+            if (msg->message == WM_POINTERLEAVE && pointer)
+            {
+                list_remove( &pointer->entry );
+                free( pointer );
+            }
+        }
+        return TRUE;
+    }
+
+    SetRect( &rect, (SHORT)LOWORD( msg->lParam ), (SHORT)HIWORD( msg->lParam ),
+             (SHORT)LOWORD( msg->lParam ), (SHORT)HIWORD( msg->lParam ) );
+    rect = map_rect_raw_to_virt( rect, get_thread_dpi() );
+    msg->lParam = MAKELPARAM( rect.left, rect.top );
+    update_pointer_from_msg( pointer_type_from_hw( &msg_data->source ), msg );
+    pointer = find_pointer( id );
+    if (msg->message == WM_POINTERDOWN || msg->message == WM_POINTERUPDATE || msg->message == WM_POINTERUP)
+        if (!save_pointer_frame( id )) return FALSE;
+    msg->pt = point_phys_to_win_dpi( msg->hwnd, msg->pt );
+    if (!remove && pointer)
+    {
+        struct pointer_frame *frame = thread->pointer_frames;
+        SIZE_T size = frame ? offsetof(struct pointer_frame, info[frame->count]) : 0;
+        if (!(pending = calloc( 1, sizeof(*pending) ))) return FALSE;
+        if (size && !(pending->frame = malloc( size )))
+        {
+            free( pending );
+            return FALSE;
+        }
+        if (size) memcpy( pending->frame, frame, size );
+        pending->info = pointer->info;
+        pending->hw_id = hw_id;
+        pending->msg = *msg;
+        pending->next = thread->pending_pointer_messages;
+        thread->pending_pointer_messages = pending;
+    }
+    if (remove && msg->message == WM_POINTERLEAVE && pointer)
+    {
+        list_remove( &pointer->entry );
+        free( pointer );
+    }
+    return TRUE;
+}

+
+/**********************************************************************
+ *       NtUserGetPointerType    (win32u.@)
+ */
+BOOL WINAPI NtUserGetPointerType( UINT32 id, POINTER_INPUT_TYPE *type )
+{
+    struct pointer *pointer;
+
+    TRACE( "%u, %p\n", id, type );
+
+    /* pointerid 1 is always the mouse */
+    if (id == 1 && type)
+    {
+        *type = PT_MOUSE;
+        return TRUE;
+    }
+
+    if (!id || !type || !(pointer = find_pointer( id )))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    *type = pointer->type;
+    return TRUE;
+}
+
+/**********************************************************************
+ *       NtUserGetPointerInfoList    (win32u.@)
+ */
+BOOL WINAPI NtUserGetPointerInfoList( UINT32 id, POINTER_INPUT_TYPE type, UINT_PTR flags, UINT_PTR unk1, SIZE_T size,
+                                      UINT32 *entry_count, UINT32 *pointer_count, void *pointer_info )
+{
+    struct user_thread_info *thread = get_user_thread_info();
+    const struct pointer_frame *frame = thread->pointer_frames;
+    struct pointer *pointer = find_pointer( id );
+    UINT entries = 1, pointers = 1, i, entry_capacity;
+    SIZE_T target_size = type == PT_POINTER ? sizeof(POINTER_INFO) :
+                        type == PT_PEN ? sizeof(POINTER_PEN_INFO) : sizeof(POINTER_TOUCH_INFO);
+    BYTE *out = pointer_info;
+    BOOL query;
+
+    if (!entry_count || !pointer_count || size != target_size || flags > 3)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!pointer)
+    {
+        RtlSetLastWin32Error( ERROR_NO_DATA );
+        return FALSE;
+    }
+    if (type != PT_POINTER && type != pointer->type)
+    {
+        RtlSetLastWin32Error( ERROR_DATATYPE_MISMATCH );
+        return FALSE;
+    }
+    query = !out && ((flags == 1 && !*pointer_count) ||
+                    (flags == 2 && !*entry_count) ||
+                    (flags == 3 && !*entry_count && !*pointer_count));
+    if (!out && !query)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((flags & 1) && pointer->type == PT_TOUCH && frame)
+    {
+        for (i = 0; i < frame->count; i++) if (frame->info[i].pointerId == id) break;
+        if (i == frame->count)
+        {
+            RtlSetLastWin32Error( ERROR_NO_DATA );
+            return FALSE;
+        }
+        pointers = frame->count;
+    }
+    entry_capacity = *entry_count;
+    if (!query && (*pointer_count < pointers || (!(flags & 2) && entry_capacity < entries)))
+    {
+        *entry_count = entries;
+        *pointer_count = pointers;
+        RtlSetLastWin32Error( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    *entry_count = entries;
+    *pointer_count = pointers;
+    TRACE_(touch)( "id %u, type %u, flags %#lx: entries %u, pointers %u, frame %u\n",
+                   id, type, flags, entries, pointers, pointer->info.frameId );
+    if (query || !entry_capacity) return TRUE;
+    for (i = 0; i < pointers; i++, out += size)
+    {
+        const POINTER_INFO *info = &pointer->info;
+        if ((flags & 1) && pointer->type == PT_TOUCH && frame) info = &frame->info[i];
+        memset( out, 0, size );
+        *(POINTER_INFO *)out = *info;
+        ((POINTER_INFO *)out)->historyCount = entries;
+    }
+    return TRUE;
+}
+
+BOOL WINAPI NtUserGetPointerDevices( UINT32 *count, POINTER_DEVICE_INFO *devices )
+{
+    static const WCHAR product[] = {'W','i','n','e',' ','d','i','r','e','c','t',' ',
+                                   't','o','u','c','h','s','c','r','e','e','n',0};
+    UINT contacts = get_system_metrics( SM_MAXIMUMTOUCHES );
+    RECT rect = get_virtual_screen_rect( 0, MDT_DEFAULT );
+    if (!count)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (devices && contacts && !*count)
+    {
+        *count = 1;
+        RtlSetLastWin32Error( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    *count = !!contacts;
+    if (devices && contacts)
+    {
+        memset( devices, 0, sizeof(*devices) );
+        devices->device = WINE_TOUCH_DEVICE;
+        devices->pointerDeviceType = POINTER_DEVICE_TYPE_TOUCH;
+        devices->monitor = NtUserMonitorFromRect( &rect, MONITOR_DEFAULTTOPRIMARY );
+        devices->startingCursorId = 2;
+        devices->maxActiveContacts = contacts;
+        memcpy( devices->productString, product, sizeof(product) );
+    }
+    return TRUE;
+}
+
+/**********************************************************************
+ *       NtUserGetPointerDeviceRects    (win32u.@)
+ */
+BOOL WINAPI NtUserGetPointerDeviceRects( HANDLE handle, RECT *device_rect, RECT *display_rect )
+{
+    RECT rect;
+
+    if (!device_rect || !display_rect || (handle != INVALID_HANDLE_VALUE && handle != WINE_TOUCH_DEVICE))
+    {
+        RtlSetLastWin32Error( ERROR_NO_DATA );
+        return FALSE;
+    }
+
+    rect = get_virtual_screen_rect( 0, MDT_DEFAULT );
+    SetRect( device_rect, 0, 0, (rect.right - rect.left) * HIMETRIC_PER_INCH / get_system_dpi(),
+             (rect.bottom - rect.top) * HIMETRIC_PER_INCH / get_system_dpi() );
+    *display_rect = rect;
+
+    TRACE( "returning device %s, display %s\n", wine_dbgstr_rect(device_rect), wine_dbgstr_rect(display_rect) );
+    return TRUE;
+}

     IMFByteStream_Release(stream);
 
     winetest_pop_context();
+}
+
+static void test_source_reader_wma2(void)
+{
+    IMFSourceReader *reader;
+    IMFMediaType *type;
+    IMFByteStream *stream;
+    IMFSample *sample;
+    DWORD flags, index, length;
+    unsigned int i, samples = 0;
+    BOOL got_eof = FALSE;
+    HRESULT hr;
+
+    if (!pMFCreateMFByteStreamOnStream)
+    {
+        win_skip("MFCreateMFByteStreamOnStream() not found\n");
+        return;
+    }
+
+    stream = get_resource_stream("test-wma2.wmv");
+    hr = MFCreateSourceReaderFromByteStream(stream, NULL, &reader);
+    if (FAILED(hr))
+    {
+        skip("MFCreateSourceReaderFromByteStream() failed, is G-Streamer missing?\n");
+        IMFByteStream_Release(stream);
+        return;
+    }
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = MFCreateMediaType(&type);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &MFAudioFormat_PCM);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMFSourceReader_SetCurrentMediaType(reader, MF_SOURCE_READER_FIRST_AUDIO_STREAM, NULL, type);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IMFMediaType_Release(type);
+
+    for (i = 0; i < 16; ++i)
+    {
+        sample = NULL;
+        flags = index = 0;
+        hr = IMFSourceReader_ReadSample(reader, MF_SOURCE_READER_FIRST_AUDIO_STREAM, 0,
+                &index, &flags, NULL, &sample);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+        if (flags & MF_SOURCE_READERF_ENDOFSTREAM)
+        {
+            ok(!sample, "Unexpected sample object.\n");
+            got_eof = TRUE;
+            break;
+        }
+
+        ok(!!sample, "Expected an audio sample.\n");
+        if (sample)
+        {
+            hr = IMFSample_GetTotalLength(sample, &length);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            ok(length != 0, "Expected nonempty PCM sample.\n");
+            if (length)
+                ++samples;
+            IMFSample_Release(sample);
+        }
+    }
+
+    ok(samples != 0, "Expected decoded PCM samples.\n");
+    ok(got_eof, "Expected end of stream.\n");
+
+    IMFSourceReader_Release(reader);
+    IMFByteStream_Release(stream);
 }
 

+static void test_sincos_profiles(void)
+{
+    static const char pixel_source[] =
+        "float4 main(float x : TEXCOORD0) : COLOR\n"
+        "{\n"
+        "    return float4(sin(x), cos(x), 0.0, 1.0);\n"
+        "}\n";
+    static const char vertex_source[] =
+        "float4 main(float4 pos : POSITION) : POSITION\n"
+        "{\n"
+        "    pos.x += sin(pos.x);\n"
+        "    pos.y += cos(pos.y);\n"
+        "    return pos;\n"
+        "}\n";
+    static const struct
+    {
+        const char *target, *source;
+        DWORD version;
+        unsigned int sincos_length;
+    }
+    tests[] =
+    {
+        {"ps_2_0", pixel_source, 0xffff0200, 4},
+        {"ps_2_a", pixel_source, 0xffff0200, 4},
+        {"ps_2_b", pixel_source, 0xffff0200, 4},
+        {"ps_2_sw", pixel_source, 0xffff0200, 4},
+        {"ps_3_0", pixel_source, 0xffff0300, 2},
+        {"vs_2_0", vertex_source, 0xfffe0200, 4},
+        {"vs_2_a", vertex_source, 0xfffe0200, 4},
+        {"vs_2_sw", vertex_source, 0xfffe0200, 4},
+        {"vs_3_0", vertex_source, 0xfffe0300, 2},
+    };
+    ID3D10Blob *shader, *disassembly;
+    unsigned int i, j, length, count, sincos_count;
+    const DWORD *tokens;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("%s", tests[i].target);
+        if ((shader = compile_shader(tests[i].source, tests[i].target, 0)))
+        {
+            tokens = ID3D10Blob_GetBufferPointer(shader);
+            count = ID3D10Blob_GetBufferSize(shader) / sizeof(*tokens);
+            ok(count && (tokens[0] & 0xffffff00) == tests[i].version,
+                    "Unexpected shader version %#lx.\n", count ? tokens[0] : 0);
+
+            sincos_count = 0;
+            for (j = 1; j < count && tokens[j] != D3DSIO_END; j += length + 1)
+            {
+                if ((tokens[j] & D3DSI_OPCODE_MASK) == D3DSIO_COMMENT)
+                    length = (tokens[j] & D3DSI_COMMENTSIZE_MASK) >> D3DSI_COMMENTSIZE_SHIFT;
+                else
+                    length = (tokens[j] & D3DSI_INSTLENGTH_MASK) >> D3DSI_INSTLENGTH_SHIFT;
+                if ((tokens[j] & D3DSI_OPCODE_MASK) == D3DSIO_SINCOS)
+                {
+                    /* SM2 has three source operands; SM3 has one. */
+                    ok(length == tests[i].sincos_length, "Unexpected SINCOS length %u.\n", length);
+                    ++sincos_count;
+                }
+            }
+            ok(j < count && tokens[j] == D3DSIO_END, "Missing shader end token.\n");
+            ok(sincos_count, "Compiled shader did not contain SINCOS.\n");
+
+            disassembly = NULL;
+            hr = D3DDisassemble(tokens, ID3D10Blob_GetBufferSize(shader), 0, NULL, &disassembly);
+            ok(hr == S_OK, "Failed to disassemble shader, hr %#lx.\n", hr);
+            if (disassembly)
+                ID3D10Blob_Release(disassembly);
+            ID3D10Blob_Release(shader);
+        }
+        winetest_pop_context();
+    }
+}

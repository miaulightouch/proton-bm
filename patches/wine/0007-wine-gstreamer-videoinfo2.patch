+static HRESULT asf_stream_convert_video_info2(AM_MEDIA_TYPE *media_type)
+{
+    const VIDEOINFOHEADER *video_format = (const VIDEOINFOHEADER *)media_type->pbFormat;
+    VIDEOINFOHEADER2 *video_format2;
+    size_t extra_size, format_size;
+
+    if (!IsEqualGUID(&media_type->majortype, &MEDIATYPE_Video)
+            || !IsEqualGUID(&media_type->formattype, &FORMAT_VideoInfo))
+        return S_FALSE;
+    if (!media_type->pbFormat || media_type->cbFormat < sizeof(*video_format))
+        return VFW_E_INVALIDMEDIATYPE;
+
+    extra_size = media_type->cbFormat - sizeof(*video_format);
+    if (extra_size > (size_t)-1 - sizeof(*video_format2)
+            || extra_size > (DWORD)-1 - sizeof(*video_format2))
+        return E_OUTOFMEMORY;
+    format_size = sizeof(*video_format2) + extra_size;
+    if (!(video_format2 = CoTaskMemAlloc(format_size)))
+        return E_OUTOFMEMORY;
+
+    memset(video_format2, 0, format_size);
+    video_format2->rcSource = video_format->rcSource;
+    video_format2->rcTarget = video_format->rcTarget;
+    video_format2->dwBitRate = video_format->dwBitRate;
+    video_format2->dwBitErrorRate = video_format->dwBitErrorRate;
+    video_format2->AvgTimePerFrame = video_format->AvgTimePerFrame;
+    video_format2->dwPictAspectRatioX = video_format->bmiHeader.biWidth < 0
+            ? -(DWORD)video_format->bmiHeader.biWidth : video_format->bmiHeader.biWidth;
+    video_format2->dwPictAspectRatioY = video_format->bmiHeader.biHeight < 0
+            ? -(DWORD)video_format->bmiHeader.biHeight : video_format->bmiHeader.biHeight;
+    video_format2->bmiHeader = video_format->bmiHeader;
+    memcpy(video_format2 + 1, video_format + 1, extra_size);
+
+    CoTaskMemFree(media_type->pbFormat);
+    media_type->formattype = FORMAT_VideoInfo2;
+    media_type->cbFormat = format_size;
+    media_type->pbFormat = (BYTE *)video_format2;
+    return S_OK;
+}
